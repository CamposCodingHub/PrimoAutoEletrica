# PRIMOX External AI (C3) — example only. Do NOT put real keys in the repo.
# Copy to .env locally (gitignored) or set User/Machine environment variables.

# Explicit enable (optional lab override). Product default remains disabled in options.
# PRIMOX_EXTERNAL_AI_ENABLED=0

# Kill-switch: set to 1 to force fail-closed regardless of enable/secret.
# PRIMOX_EXTERNAL_AI_KILL_SWITCH=0

# API key MUST come from env/user store — never commit the value.
# PRIMOX_EXTERNAL_AI_API_KEY=
