<Window x:Class="PrimoAutoEletrica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrimoAutoEletrica.UserControls"
        xmlns:helpers="clr-namespace:PrimoAutoEletrica.Helpers"
        Title="PRIMOX"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{x:Static helpers:ShellRoutedCommands.OpenCommandPalette}"/>
        <KeyBinding Key="OemQuestion" Modifiers="Control+Shift" Command="{x:Static helpers:ShellRoutedCommands.ShowShortcutsHelp}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static helpers:ShellRoutedCommands.FocusGlobalSearch}"/>
        <KeyBinding Key="F1" Command="{x:Static helpers:ShellRoutedCommands.NavigateHelp}"/>
        <KeyBinding Key="F2" Command="{x:Static helpers:ShellRoutedCommands.NavigateOrcamentos}"/>
        <KeyBinding Key="F3" Command="{x:Static helpers:ShellRoutedCommands.NavigateOrdensServico}"/>
        <KeyBinding Key="F4" Command="{x:Static helpers:ShellRoutedCommands.NavigateClientes}"/>
        <KeyBinding Key="F5" Command="{x:Static helpers:ShellRoutedCommands.RefreshModule}"/>
        <KeyBinding Key="F6" Command="{x:Static helpers:ShellRoutedCommands.NavigateEstoque}"/>
        <KeyBinding Key="F12" Command="{x:Static helpers:ShellRoutedCommands.NavigateSettings}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR PRIMOX -->
        <Border x:Name="SidebarRoot"
                Grid.Column="0"
                Style="{StaticResource PremiumSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="SidebarBrandExpanded" VerticalAlignment="Center">
                        <TextBlock Text="PRIMOX"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SidebarItemActiveForegroundBrush}"/>
                        <TextBlock Tag="SidebarLabel"
                                   Text="Operações"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarSectionTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="SidebarBrandCompact"
                               Text="PX"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrandBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <Button x:Name="SidebarToggleButton"
                            Grid.Column="1"
                            Style="{StaticResource SidebarToggleButton}"
                            Click="SidebarToggleButton_Click"
                            ToolTip="Recolher menu"
                            AutomationProperties.Name="Alternar sidebar">
                        <Path x:Name="SidebarToggleGlyph"
                              Style="{StaticResource SidebarIconPath}"
                              Data="{StaticResource Geo.MenuCollapse}"
                              Margin="0" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <TextBlock Tag="SidebarSection" Text="OPERAÇÃO" Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuDashboard"
                                Tag="Dashboard"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuDashboard_Click"
                                ToolTip="Dashboard"
                                AutomationProperties.Name="{Binding Source={StaticResource LocalizationHelper}, Path=Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Dashboard}"/>
                                <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Dashboard}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuAgendamento"
                                Tag="Agendamentos"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuAgendamento_Click"
                                ToolTip="Agendamentos">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Calendar}"/>
                                <TextBlock Tag="SidebarLabel" Text="Agendamentos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuOrcamentos"
                                Tag="Orcamentos"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuOrcamentos_Click"
                                ToolTip="Orçamentos">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Quote}"/>
                                <TextBlock Tag="SidebarLabel" Text="Orçamentos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuOS"
                                Tag="Ordens de Servico"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuOS_Click"
                                ToolTip="Ordens de Serviço">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Orders}"/>
                                <TextBlock Tag="SidebarLabel" Text="Ordens de Serviço" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuOficinaKanban"
                                Tag="Kanban da Oficina"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuOficinaKanban_Click"
                                ToolTip="Kanban da Oficina">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Kanban}"/>
                                <TextBlock Tag="SidebarLabel" Text="Kanban da Oficina" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuPDV"
                                Tag="PDV"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuPDV_Click"
                                ToolTip="PDV">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.PDV}"/>
                                <TextBlock Tag="SidebarLabel" Text="PDV" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuImportarNFe"
                                Tag="Importar NF-e"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuImportarNFe_Click"
                                ToolTip="Importar NF-e">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Import}"/>
                                <TextBlock Tag="SidebarLabel" Text="Importar NF-e" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuFiscalOperacoes"
                                Tag="Operações Fiscais"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuFiscalOperacoes_Click"
                                ToolTip="Operações Fiscais (Homologação)"
                                AutomationProperties.Name="Operações Fiscais">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Fiscal}"/>
                                <TextBlock Tag="SidebarLabel" Text="Operações Fiscais" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Tag="SidebarSection" Text="CADASTROS" Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuClientes"
                                Tag="Clientes"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuClientes_Click"
                                ToolTip="Clientes"
                                AutomationProperties.Name="{Binding Source={StaticResource LocalizationHelper}, Path=Clients}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Clients}"/>
                                <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Clients}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuVeiculos"
                                Tag="Veiculos"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuVeiculos_Click"
                                ToolTip="Veículos">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Vehicle}"/>
                                <TextBlock Tag="SidebarLabel" Text="Veículos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuAutoEletricaTecnica"
                                Tag="Auto Eletrica Tecnica"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuAutoEletricaTecnica_Click"
                                ToolTip="Auto Elétrica Técnica">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Tech}"/>
                                <TextBlock Tag="SidebarLabel" Text="Auto Elétrica Técnica" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuEstoque"
                                Tag="Estoque"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuEstoque_Click"
                                ToolTip="Estoque">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Stock}"/>
                                <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Inventory}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuCatalogoPecas"
                                Tag="Catalogo de Pecas"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuCatalogoPecas_Click"
                                ToolTip="Catálogo de Peças">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Catalog}"/>
                                <TextBlock Tag="SidebarLabel" Text="Catálogo de Peças" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuFornecedores"
                                Tag="Fornecedores"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuFornecedores_Click"
                                ToolTip="Fornecedores">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Suppliers}"/>
                                <TextBlock Tag="SidebarLabel" Text="Fornecedores" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuFuncionarios"
                                Tag="Funcionarios"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuFuncionarios_Click"
                                ToolTip="Funcionários">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Employees}"/>
                                <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Employees}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Tag="SidebarSection" Text="GESTÃO" Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuFinanceiro"
                                Tag="Financeiro"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuFinanceiro_Click"
                                ToolTip="Financeiro">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Finance}"/>
                                <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Finance}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuRelatorios"
                                Tag="Relatorios"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuRelatorios_Click"
                                ToolTip="Relatórios">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Reports}"/>
                                <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Reports}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Tag="SidebarSection" Text="SISTEMA" Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuConfiguracoes"
                                Tag="Configuracoes"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuConfiguracoes_Click"
                                ToolTip="Configurações">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Settings}"/>
                                <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Tag="SidebarSection" Text="AJUDA" Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuHelp"
                                Tag="Ajuda"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuHelp_Click"
                                ToolTip="Ajuda (F1)">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Help}"/>
                                <TextBlock Tag="SidebarLabel" Text="Ajuda" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border x:Name="SidebarUserPanel"
                            Background="{DynamicResource SidebarItemHoverBackgroundBrush}"
                            CornerRadius="{DynamicResource CornerRadiusMD}"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Tag="SidebarLabel"
                                       Text="Sessão"
                                       Foreground="{DynamicResource SidebarSectionTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="SidebarUserNameText"
                                       Tag="SidebarLabel"
                                       Foreground="{DynamicResource SidebarItemActiveForegroundBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="SidebarProfileText"
                                       Tag="SidebarLabel"
                                       Foreground="{DynamicResource SidebarSectionTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="MenuSair"
                            Style="{StaticResource SidebarItem}"
                            Click="MenuSair_Click"
                            ToolTip="Sair"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="{DynamicResource AccentButtonTextBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SidebarIconPath}" Data="{StaticResource Geo.Logout}"/>
                            <TextBlock Tag="SidebarLabel" Text="{Binding Source={StaticResource LocalizationHelper}, Path=Logout}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTEÚDO + COMMAND BAR -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource PrimoxCommandBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="160" MaxWidth="360"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PRIMOX"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrandBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="CurrentModuleText"
                                   Style="{StaticResource HeaderTitle}"
                                   MaxWidth="220"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Button x:Name="BackButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=Close}"
                                Height="36"
                                Padding="12,0"
                                Margin="0,0,6,0"
                                Click="BackButton_Click"/>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=Refresh}"
                                Height="36"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Click="RefreshButton_Click"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusFull}"
                                Padding="10,6"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="NavigationStateText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="160"/>
                        </Border>
                    </StackPanel>

                    <!-- Reservado: HeaderContextText / HeaderSystemInfoText mantidos para código legado (ocultos) -->
                    <TextBlock x:Name="HeaderContextText" Visibility="Collapsed"/>
                    <TextBlock x:Name="HeaderSystemInfoText" Visibility="Collapsed"/>

                    <controls:GlobalSearchControl x:Name="GlobalSearch"
                                                  Grid.Column="3"
                                                  Margin="12,0"
                                                  VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="CommandCenterButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Ctrl+K"
                                Height="36"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Click="CommandCenterButton_Click"
                                ToolTip="Command Center"
                                AutomationProperties.Name="Command Center"/>
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="108"
                                  Height="36"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="Português" Tag="pt-BR"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                            <ComboBoxItem Content="Español" Tag="es-ES"/>
                        </ComboBox>
                        <Button x:Name="ThemeToggleButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Tema"
                                Height="36"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Click="ThemeToggleButton_Click"
                                ToolTip="Alternar tema claro/escuro"
                                AutomationProperties.Name="Alternar tema claro/escuro"/>
                        <Button x:Name="DensityToggleButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Conforto"
                                Height="36"
                                Padding="10,0"
                                Margin="0,0,8,0"
                                Click="DensityToggleButton_Click"
                                ToolTip="Alternar modo compacto/confortavel"
                                AutomationProperties.Name="Alternar densidade da interface"/>
                        <Border Style="{StaticResource ShellHeaderInfoChip}"
                                Background="{DynamicResource BrandSoftBrush}"
                                Margin="0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Usuário"
                                           Style="{StaticResource ShellHeaderChipLabel}"/>
                                <TextBlock x:Name="HeaderUserNameText"
                                           Style="{StaticResource ShellHeaderChipValue}"
                                           MaxWidth="120"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ShellHeaderInfoChip}"
                                Margin="0,0,0,0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Perfil"
                                           Style="{StaticResource ShellHeaderChipLabel}"/>
                                <TextBlock x:Name="HeaderProfileText"
                                           Style="{StaticResource ShellHeaderChipValue}"
                                           MaxWidth="100"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HeaderDateChip"
                                Style="{StaticResource ShellHeaderInfoChip}"
                                Margin="0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Data"
                                           Style="{StaticResource ShellHeaderChipLabel}"/>
                                <TextBlock x:Name="HeaderDateText"
                                           Style="{StaticResource ShellHeaderChipValue}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ShellNotificationBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    CornerRadius="{DynamicResource CornerRadiusLG}"
                    Padding="14"
                    Margin="16,8,16,0"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="ShellNotificationTitleText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="ShellNotificationMessageText"
                                   Margin="0,4,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ShellNotificationDetailsText"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="ShellNotificationActionButton"
                            Grid.Column="1"
                            Margin="16,0,8,0"
                            Padding="16,0"
                            Height="36"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}"
                            Click="ShellNotificationActionButton_Click"/>

                    <Button x:Name="ShellNotificationDismissButton"
                            Grid.Column="2"
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            FontSize="18"
                            FontWeight="Bold"
                            Content="X"
                            Click="ShellNotificationDismissButton_Click"/>
                </Grid>
            </Border>

            <ContentControl Grid.Row="2"
                            Name="MainContent"
                            Margin="16,12,16,16"/>
        </Grid>
    </Grid>
</Window>
