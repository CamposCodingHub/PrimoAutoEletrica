<Window x:Class="PrimoAutoEletrica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrimoAutoEletrica.UserControls"
        Title="Primo Auto Eletrica"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource PremiumSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Background="{DynamicResource SecondaryLightBrush}"
                            CornerRadius="999"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14">
                        <TextBlock Text="ERP AUTOMOTIVO"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="Primo Auto"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Eletrica"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryLightBrush}"/>
                    <TextBlock Text="Navegacao centralizada, estavel e pronta para operacao real."
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,24,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="OPERACAO"
                                   Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuDashboard"
                                Tag="Dashboard"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuDashboard_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◫" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuAgendamento"
                                Tag="Agendamentos"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuAgendamento_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◴" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Agendamentos"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuOrcamentos"
                                Tag="Orcamentos"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuOrcamentos_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◭" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Orcamentos"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuOS"
                                Tag="Ordens de Servico"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuOS_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◪" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Ordens de Servico"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuPDV"
                                Tag="PDV"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuPDV_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="PDV"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuImportarNFe"
                                Tag="Importar NF-e"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuImportarNFe_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇪" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Importar NF-e"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="CADASTROS"
                                   Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuClientes"
                                Tag="Clientes"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuClientes_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◎" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Clientes"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuVeiculos"
                                Tag="Veiculos"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuVeiculos_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◌" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Veiculos"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuEstoque"
                                Tag="Estoque"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuEstoque_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◧" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Estoque"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuCatalogoPecas"
                                Tag="Catalogo de Pecas"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuCatalogoPecas_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="C" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Catalogo de Pecas"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuFornecedores"
                                Tag="Fornecedores"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuFornecedores_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◇" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Fornecedores"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuFuncionarios"
                                Tag="Funcionarios"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuFuncionarios_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Funcionarios"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="GESTAO"
                                   Style="{StaticResource SidebarSectionText}"/>

                        <Button x:Name="MenuFinanceiro"
                                Tag="Financeiro"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuFinanceiro_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◍" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Financeiro"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MenuRelatorios"
                                Tag="Relatorios"
                                Style="{StaticResource SidebarItem}"
                                Click="MenuRelatorios_Click"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◲" Width="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Relatorios"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <Border Background="{DynamicResource SecondaryLightBrush}"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sessao ativa"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="SidebarUserNameText"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="SidebarProfileText"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="MenuConfiguracoes"
                            Tag="Configuracoes"
                            Style="{StaticResource SidebarItem}"
                            Click="MenuConfiguracoes_Click"
                            Margin="0,0,0,10"
                            Background="{DynamicResource SecondaryLightBrush}"
                            Foreground="{DynamicResource AccentButtonTextBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Configuracoes"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MenuSair"
                            Style="{StaticResource SidebarItem}"
                            Click="MenuSair_Click"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="{DynamicResource AccentButtonTextBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⎋" Width="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Sair"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource PremiumHeader}"
                    CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="320" MinWidth="220" MaxWidth="380"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Plataforma estabilizada"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentModuleText"
                                   Style="{StaticResource HeaderTitle}"
                                   FontSize="20"/>
                        <TextBlock x:Name="HeaderContextText"
                                   Style="{StaticResource HeaderSubtitle}"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="HeaderSystemInfoText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <Button x:Name="BackButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Voltar"
                                Padding="16,0"
                                Margin="0,0,8,0"
                                Click="BackButton_Click"/>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Atualizar"
                                Padding="16,0"
                                Margin="0,0,12,0"
                                Click="RefreshButton_Click"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="12,8">
                            <TextBlock x:Name="NavigationStateText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <controls:GlobalSearchControl x:Name="GlobalSearch"
                                                  Grid.Column="2"
                                                  Margin="20,0"
                                                  VerticalAlignment="Center"/>

                    <WrapPanel Grid.Column="3"
                               VerticalAlignment="Center">
                        <Button x:Name="ThemeToggleButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Tema"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Click="ThemeToggleButton_Click"
                                ToolTip="Alternar tema claro/escuro"/>
                        <Border Style="{StaticResource ShellHeaderInfoChip}"
                                Background="{DynamicResource PrimaryBackgroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Usuario"
                                           Style="{StaticResource ShellHeaderChipLabel}"/>
                                <TextBlock x:Name="HeaderUserNameText"
                                           Style="{StaticResource ShellHeaderChipValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ShellHeaderInfoChip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Perfil"
                                           Style="{StaticResource ShellHeaderChipLabel}"/>
                                <TextBlock x:Name="HeaderProfileText"
                                           Style="{StaticResource ShellHeaderChipValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ShellHeaderInfoChip}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Data"
                                           Style="{StaticResource ShellHeaderChipLabel}"/>
                                <TextBlock x:Name="HeaderDateText"
                                           Style="{StaticResource ShellHeaderChipValue}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border x:Name="ShellNotificationBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,12,0,0"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="ShellNotificationTitleText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="ShellNotificationMessageText"
                                   Margin="0,4,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ShellNotificationDetailsText"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="ShellNotificationActionButton"
                            Grid.Column="1"
                            Margin="16,0,8,0"
                            Padding="16,0"
                            Height="38"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}"
                            Click="ShellNotificationActionButton_Click"/>

                    <Button x:Name="ShellNotificationDismissButton"
                            Grid.Column="2"
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            FontSize="18"
                            FontWeight="Bold"
                            Content="X"
                            Click="ShellNotificationDismissButton_Click"/>
                </Grid>
            </Border>

            <ContentControl Grid.Row="2"
                            Name="MainContent"
                            Margin="0,16,0,0"/>
        </Grid>
    </Grid>
</Window>
