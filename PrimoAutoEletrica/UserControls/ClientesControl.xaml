<UserControl x:Class="PrimoAutoEletrica.UserControls.ClientesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="ClientesModulePageHeader"
                Style="{StaticResource ModulePageHeader}">
            <StackPanel>
                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientsTitle]}"
                           Style="{StaticResource ModulePageHeaderTitle}"/>
                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientsSubtitle]}"
                           Style="{StaticResource ModulePageHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PageActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[RelationshipActions]}"
                               Style="{StaticResource PageActionTitle}"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientsActionsSubtitle]}"
                               Style="{StaticResource PageActionSubtitle}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">

                    <Button x:Name="LimparFiltrosClientesButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageSecondaryActionButton}"
                            ToolTip="{Binding Source={StaticResource LocalizationHelper}, Path=[ClearSearchAndFilters]}"
                            Click="LimparFiltrosClientesButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[ClearFilters]}"/>

                    <Button x:Name="ExportarClientesButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource ExportActionButton}"
                            ToolTip="Exportar clientes filtrados"
                            Click="ExportarClientesButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Export]}"/>

                    <Button x:Name="WhatsAppClienteButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageInfoActionButton}"
                            IsEnabled="False"
                            Click="WhatsAppClienteButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[WhatsApp]}"/>

                    <Button x:Name="NovaOsClienteButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageWarningActionButton}"
                            IsEnabled="False"
                            Click="NovaOsClienteButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NewOs]}"/>

                    <Button x:Name="NovoOrcamentoClienteButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageSecondaryActionButton}"
                            IsEnabled="False"
                            Click="NovoOrcamentoClienteButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NewQuote]}"/>

                    <Button x:Name="NovoClienteButton"
                            Style="{StaticResource PageSuccessActionButton}"
                            ToolTip="Cadastrar novo cliente (Ctrl+N)"
                            Click="NovoClienteButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NewClient]}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="4"
                     Margin="0,0,0,16">

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[TotalClients]}"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="TotalClientesText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Text="{Binding TotalClientesText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ActiveClients]}"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="ClientesAtivosText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="{Binding ClientesAtivosText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="VIP"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="ClientesFidelizadosText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding ClientesFidelizadosText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}">
                <StackPanel>
                    <TextBlock Text="Sem retorno recente"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="ClientesInativosText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ClientesInativosText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Border x:Name="ClientesLoadingPanel"
                    Style="{StaticResource LoadingStatePanel}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Carregando clientes…"
                               Style="{StaticResource LoadingStateTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Consultando cadastros e frota vinculada."
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="ClientesErrorPanel"
                    Style="{StaticResource ErrorStatePanel}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="Falha ao carregar clientes"
                               Style="{StaticResource ErrorStateTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="ClientesErrorDescriptionText"
                               Style="{StaticResource ErrorStateDescription}"
                               Text="Não foi possível consultar os clientes."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,16"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[TryAgain]}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center"
                            Click="RetryClientesButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="ClientesEmptyPanel"
                    Style="{StaticResource PrimoxEmptyStatePanel}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[NoClientsRegistered]}"
                               Style="{StaticResource PrimoxEmptyStateTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="A consulta funcionou, mas não há clientes na base. Cadastre o primeiro perfil de relacionamento."
                               Style="{StaticResource PrimoxEmptyStateDescription}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,16"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NewClient]}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Click="NovoClienteButton_Click"/>
                </StackPanel>
            </Border>

            <Grid x:Name="ClientesContentGrid"
                  Visibility="Visible">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA DE CLIENTES -->
            <Border Grid.Column="0"
                    Margin="0,0,16,0"
                    Style="{StaticResource ModalSectionCard}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FILTROS -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BuscaClienteTextBox"
                                 Height="42"
                                 Margin="0,0,12,0"
                                 Style="{StaticResource SearchBox}"
                                 Tag="{Binding Source={StaticResource LocalizationHelper}, Path=SearchPlaceholder}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="BuscaClienteTextBox_TextChanged"/>

                        <ComboBox x:Name="FiltroStatusComboBox"
                                  Grid.Column="1"
                                  Height="42"
                                  SelectionChanged="FiltroStatusComboBox_SelectionChanged"
                                  Style="{StaticResource PremiumComboBox}">

                            <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[All]}"
                                          IsSelected="True"/>

                            <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[ActiveClients]}"/>

                            <ComboBoxItem Content="VIP"/>

                            <ComboBoxItem Content="Sem retorno"/>
                        </ComboBox>
                    </Grid>

                    <!-- TABELA -->
                    <DataGrid x:Name="ClientesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionChanged="ClientesDataGrid_SelectionChanged"
                              ItemsSource="{Binding FilteredClientes}"
                              Style="{StaticResource PremiumDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientsTitle]}"
                                                    Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <Border Width="44"
                                                    Height="44"
                                                    CornerRadius="22"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">

                                                <Grid>
                                                    <Image Source="{Binding ImagemUrl}"
                                                           Stretch="UniformToFill"/>

                                                    <TextBlock Text="{Binding Iniciais}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryTextBrush}">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagemUrl}"
                                                                                 Value="">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Nome}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock Text="{Binding DocumentoResumo}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tipo"
                                                Width="120"
                                                Binding="{Binding TipoPessoaResumo}"/>

                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Contact]}"
                                                Width="170"
                                                Binding="{Binding ContatoPrincipal}"/>

                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[PrimaryVehicle]}"
                                                Width="180"
                                                Binding="{Binding VeiculoPrincipal}"/>

                            <DataGridTextColumn Header="Ultima visita"
                                                Width="120"
                                                Binding="{Binding UltimaVisita}"/>

                            <DataGridTextColumn Header="Ticket"
                                                Width="110"
                                                Binding="{Binding TicketMedio}"/>

                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                Width="120"
                                                Binding="{Binding StatusResumo}"/>

                            <DataGridTextColumn Header="LGPD"
                                                Width="145"
                                                Binding="{Binding LgpdResumo}"/>

                            <DataGridTemplateColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Actions]}"
                                                    Width="290">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <WrapPanel>
                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource TableActionButton}"
                                                    Click="VisualizarClienteButton_Click">
                                                Ver
                                            </Button>

                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource CompactSuccessActionButton}"
                                                    Click="EditarClienteButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Edit]}"/>

                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource CompactWarningActionButton}"
                                                    Click="HistoricoClienteButton_Click">
                                                Historico
                                            </Button>

                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource CompactDangerActionButton}"
                                                    Click="ExcluirClienteButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Delete]}"/>
                                        </WrapPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PAINEL DIREITO -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- CADASTROS RECENTES -->
                <Border Grid.Row="0"
                        Style="{StaticResource ModalSectionCard}"
                        Margin="0,0,0,16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Cadastros recentes"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">

                            <ItemsControl x:Name="ClientesRecentesItemsControl"
                                          ItemsSource="{Binding RecentesPanelItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,10">

                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock Text="{Binding Resumo}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- INSIGHTS OPERACIONAIS -->
                <Border Grid.Row="1"
                        Style="{StaticResource InfoCard}"
                        Margin="0,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Perfil rápido"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">

                            <StackPanel>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                    <TextBlock x:Name="InsightTicketTextBlock"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Selecione um cliente para ver identidade, frota e histórico real."/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                    <TextBlock x:Name="InsightRetencaoTextBlock"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Source={StaticResource LocalizationHelper}, Path=[LinkedVehiclesPlaceholder]}"/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">

                                    <TextBlock x:Name="InsightCrescimentoTextBlock"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="OS e indicadores usam consultas reais do domínio."/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
