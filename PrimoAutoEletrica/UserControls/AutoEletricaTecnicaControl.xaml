<UserControl x:Class="PrimoAutoEletrica.UserControls.AutoEletricaTecnicaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1440"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="TecnicaPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="{DynamicResource PageToolbarPadding}"/>
        </Style>
        <Style x:Key="TecnicaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource TecnicaPanel}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Auto eletrica tecnica"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Prontuario eletrico, diagnostico guiado, biblioteca tecnica, defeitos recorrentes, sugestao de pecas e cadastro tecnico de servicos."
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ResumoTecnicoTextBlock"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button x:Name="AtualizarTecnicaButton"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Refresh]}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="AtualizarTecnicaButton_Click"/>
                    <Button x:Name="GerarOrcamentoDiagnosticoButton"
                            Content="Gerar orcamento"
                            Style="{StaticResource PrimaryButton}"
                            Click="GerarOrcamentoDiagnosticoButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,14,0">
                <StackPanel>
                    <Border Style="{StaticResource TecnicaPanel}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Prontuario eletrico do veiculo"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="ProntuarioVeiculoTextBlock"
                                       Margin="0,8,0,12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <ItemsControl x:Name="ProntuarioItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Valor}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Grupo, StringFormat=Grupo: {0}}"
                                                           Margin="0,4,0,0"
                                                           Style="{StaticResource TecnicaLabel}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TecnicaPanel}">
                        <StackPanel>
                            <TextBlock Text="Defeitos recorrentes"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DataGrid x:Name="DefeitosRecorrentesDataGrid"
                                      Margin="0,12,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MinHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Descricao" Binding="{Binding Descricao}" Width="1.8*"/>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Qty]}" Binding="{Binding Quantidade}" Width="70"/>
                                    <DataGridTextColumn Header="Tempo" Binding="{Binding TempoMedioMinutos, StringFormat={}{0} min}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,14,0">
                <StackPanel>
                    <Border Style="{StaticResource TecnicaPanel}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Diagnostico guiado"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ListBox x:Name="RoteirosDiagnosticoListBox"
                                     Margin="0,12,0,0"
                                     MinHeight="260"
                                     SelectionChanged="RoteirosDiagnosticoListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Titulo}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Sintoma}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="0,12,0,0"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock x:Name="RoteiroDetalheTituloTextBlock"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Sequencia de testes"
                                               Margin="0,10,0,4"
                                               Style="{StaticResource TecnicaLabel}"/>
                                    <ItemsControl x:Name="RoteiroTestesItemsControl"/>
                                    <TextBlock Text="Valores esperados"
                                               Margin="0,10,0,4"
                                               Style="{StaticResource TecnicaLabel}"/>
                                    <ItemsControl x:Name="RoteiroValoresItemsControl"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TecnicaPanel}">
                        <StackPanel>
                            <TextBlock Text="Biblioteca tecnica"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ListBox x:Name="BibliotecaTecnicaListBox"
                                     Margin="0,12,0,0"
                                     MinHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Titulo}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Resumo}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource TecnicaPanel}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Servicos tecnicos"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DataGrid x:Name="ServicosTecnicosDataGrid"
                                      Margin="0,12,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MinHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Service]}" Binding="{Binding Nome}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Valor" Binding="{Binding ValorPadrao, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="Tempo" Binding="{Binding TempoMedioMinutos, StringFormat={}{0} min}" Width="90"/>
                                    <DataGridTextColumn Header="Garantia" Binding="{Binding GarantiaPadraoDias, StringFormat={}{0} dias}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TecnicaPanel}">
                        <StackPanel>
                            <TextBlock Text="Sugestao de pecas por servico"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ListBox x:Name="SugestoesPecasListBox"
                                     Margin="0,12,0,0"
                                     MinHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Servico}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Observacao}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding Pecas}"
                                                          Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
