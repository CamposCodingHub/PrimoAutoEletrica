<UserControl x:Class="PrimoAutoEletrica.UserControls.FornecedoresControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE AÇÕES -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="20,20,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Ações de fornecedores"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Gestão completa de fornecedores e parceiros comerciais"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">

                    <Button Click="AtualizarButton_Click"
                            MinWidth="112"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,8,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Refresh]}"/>
                        </StackPanel>
                    </Button>

                    <Button Click="NovoFornecedorButton_Click"
                            MinWidth="142"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,8,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource InverseTextBrush}"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Novo Fornecedor"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExcluirFornecedorSelecionadoButton"
                            Click="ExcluirFornecedorSelecionadoButton_Click"
                            MinWidth="188"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource InverseTextBrush}"
                            Background="{DynamicResource DangerBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="Excluir fornecedor selecionado"/>
                    </Button>

                </WrapPanel>
            </Grid>
        </Border>

        <!-- INDICADORES -->
        <Grid Grid.Row="1"
              Margin="20,0,20,20"
              Background="{DynamicResource AppBackgroundBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL FORNECEDORES -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,15,0">

                <StackPanel>
                    <TextBlock Text="📊 Total"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="TotalFornecedoresText"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Fornecedores cadastrados"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ATIVOS -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,15,0">

                <StackPanel>
                    <TextBlock Text="✅ Ativos"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="FornecedoresAtivosText"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"/>

                    <TextBlock Text="Fornecedores ativos"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- INATIVOS -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,15,0">

                <StackPanel>
                    <TextBlock Text="⏸️ Inativos"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="FornecedoresInativosText"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"/>

                    <TextBlock Text="Fornecedores inativos"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- MELHOR AVALIADO -->
            <Border Grid.Column="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>
                    <TextBlock Text="⭐ Melhor Avaliado"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="MelhorAvaliadoText"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"/>

                    <TextBlock Text="Maior nota ativa"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Row="2"
              Margin="20,0,20,20"
              Background="{DynamicResource AppBackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FILTROS -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">

                <Grid Background="{DynamicResource CardBackgroundBrush}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BUSCA -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔍 Buscar"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="BuscaTextBox"
                                 TextChanged="BuscaTextBox_TextChanged"
                                 Height="40"
                                 Padding="12,0"
                                 FontSize="14"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource InputForegroundBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 BorderThickness="1"
                                 CaretBrush="{DynamicResource InputForegroundBrush}"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- CATEGORIA -->
                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">

                        <TextBlock Text="📂 Categoria"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,8"/>

                        <Border Height="40"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ComboBox x:Name="FiltroCategoriaCombo"
                                      SelectionChanged="FiltroCombo_SelectionChanged"
                                      Height="40"
                                      Padding="12,0"
                                      FontSize="14"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource InputForegroundBrush}"
                                      BorderThickness="0"
                                      VerticalContentAlignment="Center">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>

                                <ComboBoxItem Content="Todas as categorias"/>
                                <ComboBoxItem Content="Peças"/>
                                <ComboBoxItem Content="Serviços"/>
                                <ComboBoxItem Content="Materiais"/>
                                <ComboBoxItem Content="Equipamentos"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- STATUS -->
                    <StackPanel Grid.Column="2"
                                Margin="15,0,0,0">

                        <TextBlock Text="📋 Status"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,8"/>

                        <Border Height="40"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ComboBox x:Name="FiltroStatusCombo"
                                      SelectionChanged="FiltroCombo_SelectionChanged"
                                      Height="40"
                                      Padding="12,0"
                                      FontSize="14"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource InputForegroundBrush}"
                                      BorderThickness="0"
                                      VerticalContentAlignment="Center">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>

                                <ComboBoxItem Content="Todos os status"/>
                                <ComboBoxItem Content="Ativo"/>
                                <ComboBoxItem Content="Inativo"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- BOTÃO LIMPAR -->
                    <Button Grid.Column="3"
                            Width="120"
                            Height="40"
                            Margin="15,0,0,0"
                            Background="{DynamicResource MutedTextBrush}"
                            Foreground="{DynamicResource InverseTextBrush}"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            VerticalAlignment="Bottom"
                            Click="LimparFiltrosButton_Click">
                        <TextBlock Text="Limpar Filtros"/>
                    </Button>

                </Grid>
            </Border>

            <!-- DATA GRID -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">

                <Grid Background="{DynamicResource CardBackgroundBrush}">
                    <DataGrid x:Name="FornecedoresDataGrid"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="FornecedoresDataGrid_SelectionChanged"
                              RowHeight="45"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource CardBackgroundBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              RowBackground="{DynamicResource CardBackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                              BorderThickness="0">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Razão Social"
                                                Width="*"
                                                Binding="{Binding RazaoSocial}"/>

                            <DataGridTextColumn Header="Nome Fantasia"
                                                Width="*"
                                                Binding="{Binding NomeFantasia}"/>

                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Cnpj]}"
                                                Width="150"
                                                Binding="{Binding CNPJ}"/>

                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Category]}"
                                                Width="120"
                                                Binding="{Binding Categoria}"/>

                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Phone]}"
                                                Width="130"
                                                Binding="{Binding Telefone}"/>

                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[City]}"
                                                Width="150"
                                                Binding="{Binding Cidade}"/>

                            <DataGridTextColumn Header="Prazo"
                                                Width="90"
                                                Binding="{Binding PrazoMedioEntregaDias, StringFormat={}{0} dia(s)}"/>

                            <DataGridTextColumn Header="Ult. Compra"
                                                Width="120"
                                                Binding="{Binding UltimaCompra, StringFormat={}{0:dd/MM/yyyy}}"/>

                            <DataGridTextColumn Header="Total Compras"
                                                Width="130"
                                                Binding="{Binding TotalCompras, StringFormat={}{0:C2}}"/>

                            <DataGridTemplateColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Ativo, Converter={StaticResource BooleanToColorConverter}}"
                                                Padding="8,4"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding Ativo, Converter={StaticResource BooleanToTextConverter}}"
                                                       Foreground="{DynamicResource InverseTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Nota"
                                                    Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nota}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Actions]}"
                                                    Width="160"
                                                    MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <Button Width="68"
                                                    Height="32"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    Foreground="{DynamicResource InverseTextBrush}"
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"
                                                    Click="VisualizarButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Visualizar fornecedor">
                                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[View]}"/>
                                            </Button>

                                            <Button Width="70"
                                                    Height="32"
                                                    Margin="6,0,0,0"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    Foreground="{DynamicResource InverseTextBrush}"
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"
                                                    Click="EditarButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Editar fornecedor">
                                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Edit]}"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
