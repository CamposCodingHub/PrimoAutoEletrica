<UserControl x:Class="PrimoAutoEletrica.UserControls.FiscalOperationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1400"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Operações Fiscais (Homologação)"
                               Style="{StaticResource PageActionTitle}"/>
                    <TextBlock Text="Configuração do emitente, saúde fiscal, produtos pendentes e histórico. Produção permanece bloqueada."
                               Style="{StaticResource PageActionSubtitle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Refresh]}"
                            Click="RefreshButton_Click"
                            Style="{StaticResource PageSecondaryActionButton}"
                            ToolTip="Atualizar saúde e histórico"
                            AutomationProperties.Name="Atualizar operações fiscais"/>
                    <Button x:Name="SaveIssuerButton"
                            Content="Salvar emitente"
                            Click="SaveIssuerButton_Click"
                            Style="{StaticResource PagePrimaryActionButton}"
                            ToolTip="Salvar configuração do estabelecimento"
                            AutomationProperties.Name="Salvar emitente fiscal"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,0,20,12"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock x:Name="HealthSummaryText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="Avaliando saúde fiscal…"/>
                <TextBlock x:Name="HealthDetailsText"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningBrush}"
                           Text="Ambiente: HOMOLOGAÇÃO · Emissão de PRODUÇÃO = BLOQUEADA"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="20,0,20,20">
            <TabItem Header="Emitente">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Cnpj]}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="CnpjTextBox" AutomationProperties.Name="CNPJ emitente"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Inscrição Estadual" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="IeTextBox" AutomationProperties.Name="IE emitente"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Razão Social" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="RazaoTextBox" AutomationProperties.Name="{Binding Source={StaticResource LocalizationHelper}, Path=[CompanyName]}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Nome Fantasia" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="FantasiaTextBox" AutomationProperties.Name="{Binding Source={StaticResource LocalizationHelper}, Path=[TradeName]}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Regime Tributário (CRT 1/2/3)" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="CrtTextBox" AutomationProperties.Name="Regime tributário"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Série NF-e" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="SerieTextBox" AutomationProperties.Name="Série NF-e"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Logradouro" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="LogradouroTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Number]}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="NumeroTextBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Complemento" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="ComplementoTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Bairro" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="BairroTextBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Município" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="MunicipioTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Código IBGE" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="IbgeTextBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="UF" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="UfTextBox" MaxLength="2"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="CEP" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="CepTextBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="CSOSN/CST padrão" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="CsosnTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Origem ICMS padrão" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="OrigemTextBox"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Produtos pendentes">
                <DataGrid x:Name="PendingProductsGrid"
                          Margin="8"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Code]}" Binding="{Binding Codigo}" Width="100"/>
                        <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="NCM" Binding="{Binding Ncm}" Width="100"/>
                        <DataGridTextColumn Header="CFOP" Binding="{Binding Cfop}" Width="80"/>
                        <DataGridTextColumn Header="Problema" Binding="{Binding Problema}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Histórico">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="HistoryGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionChanged="HistoryGrid_SelectionChanged"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Atualizado" Binding="{Binding UpdatedAt}" Width="140"/>
                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Origem" Binding="{Binding OriginModule}" Width="100"/>
                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Series]}" Binding="{Binding Serie}" Width="60"/>
                            <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Number]}" Binding="{Binding Numero}" Width="80"/>
                            <DataGridTextColumn Header="Chave" Binding="{Binding ChaveAcesso}" Width="2*"/>
                            <DataGridTextColumn Header="Ambiente" Binding="{Binding Environment}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                        <Button x:Name="ConsultarButton"
                                Content="Consultar"
                                Click="ConsultarButton_Click"
                                Style="{StaticResource PageSecondaryActionButton}"
                                IsEnabled="False"
                                Margin="0,0,8,0"
                                ToolTip="Consultar status no provider (Processing/Unknown)"
                                AutomationProperties.Name="Consultar operação fiscal"/>
                        <Button x:Name="CancelarButton"
                                Content="Cancelar (Homolog)"
                                Click="CancelarButton_Click"
                                Style="{StaticResource PageDangerActionButton}"
                                IsEnabled="False"
                                ToolTip="Somente NF-e Authorized em homologação"
                                AutomationProperties.Name="Cancelar NF-e homologação"/>
                    </StackPanel>
                    <TextBox x:Name="DetailTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             AutomationProperties.Name="Detalhe da operação fiscal"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
