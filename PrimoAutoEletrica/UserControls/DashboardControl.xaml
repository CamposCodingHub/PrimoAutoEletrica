<UserControl x:Class="PrimoAutoEletrica.UserControls.DashboardControl"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 mc:Ignorable="d"
                 d:DesignHeight="600"
                 d:DesignWidth="1000"
                 Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header interno antigo mantido oculto para não quebrar estrutura -->
        <Border Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource ShellHeaderBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                      Opacity="0.20"
                                      BlurRadius="15"
                                      ShadowDepth="5"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                <TextBlock Text="📊 Dashboard"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Painel de Gestão - Primo Auto Elétrica"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo principal -->
        <Grid Grid.Row="1"
                  Margin="20,20,20,20"
                  Background="{DynamicResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card 1 -->
            <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Receita do Dia"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock Text="R$ 0,00"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2 -->
            <Border Grid.Row="0"
                        Grid.Column="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Agendamentos Hoje"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3 -->
            <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="OS em Andamento"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4 -->
            <Border Grid.Row="0"
                        Grid.Column="3"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                <StackPanel>
                    <TextBlock Text="Estoque Crítico"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Atalhos rápidos -->
            <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">

                <Button Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource InverseTextBrush}"
                            Content="Novo Agendamento"
                            Margin="0,0,12,0"
                            Padding="20,0"
                            Height="40"
                            BorderThickness="0"
                            Cursor="Hand"/>

                <Button Background="{DynamicResource SuccessBrush}"
                            Foreground="{DynamicResource InverseTextBrush}"
                            Content="Nova Venda"
                            Margin="0,0,12,0"
                            Padding="20,0"
                            Height="40"
                            BorderThickness="0"
                            Cursor="Hand"/>

                <Button Background="{DynamicResource SecondaryLightBrush}"
                            Foreground="{DynamicResource InverseTextBrush}"
                            Content="Novo Orçamento"
                            Padding="20,0"
                            Height="40"
                            BorderThickness="0"
                            Cursor="Hand"/>
            </StackPanel>

            <!-- Área vazia do dashboard -->
            <Border Grid.Row="2"
                        Grid.ColumnSpan="4"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderThickness="0"
                        Margin="0,24,0,0"/>
        </Grid>
    </Grid>
</UserControl>