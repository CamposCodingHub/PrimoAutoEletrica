                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource InfoBrush}"/>
                                                    <TextBlock Text="Pinos vitais para medição e diagnóstico elétrico na tomada de diagnose:"
                                                               FontSize="12"
