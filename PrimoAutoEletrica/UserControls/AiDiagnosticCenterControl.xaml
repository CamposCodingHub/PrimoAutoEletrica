                                                    <TextBlock Text="• Pino 5: Terra de Sinal da ECU (Signal GND)" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="• Pino 6: Linha CAN-High (Sinal alto do barramento)" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="• Pino 14: Linha CAN-Low (Sinal baixo do barramento)" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="• Pino 16: Alimentação +12V Direta da Bateria (Linha 30)" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>

                                                    <TextBlock Text="💡 Teste de Resistência da Rede CAN: Com a bateria desconectada, meça a resistência entre o Pino 6 e o Pino 14. O valor correto deve ser 60 Ohms (dois resistores de terminação de 120 Ohms em paralelo na rede)."
                                                               FontSize="11"
