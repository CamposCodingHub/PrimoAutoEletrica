                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Abaixo de 12.2V: Bateria descarregada ou sulfatada" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>

                                                <!-- Linha 2 -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Alternador em Carga (Farol + Ar)" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="13.8V a 14.5V" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Abaixo de 13.5V: Escovas/diodos; Acima de 14.8V: Regulador aberto" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>

                                                <!-- Linha 3 -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Queda Tensão Aterramento (Linha 31)" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="&lt;= 0.20V" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Acima de 0.2V: Cabo terra do motor ou chassi oxidado" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>

                                                <!-- Linha 4 -->
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Queda Tensão Partida (Linha 50)" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="&lt;= 0.50V" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Acima de 0.5V: Comutador com folga ou relé auxiliar ausente" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>

                                                <!-- Linha 5 -->
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Consumo Parasita (Sleep Mode)" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
