                        <!-- ========================================================= -->
                        <TabItem x:Name="TabParametros"
                                 Header="📊 Parâmetros Elétricos"
                                 FontSize="12"
                                 FontWeight="SemiBold">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="📏 Valores de Referência para Diagnóstico em Auto Elétrica"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
