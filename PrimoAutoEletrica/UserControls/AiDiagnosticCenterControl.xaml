<UserControl x:Class="PrimoAutoEletrica.UserControls.AiDiagnosticCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1440"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <!-- Estilo dos cartões principais -->
        <Style x:Key="AiGlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Estilo dos chips rápidos de prompt -->
        <Style x:Key="PromptChipButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de botões de ação sugerida -->
        <Style x:Key="ActionChipButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões circulares de teste no esquema elétrico -->
        <Style x:Key="ProbePointButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ProbeGlow" Fill="{DynamicResource BrandBrush}" Opacity="0.3" Margin="-4"/>
                            <Ellipse x:Name="ProbeCircle" Fill="{DynamicResource BrandBrush}" Stroke="{DynamicResource AccentButtonTextBrush}" StrokeThickness="2"/>
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource AccentButtonTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ProbeGlow" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="ProbeCircle" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <!-- 0: Banner Superior Futurista -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Conteúdo Principal Dual-Pane -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 0. HERO BANNER: CENTRO DE IA & DIAGNÓSTICO TÉCNICO                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Style="{StaticResource AiGlassPanel}"
                Margin="0,0,0,12"
                Padding="16,12"
                BorderBrush="{DynamicResource BrandBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Indicador Pulsante Neon -->
                        <Border Background="{DynamicResource SuccessBrush}"
                                CornerRadius="5"
                                Width="10"
                                Height="10"
                                Margin="0,0,10,0"/>
                        <TextBlock Text="PRIMOX NEURAL COPILOT // LABORATÓRIO DE DIAGNÓSTICO &amp; ESQUEMAS ELÉTRICOS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <!-- Badge Motor Ativo -->
                        <Border x:Name="EngineBadge"
                                Background="{DynamicResource BrandSoftBrush}"
                                BorderBrush="{DynamicResource BrandBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="EngineBadgeText"
                                       Text="⚡ RAG Deterministico 100% Offline + Web Search"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Diagnóstico Socrático guiado, análise de esquemas de força e sinal, pinagens de relés DIN e pesquisa de diagramas automotivos na web em tempo real."
                               Margin="20,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Ações Rápidas do Cabeçalho -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="NovoChatButton"
                            Content="✨ Nova Conversa"
                            Style="{DynamicResource SecondaryButton}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="NovoChatButton_Click"
                            ToolTip="Limpar histórico da sessão e iniciar um novo diagnóstico guiado"/>

                    <Button x:Name="PesquisarWebAtalhoButton"
                            Content="🌐 Buscar Esquemas na Web"
                            Style="{DynamicResource SecondaryButton}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="PesquisarWebAtalhoButton_Click"
                            ToolTip="Pesquisar esquemas elétricos e manuais de serviço diretamente na internet"/>

                    <Button x:Name="AjudaAtalhosButton"
                            Content="❓ Guia Técnico"
                            Style="{DynamicResource GhostButton}"
                            Height="34"
                            Padding="10,0"
                            Click="AjudaAtalhosButton_Click"
                            ToolTip="Dicas de operação do Copilot de IA"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 1. ÁREA DE TRABALHO DUAL-PANE (TERMINAL DE DIÁLOGO + BANCADA VISUAL)      -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Coluna 0: Terminal de Diálogo Inteligente (45%) -->
                <ColumnDefinition Width="4.6*"/>
                <!-- Divisor Visual -->
                <ColumnDefinition Width="12"/>
                <!-- Coluna 1: Bancada Técnica & Esquemas Elétricos (55%) -->
                <ColumnDefinition Width="5.4*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- COLUNA ESQUERDA: TERMINAL DE DIÁLOGO INTELIGENTE                      -->
            <!-- ===================================================================== -->
            <Border Grid.Column="0" Style="{StaticResource AiGlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Topo: Título + Chips rápidos -->
                        <RowDefinition Height="Auto"/>
                        <!-- Centro: Histórico de Mensagens -->
                        <RowDefinition Height="*"/>
                        <!-- Indicador 'Pensando' -->
                        <RowDefinition Height="Auto"/>
                        <!-- Rodapé: Entrada de Texto e Botão Enviar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Topo do Chat: Título e Chips Rápidos -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💬 Terminal de Diálogo Técnico"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="(Passo a passo com o eletricista)"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="8,2,0,0"/>
                            </StackPanel>

                            <TextBlock Text="Enter: Enviar | Shift+Enter: Linha"
                                       HorizontalAlignment="Right"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Chips rápidos para acionamento em 1 clique -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,4">
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="🔑 Não dá partida (Tec-Tec)"
                                        Style="{StaticResource PromptChipButton}"
                                        Tag="Carro faz tec tec e não liga"
                                        Click="PromptChip_Click"/>
                                <Button Content="💡 Farol aceso direto"
                                        Style="{StaticResource PromptChipButton}"
                                        Tag="Farol alto ficou aceso direto, lâmpada 100W"
                                        Click="PromptChip_Click"/>
                                <Button Content="❄️ Ventoinha não arma (Fiat Fire)"
                                        Style="{StaticResource PromptChipButton}"
                                        Tag="Uno Mille Fire ventoinha não liga"
                                        Click="PromptChip_Click"/>
                                <Button Content="🔋 Fuga de Carga Parasita"
                                        Style="{StaticResource PromptChipButton}"
                                        Tag="Como medir consumo parasita da bateria?"
                                        Click="PromptChip_Click"/>
                                <Button Content="🚗 Chicote da Tampa Traseira"
                                        Style="{StaticResource PromptChipButton}"
                                        Tag="Lanterna traseira e luz de placa pararam juntas"
                                        Click="PromptChip_Click"/>
                                <Button Content="🔌 Pinagem Relé 4 e 5 Pinos"
                                        Style="{StaticResource PromptChipButton}"
                                        Tag="Como funciona a pinagem 30 85 86 87 do relé?"
                                        Click="PromptChip_Click"/>
                                <Button Content="🔍 DTC P0300 Falha de Ignição"
                                        Style="{StaticResource PromptChipButton}"
                                        Tag="Scanner acusou DTC P0300"
                                        Click="PromptChip_Click"/>
                            </WrapPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Histórico do Diálogo com o Eletricista -->
                    <ScrollViewer Grid.Row="1"
                                  x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,8">
                        <StackPanel x:Name="MessagesPanel" Margin="0,0,6,0"/>
                    </ScrollViewer>

                    <!-- Painel Indicador de Processamento / Pensando -->
                    <Border Grid.Row="2"
                            x:Name="ThinkingPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BrandBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource BrandBrush}"/>
                            <TextBlock Text="PRIMOX Copilot analisando telemetria, diagramas elétricos e procedimentos..."
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Caixa de Entrada de Texto -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InputTextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource BrandBrush}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MaxHeight="100"
                                     MinHeight="44"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                     VerticalContentAlignment="Center"
                                     Padding="4"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Margin="8,0,0,0">
                                <Button x:Name="EnviarButton"
                                        Content="Enviar 🚀"
                                        Style="{DynamicResource PrimaryButton}"
                                        Height="38"
                                        Padding="16,0"
                                        Click="EnviarButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===================================================================== -->
            <!-- COLUNA DIREITA: BANCADA VISUAL & ESQUEMAS ELÉTRICOS INTERATIVOS       -->
            <!-- ===================================================================== -->
            <Border Grid.Column="2" Style="{StaticResource AiGlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Topo da Bancada -->
                        <RowDefinition Height="Auto"/>
                        <!-- Conteúdo da Bancada (Tabs) -->
                        <RowDefinition Height="*"/>
                        <!-- Rodapé de Inspeção / Ponto de Teste -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Topo da Bancada -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Bancada Técnica &amp; Esquemas Elétricos"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="(Visualizador Integrado)"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="8,2,0,0"/>
                        </StackPanel>

                        <!-- Controles de Zoom e Modo de Fundo -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ZoomOutButton"
                                    Content="🔍 -"
                                    Style="{DynamicResource SecondaryButton}"
                                    Height="28"
                                    Padding="8,0"
                                    Margin="0,0,4,0"
                                    Click="ZoomOutButton_Click"
                                    ToolTip="Diminuir zoom do esquema elétrico"/>
                            <Button x:Name="ZoomResetButton"
                                    Content="100%"
                                    Style="{DynamicResource SecondaryButton}"
                                    Height="28"
                                    Padding="8,0"
                                    Margin="0,0,4,0"
                                    Click="ZoomResetButton_Click"
                                    ToolTip="Restaurar tamanho padrão"/>
                            <Button x:Name="ZoomInButton"
                                    Content="🔍 +"
                                    Style="{DynamicResource SecondaryButton}"
                                    Height="28"
                                    Padding="8,0"
                                    Click="ZoomInButton_Click"
                                    ToolTip="Aumentar zoom do esquema elétrico"/>
                        </StackPanel>
                    </Grid>

                    <!-- TabControl de Navegação da Bancada Técnica -->
                    <TabControl Grid.Row="1"
                                x:Name="WorkbenchTabControl"
                                Background="Transparent"
                                BorderThickness="0">

                        <!-- ========================================================= -->
                        <!-- ABA 1: ESQUEMAS DE CIRCUITOS INTERATIVOS                  -->
                        <!-- ========================================================= -->
                        <TabItem x:Name="TabCircuitos"
                                 Header="📐 Circuitos Elétricos"
                                 FontSize="12"
                                 FontWeight="SemiBold">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <!-- Seletor de Circuito -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Diagrama Vetorial Interativo -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Seletor de Circuito e Toolbar Trace Wire 2.0 -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Vertical">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Circuito Ativo:"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <ComboBox x:Name="CircuitSelectorComboBox"
                                                      Grid.Column="1"
                                                      Height="30"
                                                      SelectionChanged="CircuitSelectorComboBox_SelectionChanged">
                                                <ComboBoxItem Content="⚡ Circuito 1: Eletroventilador &amp; Arrefecimento (Fiat Fire / Universal)" IsSelected="True"/>
                                                <ComboBoxItem Content="⚡ Circuito 2: Motor de Partida, Solenóide &amp; Linha 50"/>
                                                <ComboBoxItem Content="⚡ Circuito 3: Relé Auxiliar de Faróis (Padrão DIN 4 e 5 Pinos)"/>
                                                <ComboBoxItem Content="⚡ Circuito 4: Teste de Consumo Parasita da Bateria (Multímetro em Série)"/>
                                                <ComboBoxItem Content="⚡ Circuito 5: Chicote da Tampa Traseira &amp; Lanternas"/>
                                                <ComboBoxItem Content="⚡ Circuito 6: Rede CAN &amp; Conector de Diagnóstico OBD-II"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Barra de Filtros Trace Wire Neon -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Botões de Destaque por Linha DIN -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Trace Wire:"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <Button x:Name="TraceLinha30Button"
                                                        Content="🔴 Linha 30 (+12V Bat)"
                                                        Style="{DynamicResource GhostButton}"
                                                        Height="24"
                                                        Padding="6,0"
                                                        Margin="0,0,4,0"
                                                        Click="TraceLinha30Button_Click"
                                                        ToolTip="Destacar condutores de alimentação direta da bateria (+12V permanente)"/>
                                                <Button x:Name="TraceLinha15Button"
                                                        Content="🟢 Linha 15 (Pós-Chave)"
                                                        Style="{DynamicResource GhostButton}"
                                                        Height="24"
                                                        Padding="6,0"
                                                        Margin="0,0,4,0"
                                                        Click="TraceLinha15Button_Click"
                                                        ToolTip="Destacar condutores de ignição pós-chave (+12V ligado)"/>
                                                <Button x:Name="TraceLinha87Button"
                                                        Content="🔵 Linha 87 (Potência)"
                                                        Style="{DynamicResource GhostButton}"
                                                        Height="24"
                                                        Padding="6,0"
                                                        Margin="0,0,4,0"
                                                        Click="TraceLinha87Button_Click"
                                                        ToolTip="Destacar saída de potência de relés para atuadores"/>
                                                <Button x:Name="TraceLinha31Button"
                                                        Content="⚪ Linha 31 (Terra)"
                                                        Style="{DynamicResource GhostButton}"
                                                        Height="24"
                                                        Padding="6,0"
                                                        Margin="0,0,4,0"
                                                        Click="TraceLinha31Button_Click"
                                                        ToolTip="Destacar malhas e cabos de aterramento ao chassi"/>
                                                <Button x:Name="TraceResetButton"
                                                        Content="🔄 Reset"
                                                        Style="{DynamicResource GhostButton}"
                                                        Height="24"
                                                        Padding="6,0"
                                                        Margin="0,0,4,0"
                                                        Click="TraceResetButton_Click"
                                                        ToolTip="Restaurar visualização normal de todos os fios"/>
                                            </StackPanel>

                                            <!-- Badge Dinâmico de Identificação do Condutor / Dica -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="ActiveWireInfoText"
                                                           Text="💡 Clique em qualquer fio ou pino para rastrear a malha contígua (Trace Wire Neon)"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Canvas de Desenho Vetorial com Zoom -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="DiagramCanvasContainer">
                                            <Grid.LayoutTransform>
                                                <ScaleTransform x:Name="DiagramScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                            </Grid.LayoutTransform>

                                            <!-- O conteúdo do circuito é montado dinamicamente no Canvas -->
                                            <Canvas x:Name="SchematicCanvas"
                                                    Width="720"
                                                    Height="420"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ========================================================= -->
                        <!-- ABA 2: DIAGRAMAS GRÁFICOS DO VEÍCULO (HD / WEB)           -->
                        <!-- ========================================================= -->
                        <TabItem x:Name="TabDiagramaGrafico"
                                 Header="🖼️ Diagrama Gráfico (HD)"
                                 FontSize="12"
                                 FontWeight="SemiBold">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <!-- Barra Superior de Controle & Amostras -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Área de Visualização do Diagrama com Zoom -->
                                    <RowDefinition Height="*"/>
                                    <!-- Rodapé com Informações Técnicas -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Barra Superior -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Informações do Diagrama Carregado -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="DiagramImageTitleText"
                                                       Text="🚗 Nenhum esquema carregado"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Border x:Name="DiagramImageBadge"
                                                    Background="{DynamicResource BrandSoftBrush}"
                                                    BorderBrush="{DynamicResource BrandBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="DiagramImageBadgeText"
                                                           Text="Aguardando"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrandBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Controles Rápidos de Zoom & Amostras -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Exemplos Rápidos 1-Clique -->
                                            <Button x:Name="ExemploHb20Button"
                                                    Content="⚡ HB20 1.0 (ME17)"
                                                    Style="{DynamicResource GhostButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Margin="0,0,4,0"
                                                    Click="ExemploHb20Button_Click"
                                                    ToolTip="Carregar esquema completo Hyundai HB20 1.0 12V Bosch ME 17.9.11.1"/>
                                            <Button x:Name="ExemploGolButton"
                                                    Content="⚡ Gol G5 (4GV)"
                                                    Style="{DynamicResource GhostButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Margin="0,0,8,0"
                                                    Click="ExemploGolButton_Click"
                                                    ToolTip="Carregar esquema VW Gol G5 Marelli IAW 4GV"/>

                                            <!-- Ferramentas de Zoom da Imagem -->
                                            <Button x:Name="ImgZoomOutButton"
                                                    Content="🔍 -"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Margin="0,0,4,0"
                                                    Click="ImgZoomOutButton_Click"
                                                    ToolTip="Diminuir zoom"/>
                                            <Button x:Name="ImgZoomResetButton"
                                                    Content="100%"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Margin="0,0,4,0"
                                                    Click="ImgZoomResetButton_Click"
                                                    ToolTip="Zoom 100% real"/>
                                            <Button x:Name="ImgZoomInButton"
                                                    Content="🔍 +"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Margin="0,0,4,0"
                                                    Click="ImgZoomInButton_Click"
                                                    ToolTip="Aumentar zoom"/>
                                            <Button x:Name="ImgZoomFitButton"
                                                    Content="↔️ Ajustar"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Margin="0,0,4,0"
                                                    Click="ImgZoomFitButton_Click"
                                                    ToolTip="Ajustar à largura da bancada"/>
                                            <Button x:Name="ImgAbrirExternoButton"
                                                    Content="📂 Abrir Externo"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Margin="0,0,4,0"
                                                    Click="ImgAbrirExternoButton_Click"
                                                    ToolTip="Abrir arquivo da imagem no visualizador padrão do Windows"/>
                                            <Button x:Name="ImgSalvarButton"
                                                    Content="💾 Salvar"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Height="28"
                                                    Padding="8,0"
                                                    Click="ImgSalvarButton_Click"
                                                    ToolTip="Exportar imagem do diagrama"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Visualizador Central da Imagem -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <ScrollViewer x:Name="DiagramImageScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="DiagramImageScrollViewer_PreviewMouseWheel">
                                        <Grid x:Name="DiagramImageContainer"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <!-- Imagem Gráfica com Transformação de Zoom -->
                                            <Image x:Name="DiagramImageDisplay"
                                                   Stretch="None"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="Collapsed">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform x:Name="DiagramImageScale" ScaleX="1.0" ScaleY="1.0"/>
                                                </Image.LayoutTransform>
                                            </Image>

                                            <!-- Estado Vazio / Dica Técnica -->
                                            <Border x:Name="DiagramEmptyStatePanel"
                                                    Background="Transparent"
                                                    Padding="40"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="📐"
                                                               FontSize="48"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,12"/>
                                                    <TextBlock Text="Nenhum diagrama gráfico carregado no visualizador"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Pergunte ao Copilot no chat (ex: 'diagrama elétrico hb20 1.0' ou 'esquema gol g5') ou clique nos botões rápidos acima para carregar o esquema em alta definição."
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Margin="0,6,0,16"
                                                               MaxWidth="480"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="🚗 Carregar HB20 1.0 (Bosch ME17)"
                                                                Style="{DynamicResource PrimaryButton}"
                                                                Height="34"
                                                                Padding="14,0"
                                                                Margin="0,0,10,0"
                                                                Click="ExemploHb20Button_Click"/>
                                                        <Button Content="🚗 Carregar VW Gol G5 (4GV)"
                                                                Style="{DynamicResource SecondaryButton}"
                                                                Height="34"
                                                                Padding="14,0"
                                                                Click="ExemploGolButton_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>

                                <!-- Rodapé Técnico com Informações de Resolução e Cache -->
                                <Border Grid.Row="2"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiagramImageInfoText"
                                                   Text="Nenhuma imagem carregada"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Zoom: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock x:Name="DiagramImageZoomText" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ========================================================= -->
                        <!-- ABA 3: PINAGENS DIN & RELÉS AUTOMOTIVOS                   -->
                        <!-- ========================================================= -->
                        <!-- ========================================================= -->
                        <!-- ABA 3: BIBLIOTECA TÉCNICA, PINAGENS & LINHA PESADA 24V    -->
                        <!-- ========================================================= -->
                        <TabItem x:Name="TabPinosReles"
                                 Header="📚 Biblioteca Técnica &amp; Pinagens"
                                 FontSize="12"
                                 FontWeight="SemiBold">
                            <TabControl Margin="0,8,0,0">
                                <!-- SUB-ABA 1: PINAGENS DE MÓDULOS ECU / BCM -->
                                <TabItem Header="🔌 Pinagens de Módulos (ECU / BCM)" FontSize="12">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Barra de Filtros -->
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox x:Name="ModuloBuscaTextBox"
                                                         Grid.Column="0"
                                                         Height="32"
                                                         VerticalContentAlignment="Center"
                                                         Padding="8,0"
                                                         FontSize="12"
                                                         Text="ME 7.5"
                                                         KeyDown="ModuloBuscaTextBox_KeyDown"/>

                                                <ComboBox x:Name="ModuloMontadoraComboBox"
                                                          Grid.Column="1"
                                                          Height="32"
                                                          Margin="6,0,0,0"
                                                          FontSize="12"
                                                          SelectionChanged="ModuloFiltro_SelectionChanged">
                                                    <ComboBoxItem Content="Todas Montadoras" IsSelected="True"/>
                                                    <ComboBoxItem Content="Volkswagen"/>
                                                    <ComboBoxItem Content="Chevrolet / GM"/>
                                                    <ComboBoxItem Content="Fiat"/>
                                                    <ComboBoxItem Content="Scania"/>
                                                    <ComboBoxItem Content="Mercedes-Benz"/>
                                                    <ComboBoxItem Content="Volvo"/>
                                                </ComboBox>

                                                <ComboBox x:Name="ModuloTensaoComboBox"
                                                          Grid.Column="2"
                                                          Height="32"
                                                          Margin="6,0,0,0"
                                                          FontSize="12"
                                                          SelectionChanged="ModuloFiltro_SelectionChanged">
                                                    <ComboBoxItem Content="Todas Tensões" IsSelected="True"/>
                                                    <ComboBoxItem Content="12V"/>
                                                    <ComboBoxItem Content="24V"/>
                                                </ComboBox>

                                                <Button x:Name="ModuloBuscarButton"
                                                        Grid.Column="3"
                                                        Content="🔍 Buscar"
                                                        Style="{DynamicResource PrimaryButton}"
                                                        Height="32"
                                                        Padding="12,0"
                                                        Margin="6,0,0,0"
                                                        Click="ModuloBuscarButton_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card Informativo do Módulo Selecionado -->
                                        <Border Grid.Row="1"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="ModuloTituloTextBlock"
                                                                   Text="Bosch Motronic ME 7.5.20 / ME 7.5.30"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrandBrush}"/>
                                                        <Border x:Name="ModuloTensaoBadge"
                                                                Background="{DynamicResource BrandSoftBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="8,0,0,0">
                                                            <TextBlock x:Name="ModuloTensaoTextBlock"
                                                                       Text="12V"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource BrandBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ModuloAplicacaoTextBlock"
                                                               Text="VW Gol G4/G5, Fox, Voyage, Saveiro 1.0 e 1.6 TotalFlex (EA111)"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Margin="0,4,0,2"/>
                                                    <TextBlock x:Name="ModuloConectoresTextBlock"
                                                               Text="Conector A (40 pinos) + Conector B (64 pinos)"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock x:Name="ModuloObsTextBlock"
                                                               Text="Aterramento central na carcaça. Fusível F14."
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontStyle="Italic"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Seletor Rápido de Módulo -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="Módulo Ativo:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="ModuloSelecionadoComboBox"
                                                              Width="260"
                                                              Height="32"
                                                              DisplayMemberPath="NomeModulo"
                                                              SelectionChanged="ModuloSelecionadoComboBox_SelectionChanged"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- DataGrid de Pinos -->
                                        <DataGrid x:Name="ModuloPinosDataGrid"
                                                  Grid.Row="2"
                                                  Style="{DynamicResource PremiumDataGrid}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Single"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column"
                                                  MinHeight="180">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Conector" Binding="{Binding Conector}" Width="120"/>
                                                <DataGridTextColumn Header="Pino" Binding="{Binding NumeroPino}" Width="70" FontWeight="Bold"/>
                                                <DataGridTextColumn Header="Função / Sinal" Binding="{Binding FuncaoSinal}" Width="2*"/>
                                                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoSinal}" Width="1.2*"/>
                                                <DataGridTextColumn Header="Cor do Fio" Binding="{Binding CorFio}" Width="110"/>
                                                <DataGridTextColumn Header="Tensão Esperada" Binding="{Binding TensaoEsperada}" Width="120"/>
                                                <DataGridTextColumn Header="Observações Técnicas" Binding="{Binding ObservacoesTecnicas}" Width="2.5*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Barra de Ações Inferior -->
                                        <Border Grid.Row="3"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8"
                                                Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="CopiarPinagemButton"
                                                        Content="📋 Copiar Dados da Pinagem"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Height="30"
                                                        Padding="10,0"
                                                        Margin="0,0,8,0"
                                                        Click="CopiarPinagemButton_Click"/>
                                                <Button x:Name="ConsultarPinagemNoCopilotButton"
                                                        Content="💬 Diagnosticar Este Módulo no Copilot"
                                                        Style="{DynamicResource PrimaryButton}"
                                                        Height="30"
                                                        Padding="12,0"
                                                        Click="ConsultarPinagemNoCopilotButton_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <!-- SUB-ABA 2: CENTRAIS DE FUSÍVEIS & RELÉS -->
                                <TabItem Header="⚡ Centrais de Fusíveis &amp; Relés" FontSize="12">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Seletor de Central & Busca -->
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox x:Name="CentralSelecionadaComboBox"
                                                          Grid.Column="0"
                                                          Height="32"
                                                          Margin="0,0,6,0"
                                                          DisplayMemberPath="Titulo"
                                                          SelectionChanged="CentralSelecionadaComboBox_SelectionChanged"/>

                                                <TextBox x:Name="CentralBuscaTextBox"
                                                         Grid.Column="1"
                                                         Height="32"
                                                         VerticalContentAlignment="Center"
                                                         Padding="8,0"
                                                         FontSize="12"
                                                         Text="Bomba"
                                                         KeyDown="CentralBuscaTextBox_KeyDown"/>

                                                <Button x:Name="CentralBuscarButton"
                                                        Grid.Column="2"
                                                        Content="🔍 Filtrar"
                                                        Style="{DynamicResource PrimaryButton}"
                                                        Height="32"
                                                        Padding="12,0"
                                                        Margin="6,0,0,0"
                                                        Click="CentralBuscarButton_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card Resumo da Central -->
                                        <Border Grid.Row="1"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock x:Name="CentralTituloTextBlock"
                                                           Text="Central Elétrica - VW Gol G5 EA111"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BrandBrush}"/>
                                                <TextBlock x:Name="CentralDetalheTextBlock"
                                                           Text="Localização: Abaixo do Painel | Tensão: 12V | Aplicação: Gol, Voyage, Fox"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Split Fusíveis e Relés -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- DataGrid Fusíveis -->
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    Margin="0,0,6,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top"
                                                               Text="🔌 Mapa de Fusíveis da Central"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Margin="0,0,0,6"/>
                                                    <DataGrid x:Name="CentralFusiveisDataGrid"
                                                              Style="{DynamicResource PremiumDataGrid}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"
                                                              HeadersVisibility="Column"
                                                              GridLinesVisibility="Horizontal">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Fusível" Binding="{Binding Numero}" Width="65" FontWeight="Bold"/>
                                                            <DataGridTextColumn Header="Corrente" Binding="{Binding CapacidadeAmperes, StringFormat={}{0}A}" Width="70"/>
                                                            <DataGridTextColumn Header="Cor Padrão" Binding="{Binding CorPadrao}" Width="100"/>
                                                            <DataGridTextColumn Header="Circuito Protegido" Binding="{Binding CircuitoProtegido}" Width="*"/>
                                                            <DataGridTextColumn Header="Relé Associado" Binding="{Binding ReleAssociado}" Width="120"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>

                                            <!-- DataGrid Relés -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    Margin="6,0,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top"
                                                               Text="⚡ Relés e Comutadores"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Margin="0,0,0,6"/>
                                                    <DataGrid x:Name="CentralRelesDataGrid"
                                                              Style="{DynamicResource PremiumDataGrid}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"
                                                              HeadersVisibility="Column"
                                                              GridLinesVisibility="Horizontal">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Posição" Binding="{Binding Posicao}" Width="65" FontWeight="Bold"/>
                                                            <DataGridTextColumn Header="Função" Binding="{Binding NomeFuncao}" Width="1.5*"/>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoPinos}" Width="90"/>
                                                            <DataGridTextColumn Header="Pinagem / Teste" Binding="{Binding PinagemReferencia}" Width="2*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </TabItem>

                                <!-- SUB-ABA 3: LINHA PESADA 24V FROTAS -->
                                <TabItem Header="🚛 Linha Pesada 24V Frotas" FontSize="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                        <StackPanel>
                                            <!-- Seletor de Modelo Pesado -->
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="Selecione o Veículo 24V:"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <ComboBox x:Name="PesadoSelecionadoComboBox"
                                                              Grid.Column="1"
                                                              Height="32"
                                                              DisplayMemberPath="Modelo"
                                                              SelectionChanged="PesadoSelecionadoComboBox_SelectionChanged"/>
                                                </Grid>
                                            </Border>

                                            <!-- Bloco 1: Sistema Elétrico 24V & Baterias -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="⚡ Sistema Elétrico 24V &amp; Balanceamento de Baterias"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource BrandBrush}"/>
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="• Tensão do Sistema:" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock x:Name="PesadoTensaoTextBlock" Text="24V Nominal (28.4V Carregando)" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,2,0,6"/>
                                                            <TextBlock Text="• Alternador:" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock x:Name="PesadoAlternadorTextBlock" Text="Bosch 28V 100A/150A com LIN" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,2,0,6"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <TextBlock Text="• Baterias em Série:" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock x:Name="PesadoBateriasTextBlock" Text="2x 12V em série. Diferença máx 0.25V" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="10,2,0,6"/>
                                                            <TextBlock Text="• Consumo Máximo em Repouso:" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock x:Name="PesadoStandbyTextBlock" Text="&lt;= 45mA após corte de repouso" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,2,0,6"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bloco 2: Torques de Cabeçote & Folga de Válvulas -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="⚙️ Torques Normativos &amp; Folga de Válvulas a Frio"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource InfoBrush}"/>
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="• Torque de Aperto do Cabeçote:" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock x:Name="PesadoTorqueTextBlock" Text="1ª: 60 Nm | 2ª: 150 Nm | 3ª: +90°" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="10,2,0,6"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <TextBlock Text="• Calibração de Folga de Válvulas:" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock x:Name="PesadoFolgaTextBlock" Text="Admissão: 0.45 mm | Escape: 0.70 mm" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="10,2,0,6"/>
                                                        </StackPanel>
