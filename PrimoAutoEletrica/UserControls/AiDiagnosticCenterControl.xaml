                                                                <TextBlock Text="• Pino 85: Bobina (Negativo / Controle)" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,2"/>
                                                                <TextBlock Text="• Pino 86: Bobina (Positivo / Disparo)" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,2"/>
