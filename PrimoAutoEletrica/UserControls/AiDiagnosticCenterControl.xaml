                        <!-- ========================================================= -->
                        <!-- ABA 6: BASE SURETRACK (CASOS CONFIRMADOS DA OFICINA)      -->
                        <!-- ========================================================= -->
                        <TabItem x:Name="TabSureTrack"
                                 Header="📊 Repair Intelligence (Base Técnica)"
                                 FontSize="12"
                                 FontWeight="SemiBold">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <!-- 0: Barra de Busca e Filtros Rápidos -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 1: Conteúdo Principal com Estatísticas e Casos -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Topo: Barra de Busca e Filtro de Modelo/DTC -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="10"
                                        Padding="10,8"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Buscar Caso ou DTC:"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>

                                            <TextBox x:Name="SureTrackSearchTextBox"
                                                     Grid.Column="1"
                                                     Height="30"
                                                     FontSize="12"
                                                     VerticalContentAlignment="Center"
                                                     Padding="6,0"
                                                     KeyDown="SureTrackSearchTextBox_KeyDown"
                                                     ToolTip="Digite modelo do carro (Onix, Gol, Palio), DTC (P0300, P0118) ou sintoma"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button x:Name="SureTrackSearchButton"
                                                        Content="🔍 Consultar"
                                                        Style="{DynamicResource PrimaryButton}"
                                                        Height="30"
                                                        Padding="12,0"
                                                        Click="SureTrackSearchButton_Click"/>
                                                <Button x:Name="SureTrackLimparButton"
                                                        Content="Limpar"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Height="30"
                                                        Padding="8,0"
                                                        Margin="4,0,0,0"
                                                        Click="SureTrackLimparButton_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Chips Rápidos de Pesquisa SureTrack -->
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="Atalhos:"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,6"/>
                                            <Button Content="Onix P0300"
                                                    Style="{StaticResource PromptChipButton}"
                                                    Tag="Onix P0300"
                                                    Click="SureTrackChip_Click"/>
                                            <Button Content="Gol P0118 Ventoinha"
                                                    Style="{StaticResource PromptChipButton}"
                                                    Tag="Gol P0118"
                                                    Click="SureTrackChip_Click"/>
                                            <Button Content="Palio Linha 50 Partida"
                                                    Style="{StaticResource PromptChipButton}"
                                                    Tag="Palio partida"
                                                    Click="SureTrackChip_Click"/>
                                            <Button Content="Corolla P0101 MAF"
                                                    Style="{StaticResource PromptChipButton}"
                                                    Tag="Corolla P0101"
                                                    Click="SureTrackChip_Click"/>
                                            <Button Content="Sandero Bateria LIN"
                                                    Style="{StaticResource PromptChipButton}"
                                                    Tag="Sandero bateria"
                                                    Click="SureTrackChip_Click"/>
                                            <Button Content="Civic Ar-Condicionado"
                                                    Style="{StaticResource PromptChipButton}"
                                                    Tag="Civic ar"
                                                    Click="SureTrackChip_Click"/>
                                            <Button Content="Accelo 24V CAN"
                                                    Style="{StaticResource PromptChipButton}"
                                                    Tag="Accelo CAN"
                                                    Click="SureTrackChip_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Conteúdo Dividido: Probabilidade & Atalho 15 min + Grid de Casos -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Painel de Probabilidade Empírica -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🎯 Probabilidade de Causa-Raiz (PRIMOX Repair Intelligence)"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock x:Name="SureTrackBadgeTotalTextBlock"
                                                                   Text="(10 casos curados)"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Margin="8,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <ItemsControl x:Name="SureTrackProbabilidadeItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8"
                                                                    Padding="10"
                                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Linha 0: Causa Raiz e Percentual -->
                                                                    <Grid Grid.Row="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding CausaRaiz}"
                                                                                   FontWeight="Bold"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                        <Border Grid.Column="1"
                                                                                Background="{DynamicResource BrandSoftBrush}"
                                                                                CornerRadius="6"
                                                                                Padding="6,2"
                                                                                Margin="6,0,0,0">
                                                                            <TextBlock Text="{Binding PercentualFormatado}"
                                                                                       FontWeight="Bold"
                                                                                       FontSize="12"
                                                                                       Foreground="{DynamicResource BrandBrush}"/>
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- Linha 1: Barra Gráfica de Progresso -->
                                                                    <ProgressBar Grid.Row="1"
                                                                                 Value="{Binding PercentualProbabilidade}"
                                                                                 Maximum="100"
                                                                                 Height="8"
                                                                                 Margin="0,6,0,6"
                                                                                 Foreground="{DynamicResource SuccessBrush}"
                                                                                 Background="{DynamicResource CardBackgroundBrush}"/>

                                                                    <!-- Linha 2: Ocorrências e Procedimento -->
                                                                    <TextBlock Grid.Row="2"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               TextWrapping="Wrap">
                                                                        <Run Text="{Binding OcorrenciasFormatado}" FontWeight="SemiBold"/>
                                                                        <Run Text=" • Procedimento: "/>
                                                                        <Run Text="{Binding ProcedimentoRecomendado}"/>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Dica de 15 Minutos (Atalho do Eletricista Sênior) -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BrandBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="⏱️ Dica de 15 Minutos (Atalho do Eletricista Sênior)"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrandBrush}"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock x:Name="SureTrackDica15MinTextBlock"
                                                           Text="Inspecione os cabos de vela e corpo da bobina à procura de marcas brancas de faiscamento para descartar módulo."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Histórico de Casos Detalhados -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="📋 Casos Confirmados Catalogados na Oficina"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Button x:Name="EnviarCasoParaCopilotButton"
                                                            Content="💬 Enviar Caso para o Copilot"
                                                            Style="{DynamicResource SecondaryButton}"
                                                            HorizontalAlignment="Right"
                                                            Height="28"
                                                            Padding="8,0"
                                                            Click="EnviarCasoParaCopilotButton_Click"/>
                                                </Grid>

                                                <DataGrid x:Name="SureTrackCasosDataGrid"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          IsReadOnly="True"
                                                          MinHeight="200"
                                                          MaxHeight="320"
                                                          Style="{DynamicResource PremiumDataGrid}"
                                                          Background="Transparent"
                                                          SelectionMode="Single">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Veículo" Binding="{Binding VeiculoFormatado}" Width="1.4*"/>
                                                        <DataGridTextColumn Header="DTC" Binding="{Binding CodigosDTC}" Width="80"/>
                                                        <DataGridTextColumn Header="Sintoma" Binding="{Binding SintomaPrincipal}" Width="1.8*"/>
                                                        <DataGridTextColumn Header="Causa Raiz Confirmada" Binding="{Binding CausaRaizDetectada}" Width="2*"/>
                                                        <DataGridTextColumn Header="Confirmados" Binding="{Binding OcorrenciasConfirmadas, StringFormat={}{0}x}" Width="85"/>
                                                        <DataGridTextColumn Header="Origem" Binding="{Binding OrigemCaso}" Width="90"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- ========================================================= -->
                        <!-- ABA 7: DIAGNÓSTICO GUIADO & CALCULADORA DE QUEDA DE TENSÃO -->
                        <!-- ========================================================= -->
                        <TabItem x:Name="TabDiagnosticoGuiado"
                                 Header="🧠 Diagnóstico Guiado &amp; Queda de Tensão"
                                 FontSize="13"
                                 FontWeight="SemiBold">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COLUNA ESQUERDA: ÁRVORE INTERATIVA DE TROUBLESHOOTING -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource AiGlassPanel}"
                                        Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Topo: Seletor de Fluxograma e Reset -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Árvore de Diagnóstico Guiado (Troubleshooting)"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Passo a passo com eliminação lógica e ferramentas de bancada (Bosch ESI / Doutor-IE)."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,2,0,6"/>
                                                <ComboBox x:Name="FluxogramasComboBox"
                                                          Height="32"
                                                          Style="{DynamicResource PremiumComboBox}"
                                                          DisplayMemberPath="Titulo"
                                                          SelectionChanged="FluxogramasComboBox_SelectionChanged"/>
                                            </StackPanel>
                                            <Button x:Name="ReiniciarFluxogramaButton"
                                                    Grid.Column="1"
                                                    Content="🔄 Reiniciar"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Height="32"
                                                    Margin="8,18,0,0"
                                                    Click="ReiniciarFluxogramaButton_Click"
                                                    ToolTip="Reiniciar este fluxograma do primeiro passo"/>
                                        </Grid>

                                        <!-- Centro: Painel do Passo Atual e Conclusão -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <!-- Card do Passo Atual -->
                                                <Border x:Name="CardPassoAtualBorder"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BrandBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="12"
                                                        Padding="14"
                                                        Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <TextBlock x:Name="PassoTituloTextBlock"
                                                                       Text="Passo 1: Teste de Tensão"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource BrandBrush}"/>
                                                            <Border x:Name="CategoriaFluxoBadge"
                                                                    HorizontalAlignment="Right"
                                                                    Background="{DynamicResource BrandSoftBrush}"
                                                                    CornerRadius="10"
                                                                    Padding="8,2">
                                                                <TextBlock x:Name="CategoriaFluxoTextBlock"
                                                                           Text="Partida &amp; Carga"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrandBrush}"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Instrução de Teste em Destaque -->
                                                        <TextBlock x:Name="InstrucaoTesteTextBlock"
                                                                   Text="Instrução do teste..."
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,0,10"/>

                                                        <!-- Metadados do Teste (Ferramenta, Ponto, Valor) -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="🔧 Instrumento: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock x:Name="FerramentaRecomendadaTextBlock" Text="Multímetro Digital" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="📍 Ponto de Teste: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock x:Name="PontoMedicaoTextBlock" Text="Bornes da bateria" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="⚡ Valor Esperado: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock x:Name="ValorEsperadoTextBlock" Text=">= 9.60V" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Botões de Decisão / Resposta Rápida de 1-Clique -->
                                                        <TextBlock Text="Selecione o resultado medido na bancada:"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Margin="0,8,0,6"/>

                                                        <ItemsControl x:Name="OpcoesRespostaItemsControl">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding TextoBotao}"
                                                                            Style="{DynamicResource SecondaryButton}"
                                                                            Height="36"
                                                                            Margin="0,0,0,6"
                                                                            HorizontalContentAlignment="Left"
                                                                            Padding="12,0"
                                                                            FontWeight="SemiBold"
                                                                            Cursor="Hand"
                                                                            Tag="{Binding}"
                                                                            Click="AvancarOpcaoFluxograma_Click"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Card de Conclusão / Diagnóstico Confirmado -->
                                                <Border x:Name="CardConclusaoBorder"
                                                        Visibility="Collapsed"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="#10B981"
                                                        BorderThickness="2"
                                                        CornerRadius="12"
                                                        Padding="14"
                                                        Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <TextBlock Text="🎯 CAUSA RAIZ CONFIRMADA"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="#10B981"/>
                                                            <Border HorizontalAlignment="Right"
                                                                    Background="#2010B981"
                                                                    CornerRadius="10"
                                                                    Padding="8,2">
                                                                <TextBlock Text="Diagnóstico Concluído"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#10B981"/>
                                                            </Border>
                                                        </Grid>

                                                        <TextBlock x:Name="ConclusaoDiagnosticaTextBlock"
                                                                   Text="Causa raiz detectada..."
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,8"/>

                                                        <TextBlock Text="🛠️ Procedimento Recomendado:"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <TextBlock x:Name="AcaoRecomendadaTextBlock"
                                                                   Text="Ação corretiva..."
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,12"/>

                                                        <!-- Ponte 1-Click com a Ordem de Serviço -->
                                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="Sugestão de Reposição / Aplicação:"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock x:Name="PecaSugeridaTextBlock"
                                                                               Text="Peça sugerida"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource BrandBrush}"/>
                                                                </StackPanel>
                                                                <Button x:Name="InserirPecaFluxogramaEmOSButton"
                                                                        Grid.Column="1"
                                                                        Content="➕ Inserir na OS"
                                                                        Style="{DynamicResource PrimaryButton}"
                                                                        Height="30"
                                                                        Padding="10,0"
                                                                        Click="InserirPecaFluxogramaEmOSButton_Click"
                                                                        ToolTip="Vincular e adicionar esta peça/serviço diretamente em uma Ordem de Serviço aberta"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- Rodapé: Trilha de Passos Realizados (Breadcrumbs) -->
                                        <Border Grid.Row="2"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,6"
                                                Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Histórico da Trilha de Testes:"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock x:Name="TrilhaPassosTextBlock"
                                                           Text="Início do diagnóstico."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- COLUNA DIREITA: CALCULADORA DE QUEDA DE TENSÃO (VOLTAGE DROP) -->
                                <Border Grid.Column="1"
                                        Style="{StaticResource AiGlassPanel}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Topo: Título da Calculadora -->
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="Calculadora de Queda de Tensão (Voltage Drop)"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Normas SAE J1128 &amp; DIN 72551 para circuitos de potência, carga e chassi."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Centro: Formulário e Painel de Resultados -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <!-- Grid de Entradas -->
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10"
                                                        Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- V Fonte -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                                            <TextBlock Text="Tensão na Fonte (V):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBox x:Name="TensaoFonteTextBox" Text="12.60" Height="28" Style="{DynamicResource SearchBoxStyle}"/>
                                                        </StackPanel>

                                                        <!-- V Carga -->
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                                                            <TextBlock Text="Tensão na Carga (V):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBox x:Name="TensaoCargaTextBox" Text="11.40" Height="28" Style="{DynamicResource SearchBoxStyle}"/>
                                                        </StackPanel>

                                                        <!-- Corrente (A) -->
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,8">
                                                            <TextBlock Text="Corrente Medida (A):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBox x:Name="CorrenteAmperesTextBox" Text="15.0" Height="28" Style="{DynamicResource SearchBoxStyle}"/>
                                                        </StackPanel>

                                                        <!-- Comprimento (m) -->
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,8">
                                                            <TextBlock Text="Comprimento Cabo (m):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBox x:Name="ComprimentoCaboTextBox" Text="2.5" Height="28" Style="{DynamicResource SearchBoxStyle}"/>
                                                        </StackPanel>

                                                        <!-- Tipo de Circuito -->
                                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                                            <TextBlock Text="Tipo de Circuito Automotivo:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <ComboBox x:Name="TipoCircuitoComboBox" Height="28" Style="{DynamicResource PremiumComboBox}">
                                                                <ComboBoxItem Content="Potência (SAE J1128 - Limite 0.20V)" IsSelected="True"/>
                                                                <ComboBoxItem Content="Aterramento / Massa (DIN - Limite 0.10V)"/>
                                                                <ComboBoxItem Content="Sinal / Sensores (Eletrônica - Limite 0.05V)"/>
                                                                <ComboBoxItem Content="Linha Pesada 24V (Força - Limite 0.40V)"/>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <!-- Identificação do Circuito e Placa -->
                                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,6,8">
                                                            <TextBlock Text="Identificação do Circuito:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBox x:Name="IdentificacaoCircuitoTextBox" Text="Alimentação B+ Motor Partida" Height="28" Style="{DynamicResource SearchBoxStyle}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="6,0,0,8">
                                                            <TextBlock Text="Placa do Veículo (Opcional):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBox x:Name="PlacaCalculoTextBox" Height="28" Style="{DynamicResource SearchBoxStyle}"/>
                                                        </StackPanel>

                                                        <!-- Botão de Ação -->
                                                        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Name="CalcularQuedaTensaoButton"
                                                                    Content="⚡ Calcular Queda &amp; Analisar"
                                                                    Style="{DynamicResource PrimaryButton}"
                                                                    Height="32"
                                                                    Click="CalcularQuedaTensaoButton_Click"/>
                                                            <Button x:Name="SalvarHistoricoCalculoButton"
                                                                    Grid.Column="1"
                                                                    Content="💾 Salvar Histórico"
                                                                    Style="{DynamicResource SecondaryButton}"
                                                                    Height="32"
                                                                    Margin="8,0,0,0"
                                                                    Click="SalvarHistoricoCalculoButton_Click"
                                                                    ToolTip="Salvar este laudo de medição no histórico da oficina"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!-- Card com Resultados do Cálculo -->
                                                <Border x:Name="ResultadoCalculoBorder"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BrandBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <TextBlock Text="Resultado da Análise Elétrica"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <Border x:Name="StatusConformidadeBadge"
                                                                    HorizontalAlignment="Right"
                                                                    Background="#EF4444"
                                                                    CornerRadius="10"
                                                                    Padding="8,2">
                                                                <TextBlock x:Name="StatusConformidadeTextBlock"
                                                                           Text="NÃO CONFORME"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Indicadores Principais em Grid 2x2 -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Queda ΔV -->
                                                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="6" Margin="0,0,3,3">
                                                                <StackPanel>
                                                                    <TextBlock Text="Queda Efetiva (ΔV):" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock x:Name="QuedaTensaoTextBlock" Text="1.20 V (9.5%)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Resistência Parasita -->
                                                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="6" Margin="3,0,0,3">
                                                                <StackPanel>
                                                                    <TextBlock Text="Resistência Parasita:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock x:Name="ResistenciaParasitaTextBlock" Text="0.0800 Ω" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Calor Dissipado -->
                                                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="6" Margin="0,3,3,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="Calor Dissipado:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock x:Name="PotenciaDissipadaTextBlock" Text="18.00 Watts" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Bitola Recomendada -->
                                                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="6" Margin="3,3,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="Bitola Mínima Sugerida:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock x:Name="BitolaSugeridaTextBlock" Text="16.00 mm²" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Diagnóstico e Ação -->
                                                        <TextBlock x:Name="DiagnosticoCalculoTextBlock"
                                                                   Text="Diagnóstico técnico detalhado..."
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,6"/>

                                                        <TextBlock x:Name="AcaoCalculoTextBlock"
                                                                   Text="Ação corretiva recomendada..."
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,8"/>

                                                        <!-- Ações Rápidas do Laudo -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button x:Name="CopiarLaudoQuedaTensaoButton"
                                                                    Content="📋 Copiar Laudo"
                                                                    Style="{DynamicResource SecondaryButton}"
                                                                    Height="26"
                                                                    Padding="8,0"
                                                                    Margin="0,0,6,0"
                                                                    Click="CopiarLaudoQuedaTensaoButton_Click"/>
                                                            <Button x:Name="EnviarLaudoParaCopilotButton"
                                                                    Content="💬 Consultar no Copilot"
                                                                    Style="{DynamicResource SecondaryButton}"
                                                                    Height="26"
                                                                    Padding="8,0"
                                                                    Click="EnviarLaudoParaCopilotButton_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Histórico Recente de Cálculos -->
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Text="Histórico Recente de Medições da Oficina"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Margin="0,0,0,6"/>
                                                        <DataGrid x:Name="HistoricoCalculosDataGrid"
                                                                  AutoGenerateColumns="False"
                                                                  IsReadOnly="True"
                                                                  Height="120"
                                                                  Style="{DynamicResource PremiumDataGrid}"
                                                                  Background="Transparent"
                                                                  SelectionMode="Single">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Data" Binding="{Binding DataHora}" Width="100"/>
                                                                <DataGridTextColumn Header="Circuito" Binding="{Binding IdentificacaoCircuito}" Width="*"/>
                                                                <DataGridTextColumn Header="Queda (V)" Binding="{Binding QuedaTensaoVolts, StringFormat={}{0:F2}V}" Width="75"/>
                                                                <DataGridTextColumn Header="Resistência" Binding="{Binding ResistenciaParasitaOhms, StringFormat={}{0:F4} Ω}" Width="85"/>
                                                                <DataGridTextColumn Header="Status" Binding="{Binding StatusConformidade}" Width="90"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- ========================================================= -->
                    <!-- RODAPÉ DE INSPEÇÃO: DETALHES DO PONTO DE TESTE CLICADO    -->
                    <!-- ========================================================= -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BrandBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⚡ Teste Rápido:"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{DynamicResource BrandBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <TextBlock x:Name="ProbeDetailTextBlock"
                                       Grid.Column="1"
                                       Text="Clique nos pontos marcados no esquema elétrico acima (A, B, C, D) para visualizar o valor esperado no multímetro e diagnóstico."
                                       FontSize="11"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="EnviarTesteParaChatButton"
                                    Grid.Column="2"
                                    Content="💬 Perguntar sobre este ponto"
                                    Style="{DynamicResource SecondaryButton}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="8,0,0,0"
                                    Click="EnviarTesteParaChatButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
