<UserControl x:Class="PrimoAutoEletrica.UserControls.OrcamentosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PrimoAutoEletrica.UserControls"
             xmlns:views="clr-namespace:PrimoAutoEletrica.Views"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1600"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="ToolbarPrimaryActionButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="ToolbarSecondaryActionButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="102"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="ToolbarSuccessActionButton"
               TargetType="Button"
               BasedOn="{StaticResource SuccessButton}">
            <Setter Property="MinWidth" Value="102"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="ToolbarWarningActionButton"
               TargetType="Button"
               BasedOn="{StaticResource WarningButton}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="ToolbarDangerActionButton"
               TargetType="Button"
               BasedOn="{StaticResource DangerButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="CompactSecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="CompactPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="CarteiraListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="20,20,20,16"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Acoes comerciais"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Gerencie propostas com carteira central, selecao clara e conversoes sem ruído visual."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="12,8"
                            Margin="16,0,0,0"
                            Background="{DynamicResource PrimaryBackgroundBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding OrcamentoAtual.Numero, TargetNullValue=Selecione um orcamento, FallbackValue=Selecione um orcamento}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding OrcamentoAtual.Cliente.Nome, TargetNullValue=Carteira pronta para selecao, FallbackValue=Carteira pronta para selecao}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <WrapPanel Grid.Row="1"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Left">
                    <Button Content="Novo orcamento"
                            Style="{StaticResource ToolbarPrimaryActionButton}"
                            Click="NovoOrcamento_Click"/>
                    <Button Content="Duplicar"
                            Style="{StaticResource ToolbarSecondaryActionButton}"
                            Click="Duplicar_Click"/>
                    <Button x:Name="ExportarPdfOrcamentoButton"
                            Content="Exportar PDF"
                            Style="{StaticResource ToolbarSecondaryActionButton}"
                            Click="ExportarPDF_Click"/>
                    <Button Content="Imprimir"
                            Style="{StaticResource ToolbarSecondaryActionButton}"
                            Click="Imprimir_Click"/>
                    <Button x:Name="WhatsAppOrcamentoButton"
                            Content="WhatsApp"
                            Style="{StaticResource ToolbarSecondaryActionButton}"
                            Click="WhatsApp_Click"/>
                    <Button Content="E-mail"
                            Style="{StaticResource ToolbarSecondaryActionButton}"
                            Click="Email_Click"/>
                    <Button Content="Aprovar"
                            Style="{StaticResource ToolbarSuccessActionButton}"
                            Click="Aprovar_Click"/>
                    <Button Content="Converter venda"
                            Style="{StaticResource ToolbarPrimaryActionButton}"
                            Click="ConverterVenda_Click"/>
                    <Button Content="Converter OS"
                            Style="{StaticResource ToolbarWarningActionButton}"
                            Click="ConverterOs_Click"/>
                    <Button Content="Salvar rascunho"
                            Style="{StaticResource ToolbarSecondaryActionButton}"
                            Click="SalvarRascunho_Click"/>
                    <Button Content="Excluir"
                            Style="{StaticResource ToolbarDangerActionButton}"
                            Click="Excluir_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Background="{DynamicResource AppBackgroundBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,20"
                        Background="{DynamicResource AppBackgroundBrush}">

                <Border Background="{DynamicResource AppBackgroundBrush}"
                        BorderThickness="0">
                    <views:OrcamentosDashboardControl/>
                </Border>

                <Border Margin="0,16,0,0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderThickness="0">
                    <local:OrcamentoStatusControl/>
                </Border>

                <Border Margin="0,16,0,0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderThickness="0">
                    <local:OrcamentoBuscaInteligenteControl/>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="20"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Carteira de orcamentos"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding Orcamentos.Count, StringFormat={}{0} orcamento(s) disponivel(is) para selecionar e acompanhar antes de converter}"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="Carteira completa"
                                        Style="{StaticResource CompactPrimaryButton}"
                                        Click="CarteiraCompleta_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,18,0,0"
                                Padding="14"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding OrcamentoAtual.Numero, TargetNullValue=Nenhum orcamento selecionado, FallbackValue=Nenhum orcamento selecionado}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Margin="0,10,0,0"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource PrimaryBackgroundBrush}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999">
                                        <TextBlock Text="{Binding OrcamentoAtual.Status, TargetNullValue=Status indisponivel, FallbackValue=Status indisponivel}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding OrcamentoAtual.Total, StringFormat=Total: {0:C}, TargetNullValue=Total nao calculado, FallbackValue=Total nao calculado}"
                                               Margin="0,10,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="{Binding OrcamentoAtual.Cliente.Nome, TargetNullValue=Cliente nao vinculado, FallbackValue=Cliente nao vinculado}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding OrcamentoAtual.Cliente.Telefone, StringFormat=Telefone: {0}, TargetNullValue=Telefone nao informado, FallbackValue=Telefone nao informado}"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding OrcamentoAtual.Cliente.Documento, StringFormat=Documento: {0}, TargetNullValue=Documento nao informado, FallbackValue=Documento nao informado}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding OrcamentoAtual.DataValidade, StringFormat=Validade: {0:dd/MM/yyyy}, TargetNullValue=Validade nao definida, FallbackValue=Validade nao definida}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding OrcamentoAtual.Itens.Count, StringFormat=Itens na proposta: {0}, TargetNullValue=Itens na proposta: 0, FallbackValue=Itens na proposta: 0}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <WrapPanel Grid.Column="2"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Top"
                                           ItemHeight="34"
                                           ItemWidth="128">
                                    <Button Content="Ficha do cliente"
                                            Style="{StaticResource CompactSecondaryButton}"
                                            Click="BuscarCliente_Click"/>
                                    <Button Content="Historico"
                                            Style="{StaticResource CompactSecondaryButton}"
                                            Click="HistoricoCompleto_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="CarteiraOrcamentosListBox"
                                 Grid.Row="2"
                                 Margin="0,18,0,0"
                                 MaxHeight="360"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemsSource="{Binding Orcamentos}"
                                 SelectedItem="{Binding OrcamentoAtual, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource CarteiraListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="CarteiraOrcamentosListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Numero}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Cliente.Nome, TargetNullValue=Cliente nao informado, FallbackValue=Cliente nao informado}"
                                                       Margin="0,6,0,0"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Status, StringFormat=Status: {0}}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding DataValidade, StringFormat=Validade: {0:dd/MM/yyyy}, TargetNullValue=Validade nao definida, FallbackValue=Validade nao definida}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="18,0,0,0"
                                                    HorizontalAlignment="Right">
                                            <Border Padding="10,4"
                                                    HorizontalAlignment="Right"
                                                    Background="{DynamicResource PrimaryBackgroundBrush}"
                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="999">
                                                <TextBlock Text="{Binding Total, StringFormat={}{0:C}}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding DataCriacao, StringFormat=Criado em {0:dd/MM/yyyy HH:mm}}"
                                                       Margin="0,10,0,0"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="3"
                                   Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="A selecao da carteira alimenta os dados do cliente, os totais e o acompanhamento comercial abaixo."/>
                    </Grid>
                </Border>

                <Border Margin="0,16,0,0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderThickness="0">
                    <local:OrcamentoResumoFinanceiroControl/>
                </Border>

                <Grid Margin="0,16,0,0"
                      Background="{DynamicResource AppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="20"
                            Margin="0,0,8,0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Ultimos 10 orcamentos"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Painel rapido para revisar o historico recente sem poluir a tela principal."
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Ver todos"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        VerticalAlignment="Top"
                                        Click="CarteiraCompleta_Click"/>
                            </Grid>

                            <DataGrid x:Name="UltimosOrcamentosDataGrid"
                                      Grid.Row="1"
                                      Margin="0,16,0,0"
                                      MaxHeight="360"
                                      Style="{StaticResource PremiumDataGrid}"
                                      ItemsSource="{Binding UltimosOrcamentos}"
                                      SelectedItem="{Binding OrcamentoAtual, Mode=TwoWay}"
                                      SelectionChanged="UltimosOrcamentosDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Numero"
                                                        Binding="{Binding Numero}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="Cliente"
                                                        Binding="{Binding Cliente.Nome}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Data"
                                                        Binding="{Binding DataCriacao, StringFormat=dd/MM/yyyy HH:mm}"
                                                        Width="135"/>
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}"
                                                        Width="150"/>
                                    <DataGridTextColumn Header="Total"
                                                        Binding="{Binding Total, StringFormat=C}"
                                                        Width="125"/>
                                    <DataGridTextColumn Header="Itens"
                                                        Binding="{Binding Itens.Count}"
                                                        Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2"
                                       Margin="0,12,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="A grade mostra somente os 10 mais recentes; a carteira completa traz todos os registros com filtro e busca."/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="20"
                            Margin="8,0,0,0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Acompanhamento comercial"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Resumo do cliente e eventos do orcamento selecionado."
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,16,0,0"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nome, TargetNullValue=Cliente nao vinculado, FallbackValue=Cliente nao vinculado}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding HistoricoComprasResumo}"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding UltimaCompraResumo, StringFormat=Ultima visita: {0}}"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding ValorTotalGastoResumo, StringFormat=Total gasto: {0:C}}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Negociacao"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <ItemsControl Margin="0,10,0,0"
                                                  ItemsSource="{Binding HistoricoNegociacao}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="12,10"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Timeline"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <ItemsControl Margin="0,10,0,0"
                                                  ItemsSource="{Binding TimelineComercial}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="12,10"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                <TextBlock Text="Alertas"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ItemsControl Margin="0,10,0,0"
                                              ItemsSource="{Binding Alertas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,8"
                                                    Padding="12,6"
                                                    Background="{DynamicResource WarningCardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource WarningBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="999">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource WarningBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
