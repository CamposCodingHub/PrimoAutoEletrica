<UserControl x:Class="PrimoAutoEletrica.UserControls.GlobalSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="50">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search input -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="12" 
                Padding="4"
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search icon -->
                <Border Grid.Column="0" 
                        Width="40" 
                        Height="40" 
                        CornerRadius="8" 
                        Background="#F1F5F9"
                        Margin="4,4,0,4">
                    <TextBlock Text="🔍" 
                               FontSize="18" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Search textbox -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Height="40"
                         Padding="12,0"
                         FontSize="14"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"
                         KeyDown="SearchTextBox_KeyDown"/>

                <!-- Clear button -->
                <Button Grid.Column="2"
                        x:Name="ClearButton"
                        Width="32"
                        Height="32"
                        Margin="0,0,4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ClearButton_Click"
                        Visibility="Collapsed">
                    <TextBlock Text="✕" FontSize="14" Foreground="#64748B"/>
                </Button>
            </Grid>
        </Border>

        <!-- Autocomplete dropdown -->
        <Popup x:Name="AutocompletePopup"
               Grid.Row="1"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=SearchTextBox}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Effect="{StaticResource ShadowMD}">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AutocompleteItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,2"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ResultItem_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Type icon -->
                                        <Border Grid.Column="0"
                                                Width="32"
                                                Height="32"
                                                CornerRadius="8"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Cliente">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Veículo">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Agendamento">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Produto">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="OS">
                                                            <Setter Property="Background" Value="#E0E7FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="16" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       Text="📄">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="Cliente">
                                                                <Setter Property="Text" Value="👤"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="Veículo">
                                                                <Setter Property="Text" Value="🚗"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="Agendamento">
                                                                <Setter Property="Text" Value="📅"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="Produto">
                                                                <Setter Property="Text" Value="📦"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="OS">
                                                                <Setter Property="Text" Value="🔧"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="14" 
                                                       Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding Subtitulo}" 
                                                       FontSize="12" 
                                                       Foreground="#64748B" 
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Type badge -->
                                        <Border Grid.Column="2"
                                                Background="#F1F5F9"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tipo}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#64748B"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
