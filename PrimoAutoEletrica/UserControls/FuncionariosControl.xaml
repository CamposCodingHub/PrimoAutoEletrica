<UserControl x:Class="PrimoAutoEletrica.UserControls.FuncionariosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1220"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="DetailLabelText"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="DetailValueText"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="20,20,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Equipe e acessos"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Perfis operacionais, ultimo acesso, foto e bloqueio de usuarios."
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button x:Name="AtualizarButton"
>
                            MinWidth="110"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,8,8"
                            Style="{StaticResource PageSecondaryActionButton}">
                        Atualizar
                    </Button>

                    <Button x:Name="NovoFuncionarioButton"
>
                            MinWidth="148"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,8,8"
                            Style="{StaticResource PagePrimaryActionButton}">
                        Novo funcionario
                    </Button>

                    <Button x:Name="GerenciarPerfisButton"
>
                            MinWidth="152"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,8,8"
                            Style="{StaticResource PageInfoActionButton}">
                        Gerenciar perfis
                    </Button>

                    <Button x:Name="ConfigurarPermissoesButton"
>
                            MinWidth="176"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,0,8"
                            Style="{StaticResource PageWarningActionButton}">
                        Configurar permissoes
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource MetricCardStyle}"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Total"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TotalFuncionariosTextBlock"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="colaboradores cadastrados"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource MetricCardStyle}"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Ativos"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="FuncionariosAtivosTextBlock"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="usuarios com acesso"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource MetricCardStyle}"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Bloqueados/Inativos"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="FuncionariosInativosTextBlock"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="fora da operacao"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Administradores"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="FuncionariosAdminTextBlock"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="perfis com acesso total"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,0"
                                Margin="0,0,12,0">
                            <TextBox x:Name="SearchTextBox"
                                     Height="42"
                                     Background="Transparent"
                                     Foreground="{DynamicResource InputForegroundBrush}"
                                     CaretBrush="{DynamicResource InputForegroundBrush}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     TextChanged="TextBox_TextChanged"/>
                        </Border>

                        <Button Grid.Column="1"
                                Width="120"
                                Height="42"
                                Style="{StaticResource FilterActionButton}"
    >
                            Limpar busca
                        </Button>
                    </Grid>

                    <DataGrid x:Name="FuncionariosDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              RowHeight="48"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Style="{StaticResource PremiumDataGrid}"
>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome"
                                                Binding="{Binding Nome}"
                                                Width="1.4*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Funcao"
                                                Binding="{Binding Funcao}"
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Perfil"
                                                Binding="{Binding PerfilAcesso}"
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="1.3*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ultimo acesso"
                                                Width="145"
                                                IsReadOnly="True"
                                                Binding="{Binding DataUltimoLogin, StringFormat=dd/MM/yyyy HH:mm}"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="120"
                                                IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Acoes"
                                                    Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Width="52"
                                                    Height="32"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource TableActionButton}"
                                                    ToolTip="Visualizar"
                                                    Tag="{Binding}"
                        >
                                                Ver
                                            </Button>
                                            <Button Width="52"
                                                    Height="32"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource PageSuccessActionButton}"
                                                    ToolTip="Editar"
                                                    Tag="{Binding}"
                        >
                                                Editar
                                            </Button>
                                            <Button Width="70"
                                                    Height="32"
                                                    Style="{StaticResource PageDangerActionButton}"
                                                    ToolTip="Inativar"
                                                    Tag="{Binding}"
                        >
                                                Inativar
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Painel do colaborador"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <Border Height="220"
                                Margin="0,16,0,12"
                                CornerRadius="16"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Image x:Name="FuncionarioFotoImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="FuncionarioFotoPlaceholderText"
                                           Text="Sem foto"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="FuncionarioNomeTextBlock"
                                   Text="Selecione um colaborador"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioFuncaoTextBlock"
                                   Text="Sem funcao"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Perfil" Style="{StaticResource DetailLabelText}"/>
                            <TextBlock x:Name="FuncionarioPerfilTextBlock" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource DetailValueText}" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" Style="{StaticResource DetailLabelText}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="FuncionarioStatusTextBlock" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource DetailValueText}" Margin="0,10,0,0" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ultimo acesso" Style="{StaticResource DetailLabelText}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="FuncionarioUltimoAcessoTextBlock" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource DetailValueText}" Margin="0,10,0,0" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cadastro" Style="{StaticResource DetailLabelText}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="FuncionarioDataCadastroTextBlock" Grid.Row="3" Grid.Column="1" Text="-" Style="{StaticResource DetailValueText}" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="FuncionarioEmailTextBlock"
                                   Text="-"
                                   Margin="0,16,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioTelefoneTextBlock"
                                   Text="-"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioObservacoesTextBlock"
                                   Text="-"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="RedefinirSenhaButton"
        >
                                    Margin="0,0,8,8"
                                    Style="{StaticResource PageInfoActionButton}">
                                Redefinir senha
                            </Button>
                            <Button x:Name="BloquearFuncionarioButton"
        >
                                    Margin="0,0,8,8"
                                    Style="{StaticResource PageDangerActionButton}">
                                Bloquear
                            </Button>
                            <Button x:Name="ReativarFuncionarioButton"
        >
                                    Margin="0,0,0,8"
                                    Style="{StaticResource PageSuccessActionButton}"
                                    Visibility="Collapsed">
                                Reativar
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Auditoria e produtividade"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioProdutividadeResumoTextBlock"
                                   Text="Selecione um colaborador para calcular produtividade."
                                   Margin="0,12,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioOperacaoResumoTextBlock"
                                   Text="-"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioCaixaResumoTextBlock"
                                   Text="-"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioLoginResumoTextBlock"
                                   Text="-"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock x:Name="FuncionarioAuditoriaResumoTextBlock"
                                   Text="-"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioUltimaAcaoTextBlock"
                                   Text="Ultima acao auditada: -"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Eventos recentes"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="FuncionarioAcoesRecentesTextBlock"
                                           Text="-"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Permissoes por acao"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioPermissoesResumoTextBlock"
                                   Text="Selecione um colaborador para ver cobertura de permissoes."
                                   Margin="0,12,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="FuncionarioPermissoesAcoesTextBlock"
                                   Text="-"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Perfis operacionais"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Administrador, gerente, mecanico, vendedor, caixa e almoxarife ja podem ser combinados com permissoes por modulo e por acao."
                                   Margin="0,12,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
