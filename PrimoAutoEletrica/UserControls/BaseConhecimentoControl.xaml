<UserControl x:Class="PrimoAutoEletrica.UserControls.BaseConhecimentoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE AÇÕES -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="20,20,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Base de Conhecimento &amp; Diagnóstico — PRIMOX Knowledge"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Boletins técnicos, casos reais de bancada (D01-D17) e assistente grounded com zero alucinação."
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">

                    <Button Click="AtualizarButton_Click"
                            MinWidth="105"
                            Height="38"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="Atualizar"/>
                        </StackPanel>
                    </Button>

                    <Button Click="VerDetalhesButton_Click"
                            MinWidth="115"
                            Height="38"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,6,0"/>
                            <TextBlock Text="Ver Detalhes"/>
                        </StackPanel>
                    </Button>

                    <Button Click="PromoverOSButton_Click"
                            MinWidth="160"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,0,0"
                            Style="{StaticResource PagePrimaryActionButton}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                            <TextBlock Text="Promover OS para Caso"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- KPI SUMMARY CARDS -->
        <Grid Grid.Row="1"
              Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Boletins -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="📖 Boletins Técnicos"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TotalArtigosText"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Guias e procedimentos operacionais"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Casos Reais -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="🔬 Casos Reais de Oficina"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TotalCasosText"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="Diagnósticos comprovados em bancada"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Linha Pesada 24V -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="🚛 Linha Pesada 24V"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="Casos24VText"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InfoBrush}"/>
                    <TextBlock Text="Caminhões, ônibus e máquinas"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Linha Leve 12V -->
            <Border Grid.Column="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="🚗 Linha Leve 12V"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="Casos12VText"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="Automóveis e comerciais leves"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ABAS PRINCIPAIS -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="20,0,20,20">
            <TabControl x:Name="MainKnowledgeTabControl"
                        Style="{StaticResource ModernTabControl}"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- ABA 1: BOLETINS TÉCNICOS -->
                <TabItem Header="📖 Boletins Técnicos"
                         Style="{StaticResource ModernTabItem}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filtros Artigos -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔍 Buscar Artigo / Procedimento"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="BuscaArtigoTextBox"
                                             TextChanged="BuscaArtigoTextBox_TextChanged"
                                             Height="36"
                                             Style="{StaticResource PremiumTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="⚡ Sistema"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FiltroSistemaArtigoCombo"
                                              SelectionChanged="FiltroArtigoCombo_SelectionChanged"
                                              Style="{StaticResource PremiumComboBox}"
                                              Height="36">
                                        <ComboBoxItem Content="Todos os sistemas" IsSelected="True"/>
                                        <ComboBoxItem Content="Partida"/>
                                        <ComboBoxItem Content="Carga"/>
                                        <ComboBoxItem Content="Injeção"/>
                                        <ComboBoxItem Content="Iluminação"/>
                                        <ComboBoxItem Content="Ar Condicionado"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="🔋 Tensão"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FiltroTensaoArtigoCombo"
                                              SelectionChanged="FiltroArtigoCombo_SelectionChanged"
                                              Style="{StaticResource PremiumComboBox}"
                                              Height="36">
                                        <ComboBoxItem Content="Todas" IsSelected="True"/>
                                        <ComboBoxItem Content="12V"/>
                                        <ComboBoxItem Content="24V"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Click="LimparFiltrosArtigo_Click"
                                        Height="36"
                                        Padding="14,0"
                                        Margin="12,20,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Limpar"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid Artigos -->
                        <DataGrid Grid.Row="1"
                                  x:Name="ArtigosDataGrid"
                                  Style="{StaticResource PremiumDataGrid}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  MouseDoubleClick="ArtigosDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding Code}"
                                                    FontWeight="Bold"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Título do Boletim"
                                                    Binding="{Binding Title}"
                                                    FontWeight="SemiBold"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Sistema"
                                                    Binding="{Binding System}"
                                                    Width="130"/>

                                <DataGridTextColumn Header="Tensão"
                                                    Binding="{Binding Voltage}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Sintoma"
                                                    Binding="{Binding Symptom}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Causa Raiz"
                                                    Binding="{Binding PossibleCauses}"
                                                    Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ABA 2: CASOS REAIS DE OFICINA (D01-D17) -->
                <TabItem Header="🔬 Casos Reais de Oficina"
                         Style="{StaticResource ModernTabItem}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filtros Casos -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔍 Buscar Casos Reais (Veículo, Sintoma, Causa, DTC)"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="BuscaCasoTextBox"
                                             TextChanged="BuscaCasoTextBox_TextChanged"
                                             Height="36"
                                             Style="{StaticResource PremiumTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="⚡ Sistema"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FiltroSistemaCasoCombo"
                                              SelectionChanged="FiltroCasoCombo_SelectionChanged"
                                              Style="{StaticResource PremiumComboBox}"
                                              Height="36">
                                        <ComboBoxItem Content="Todos os sistemas" IsSelected="True"/>
                                        <ComboBoxItem Content="Partida"/>
                                        <ComboBoxItem Content="Carga"/>
                                        <ComboBoxItem Content="Injeção"/>
                                        <ComboBoxItem Content="Iluminação"/>
                                        <ComboBoxItem Content="Ar Condicionado"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="🔋 Tensão"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FiltroTensaoCasoCombo"
                                              SelectionChanged="FiltroCasoCombo_SelectionChanged"
                                              Style="{StaticResource PremiumComboBox}"
                                              Height="36">
                                        <ComboBoxItem Content="Todas" IsSelected="True"/>
                                        <ComboBoxItem Content="12V"/>
                                        <ComboBoxItem Content="24V"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Click="LimparFiltrosCaso_Click"
                                        Height="36"
                                        Padding="14,0"
                                        Margin="12,20,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Limpar"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid Casos Reais -->
                        <DataGrid Grid.Row="1"
                                  x:Name="CasosDataGrid"
                                  Style="{StaticResource PremiumDataGrid}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  MouseDoubleClick="CasosDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding Code}"
                                                    FontWeight="Bold"
                                                    Width="130"/>

                                <DataGridTextColumn Header="Veículo"
                                                    Binding="{Binding VehicleModel}"
                                                    FontWeight="SemiBold"
                                                    Width="180"/>

                                <DataGridTextColumn Header="OS"
                                                    Binding="{Binding WorkOrderNumber}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Tensão"
                                                    Binding="{Binding Voltage}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Sistema"
                                                    Binding="{Binding System}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Sintoma Relatado"
                                                    Binding="{Binding Symptom}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Causa Confirmada"
                                                    Binding="{Binding ConfirmedCause}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Técnico"
                                                    Binding="{Binding TechnicianName}"
                                                    Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ABA 3: PRIMOX ASSIST COPILOT -->
                <TabItem Header="🤖 PRIMOX Assist Copilot"
                         Style="{StaticResource ModernTabItem}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Prompt Input Area -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Assistente Técnico Operacional de Diagnóstico (Fail-Closed Grounded)"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Consulte hipóteses fundamentadas em medições e no acervo de casos reais. Sem ordens cegas de troca de peças."
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,4,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="AssistQueryTextBox"
                                             Height="42"
                                             FontSize="14"
                                             Style="{StaticResource PremiumTextBox}"
                                             Text="Actros 24V descarregando bateria durante pernoite com chave desligada"
                                             VerticalContentAlignment="Center"
                                             KeyDown="AssistQueryTextBox_KeyDown"/>

                                    <Button Grid.Column="1"
                                            x:Name="ConsultarAssistButton"
                                            Click="ConsultarAssistButton_Click"
                                            Height="42"
                                            Padding="18,0"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource PagePrimaryActionButton}"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" Margin="0,0,6,0"/>
                                            <TextBlock Text="Analisar Diagnóstico"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Sugestões Rápidas -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Consultas frequentes:"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <Button Style="{StaticResource SecondaryButton}"
                                            Height="26"
                                            Padding="8,0"
                                            Margin="0,0,6,0"
                                            FontSize="11"
                                            Content="Fuga de Corrente Actros 24V"
                                            Click="SugestaoRapida_Click"/>

                                    <Button Style="{StaticResource SecondaryButton}"
                                            Height="26"
                                            Padding="8,0"
                                            Margin="0,0,6,0"
                                            FontSize="11"
                                            Content="Queda de Tensão Ranger 12V"
                                            Click="SugestaoRapida_Click"/>

                                    <Button Style="{StaticResource SecondaryButton}"
                                            Height="26"
                                            Padding="8,0"
                                            Margin="0,0,6,0"
                                            FontSize="11"
                                            Content="Alternador Sobretensão 24V"
                                            Click="SugestaoRapida_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Fail-closed Warning Banner -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="🛡️ PROTOCOLO DE SEGURANÇA OPERACIONAL: "
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="Proibida a substituição de peças sem medição instrumental comprobatória registrada em OS."
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </DockPanel>
                        </Border>

                        <!-- Answer & Checklist Panel -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Badges -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="{DynamicResource SuccessBrush}"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="Grounded Foundation (Zero Alucinação)"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InverseTextBrush}"/>
                                        </Border>

                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3">
                                            <TextBlock x:Name="AssistConfiancaTextBlock"
                                                       Text="Nível de Evidência: Elevado"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Parecer Principal -->
                                    <TextBlock Text="Parecer Técnico e Hipóteses de Diagnóstico"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,14">
                                        <TextBlock x:Name="AssistRespostaTextBlock"
                                                   Text="Clique em 'Analisar Diagnóstico' para processar a consulta técnica grounded."
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>

                                    <!-- Protocolo de Testes Não Destrutivos -->
                                    <TextBlock Text="Protocolo de Medição Recomendado (Checklist Não Destrutivo)"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,14">
                                        <TextBlock x:Name="AssistChecklistTextBlock"
                                                   Text="1. Medir queda de tensão em bornes de bateria sob carga.\n2. Inserir alicate amperímetro DC com resolução de 1mA em repouso após 20 minutos (sono das ECUs).\n3. Monitorar linhas CAN High e CAN Low para detectar barramento acordado."
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>

                                    <!-- Fontes Citadas -->
                                    <TextBlock Text="Evidências e Fontes Citadas do Acervo"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6"/>

                                    <TextBlock x:Name="AssistFontesTextBlock"
                                               Text="• D01: Mercedes-Benz Actros 2546 24V — Fuga no módulo de conforto após repouso.\n• KB-002: Procedimento Padrão de Medição de Corrente de Fuga em 24V."
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
