<UserControl x:Class="PrimoAutoEletrica.UserControls.OrcamentoBuscaInteligenteControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="80" Width="Auto">
    <Grid>
        <Grid>
            <TextBox x:Name="BuscaBox"
                     Width="400"
                     Style="{StaticResource SearchBox}"
                     FontSize="16"
                     Margin="8"
                     Tag="Buscar por nome, codigo, fabricante, categoria..."/>
        </Grid>
        <!-- Sugestões, autocomplete e histórico podem ser exibidos em um Popup ou ListBox -->
    </Grid>
</UserControl>
