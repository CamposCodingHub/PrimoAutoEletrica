<UserControl x:Class="PrimoAutoEletrica.UserControls.OrdensServicoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:PrimoAutoEletrica.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1260"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:WorkOrderStatusLocalizationConverter x:Key="WorkOrderStatusLocalizer"/>

        <Style x:Key="OsPrimaryActionButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="OsSecondaryActionButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="OsSuccessActionButton"
               TargetType="Button"
               BasedOn="{StaticResource SuccessButton}">
            <Setter Property="MinWidth" Value="124"/>
            <Setter Property="Height" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="OsWarningActionButton"
               TargetType="Button"
               BasedOn="{StaticResource WarningButton}">
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Height" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="OsDangerActionButton"
               TargetType="Button"
               BasedOn="{StaticResource DangerButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="OsInfoActionButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="134"/>
            <Setter Property="Height" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER (Fase 4) -->
        <Border Grid.Row="0"
                x:Name="OsModulePageHeader"
                Style="{StaticResource ModulePageHeader}">
            <StackPanel>
                <TextBlock Text="Ordem de Serviço"
                           Style="{StaticResource ModulePageHeaderTitle}"/>
                <TextBlock Text="Dossiê técnico da oficina — identidade do atendimento, fluxo real, peças, serviços, eventos e valores."
                           Style="{StaticResource ModulePageHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- BARRA DE AÇÕES -->
        <Border Grid.Row="1"
                Style="{StaticResource PageActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Ações da OS"
                               Style="{StaticResource PageActionTitle}"/>
                    <TextBlock Text="Operações reais: cadastro, aprovação, peças, execução, financeiro, impressão e envio."
                               Style="{StaticResource PageActionSubtitle}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">

                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NewOs]}"
                            MinWidth="112"
                            Style="{StaticResource OsPrimaryActionButton}"
                            ToolTip="Criar nova ordem de serviço (Ctrl+N)"
                            Click="NovaOsButton_Click"/>

                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Edit]}"
                            Style="{StaticResource OsSecondaryActionButton}"
                            ToolTip="Abrir dossiê completo da OS selecionada (Enter)"
                            Click="EditarOsButton_Click"/>

                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Delete]}"
                            x:Name="ExcluirOsButton"
                            Style="{StaticResource OsDangerActionButton}"
                            ToolTip="Excluir a OS selecionada"
                            Click="ExcluirOsButton_Click"/>

                    <Button Content="Aprovar cliente"
                            MinWidth="132"
                            Style="{StaticResource OsSuccessActionButton}"
                            ToolTip="Registrar aprovação do cliente na OS selecionada"
                            Click="AprovarClienteButton_Click"/>

                    <Button Content="Aguardar peca"
                            MinWidth="124"
                            Style="{StaticResource OsWarningActionButton}"
                            ToolTip="Mover a OS para aguardando peça"
                            Click="AguardarPecaButton_Click"/>

                    <Button x:Name="AvancarStatusButton"
                            Content="Avancar"
                            Style="{StaticResource OsPrimaryActionButton}"
                            ToolTip="Avançar status pela lógica real de transição"
                            Click="AvancarStatusButton_Click"/>

                    <Button x:Name="GerarFinanceiroButton"
                            Content="Gerar financeiro"
                            MinWidth="144"
                            Style="{StaticResource OsInfoActionButton}"
                            ToolTip="Gerar lançamento financeiro da OS (operação existente)"
                            Click="GerarFinanceiroButton_Click"/>

                    <Button x:Name="EnviarClienteButton"
                            Content="Enviar cliente"
                            MinWidth="120"
                            Style="{StaticResource OsSecondaryActionButton}"
                            ToolTip="Enviar resumo da OS ao cliente"
                            Click="EnviarClienteButton_Click"/>

                    <Button x:Name="ImprimirOsButton"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Print]}"
                            Style="{StaticResource OsSecondaryActionButton}"
                            ToolTip="Imprimir a OS selecionada"
                            Click="ImprimirOsButton_Click"/>

                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Refresh]}"
                            Style="{StaticResource OsSecondaryActionButton}"
                            ToolTip="Recarregar ordens de serviço"
                            Click="AtualizarButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- RESUMO OPERACIONAL (contagens reais da lista) -->
        <UniformGrid Grid.Row="2"
                     Columns="5"
                     Margin="0,0,0,16"
                     Background="{DynamicResource AppBackgroundBrush}">

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Ordens abertas"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="TotalAbertasText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Aguardando aprovação"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="AguardandoAprovacaoText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Aguardando peça"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="AguardandoPecaText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Prontas para entrega"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="ProntasText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}">
                <StackPanel>
                    <TextBlock Text="Faturamento previsto"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="FaturamentoPrevistoText"
                               Margin="0,6,0,0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="R$ 0,00"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- CONTEÚDO PRINCIPAL + ESTADOS -->
        <Grid Grid.Row="3"
              Background="{DynamicResource AppBackgroundBrush}">

            <Border x:Name="OsLoadingPanel"
                    Style="{StaticResource LoadingStatePanel}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Carregando ordens de serviço…"
                               Style="{StaticResource LoadingStateTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Consultando OS, itens e eventos reais."
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="OsErrorPanel"
                    Style="{StaticResource ErrorStatePanel}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="Falha ao carregar OS"
                               Style="{StaticResource ErrorStateTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="OsErrorDescriptionText"
                               Style="{StaticResource ErrorStateDescription}"
                               Text="Não foi possível consultar as ordens de serviço."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,16"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[TryAgain]}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center"
                            Click="AtualizarButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="OsEmptyPanel"
                    Style="{StaticResource PrimoxEmptyStatePanel}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[NoWorkOrders]}"
                               Style="{StaticResource PrimoxEmptyStateTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="A consulta funcionou, mas não há OS para os filtros atuais. Crie uma nova OS ou limpe a busca."
                               Style="{StaticResource PrimoxEmptyStateDescription}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,16"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NewOs]}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Click="NovaOsButton_Click"/>
                </StackPanel>
            </Border>

            <Grid x:Name="OsContentGrid"
                  Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA DE ORDENS -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,18,0">
                <Grid Background="{DynamicResource CardBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FILTROS -->
                    <Grid Margin="0,0,0,16"
                          Background="{DynamicResource CardBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BuscaTextBox"
                                 Height="42"
                                 Padding="12"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource InputForegroundBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 BorderThickness="1"
                                 CaretBrush="{DynamicResource InputForegroundBrush}"
                                 TextChanged="BuscaTextBox_TextChanged"/>

                        <Border Grid.Column="1"
                                Height="42"
                                Margin="12,0,0,0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ComboBox x:Name="FiltroStatusComboBox"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource InputForegroundBrush}"
                                      BorderThickness="0"
                                      Padding="10,0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="FiltroStatusComboBox_SelectionChanged">
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[AllStatus]}" Tag="Todos os status"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusDraft]}" Tag="Rascunho"/>
                                <ComboBoxItem Content="Aberta" Tag="Aberta"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusAwaitingApproval]}" Tag="Aguardando aprovação"/>
                                <ComboBoxItem Content="Aprovada" Tag="Aprovada"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusInDiagnosis]}" Tag="Em diagnóstico"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusInExecution]}" Tag="Em execução"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusAwaitingPart]}" Tag="Aguardando peça"/>
                                <ComboBoxItem Content="Finalizada" Tag="Finalizada"/>
                                <ComboBoxItem Content="Aguardando pagamento" Tag="Aguardando pagamento"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusReady]}" Tag="Pronta para entrega"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusDelivered]}" Tag="Entregue"/>
                                <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OsStatusCancelled]}" Tag="Cancelada"/>
                            </ComboBox>
                        </Border>

                        <Border Grid.Column="2"
                                Height="42"
                                Margin="12,0,0,0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ComboBox x:Name="FiltroPrioridadeComboBox"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource InputForegroundBrush}"
                                      BorderThickness="0"
                                      Padding="10,0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="FiltroPrioridadeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Todas"/>
                                <ComboBoxItem Content="Alta"/>
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Baixa"/>
                            </ComboBox>
                        </Border>

                        <Button Grid.Column="3"
                                Margin="12,0,0,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="20,0"
                                Height="40"
                                Cursor="Hand"
                                Content="Copiar resumo"
                                Click="CopiarResumoButton_Click"/>
                    </Grid>

                    <!-- LISTA -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="OrdensListBox"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderThickness="0"
                                 ItemContainerStyle="{x:Null}"
                                 SelectionChanged="OrdensListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="16"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Numero}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding ClienteNome}"
                                                       ToolTip="{Binding ClienteNome}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding VeiculoResumo}"
                                                       ToolTip="{Binding VeiculoResumo}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right">
                                            <Border Padding="10,5"
                                                    CornerRadius="20"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource WorkOrderStatusLocalizer}}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{Binding StatusForeground}"/>
                                            </Border>

                                            <Border Margin="0,8,0,0"
                                                    Padding="10,5"
                                                    CornerRadius="20"
                                                    Background="{Binding PrioridadeBackground}">
                                                <TextBlock Text="{Binding Prioridade}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{Binding PrioridadeForeground}"/>
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="1"
                                              Grid.ColumnSpan="2"
                                              Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding TecnicoResumo}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="18,0,0,0"
                                                       Text="{Binding PrazoResumo}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="2"
                                                       Margin="18,0,0,0"
                                                       Text="{Binding TotalFormatado}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </Grid>

                                        <StackPanel Grid.Row="2"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,16,0,0">
                                            <ProgressBar Height="8"
                                                         Maximum="100"
                                                         Value="{Binding Progresso, Mode=OneWay}"/>
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding ProgressoResumo}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- DETALHES DA ORDEM -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel>

                        <!-- CABEÇALHO DOSSIÊ -->
                        <TextBlock Text="Dossiê técnico"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.Numero, TargetNullValue='Nenhuma OS selecionada'}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.Subtitulo, TargetNullValue='Selecione uma OS para ver o dossiê'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.Subtitulo}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.OrcamentoResumo, TargetNullValue=''}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <Border Padding="10,5"
                                        CornerRadius="20"
                                        Background="{Binding ElementName=OrdensListBox, Path=SelectedItem.StatusBackground}">
                                    <TextBlock Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.Status, Converter={StaticResource WorkOrderStatusLocalizer}, TargetNullValue='-'}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding ElementName=OrdensListBox, Path=SelectedItem.StatusForeground}"/>
                                </Border>

                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.TotalFormatado, TargetNullValue='R$ 0,00'}"/>
                            </StackPanel>
                        </Grid>

                        <!-- RESUMO CLIENTE / VEÍCULO / TÉCNICO -->
                        <WrapPanel Margin="0,0,0,16">
                            <Border Width="180"
                                    Margin="0,0,12,12"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientsTitle]}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.ClienteNome, TargetNullValue='-'}"
                                               ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.ClienteNome}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="42"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.Telefone, TargetNullValue='-'}"/>
                                </StackPanel>
                            </Border>

                            <Border Width="180"
                                    Margin="0,0,12,12"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Veículo"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.VeiculoResumo, TargetNullValue='-'}"
                                               ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.VeiculoResumo}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="42"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.Placa, TargetNullValue='-'}"/>
                                </StackPanel>
                            </Border>

                            <Border Width="180"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Técnico"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.TecnicoResumo, TargetNullValue='-'}"
                                               ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.TecnicoResumo}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="42"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.PrazoResumo, TargetNullValue='-'}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- APROVAÇÃO -->
                        <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Aprovação do cliente"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.AprovacaoResumo, TargetNullValue='-'}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="Fluxo"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.ProgressoResumo, TargetNullValue='-'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PROBLEMA / DIAGNÓSTICO -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Problema relatado"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.ProblemaRelatado, TargetNullValue='-'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.ProblemaRelatado}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Margin="0,16,0,0"
                                           Text="Diagnóstico inicial"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.DiagnosticoInicial, TargetNullValue='-'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.DiagnosticoInicial}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Margin="0,16,0,0"
                                           Text="Diagnóstico final"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.DiagnosticoFinal, TargetNullValue='-'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.DiagnosticoFinal}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- FINANCEIRO -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[FinanceTitle]}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Peças"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.TotalPecasFormatado, TargetNullValue='R$ 0,00'}"/>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,10,0,0"
                                               Text="Serviços"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,10,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.TotalServicosFormatado, TargetNullValue='R$ 0,00'}"/>

                                    <TextBlock Grid.Row="2"
                                               Margin="0,10,0,0"
                                               Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Discount]}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0,10,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.DescontoFormatado, TargetNullValue='R$ 0,00'}"/>

                                    <Border Grid.Row="3"
                                            Grid.ColumnSpan="2"
                                            Margin="0,16,0,0"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Total da OS"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Margin="0,6,0,0"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.TotalFormatado, TargetNullValue='R$ 0,00'}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="Lucro estimado"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Margin="0,6,0,0"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.LucroFormatado, TargetNullValue='R$ 0,00'}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CHECKLIST -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Checklist e garantia"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Inbound]}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.ChecklistEntrada, TargetNullValue='Checklist de entrada não informado'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.ChecklistEntrada}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="96"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Margin="0,14,0,0"
                                           Text="Termo de autorização"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.TermoAutorizacao, TargetNullValue='Termo de autorização não informado'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.TermoAutorizacao}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="96"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Margin="0,14,0,0"
                                           Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Outbound]}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,14,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.ChecklistSaida, TargetNullValue='Checklist de saída não informado'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.ChecklistSaida}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="96"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Margin="0,14,0,0"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.GarantiaObservacoes, TargetNullValue='Garantia sem observações'}"
                                           ToolTip="{Binding ElementName=OrdensListBox, Path=SelectedItem.GarantiaObservacoes}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="96"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.EvidenciasResumo, TargetNullValue='Evidências não registradas'}"/>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.TempoResumo, TargetNullValue='Tempo não informado'}"/>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.OrcamentoResumo, TargetNullValue='Sem orçamento vinculado'}"/>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.AssinaturaResumo, TargetNullValue='Assinatura pendente'}"/>
                                <TextBlock Margin="0,14,0,0"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Text="{Binding ElementName=OrdensListBox, Path=SelectedItem.GarantiaResumo, TargetNullValue='Garantia sem data definida'}"/>
                            </StackPanel>
                        </Border>

                        <!-- ITENS DA ORDEM -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Itens da ordem"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <ItemsControl Margin="0,12,0,0"
                                              ItemsSource="{Binding ElementName=OrdensListBox, Path=SelectedItem.Itens}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Descricao}"
                                                                   ToolTip="{Binding Descricao}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="42"/>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Text="{Binding Resumo}"
                                                                   ToolTip="{Binding Resumo}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="42"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   Text="{Binding TotalFormatado}"/>
                                                        <Border Margin="0,6,0,0"
                                                                Padding="8,4"
                                                                CornerRadius="10"
                                                                Background="{Binding EstoqueBackground}">
                                                            <TextBlock Text="{Binding EstoqueResumo}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding EstoqueForeground}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- EVENTOS / HISTÓRICO (OrdemServicoEventos real) -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Eventos"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Registro real em OrdemServicoEventos — sem timeline inventada."/>

                                <Border Margin="0,12,0,0"
                                        Style="{StaticResource PrimoxEmptyStatePanel}"
                                        Padding="14"
                                        Visibility="{Binding ElementName=OrdensListBox, Path=SelectedItem.SemEventos, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <TextBlock Text="Sem eventos"
                                                   Style="{StaticResource PrimoxEmptyStateTitle}"
                                                   FontSize="13"/>
                                        <TextBlock Text="Esta OS ainda não possui eventos registrados."
                                                   Style="{StaticResource PrimoxEmptyStateDescription}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl Margin="0,12,0,0"
                                              ItemsSource="{Binding ElementName=OrdensListBox, Path=SelectedItem.Eventos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="14"
                                                        Height="14"
                                                        Margin="0,4,12,0"
                                                        CornerRadius="7"
                                                        Background="{Binding IndicadorBackground}"
                                                        ToolTip="{Binding TipoResumo}"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Titulo}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding Descricao}"
                                                               ToolTip="{Binding Descricao}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="72"/>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Text="{Binding MetaResumo}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Button HorizontalAlignment="Left"
                                Style="{StaticResource GhostButton}"
                                Padding="12,0"
                                Height="{DynamicResource DensityControlHeight}"
                                Content="Histórico do cliente"
                                ToolTip="Abrir histórico real do cliente da OS selecionada"
                                Click="HistoricoClienteButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
