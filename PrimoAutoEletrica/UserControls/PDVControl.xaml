<UserControl x:Class="PrimoAutoEletrica.UserControls.PDVControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1366"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>

        <Style x:Key="PdvBackground" TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        </Style>

        <Style x:Key="PdvCardBackground" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="{DynamicResource PageToolbarPadding}"/>
        </Style>

        <Style x:Key="PdvSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PdvLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PdvSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="SelectionTextBrush" Value="{DynamicResource InverseTextBrush}"/>
        </Style>

        <Style x:Key="PdvPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="{DynamicResource DensityControlHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource PageInputPadding}"/>
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PdvGhostButton" TargetType="Button" BasedOn="{StaticResource PdvPrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PdvDangerButton" TargetType="Button" BasedOn="{StaticResource PdvPrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
        </Style>

        <Style x:Key="PdvTinyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="{DynamicResource DensityCompactControlHeight}"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PdvListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Style="{StaticResource PdvBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOPO OPERACIONAL -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                Padding="12,8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BUSCA RÁPIDA + PRODUTOS -->
                <Grid Grid.Column="0"
                      MaxWidth="820">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="BuscaProdutoTextBox"
                             Grid.Column="0"
                             Style="{StaticResource PdvSearchBox}"
                             KeyDown="BuscaProdutoTextBox_KeyDown"
                             ToolTip="Digite código, nome, SKU ou código de barras e pressione Enter"/>

                    <Button x:Name="BuscarProdutoButton"
                            Grid.Column="1"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Search]}"
                            Style="{StaticResource PdvPrimaryButton}"
                            MinWidth="88"
                            Margin="8,0,0,0"
                            Click="BuscarProdutoButton_Click"
                            ToolTip="Buscar produto digitado no campo"/>

                    <Button x:Name="AbrirSelecionarProdutoButton"
                            Grid.Column="2"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Products]}"
                            Style="{StaticResource PdvGhostButton}"
                            MinWidth="120"
                            Margin="8,0,0,0"
                            Click="AbrirSelecionarProdutoButton_Click"
                            ToolTip="Abrir janela com todos os produtos do estoque"/>
                </Grid>

                <!-- STATUS RÁPIDO -->
                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CLIENTE: "
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding ClienteSelecionado.Nome, TargetNullValue='CONSUMIDOR FINAL'}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SuccessCardBackgroundBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CAIXA "
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding NumeroCaixa, TargetNullValue='01'}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text=" | "
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10"/>

                            <TextBlock Text="{Binding StatusCaixa, TargetNullValue='FECHADO'}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button Content="..."
                            Style="{StaticResource PdvGhostButton}"
                            Width="36"
                            Height="32"
                            Padding="0"
                            ToolTip="Mais ações"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- CORPO PRINCIPAL -->
        <Grid Grid.Row="1"
              Background="{DynamicResource AppBackgroundBrush}"
              Margin="14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*"/>
                <ColumnDefinition Width="1.08*"/>
            </Grid.ColumnDefinitions>

            <!-- CARRINHO MÉDIO -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,12,0">

                <Grid Background="{DynamicResource CardBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO CARRINHO -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Cart]}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="Itens adicionados na venda atual."
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="12,7"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuantidadeItens, StringFormat={}{0} itens}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Border>
                    </Grid>

                    <!-- CABEÇALHO COLUNAS -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="0.55*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Item]}"
                                       Style="{StaticResource PdvLabel}"/>

                            <TextBlock Grid.Column="1"
                                       Text="Qtd."
                                       Style="{StaticResource PdvLabel}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Total]}"
                                       Style="{StaticResource PdvLabel}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Actions]}"
                                       Style="{StaticResource PdvLabel}"
                                       Margin="14,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- LISTA DO CARRINHO -->
                    <ListView x:Name="CarrinhoListView"
                              Grid.Row="2"
                              ItemsSource="{Binding Carrinho}"
                              BorderThickness="0"
                              Background="Transparent"
                              ItemContainerStyle="{StaticResource PdvListViewItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling" d:ItemsSource="{d:SampleData ItemCount=5}">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="10"
                                        Margin="0,0,0,8">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="0.55*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding NomeExibicao}"
                                                       ToolTip="{Binding NomeExibicao}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="38"/>

                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Margin="0,3,0,0">
                                                <Run Text="Unit: "/>
                                                <Run Text="{Binding PrecoUnitario, StringFormat={}{0:C}}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Quantidade}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Subtotal, StringFormat={}{0:C}}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="14,0,0,0">

                                            <Button Content="+"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    Style="{StaticResource PdvTinyButton}"
                                                    ToolTip="Aumentar quantidade"
                                                    AutomationProperties.Name="Aumentar quantidade"
                                                    Click="AumentarQuantidadeButton_Click"/>

                                            <Button Content="-"
                                                    Background="{DynamicResource WarningBrush}"
                                                    Style="{StaticResource PdvTinyButton}"
                                                    ToolTip="Diminuir quantidade"
                                                    AutomationProperties.Name="Diminuir quantidade"
                                                    Click="DiminuirQuantidadeButton_Click"/>

                                            <Button Content="X"
                                                    Background="{DynamicResource DangerBrush}"
                                                    Style="{StaticResource PdvTinyButton}"
                                                    Margin="0"
                                                    ToolTip="Remover item"
                                                    AutomationProperties.Name="Remover item"
                                                    Click="RemoverItemButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- PAINEL DA VENDA MAIS AMPLO -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource CardBackgroundBrush}">

                    <StackPanel>

                        <!-- LINHA SUPERIOR: CLIENTE + CAIXA -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,8,0">

                                <StackPanel>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientsTitle]}"
                                               Style="{StaticResource PdvLabel}"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Text="{Binding ClienteSelecionado.Nome, TargetNullValue='CONSUMIDOR FINAL'}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[SearchClientShortcut]}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"/>

                                        <Button x:Name="AbrirSelecionarClienteButton"
                                                Grid.Column="1"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Select]}"
                                                Height="32"
                                                MinWidth="96"
                                                Padding="12,0"
                                                Style="{StaticResource PdvGhostButton}"
                                                Click="AbrirSelecionarClienteButton_Click"/>
                                    </Grid>

                                    <TextBox x:Name="BuscaClienteTextBox"
                                             Visibility="Collapsed"
                                             KeyDown="BuscaClienteTextBox_KeyDown"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource SuccessCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="8,0,0,0">

                                <StackPanel>
                                    <TextBlock Text="Caixa"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="Bold">
                                        <Run Text="Nº "/>
                                        <Run Text="{Binding NumeroCaixa, TargetNullValue='01'}"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding StatusCaixa, TargetNullValue='FECHADO'}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- TOTAL EM DESTAQUE -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.95*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,14,0">

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="SUBTOTAL"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Subtotal, StringFormat={}{0:C}}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="DESCONTO"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DescontoGeral, StringFormat={}{0:C}}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="DescontoTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource PdvSearchBox}"
                                                 Height="38"
                                                 Padding="12,0"
                                                 FontSize="13"
                                                 Text="{Binding DescontoGeral, Mode=OneWay}"
                                                 KeyDown="DescontoTextBox_KeyDown"/>

                                        <Button x:Name="AplicarDescontoButton"
                                                Grid.Column="1"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Apply]}"
                                                Style="{StaticResource PdvGhostButton}"
                                                MinHeight="38"
                                                MinWidth="88"
                                                Margin="8,0,0,0"
                                                Padding="14,0"
                                                FontSize="12"
                                                Click="AplicarDescontoButton_Click"/>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16"
                                        VerticalAlignment="Stretch">

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="{Binding Total, StringFormat={}{0:C}}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="38"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- AÇÕES PRINCIPAIS -->
                        <Button x:Name="PagamentoButton"
                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[FinalizeSaleShortcut]}"
                                Style="{StaticResource PdvPrimaryButton}"
                                MinHeight="54"
                                FontSize="16"
                                FontWeight="Bold"
                                Margin="0,0,0,8"
                                Click="PagamentoButton_Click"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[CancelSaleShortcut]}"
                                    Style="{StaticResource PdvDangerButton}"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    Click="CancelarVendaButton_Click"/>

                            <Button x:Name="SuspenderVendaButton"
                                    Content="{Binding Source={StaticResource LocalizationHelper}, Path=[SuspendShortcut]}"
                                    Style="{StaticResource PdvGhostButton}"
                                    Grid.Column="1"
                                    Margin="5,0,5,0"
                                    Click="SuspenderVendaButton_Click"/>

                            <Button x:Name="RetomarVendaSuspensaButton"
                                    Content="{Binding Source={StaticResource LocalizationHelper}, Path=[ResumeShortcut]}"
                                    Style="{StaticResource PdvGhostButton}"
                                    Grid.Column="2"
                                    Margin="5,0,0,0"
                                    Click="RetomarVendaSuspensaButton_Click"/>
                        </Grid>

                        <TextBlock Text="{Binding VendasSuspensasResumo}"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <!-- PAGAMENTO + CAIXA EM DUAS COLUNAS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PAGAMENTO -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,8,0">

                                <StackPanel>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Payment]}"
                                               Style="{StaticResource PdvLabel}"
                                               Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="DinheiroButton"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cash]}"
                                                Tag="Dinheiro"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                Padding="10,0"
                                                FontSize="12"
                                                Click="FormaPagamentoButton_Click"/>

                                        <Button x:Name="PixButton"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Pix]}"
                                                Tag="PIX"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Padding="10,0"
                                                FontSize="12"
                                                Click="FormaPagamentoButton_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="DebitoButton"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Debit]}"
                                                Tag="Debito"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                Padding="10,0"
                                                FontSize="12"
                                                Click="FormaPagamentoButton_Click"/>

                                        <Button x:Name="CreditoButton"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Credit]}"
                                                Tag="Credito"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="1"
                                                Margin="4,0,4,0"
                                                Padding="10,0"
                                                FontSize="12"
                                                Click="FormaPagamentoButton_Click"/>

                                        <Button x:Name="MistoButton"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Mixed]}"
                                                Tag="Misto"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="2"
                                                Margin="4,0,0,0"
                                                Padding="10,0"
                                                FontSize="12"
                                                Click="FormaPagamentoButton_Click"/>
                                    </Grid>

                                    <TextBlock Text="{Binding PagamentoMistoResumo}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- OPERAÇÃO DE CAIXA -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="8,0,0,0">

                                <StackPanel>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[CashOperation]}"
                                               Style="{StaticResource PdvLabel}"
                                               Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[OpenCash]}"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                Padding="8,0"
                                                FontSize="11"
                                                Click="AbrirCaixaButton_Click"/>

                                        <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[CashSupply]}"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Padding="8,0"
                                                FontSize="11"
                                                Click="SuprimentoButton_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[CashWithdrawal]}"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                Padding="8,0"
                                                FontSize="11"
                                                Click="SangriaButton_Click"/>

                                        <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[CloseCash]}"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Padding="8,0"
                                                FontSize="11"
                                                Click="FecharCaixaButton_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="ReimprimirUltimaVendaButton"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Reprint]}"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                Padding="8,0"
                                                FontSize="11"
                                                Click="ReimprimirUltimaVendaButton_Click"/>

                                        <Button x:Name="CancelarUltimaVendaConcluidaButton"
                                                Content="{Binding Source={StaticResource LocalizationHelper}, Path=[CancelCompletedSale]}"
                                                Style="{StaticResource PdvGhostButton}"
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Padding="8,0"
                                                FontSize="11"
                                                ToolTip="Cancelar venda concluída"
                                                Click="CancelarUltimaVendaConcluidaButton_Click"/>
                                    </Grid>

                                    <Button x:Name="EmitirNFeHomologacaoButton"
                                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NfeHomologation]}"
                                            Style="{StaticResource PdvGhostButton}"
                                            Margin="0,6,0,0"
                                            Padding="8,0"
                                            FontSize="11"
                                            ToolTip="Emitir NF-e no ambiente de HOMOLOGAÇÃO (não é produção)"
                                            AutomationProperties.Name="Emitir NF-e Homologação"
                                            Click="EmitirNFeHomologacaoButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- PRODUTO SELECIONADO / CLIENTE / ATALHOS -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12,8"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PRODUTO: "
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedProduto.Nome, TargetNullValue='Nenhum selecionado'}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="12,8"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CLIENTE: "
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding ClienteSelecionado.Nome, TargetNullValue='CONSUMIDOR FINAL'}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   MaxWidth="240"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="12,8">
                    <WrapPanel>
                        <TextBlock Text="F1 Produtos"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="F5 Cliente"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="F2 Desconto"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="DEL Remover"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RODAPÉ OPERACIONAL -->
        <Border Grid.Row="3"
                Background="{DynamicResource AppBackgroundBrush}"
                Padding="12,6"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0">
                    <TextBlock Text="F1 Produtos | "
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10"/>

                    <TextBlock Text="F5 Cliente | "
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10"/>

                    <TextBlock Text="Enter Busca rápida | "
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10"/>

                    <TextBlock Text="F2 Desconto | "
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10"/>

                    <TextBlock Text="F6 Finalizar | "
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10"/>

                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[EscCancel]}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10"/>
                </WrapPanel>

                <WrapPanel Grid.Column="1">
                    <TextBlock Text="ADMIN"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"/>

                    <TextBlock Text="REDE: ONLINE"
                               Foreground="{DynamicResource SuccessBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"/>

                    <TextBlock Text="PDV pronto"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
