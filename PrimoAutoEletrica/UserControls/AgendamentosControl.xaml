<UserControl x:Class="PrimoAutoEletrica.UserControls.AgendamentosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PrimoAutoEletrica.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1600"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToAvailabilityConverter x:Key="BoolToAvailabilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- BARRA DE AÇÕES DA PÁGINA                                 -->
        <!-- ========================================================= -->
        <Border x:Name="headerBorder"
                Grid.Row="0"
                Style="{StaticResource PageActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Ações da agenda"
                               Style="{StaticResource PageActionTitle}"/>
                    <TextBlock Text="Planejamento inteligente, check-in técnico e fluxo da oficina em tempo real."
                               Style="{StaticResource PageActionSubtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <WrapPanel HorizontalAlignment="Right">

                        <Button Command="{Binding NovoAgendamentoCommand}"
                                Style="{StaticResource PagePrimaryActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Novo agendamento"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding EncaixeRapidoCommand}"
                                Style="{StaticResource PageWarningActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="!"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Encaixe rápido"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AtualizarCommand}"
                                Style="{StaticResource PageSecondaryActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="R"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Atualizar agenda"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ImprimirAgendaCommand}"
                                Style="{StaticResource PrintActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PR"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Imprimir"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportarPDFCommand}"
                                Style="{StaticResource PageDangerActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PDF"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Exportar"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding FiltrosRapidosCommand}"
                                Style="{StaticResource FilterActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FL"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Filtros"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ModoOficinaCommand}"
                                Style="{StaticResource PageInfoActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OF"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Modo oficina"/>
                            </StackPanel>
                        </Button>

                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- CARDS DE MÉTRICAS                                        -->
        <!-- ========================================================= -->
        <ItemsControl Grid.Row="1"
                      Margin="20,0,20,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icone}"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}"
                                               ToolTip="{Binding Titulo}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Comparacao}"
                                               ToolTip="{Binding Comparacao}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Valor}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{Binding Cor}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding Tendencia}"
                                           ToolTip="{Binding Tendencia}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ========================================================= -->
        <!-- CONTEÚDO PRINCIPAL                                       -->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Row="2"
                      Margin="20,0,20,20"
                      Background="{DynamicResource AppBackgroundBrush}"
                      VerticalScrollBarVisibility="Auto">

            <Grid Background="{DynamicResource AppBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"
                                      MinWidth="280"/>
                    <ColumnDefinition Width="*"
                                      MinWidth="400"/>
                    <ColumnDefinition Width="380"
                                      MinWidth="350"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- COLUNA ESQUERDA: CALENDÁRIO, FILTROS E ALERTAS     -->
                <!-- ================================================= -->
                <Grid Grid.Column="0"
                      Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Calendário -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Calendário inteligente"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="0,0,0,14"/>

                            <!--
                              Nao vincular DisplayDateStart/End a DataInicioPeriodo/DataFimPeriodo.
                              Esses campos do VM definem o FILTRO da lista (diario/semanal/mensal).
                              No Calendar WPF, DisplayDateStart/End restringem selecao/navegacao.
                            -->
                            <Calendar x:Name="calendarControl"
                                      SelectedDate="{Binding DataSelecionada, Mode=TwoWay}"
                                      DisplayDate="{Binding DataSelecionada, Mode=OneWay}"
                                      FirstDayOfWeek="Monday"
                                      FontSize="13"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      AllowDrop="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Filtros -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Filtros e busca global"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="0,0,0,14"/>

                            <TextBox x:Name="searchBox"
                                     Height="36"
                                     Margin="0,0,0,10"
                                     Padding="10"
                                     Style="{StaticResource PremiumTextBox}"
                                     Text="{Binding FiltroBusca, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnSearchTextChanged"/>

                            <ComboBox Margin="0,0,0,10"
                                      Height="36"
                                      Style="{StaticResource PremiumComboBox}"
                                      ItemsSource="{Binding VisualizacaoOptions}"
                                      SelectedItem="{Binding VisualizacaoCalendario}"/>

                            <ComboBox Margin="0,0,0,10"
                                      Height="36"
                                      Style="{StaticResource PremiumComboBox}"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding FiltroStatus}"/>

                            <ComboBox Margin="0,0,0,10"
                                      Height="36"
                                      Style="{StaticResource PremiumComboBox}"
                                      ItemsSource="{Binding PrioridadeOptions}"
                                      SelectedItem="{Binding FiltroPrioridade}"/>

                            <TextBox Height="36"
                                     Margin="0,0,0,10"
                                     Padding="10"
                                     Style="{StaticResource PremiumTextBox}"
                                     Text="{Binding FiltroCliente}"/>

                            <TextBox Height="36"
                                     Margin="0,0,0,14"
                                     Padding="10"
                                     Style="{StaticResource PremiumTextBox}"
                                     Text="{Binding FiltroVeiculo}"/>

                            <Button Command="{Binding LimparFiltrosCommand}"
                                    Style="{StaticResource CompactSecondaryActionButton}"
                                    Margin="0">
                                <TextBlock Text="Limpar filtros"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Alertas -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Alertas inteligentes"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding Alertas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Tipo}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource WarningBrush}"/>

                                                <TextBlock Text="{Binding Mensagem}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================================================= -->
                <!-- COLUNA CENTRAL: AGENDA E TIMELINE                 -->
                <!-- ================================================= -->
                <Grid Grid.Column="1"
                      Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Agenda operacional -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Agenda operacional"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="Bold"
                                           FontSize="20"/>

                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource InfoCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource InfoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,4">
                                    <TextBlock Text="{Binding VisualizacaoCalendario}"
                                               Foreground="{DynamicResource InfoBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="11"/>
                                </Border>
                            </DockPanel>

                            <WrapPanel Margin="0,0,0,14">
                                <Border Background="{DynamicResource SuccessBrush}"
                                        CornerRadius="999"
                                        Padding="12,6"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="Hoje"
                                               Foreground="{DynamicResource InverseTextBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="12,6"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="Semana"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="12,6"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="Mês"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="12,6"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="Timeline"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </WrapPanel>

                            <ListView x:Name="agendamentosListView"
                                      ItemsSource="{Binding AgendamentosFiltrados}"
                                      SelectedItem="{Binding AgendamentoSelecionado, Mode=TwoWay}"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderThickness="0"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="16"
                                                Margin="0,0,0,12"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                        CornerRadius="999"
                                                        Padding="10,5"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="{DynamicResource InverseTextBrush}"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Numero}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                    <TextBlock Text="{Binding ClienteNome}"
                                                               ToolTip="{Binding ClienteNome}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="38"/>

                                                    <WrapPanel Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding VeiculoPlaca}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                        <TextBlock Text=" | "
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource MutedTextBrush}"/>

                                                        <TextBlock Text="{Binding VeiculoModelo}"
                                                                   ToolTip="{Binding VeiculoModelo}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Text=" | "
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource MutedTextBrush}"/>

                                                        <TextBlock Text="{Binding TipoServico}"
                                                                   ToolTip="{Binding TipoServico}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </WrapPanel>

                                                    <WrapPanel Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding HoraInicio, StringFormat=HH:mm}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                        <TextBlock Text=" até "
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                        <TextBlock Text="{Binding HoraTermino, StringFormat=HH:mm}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                        <TextBlock Text=" | Prioridade "
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                        <TextBlock Text="{Binding Prioridade}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontWeight="SemiBold"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Top">

                                                    <Button x:Name="CheckInAgendamentoButton"
                                                            Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Style="{StaticResource CompactPrimaryActionButton}"
                                                            MinWidth="50"
                                                            Padding="0"
                                                            Width="50"
                                                            Height="36"
                                                            Margin="0,0,4,0">
                                                        <TextBlock Text="Entrada"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"/>
                                                    </Button>

                                                    <Button x:Name="CheckOutAgendamentoButton"
                                                            Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Style="{StaticResource CompactSuccessActionButton}"
                                                            MinWidth="50"
                                                            Padding="0"
                                                            Width="50"
                                                            Height="36"
                                                            Margin="0">
                                                        <TextBlock Text="Saída"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <WrapPanel HorizontalAlignment="Right"
                                       Margin="0,14,0,0">

                                <Button Command="{Binding NovoAgendamentoCommand}"
                                        Style="{StaticResource PagePrimaryActionButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Novo"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding EditarCommand}"
                                        Style="{StaticResource CompactSecondaryActionButton}"
                                        IsEnabled="{Binding AgendamentoSelecionado, Converter={StaticResource NullToBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ED"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Editar"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ReagendarAgendamentoButton"
                                        Command="{Binding ReagendarCommand}"
                                        Style="{StaticResource CompactWarningActionButton}"
                                        IsEnabled="{Binding AgendamentoSelecionado, Converter={StaticResource NullToBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="RE"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Reagendar"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ConfirmarAgendamentoButton"
                                        Command="{Binding ConfirmarCommand}"
                                        Style="{StaticResource CompactSuccessActionButton}"
                                        IsEnabled="{Binding AgendamentoSelecionado, Converter={StaticResource NullToBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="OK"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Confirmar"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DuplicarCommand}"
                                        Style="{StaticResource CompactInfoActionButton}"
                                        IsEnabled="{Binding AgendamentoSelecionado, Converter={StaticResource NullToBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CP"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Duplicar"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="GerarOsAgendamentoButton"
                                        Command="{Binding ConverterEmOSCommand}"
                                        Style="{StaticResource CompactPrimaryActionButton}"
                                        IsEnabled="{Binding AgendamentoSelecionado, Converter={StaticResource NullToBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="OS"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Gerar OS"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding CancelarCommand}"
                                        Style="{StaticResource CompactDangerActionButton}"
                                        IsEnabled="{Binding AgendamentoSelecionado, Converter={StaticResource NullToBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="X"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Cancelar"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Timeline operacional -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Timeline operacional"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding Timeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                    <TextBlock Text=" | "
                                                               Foreground="{DynamicResource MutedTextBrush}"/>

                                                    <TextBlock Text="{Binding Usuario}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontWeight="SemiBold"/>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding Acao}"
                                                           Margin="0,6,0,0"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock Text="{Binding Detalhes}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================================================= -->
                <!-- COLUNA DIREITA: DETALHES DO AGENDAMENTO           -->
                <!-- ================================================= -->
                <Border Grid.Column="2"
                        x:Name="detailsPanel"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">

                    <ContentControl Content="{Binding AgendamentoSelecionado}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>

                                    <!-- Cabeçalho do detalhe -->
                                    <Border Background="{DynamicResource InfoCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource InfoBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Numero}"
                                                           FontWeight="Bold"
                                                           FontSize="20"
                                                           Foreground="{DynamicResource InfoBrush}"/>

                                                <TextBlock Text="{Binding Data, StringFormat=dd/MM/yyyy}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                    CornerRadius="999"
                                                    Padding="12,6">
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{DynamicResource InverseTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Cliente -->
                                    <TextBlock Text="Cliente"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ClienteNome}"
                                                       ToolTip="{Binding ClienteNome}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="42"/>

                                            <TextBlock Text="{Binding ClienteTelefone}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Veículo -->
                                    <TextBlock Text="Veículo"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding VeiculoModelo}"
                                                       ToolTip="{Binding VeiculoModelo}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="42"/>

                                            <WrapPanel Margin="0,4,0,0">
                                                <TextBlock Text="{Binding VeiculoPlaca}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text=" | "
                                                           FontSize="13"
                                                           Foreground="{DynamicResource MutedTextBrush}"/>

                                                <TextBlock Text="{Binding VeiculoCor}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Serviço -->
                                    <TextBlock Text="Serviço"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TipoServico}"
                                                       ToolTip="{Binding TipoServico}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="42"/>

                                            <TextBlock Text="{Binding DescricaoServico}"
                                                       ToolTip="{Binding DescricaoServico}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="72"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Técnico -->
                                    <TextBlock Text="Técnico"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TecnicoNome}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                                            <TextBlock Text="{Binding TecnicoEspecialidade}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Horário -->
                                    <TextBlock Text="Horário"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Início"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}"/>

                                                <TextBlock Text="{Binding HoraInicio, StringFormat=HH:mm}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Término"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}"/>

                                                <TextBlock Text="{Binding HoraTermino, StringFormat=HH:mm}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Financeiro -->
                                    <TextBlock Text="Financeiro"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SuccessCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource SuccessBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Valor estimado"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SuccessBrush}"/>

                                            <TextBlock Text="{Binding ValorEstimado, StringFormat=R$ {0:F2}}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Observações -->
                                    <TextBlock Text="Observações"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Observacoes}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Ações rápidas -->
                                    <WrapPanel Margin="0,8,0,0">

                                        <Button Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource CompactPrimaryActionButton}"
                                                ToolTip="Iniciar serviço">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📍"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="Iniciar"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource CompactSuccessActionButton}"
                                                ToolTip="Finalizar serviço">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="Finalizar"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.ReagendarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource CompactWarningActionButton}"
                                                ToolTip="Reagendar para outra data">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="Reagendar"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.EnviarWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource CompactSecondaryActionButton}"
                                                ToolTip="Enviar mensagem via WhatsApp">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💬"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="WhatsApp"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.GerarOSCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource CompactPrimaryActionButton}"
                                                ToolTip="Gerar Ordem de Serviço">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="OS"
                                                           FontWeight="Bold"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="Gerar OS"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource CompactSecondaryActionButton}"
                                                Margin="0"
                                                ToolTip="Editar agendamento">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✏️"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="Editar"/>
                                            </StackPanel>
                                        </Button>

                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
