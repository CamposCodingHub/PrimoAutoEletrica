<UserControl x:Class="PrimoAutoEletrica.UserControls.HelpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="16,14"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="📖 Central de Ajuda"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Pressione F1 em qualquer tela"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tree de Tópicos -->
                <ScrollViewer Grid.Row="1">
                    <TreeView x:Name="HelpTreeView"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="8"
                              SelectedItemChanged="HelpTreeView_SelectedItemChanged">

                        <TreeViewItem Header="🎯 Início Rápido" IsExpanded="True"
                                      Foreground="{DynamicResource PrimaryTextBrush}">
                            <TreeViewItem Header="Primeiro Acesso" Tag="primeiro-acesso"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Criar Cliente" Tag="criar-cliente"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Registrar Veículo" Tag="registrar-veiculo"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Criar Orçamento" Tag="criar-orcamento"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Gerar Relatório" Tag="gerar-relatorio"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </TreeViewItem>

                        <TreeViewItem Header="📚 Módulos" IsExpanded="False"
                                      Foreground="{DynamicResource PrimaryTextBrush}">
                            <TreeViewItem Header="Dashboard" Tag="modulo-dashboard"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Clientes" Tag="modulo-clientes"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Orçamentos" Tag="modulo-orcamentos"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Ordens de Serviço" Tag="modulo-os"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Estoque" Tag="modulo-estoque"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Financeiro" Tag="modulo-financeiro"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="Relatórios" Tag="modulo-relatorios"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TreeViewItem Header="PDV (Ponto de Venda)" Tag="modulo-pdv"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </TreeViewItem>

                        <TreeViewItem Header="⌨️ Atalhos de Teclado" Tag="atalhos-teclado"
                                      Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TreeViewItem Header="❓ Perguntas Frequentes" Tag="faq"
                                      Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TreeViewItem Header="📞 Suporte" Tag="suporte"
                                      Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </TreeView>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Column="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentArea" MaxWidth="700">
                <!-- Conteúdo de boas-vindas padrão -->
                <TextBlock Text="📖 Bem-vindo à Central de Ajuda"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,16"/>
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    Selecione um tópico no menu à esquerda para ver instruções detalhadas sobre cada funcionalidade do sistema PrimoAutoEletrica.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,12,0,0">
                    Dica: Pressione F1 em qualquer tela do sistema para abrir a ajuda do módulo correspondente.
                </TextBlock>

                <!-- Destaques rápidos -->
                <Border Background="{DynamicResource InfoCardBackgroundBrush}"
                        CornerRadius="8" Padding="16" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="🚀 Acesso Rápido" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="• Ctrl+N → Novo registro" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="• Ctrl+S → Salvar" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="• Ctrl+K → Busca global" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="• F1 → Ajuda do módulo" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="• F5 → Atualizar" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
