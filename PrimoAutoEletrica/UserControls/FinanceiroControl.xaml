                                                                Width="120"/>
                                            <DataGridTextColumn Header="Resultado"
                                                                Binding="{Binding Resultado, StringFormat={}{0:C}}"
                                                                Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
