<UserControl x:Class="PrimoAutoEletrica.UserControls.FinanceiroControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="FinanceiroModulePageHeader"
                Style="{StaticResource ModulePageHeader}">
            <StackPanel>
                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[FinanceTitle]}"
                           Style="{StaticResource ModulePageHeaderTitle}"/>
                <TextBlock Text="Central financeira — quanto entrou, quanto saiu, o que vence, o que atrasa e a origem real de cada lancamento."
                           Style="{StaticResource ModulePageHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PageActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Acoes financeiras"
                               Style="{StaticResource PageActionTitle}"/>
                    <TextBlock Text="Atualizar, exportar, imprimir e baixar contas com as operacoes reais do dominio."
                               Style="{StaticResource PageActionSubtitle}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource StatusBadgeNeutral}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CaixaNumero, StringFormat=Caixa: {0}}"
                                       Style="{StaticResource StatusBadgeTextNeutral}"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadgeWarning}">
                            <TextBlock Text="{Binding StatusFinanceiro, StringFormat=Status: {0}}"
                                       Style="{StaticResource StatusBadgeTextWarning}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button x:Name="AtualizarDadosButton"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Refresh]}"
                            Click="AtualizarDadosButton_Click"
                            Style="{StaticResource PagePrimaryActionButton}"
                            ToolTip="Atualizar panorama financeiro (F5)"/>
                    <Button x:Name="ExportarRelatorioButton"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Export]}"
                            Click="ExportarRelatorioButton_Click"
                            Style="{StaticResource ExportActionButton}"
                            ToolTip="Exportar panorama financeiro"/>
                    <Button Content="PDF"
                            Click="GerarPDFButton_Click"
                            Style="{StaticResource PageDangerActionButton}"
                            MinWidth="86"
                            ToolTip="Gerar PDF de fluxo de caixa"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Print]}"
                            Click="ImprimirButton_Click"
                            Style="{StaticResource PrintActionButton}"
                            ToolTip="Imprimir relatorio financeiro"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Filters]}"
                            Click="FiltrosAvancadosButton_Click"
                            Style="{StaticResource FilterActionButton}"
                            ToolTip="Orientacao sobre filtros de contas"/>
                </WrapPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="5"
                     Margin="0,0,0,16">
            <Border Style="{StaticResource OpsPulseCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ReceivablesShort]}" Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="{Binding PulseReceberText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource OpsPulseCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[PayablesShort]}" Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding PulsePagarText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource OpsPulseCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Vencendo hoje" Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding PulseVencendoHojeText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource OpsPulseCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Vencidas" Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding PulseVencidasText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource OpsPulseCard}">
                <StackPanel>
                    <TextBlock Text="Saldo do periodo" Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource DashboardMetricValue}"
                               Text="{Binding PulseSaldoText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Border x:Name="FinanceiroLoadingPanel" Style="{StaticResource LoadingStatePanel}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Carregando financeiro…" Style="{StaticResource LoadingStateTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Consultando contas, fluxo e alertas operacionais." Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border x:Name="FinanceiroErrorPanel" Style="{StaticResource ErrorStatePanel}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="Falha ao carregar financeiro" Style="{StaticResource ErrorStateTitle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="FinanceiroErrorDescriptionText" Style="{StaticResource ErrorStateDescription}"
                               Text="Nao foi possivel consultar o panorama financeiro." HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,16"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[TryAgain]}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Click="RetryFinanceiroButton_Click"/>
                </StackPanel>
            </Border>
            <Border x:Name="FinanceiroEmptyPanel" Style="{StaticResource PrimoxEmptyStatePanel}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="Nenhuma conta financeira" Style="{StaticResource PrimoxEmptyStateTitle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="A consulta funcionou, mas nao ha contas a pagar ou a receber cadastradas no momento."
                               Style="{StaticResource PrimoxEmptyStateDescription}" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="FinanceiroContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBackgroundBrush}">

            <StackPanel Margin="20,0,20,24"
                        Background="{DynamicResource AppBackgroundBrush}">

                <TextBlock Text="Indicadores"
                           Margin="0,0,0,14"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- CARDS FINANCEIROS LINHA 1 -->
                <ItemsControl ItemsSource="{Binding CardsFinanceirosLinha1}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icone}"
                                                   FontSize="22"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Titulo}"
                                                   ToolTip="{Binding Titulo}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Valor, StringFormat={}{0:C}}"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Comparacao}"
                                               ToolTip="{Binding Comparacao}"
                                               Foreground="{Binding CorComparacao}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CARDS FINANCEIROS LINHA 2 -->
                <ItemsControl ItemsSource="{Binding CardsFinanceirosLinha2}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icone}"
                                                   FontSize="22"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Titulo}"
                                                   ToolTip="{Binding Titulo}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Valor, StringFormat={}{0:C}}"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Comparacao}"
                                               ToolTip="{Binding Comparacao}"
                                               Foreground="{Binding CorComparacao}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CARDS FINANCEIROS LINHA 3 -->
                <ItemsControl ItemsSource="{Binding CardsFinanceirosLinha3}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icone}"
                                                   FontSize="22"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Titulo}"
                                                   ToolTip="{Binding Titulo}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Valor, StringFormat={}{0:C}}"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Comparacao}"
                                               ToolTip="{Binding Comparacao}"
                                               Foreground="{Binding CorComparacao}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- GRÁFICOS -->
                <Grid Margin="0,8,0,24"
                      Background="{DynamicResource AppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FLUXO DE CAIXA -->
                    <Border Grid.Column="0"
                            Margin="0,0,16,0"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.10"
                                              BlurRadius="12"
                                              ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[DailyCashFlow]}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="Entradas e saídas do mês atual"
                                       Margin="0,4,0,18"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <TextBlock Text="{Binding FluxoCaixaResumo}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,18,0">
                                    <Border Width="12"
                                            Height="12"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource SuccessBrush}"
                                            CornerRadius="3"/>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Inflows]}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12"
                                            Height="12"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource DangerBrush}"
                                            CornerRadius="3"/>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Outflows]}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Background="{DynamicResource CardBackgroundBrush}">
                                <ItemsControl ItemsSource="{Binding FluxoCaixaGrafico}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="52"
                                                    Margin="0,0,10,0"
                                                    Padding="8,12"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    CornerRadius="10"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid Height="210">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0"
                                                          VerticalAlignment="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Height="{Binding EntradasAltura}"
                                                                Margin="0,0,3,0"
                                                                VerticalAlignment="Bottom"
                                                                Background="{DynamicResource SuccessBrush}"
                                                                CornerRadius="4,4,0,0"/>

                                                        <Border Grid.Column="1"
                                                                Height="{Binding SaidasAltura}"
                                                                Margin="3,0,0,0"
                                                                VerticalAlignment="Bottom"
                                                                Background="{DynamicResource DangerBrush}"
                                                                CornerRadius="4,4,0,0"/>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1"
                                                               Margin="0,10,0,0"
                                                               HorizontalAlignment="Center"
                                                               Text="{Binding Dia}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,4,0,0"
                                                               HorizontalAlignment="Center"
                                                               Text="{Binding Lucro, StringFormat={}{0:C0}}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding LucroCor}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- FORMAS DE PAGAMENTO -->
                    <Border Grid.Column="1"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.10"
                                              BlurRadius="12"
                                              ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Formas de pagamento"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[MonthReceiptsDistribution]}"
                                       Margin="0,4,0,18"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <TextBlock Text="{Binding FormasPagamentoResumo}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FormasPagamentoGrafico}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Nome}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Valor, StringFormat={}{0:C}}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="Bold"/>
                                            </DockPanel>

                                            <Grid Height="12"
                                                  Margin="0,8,0,4">
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        CornerRadius="6"/>
                                                <Border Width="{Binding LarguraBarra}"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding Cor}"
                                                        CornerRadius="6"/>
                                            </Grid>

                                            <TextBlock Text="{Binding ParticipacaoTexto}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ALERTAS FINANCEIROS -->
                <Border Padding="22"
                        Margin="0,0,0,24"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          Opacity="0.10"
                                          BlurRadius="12"
                                          ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[DivergenceAlerts]}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <TextBlock Text="Pendencias que podem distorcer caixa, DRE ou conciliacao."
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,6">
                                <TextBlock Text="{Binding StatusFinanceiro, StringFormat=Status financeiro: {0}}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding AlertasDivergencia}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="310"
                                            MinHeight="142"
                                            Margin="0,0,12,12"
                                            Padding="16"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{Binding Cor}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Tipo}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>

                                                <Border DockPanel.Dock="Right"
                                                        Background="{Binding Cor}"
                                                        CornerRadius="999"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Severidade}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource InverseTextBrush}"/>
                                                </Border>
                                            </DockPanel>

                                            <TextBlock Text="{Binding Mensagem}"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Valor, StringFormat=Valor em atencao: {0:C}}"
                                                       Margin="0,8,0,0"
                                                       Foreground="{Binding Cor}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding Detalhes}"
                                                       Margin="0,8,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CONTAS -->
                <Grid Margin="0,0,0,24"
                      Background="{DynamicResource AppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CONTAS A PAGAR -->
                    <Border Grid.Column="0"
                            Margin="0,0,16,0"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.10"
                                              BlurRadius="12"
                                              ShadowDepth="3"/>
                        </Border.Effect>

                        <Grid Background="{DynamicResource CardBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[AccountsPayable]}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <StackPanel Grid.Row="1" Margin="0,14,0,14">
                                <TextBox x:Name="BuscaContasPagarTextBox"
                                         Style="{StaticResource SearchBox}"
                                         Margin="0,0,0,10"
                                         ToolTip="Buscar por fornecedor, descricao, origem ou status (Ctrl+F)"
                                         Text="{Binding TextoBuscaPagar, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel>
                                <Button x:Name="FiltroContasPagarTodasButton"
                                        Content="{Binding Source={StaticResource LocalizationHelper}, Path=[All]}"
                                        Click="FiltroContasPagarTodas_Click"
                                        Style="{StaticResource CompactSecondaryActionButton}"/>

                                <Button x:Name="FiltroContasPagarVencidasButton"
                                        Content="Vencidas"
                                        Click="FiltroContasPagarVencidas_Click"
                                        Style="{StaticResource CompactDangerActionButton}"/>

                                <Button x:Name="FiltroContasPagarHojeButton"
                                        Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Today]}"
                                        Click="FiltroContasPagarHoje_Click"
                                        Style="{StaticResource CompactWarningActionButton}"/>

                                <Button x:Name="FiltroContasPagarSemanaButton"
                                        Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Week]}"
                                        Click="FiltroContasPagarSemana_Click"
                                        Style="{StaticResource CompactInfoActionButton}"/>

                                <Button x:Name="BaixarContaPagarSelecionadaButton"
                                        Content="Baixar selecionada"
                                        Click="BaixarContaPagarSelecionada_Click"
                                        Style="{StaticResource CompactPrimaryActionButton}"
