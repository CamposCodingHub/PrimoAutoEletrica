<UserControl x:Class="PrimoAutoEletrica.UserControls.CatalogoPecasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:PrimoAutoEletrica.Converters"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1440"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:ImagePathToImageSourceConverter x:Key="ImagePathToImageSourceConverter"/>
    </UserControl.Resources>

<Grid Background="{DynamicResource AppBackgroundBrush}">
<Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MaxHeight="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PageActionBar}"
                MaxHeight="140">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Catalogo de Pecas"
                               Style="{StaticResource PageActionTitle}"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[CatalogTechnicalBase]}"
                               Style="{StaticResource PageActionSubtitle}"/>
                    <TextBlock Text="Os itens do catalogo ficam separados do estoque real e so viram produto depois de revisao."
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">
                    <Button x:Name="ImportarCatalogoButton"
                            Click="ImportarCatalogoButton_Click"
                            Style="{StaticResource PagePrimaryActionButton}">
                        Importar catalogo
                    </Button>
                    <Button x:Name="HistoricoImportacoesButton"
                            Click="HistoricoImportacoesButton_Click"
                            Style="{StaticResource PageSecondaryActionButton}">
                        Historico de importacoes
                    </Button>
                    <Button x:Name="ExportarButton"
                            Click="ExportarButton_Click"
                            Style="{StaticResource PageInfoActionButton}" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Export]}"/>
                    <Button x:Name="AtualizarButton"
                            Click="AtualizarButton_Click"
                            Style="{StaticResource PageSecondaryActionButton}" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Refresh]}"/>
                    <Button x:Name="Peca360Button"
                            Click="Peca360Button_Click"
                            Style="{StaticResource PageInfoActionButton}"
                            IsEnabled="False"
                            ToolTip="Abrir Peca 360 — ver, revisar, criar produto ou ignorar"
                            AutomationProperties.Name="Peca 360"
                            Content="360"/>
                    <Button x:Name="IgnorarCatalogoButton"
                            Click="IgnorarCatalogoButton_Click"
                            Style="{StaticResource PageSecondaryActionButton}"
                            IsEnabled="False"
                            ToolTip="Marcar item selecionado como Ignorado"
                            Content="Ignorar"/>
                    <Button x:Name="ExcluirCatalogoButton"
                            Click="ExcluirCatalogoButton_Click"
                            Style="{StaticResource PageDangerActionButton}"
                            IsEnabled="False"
                            ToolTip="Excluir item selecionado do catalogo (nao remove produto do estoque)"
                            Content="Excluir"/>
                    <Button x:Name="CriarProdutoButton"
                            Click="CriarProdutoButton_Click"
                            Style="{StaticResource PageSuccessActionButton}"
                            IsEnabled="False"
                            ToolTip="Atalho: criar produto no estoque a partir do item selecionado">
                        Criar produto no estoque
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1"
                     Margin="20,0,20,16"
                     Columns="4">
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Total de itens"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TotalItensText"
                               Text="0"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Pendentes de revisao"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="PendentesText"
                               Text="0"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Convertidos em estoque"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="ConvertidosText"
                               Text="0"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Duplicados provaveis"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="DuplicadosText"
                               Text="0"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InfoBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2"
              MinHeight="300"
              Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Consulta do catalogo"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Pesquise por codigo, nome, aplicacao, categoria ou status de revisao."
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="12,8"
                                VerticalAlignment="Center">
                            <TextBlock Text="Separado do estoque e pronto para conferencia"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,18,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Busca"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Brand]}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Category]}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="4"
                                   Text="Pendencias"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <TextBox x:Name="BuscaTextBox"
                                 Grid.Row="1"
                                 Margin="0,8,12,0"
                                 MinHeight="38"
                                 Style="{StaticResource SearchBox}"
                                 Tag="{Binding Source={StaticResource LocalizationHelper}, Path=SearchPlaceholder}"
                                 TextChanged="BuscaTextBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <ComboBox x:Name="MarcaComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,8,12,0"
                                  MinHeight="38"
                                  SelectionChanged="Filtros_Changed"/>
                        <ComboBox x:Name="CategoriaComboBox"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  Margin="0,8,12,0"
                                  MinHeight="38"
                                  SelectionChanged="Filtros_Changed"/>
                        <ComboBox x:Name="StatusComboBox"
                                  Grid.Row="1"
                                  Grid.Column="3"
                                  Margin="0,8,12,0"
                                  MinHeight="38"
                                  SelectionChanged="Filtros_Changed"/>
                        <CheckBox x:Name="SomentePendentesCheckBox"
                                  Grid.Row="1"
                                  Grid.Column="4"
                                  Margin="0,16,12,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  Checked="Filtros_Changed"
                                  Unchecked="Filtros_Changed"
                                  Content="Somente pendentes"/>
                        <Button x:Name="LimparFiltrosButton"
                                Grid.Row="1"
                                Grid.Column="5"
                                Margin="0,8,0,0"
                                Style="{StaticResource FilterActionButton}"
                                Click="LimparFiltrosButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[ClearFilters]}"/>

                        <TextBlock Grid.Row="2"
                                   Margin="0,12,0,0"
                                   Text="Marca do veiculo"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,12,0,0"
                                   Text="Modelo"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Margin="0,12,0,0"
                                   Text="Ano"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Margin="0,12,0,0"
                                   Text="Motor"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="4"
                                   Margin="0,12,0,0"
                                   Text="Equivalentes / OEM"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="MarcaVeiculoFiltroComboBox"
                                  Grid.Row="3"
                                  Margin="0,8,12,0"
                                  MinHeight="38"
                                  MaxDropDownHeight="320"
                                  IsEditable="False"
                                  Panel.ZIndex="20"
                                  DropDownOpened="FiltroVeiculo_DropDownOpened"
                                  DropDownClosed="FiltroVeiculo_DropDownClosed"
                                  SelectionChanged="FiltroVeiculo_SelectionChanged"/>
                        <ComboBox x:Name="ModeloVeiculoFiltroComboBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,8,12,0"
                                  MinHeight="38"
                                  MaxDropDownHeight="320"
                                  IsEditable="False"
                                  Panel.ZIndex="20"
                                  DropDownOpened="FiltroVeiculo_DropDownOpened"
                                  DropDownClosed="FiltroVeiculo_DropDownClosed"
                                  SelectionChanged="FiltroVeiculo_SelectionChanged"/>
                        <TextBox x:Name="AnoFiltroTextBox"
                                 Grid.Row="3"
                                 Grid.Column="2"
                                 Margin="0,8,12,0"
                                 MinHeight="38"
                                 Style="{StaticResource SearchBox}"
                                 Tag="Ano"
                                 TextChanged="BuscaTextBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <TextBox x:Name="MotorFiltroTextBox"
                                 Grid.Row="3"
                                 Grid.Column="3"
                                 Margin="0,8,12,0"
                                 MinHeight="38"
                                 Style="{StaticResource SearchBox}"
                                 Tag="Motor"
                                 TextChanged="BuscaTextBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <TextBox x:Name="EquivalentesFiltroTextBox"
                                 Grid.Row="3"
                                 Grid.Column="4"
                                 Margin="0,8,12,0"
                                 MinHeight="38"
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="BuscaTextBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <!-- compat: campos antigos mantidos ocultos para nao quebrar referencias -->
                        <TextBox x:Name="AplicacaoFiltroTextBox" Visibility="Collapsed"/>
                        <TextBox x:Name="ModeloVeiculoFiltroTextBox" Visibility="Collapsed"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="CatalogoDataGrid"
                                  Style="{StaticResource PremiumDataGrid}"
                                  RowHeight="68"
                                  MinRowHeight="68"
                                  CanUserResizeRows="False"
                                  SelectionChanged="CatalogoDataGrid_SelectionChanged"
                                  MouseDoubleClick="CatalogoDataGrid_MouseDoubleClick"
                                  AutoGenerateColumns="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                                    <Setter Property="Height" Value="68"/>
                                    <Setter Property="MinHeight" Value="68"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                                                <DataGridTemplateColumn Header="Foto"
                                                        Width="72"
                                                        MinWidth="64"
                                                        CanUserResize="False"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="4,0" ClipToBounds="True">
                                                <Image Source="{Binding ImagemLocal, Converter={StaticResource ImagePathToImageSourceConverter}}"
                                                       Stretch="Uniform"
                                                       ToolTip="{Binding ImagemLocal}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn><DataGridTextColumn Header="Codigo"
                                                    Binding="{Binding CodigoFabricante}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Brand]}"
                                                    Binding="{Binding Marca}"
                                                    Width="95"/>
                                <DataGridTemplateColumn Header="Nome / Descricao"
                                                        Width="2.2*"
                                                        MinWidth="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NomeExibicao}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Descricao}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Category]}"
                                                    Binding="{Binding Categoria}"
                                                    Width="145"/>
                                <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Application]}"
                                                    Binding="{Binding Aplicacao}"
                                                    Width="1.5*"
                                                    MinWidth="180"/>
                                <DataGridTextColumn Header="Pagina"
                                                    Binding="{Binding PaginaCatalogo}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                    Binding="{Binding StatusRevisao}"
                                                    Width="130"/>
                                <DataGridTemplateColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[LinkedToStock]}"
                                                        Width="110"
                                                        MinWidth="100"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding EstaVinculadoAoEstoque, Mode=OneWay}"
                                                      ToolTip="Marque para criar ou vincular este item no estoque. Se ja estiver vinculado, fica marcado."
                                                      AutomationProperties.Name="Vincular ao estoque"
                                                      Click="VincularEstoqueCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="EmptyStateBorder"
                                Visibility="Collapsed"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="36"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="520">
                                <TextBlock x:Name="EmptyStateTitleText"
                                           Text="Nenhum item no catalogo"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="EmptyStateDescriptionText"
                                           Text="Importe um PDF, CSV, Excel ou XML para criar a base tecnica de consulta sem poluir o estoque real."
                                           Margin="0,12,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Button Margin="0,24,0,0"
                                        Click="ImportarCatalogoButton_Click"
                                        Style="{StaticResource PagePrimaryActionButton}"
                                        HorizontalAlignment="Center">
                                    Importar catalogo
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Margin="16,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource AppBackgroundBrush}">
<StackPanel>
                    <Border Style="{StaticResource InfoCard}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Item selecionado"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InfoBrush}"/>
                            <TextBlock x:Name="DetalhesItemText"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WarningCard}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Origem e conferencia"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningDarkBrush}"/>
                            <TextBlock x:Name="OrigemItemText"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SuccessCard}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resumo operacional"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessDarkBrush}"/>
                            <TextBlock x:Name="ResumoCatalogoText"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Dicas de uso"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="DicasUsoText"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>


