<UserControl x:Class="PrimoAutoEletrica.UserControls.OficinaKanbanControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1400"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="KanbanPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="{DynamicResource PageToolbarPadding}"/>
        </Style>

        <Style x:Key="KanbanLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource KanbanPanel}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Kanban da oficina"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Visao profissional das Ordens de Servico: status, prazo, tecnico, valor, checklist, timeline e comunicacao com cliente."
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ResumoKanbanTextBlock"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button x:Name="AtualizarKanbanButton"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Refresh]}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="AtualizarKanbanButton_Click"/>
                    <Button x:Name="AbrirOsSelecionadaButton"
                            Content="Abrir OS"
                            Style="{StaticResource PrimaryButton}"
                            Click="AbrirOsSelecionadaButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.35*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource KanbanPanel}"
                    Margin="0,0,16,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="KanbanColumnsItemsControl"
                                  ItemsSource="{Binding KanbanColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="292"
                                        MinHeight="560"
                                        Margin="0,0,12,0"
                                        Padding="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Titulo}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <Border Grid.Column="1"
                                                        Padding="9,3"
                                                        Background="{DynamicResource PrimaryBackgroundBrush}"
                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="999">
                                                    <TextBlock Text="{Binding Quantidade}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Descricao}"
                                                       Margin="0,6,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TotalEstimadoFormatado, StringFormat=Total previsto: {0}}"
                                                       Margin="0,8,0,12"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Cards}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10"
                                                                Padding="12"
                                                                Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="12">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Numero}"
                                                                               FontSize="15"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding ValorEstimadoFormatado}"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Cliente}"
                                                                           Margin="0,7,0,0"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Veiculo}"
                                                                           Margin="0,4,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Placa, StringFormat=Placa: {0}}"
                                                                           Margin="0,4,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock Text="{Binding ServicoPrincipal}"
                                                                           Margin="0,8,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           TextWrapping="Wrap"/>

                                                                <Grid Margin="0,10,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Tecnico" Style="{StaticResource KanbanLabel}"/>
                                                                        <TextBlock Text="{Binding Tecnico}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="Prazo" Style="{StaticResource KanbanLabel}"/>
                                                                        <TextBlock Text="{Binding Prazo}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <WrapPanel Margin="0,12,0,0">
                                                                    <Button Content="Selecionar"
                                                                            Style="{StaticResource SecondaryButton}"
                                                                            Height="{DynamicResource DensityCompactControlHeight}"
                                                                            Padding="10,0"
                                                                            FontSize="11"
                                                                            Margin="0,0,6,6"
                                                                            Click="SelecionarCardButton_Click"/>
                                                                    <Button Content="Avancar"
                                                                            Style="{StaticResource PrimaryButton}"
                                                                            Height="{DynamicResource DensityCompactControlHeight}"
                                                                            Padding="10,0"
                                                                            FontSize="11"
                                                                            Margin="0,0,6,6"
                                                                            Click="AvancarStatusCardButton_Click"/>
                                                                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[WhatsApp]}"
                                                                            Style="{StaticResource SecondaryButton}"
                                                                            Height="{DynamicResource DensityCompactControlHeight}"
                                                                            Padding="10,0"
                                                                            FontSize="11"
                                                                            Margin="0,0,6,6"
                                                                            Click="WhatsAppCardButton_Click"/>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource KanbanPanel}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="OS selecionada"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedCard.Numero, TargetNullValue=Nenhuma OS selecionada}"
                                       Margin="0,8,0,0"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedCard.ResumoOperacional, TargetNullValue=Selecione um card para ver timeline e mensagens.}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="NovoStatusComboBox"
                                          ItemsSource="{Binding StatusOptions}"
                                          SelectedIndex="0"/>
                                <Button Grid.Column="1"
                                        Content="Alterar"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        Click="AlterarStatusSelecionadoButton_Click"/>
                            </Grid>

                            <Button Content="Copiar mensagem sugerida"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0"
                                    Click="CopiarMensagemButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KanbanPanel}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Checklist visual padrao"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ItemsControl ItemsSource="{Binding ChecklistPadrao}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Categoria}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KanbanPanel}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Timeline cliente/veiculo"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ItemsControl ItemsSource="{Binding Timeline}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding DataResumo}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding Descricao}"
                                                           Margin="0,5,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KanbanPanel}">
                        <StackPanel>
                            <TextBlock Text="Modelos de comunicacao"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ItemsControl ItemsSource="{Binding Mensagens}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Mensagem}"
                                                           Margin="0,5,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
