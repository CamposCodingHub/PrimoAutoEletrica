<UserControl x:Class="PrimoAutoEletrica.UserControls.RelatoriosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:PrimoAutoEletrica.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="1200"
             d:DesignWidth="1600"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:TendenciaToColorConverter x:Key="TendenciaToColorConverter"/>
        <converters:BooleanToVisibilityStateConverter x:Key="BooleanToVisibilityStateConverter"/>

        <x:Array x:Key="AuditSeverityOptions" Type="{x:Type sys:String}">
            <sys:String>Todas</sys:String>
            <sys:String>Info</sys:String>
            <sys:String>Warning</sys:String>
            <sys:String>Error</sys:String>
            <sys:String>Critical</sys:String>
        </x:Array>

        <x:Array x:Key="AuditStatusOptions" Type="{x:Type sys:String}">
            <sys:String>Todos</sys:String>
            <sys:String>Sucesso</sys:String>
            <sys:String>Falha</sys:String>
        </x:Array>

        <Style x:Key="RelatorioCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="RelatorioMetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="150"/>
        </Style>

        <Style x:Key="RelatorioTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RelatorioComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RelatorioComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RelatorioDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="RelatorioDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RelatorioDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel Margin="20"
                        Background="{DynamicResource AppBackgroundBrush}">

                <!-- BARRA DE AÇÕES -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ações e filtros executivos"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="{Binding EmpresaAtual}"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <WrapPanel Margin="0,12,0,0">
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,6"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PeriodoSelecionado, StringFormat=Período: {0}}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="{DynamicResource SuccessCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,6"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding StatusSistema, StringFormat=Status: {0}}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontWeight="Bold"/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,6"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding RelatorioFavorito, Converter={StaticResource BooleanToVisibilityStateConverter}}">
                                    <TextBlock Text="Favorito"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="Bold"/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,6"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding ModoExecutivoAtivo, Converter={StaticResource BooleanToVisibilityStateConverter}}">
                                    <TextBlock Text="Modo executivo"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="Bold"/>
                                </Border>

                                <Border Background="{DynamicResource InfoCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource InfoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,6"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding TemExportacaoGerada, Converter={StaticResource BooleanToVisibilityStateConverter}}">
                                    <TextBlock Text="{Binding ResumoUltimaExportacao}"
                                               Foreground="{DynamicResource InfoBrush}"
                                               FontWeight="SemiBold"
                                               MaxWidth="420"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top">
                            <Button Content="Atualizar"
                                    Style="{StaticResource PagePrimaryActionButton}"
                                    Click="Atualizar_Click"/>

                            <Button Content="PDF"
                                    Style="{StaticResource PageDangerActionButton}"
                                    Click="ExportarPDF_Click"/>

                            <Button Content="Excel"
                                    Style="{StaticResource ExportActionButton}"
                                    Click="ExportarExcel_Click"/>

                            <Button Content="Evidencias"
                                    Style="{StaticResource PageInfoActionButton}"
                                    Click="ExportarEvidencias_Click"/>

                            <Button Content="Imprimir"
                                    Style="{StaticResource PrintActionButton}"
                                    Click="Imprimir_Click"/>

                            <Button Content="Favoritos"
                                    Style="{StaticResource PageWarningActionButton}"
                                    Click="Favoritos_Click"/>

                            <Button Content="Salvar"
                                    Style="{StaticResource PageSuccessActionButton}"
                                    Click="Salvar_Click"/>

                            <Button Content="Executivo"
                                    Style="{StaticResource PageInfoActionButton}"
                                    Click="ModoExecutivo_Click"/>

                            <Button Content="Tela cheia"
                                    Style="{StaticResource PageSecondaryActionButton}"
                                    Click="TelaCheia_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- FATURAMENTO -->
                <Border Style="{StaticResource RelatorioCard}"
                        Visibility="{Binding ModoExecutivoAtivo, Converter={StaticResource BooleanToVisibilityStateConverter}, ConverterParameter=Invert}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="14" ShadowDepth="4"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Faturamento do período"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="{Binding ResumoFaturamento, StringFormat={}{0:C}}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="{DynamicResource SuccessCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,10"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Crescimento mensal"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CrescimentoMensal, StringFormat={}{0:F1}%}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontSize="18"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,10">
                                <StackPanel>
                                    <TextBlock Text="Meta mensal"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MetaMensal, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="18"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FILTROS -->
                <Border Style="{StaticResource RelatorioCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="14" ShadowDepth="4"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Filtros executivos"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Data início"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding DataInicio}"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            Foreground="{DynamicResource InputForegroundBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Data fim"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding DataFim}"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            Foreground="{DynamicResource InputForegroundBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Operador"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FiltroOperador}"
                                         Style="{StaticResource RelatorioTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Vendedor"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FiltroVendedor}"
                                         Style="{StaticResource RelatorioTextBox}"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <Button Content="Aplicar"
                                        Style="{StaticResource PagePrimaryActionButton}"
                                        Margin="0,0,8,0"
                                        Click="AplicarFiltros_Click"/>

                                <Button Content="Limpar"
                                        Style="{StaticResource PageSecondaryActionButton}"
                                        Click="LimparFiltros_Click"/>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DASHBOARD ANALÍTICO -->
                <TextBlock Text="Dashboard analítico"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding DashboardCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RelatorioMetricCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Icone}"
                                               FontSize="28"
                                               Margin="0,0,10,0"/>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding Titulo}"
                                               ToolTip="{Binding Titulo}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Valor}"
                                               ToolTip="{Binding Valor}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{Binding Cor}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding Comparacao}"
                                                   ToolTip="{Binding Comparacao}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text=" • "
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="4,0"/>
                                        <TextBlock Text="{Binding Tendencia}"
                                                   ToolTip="{Binding Tendencia}"
                                                   Foreground="{Binding Cor}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- VENDAS E MARGEM -->
                <TextBlock Text="Vendas e margem"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,8,0,16"/>

                <Border Style="{StaticResource RelatorioCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource SuccessCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Margem por produto"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ResumoMargemProdutos}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource InfoCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource InfoBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Melhor horario"
                                               Foreground="{DynamicResource InfoBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MelhorHorarioVendas}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource WarningCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Melhor dia"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MelhorDiaVendas}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding MargemPorProduto}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  MaxHeight="260"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  RowBackground="{DynamicResource CardBackgroundBrush}"
                                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource RelatorioDataGridHeaderStyle}"
                                  RowStyle="{StaticResource RelatorioDataGridRowStyle}"
                                  CellStyle="{StaticResource RelatorioDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="220"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
                                <DataGridTextColumn Header="Qtd." Binding="{Binding QuantidadeVendida}" Width="70"/>
                                <DataGridTextColumn Header="Receita" Binding="{Binding ReceitaTotal, StringFormat={}{0:C}}" Width="110"/>
                                <DataGridTextColumn Header="Custo" Binding="{Binding CustoTotal, StringFormat={}{0:C}}" Width="110"/>
                                <DataGridTextColumn Header="Lucro" Binding="{Binding LucroBruto, StringFormat={}{0:C}}" Width="110"/>
                                <DataGridTextColumn Header="Margem" Binding="{Binding MargemPercentual, StringFormat={}{0:N1}%}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2"
                              Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Vendas por hora"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding VendasPorHora}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          MaxHeight="220"
                                          EnableRowVirtualization="True"
                                          Background="{DynamicResource CardBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          RowBackground="{DynamicResource CardBackgroundBrush}"
                                          AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                          VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                          ColumnHeaderStyle="{StaticResource RelatorioDataGridHeaderStyle}"
                                          RowStyle="{StaticResource RelatorioDataGridRowStyle}"
                                          CellStyle="{StaticResource RelatorioDataGridCellStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" Binding="{Binding Periodo}" Width="80"/>
                                        <DataGridTextColumn Header="Vendas" Binding="{Binding QuantidadeVendas}" Width="80"/>
                                        <DataGridTextColumn Header="Itens" Binding="{Binding ItensVendidos}" Width="70"/>
                                        <DataGridTextColumn Header="Faturamento" Binding="{Binding Faturamento, StringFormat={}{0:C}}" Width="120"/>
                                        <DataGridTextColumn Header="Ticket" Binding="{Binding TicketMedio, StringFormat={}{0:C}}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="Vendas por dia"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding VendasPorDia}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          MaxHeight="220"
                                          EnableRowVirtualization="True"
                                          Background="{DynamicResource CardBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          RowBackground="{DynamicResource CardBackgroundBrush}"
                                          AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                          VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                          ColumnHeaderStyle="{StaticResource RelatorioDataGridHeaderStyle}"
                                          RowStyle="{StaticResource RelatorioDataGridRowStyle}"
                                          CellStyle="{StaticResource RelatorioDataGridCellStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Dia" Binding="{Binding Periodo}" Width="100"/>
                                        <DataGridTextColumn Header="Vendas" Binding="{Binding QuantidadeVendas}" Width="80"/>
                                        <DataGridTextColumn Header="Itens" Binding="{Binding ItensVendidos}" Width="70"/>
                                        <DataGridTextColumn Header="Faturamento" Binding="{Binding Faturamento, StringFormat={}{0:C}}" Width="120"/>
                                        <DataGridTextColumn Header="Ticket" Binding="{Binding TicketMedio, StringFormat={}{0:C}}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- INADIMPLENCIA DETALHADA -->
                <TextBlock Text="Inadimplencia detalhada"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,8,0,16"/>

                <Border Style="{StaticResource RelatorioCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource WarningCardBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Titulos vencidos em aberto"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResumoInadimplenciaDetalhada}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding InadimplenciaDetalhada}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  MaxHeight="260"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  RowBackground="{DynamicResource CardBackgroundBrush}"
                                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource RelatorioDataGridHeaderStyle}"
                                  RowStyle="{StaticResource RelatorioDataGridRowStyle}"
                                  CellStyle="{StaticResource RelatorioDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="180"/>
                                <DataGridTextColumn Header="Descricao" Binding="{Binding Descricao}" Width="220"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C}}" Width="110"/>
                                <DataGridTextColumn Header="Vencimento" Binding="{Binding DataVencimento, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                                <DataGridTextColumn Header="Atraso" Binding="{Binding DiasAtraso}" Width="80"/>
                                <DataGridTextColumn Header="Faixa" Binding="{Binding FaixaAtraso}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Forma" Binding="{Binding FormaPagamento}" Width="120"/>
                                <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- DRE OPERACIONAL -->
                <TextBlock Text="DRE operacional"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,8,0,16"/>

                <Border Style="{StaticResource RelatorioCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <Border Background="{DynamicResource InfoCardBackgroundBrush}"
                                BorderBrush="{DynamicResource InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Resultado consolidado do periodo"
                                           Foreground="{DynamicResource InfoBrush}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResumoDreOperacional}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="4">
                            <Border Background="{DynamicResource SuccessCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Receitas confirmadas"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DemonstrativoResultado.ReceitasConfirmadas, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Despesas confirmadas"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DemonstrativoResultado.DespesasConfirmadas, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource InfoCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource InfoBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Resultado operacional"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DemonstrativoResultado.ResultadoOperacional, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource InfoBrush}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Resultado projetado"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DemonstrativoResultado.ResultadoProjetado, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Receber pendente"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DemonstrativoResultado.ContasReceberPendentes, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Pagar pendente"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DemonstrativoResultado.ContasPagarPendentes, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Inadimplencia em aberto"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DemonstrativoResultado.InadimplenciaEmAberto, StringFormat={}{0:C}}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- CONCILIACAO FINANCEIRA -->
                <TextBlock Text="Conciliacao financeira"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,8,0,16"/>

                <Border Style="{StaticResource RelatorioCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource InfoCardBackgroundBrush}"
                                BorderBrush="{DynamicResource InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Vendas x entradas financeiras"
                                           Foreground="{DynamicResource InfoBrush}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResumoConciliacaoFinanceira}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ConciliacaoFinanceira}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  MaxHeight="260"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  RowBackground="{DynamicResource CardBackgroundBrush}"
                                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource RelatorioDataGridHeaderStyle}"
                                  RowStyle="{StaticResource RelatorioDataGridRowStyle}"
                                  CellStyle="{StaticResource RelatorioDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Forma" Binding="{Binding FormaPagamento}" Width="140"/>
                                <DataGridTextColumn Header="Vendas" Binding="{Binding TotalVendas, StringFormat={}{0:C}}" Width="120"/>
                                <DataGridTextColumn Header="Entradas" Binding="{Binding EntradasFinanceiras, StringFormat={}{0:C}}" Width="120"/>
                                <DataGridTextColumn Header="Diferenca" Binding="{Binding Diferenca, StringFormat={}{0:C}}" Width="120"/>
                                <DataGridTextColumn Header="Qtd. vendas" Binding="{Binding QuantidadeVendas}" Width="100"/>
                                <DataGridTextColumn Header="Lancamentos" Binding="{Binding QuantidadeMovimentacoes}" Width="110"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- INTELIGENCIA DE ESTOQUE -->
                <TextBlock Text="Inteligencia de estoque"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,8,0,16"/>

                <Border Style="{StaticResource RelatorioCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource InfoCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource InfoBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Curva ABC"
                                               Foreground="{DynamicResource InfoBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ResumoCurvaAbc}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource WarningCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Produtos parados"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RankingProdutosParados}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Distribuicao"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="A: "/>
                                        <Run Text="{Binding ProdutosCurvaA, Mode=OneWay}"/>
                                        <Run Text=" | B: "/>
                                        <Run Text="{Binding ProdutosCurvaB, Mode=OneWay}"/>
                                        <Run Text=" | C: "/>
                                        <Run Text="{Binding ProdutosCurvaC, Mode=OneWay}"/>
                                        <Run Text=" | Sem giro: "/>
                                        <Run Text="{Binding ProdutosSemGiro, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DadosEstoque}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  MaxHeight="320"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  RowBackground="{DynamicResource CardBackgroundBrush}"
                                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource RelatorioDataGridHeaderStyle}"
                                  RowStyle="{StaticResource RelatorioDataGridRowStyle}"
                                  CellStyle="{StaticResource RelatorioDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="220"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
                                <DataGridTextColumn Header="Estoque" Binding="{Binding QuantidadeAtual}" Width="80"/>
                                <DataGridTextColumn Header="Minimo" Binding="{Binding QuantidadeMinima}" Width="80"/>
                                <DataGridTextColumn Header="Valor total" Binding="{Binding ValorTotal, StringFormat={}{0:C}}" Width="120"/>
                                <DataGridTextColumn Header="ABC" Binding="{Binding CurvaAbc}" Width="70"/>
                                <DataGridTextColumn Header="Part." Binding="{Binding ParticipacaoEstoquePercentual, StringFormat={}{0:N1}%}" Width="80"/>
                                <DataGridTextColumn Header="Giro mensal" Binding="{Binding GiroMensal}" Width="100"/>
                                <DataGridTextColumn Header="Dias sem giro" Binding="{Binding DiasSemMovimentacao}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ALERTAS / METAS -->
                <Grid Margin="0,8,0,24"
                      Background="{DynamicResource AppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,16,0"
                            Style="{StaticResource RelatorioCard}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Alertas inteligentes"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding Alertas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Mensagem}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarningBrush}"/>
                                                <TextBlock Text="{Binding Severidade}"
                                                           Margin="0,6,0,0"
                                                           Foreground="{DynamicResource WarningBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource RelatorioCard}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Metas e performance"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding Metas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Tipo}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Periodo}"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <ProgressBar Height="8"
                                                                 Margin="0,10,0,0"
                                                                 Value="{Binding PercentualAtingido}"
                                                                 Maximum="100"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding PercentualAtingido, StringFormat={}{0:F1}%}"
                                                               FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                    <TextBlock Text="{Binding Status}"
                                                               Margin="0,6,0,0"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CONSISTÊNCIA -->
                <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                        CornerRadius="18"
                        Padding="22"
                        Margin="0,0,0,24"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Consistência operacional entre módulos"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding ResumoConsistenciaOperacional}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- TIMELINE -->
                <TextBlock Text="Timeline operacional"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,16"
                           Visibility="{Binding ModoExecutivoAtivo, Converter={StaticResource BooleanToVisibilityStateConverter}, ConverterParameter=Invert}"/>

                <Border Style="{StaticResource RelatorioCard}"
                        Visibility="{Binding ModoExecutivoAtivo, Converter={StaticResource BooleanToVisibilityStateConverter}, ConverterParameter=Invert}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>

                    <ItemsControl ItemsSource="{Binding Timeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,16"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding TipoEvento}"
                                                   Margin="0,6,0,0"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Descricao}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Usuario}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text=" • "
                                                       Margin="4,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding Categoria}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- AUDITORIA -->
                <TextBlock Text="Auditoria completa"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,16"
                           Visibility="{Binding ModoExecutivoAtivo, Converter={StaticResource BooleanToVisibilityStateConverter}, ConverterParameter=Invert}"/>

                <Border Style="{StaticResource RelatorioCard}"
                        Visibility="{Binding ModoExecutivoAtivo, Converter={StaticResource BooleanToVisibilityStateConverter}, ConverterParameter=Invert}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Área operacional"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding CategoriasAuditoriaDisponiveis}"
                                          SelectedItem="{Binding CategoriaAuditoriaSelecionada}"
                                          Style="{StaticResource RelatorioComboBox}"
                                          ItemContainerStyle="{StaticResource RelatorioComboBoxItem}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Severidade"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{StaticResource AuditSeverityOptions}"
                                          SelectedItem="{Binding SeveridadeAuditoriaSelecionada}"
                                          Style="{StaticResource RelatorioComboBox}"
                                          ItemContainerStyle="{StaticResource RelatorioComboBoxItem}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Status"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{StaticResource AuditStatusOptions}"
                                          SelectedItem="{Binding StatusAuditoriaSelecionado}"
                                          Style="{StaticResource RelatorioComboBox}"
                                          ItemContainerStyle="{StaticResource RelatorioComboBoxItem}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="Usuário"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding UsuarioAuditoriaFiltro}"
                                         Style="{StaticResource RelatorioTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,12,0">
                                <TextBlock Text="Busca operacional"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding TermoAuditoriaFiltro}"
                                         Style="{StaticResource RelatorioTextBox}"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="5" VerticalAlignment="Bottom">
                                <Button Content="Consultar"
                                        Style="{StaticResource PagePrimaryActionButton}"
                                        Margin="0,0,8,0"
                                        Click="AplicarAuditoriaFiltros_Click"/>

                                <Button Content="Anterior"
                                        Style="{StaticResource PageSecondaryActionButton}"
                                        Margin="0,0,8,0"
                                        IsEnabled="{Binding TemPaginaAnteriorAuditoria}"
                                        Click="AuditoriaAnterior_Click"/>

                                <Button Content="Próxima"
                                        Style="{StaticResource PageSecondaryActionButton}"
                                        IsEnabled="{Binding TemProximaPaginaAuditoria}"
                                        Click="AuditoriaProxima_Click"/>
                            </WrapPanel>
                        </Grid>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,14">
                            <TextBlock Text="{Binding ResumoAuditoria}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <DataGrid ItemsSource="{Binding Auditoria}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  ScrollViewer.CanContentScroll="True"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  RowBackground="{DynamicResource CardBackgroundBrush}"
                                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource RelatorioDataGridHeaderStyle}"
                                  RowStyle="{StaticResource RelatorioDataGridRowStyle}"
                                  CellStyle="{StaticResource RelatorioDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
                                <DataGridTextColumn Header="Área" Binding="{Binding Categoria}" Width="110"/>
                                <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="170"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusOperacional}" Width="90"/>
                                <DataGridTextColumn Header="Severidade" Binding="{Binding Severidade}" Width="90"/>
                                <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario}" Width="130"/>
                                <DataGridTextColumn Header="Entidade" Binding="{Binding Tabela}" Width="130"/>
                                <DataGridTextColumn Header="Contexto" Binding="{Binding ValorAnterior}" Width="220"/>
                                <DataGridTextColumn Header="Detalhes" Binding="{Binding ValorNovo}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- COMPARATIVOS -->
                <TextBlock Text="Comparativos de período"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding Comparativos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RelatorioCard}"
                                    Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding PeriodoAtual}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ValorAtual, StringFormat={}{0:C}}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding PeriodoAnterior}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ValorAnterior, StringFormat={}{0:C}}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding PercentualVariacao, StringFormat={}{0:F1}%}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Tendencia, Converter={StaticResource TendenciaToColorConverter}}"/>
                                        <TextBlock Text="{Binding Tendencia}"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- LOADING -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityStateConverter}}">
            <Border Background="#99000000"/>

            <Border Width="360"
                    Padding="22"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processando dados operacionais"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="{Binding LoadingMessage}"
                               Margin="0,8,0,16"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="8"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource SurfaceAltBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
