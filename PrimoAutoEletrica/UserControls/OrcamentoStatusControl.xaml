<UserControl x:Class="PrimoAutoEletrica.UserControls.OrcamentoStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="80" Width="Auto">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
            <Border Style="{StaticResource StatusBadgeNeutral}" Margin="4">
                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Draft]}" Style="{StaticResource StatusBadgeTextNeutral}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeInfo}" Margin="4">
                <TextBlock Text="Enviado" Style="{StaticResource StatusBadgeTextInfo}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeWarning}" Margin="4">
                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[AwaitingClient]}" Style="{StaticResource StatusBadgeTextWarning}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeSuccess}" Margin="4">
                <TextBlock Text="Aprovado" Style="{StaticResource StatusBadgeTextSuccess}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeDanger}" Margin="4">
                <TextBlock Text="Recusado" Style="{StaticResource StatusBadgeTextDanger}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeNeutral}" Margin="4">
                <TextBlock Text="Vencido" Style="{StaticResource StatusBadgeTextNeutral}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeInfo}" Margin="4">
                <TextBlock Text="Convertido em Venda" Style="{StaticResource StatusBadgeTextInfo}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeDanger}" Margin="4">
                <TextBlock Text="Cancelado" Style="{StaticResource StatusBadgeTextDanger}" FontWeight="Bold"/>
            </Border>
            <Border Style="{StaticResource StatusBadgeInfo}" Margin="4">
                <TextBlock Text="Em Negociação" Style="{StaticResource StatusBadgeTextInfo}" FontWeight="Bold"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
