<UserControl x:Class="PrimoAutoEletrica.UserControls.VeiculosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="20,20,20,16"
                Padding="18"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Central de veiculos"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Cadastro tecnico com sistema eletrico, alertas, retornos e historico operacional por unidade."
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right">
                    <Button x:Name="NovoVeiculoButton"
                            MinWidth="132"
                            Margin="0,0,10,10"
                            Style="{StaticResource PagePrimaryActionButton}"
                            Click="NovoVeiculoButton_Click">
                        Novo veiculo
                    </Button>

                    <Button x:Name="ExportarVeiculosButton"
                            MinWidth="116"
                            Margin="0,0,10,10"
                            Style="{StaticResource ExportActionButton}"
                            Click="ExportarVeiculosButton_Click">
                        Exportar
                    </Button>

                    <Button x:Name="LimparFiltrosVeiculosButton"
                            MinWidth="120"
                            Margin="0,0,0,10"
                            Style="{StaticResource FilterActionButton}"
                            Click="LimparFiltros_Click">
                        Limpar filtros
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="20,0,20,18">
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Total em carteira"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TotalVeiculosText"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}"
                    Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Retorno em 7 dias"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="VeiculosLevesText"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}"
                    Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Garantias ativas"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="VeiculosPesadosText"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}"
                    Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Alertas tecnicos"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="SemProprietarioText"
                               Margin="0,10,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Margin="20,0,20,20"
                Padding="20"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="BuscaTextBox"
                             Height="42"
                             VerticalContentAlignment="Center"
                             TextChanged="BuscaTextBox_TextChanged"/>

                    <ComboBox x:Name="FiltroCombustivelCombo"
                              Grid.Column="1"
                              Margin="12,0,0,0"
                              Height="42"
                              SelectionChanged="FiltroCombustivel_Changed">
                        <ComboBoxItem Content="Todos os sistemas" IsSelected="True"/>
                        <ComboBoxItem Content="12V"/>
                        <ComboBoxItem Content="24V"/>
                        <ComboBoxItem Content="12/24V"/>
                    </ComboBox>

                    <ComboBox x:Name="FiltroTipoCombo"
                              Grid.Column="2"
                              Margin="12,0,0,0"
                              Height="42"
                              SelectionChanged="FiltroTipo_Changed">
                        <ComboBoxItem Content="Todos os tipos" IsSelected="True"/>
                        <ComboBoxItem Content="Carro"/>
                        <ComboBoxItem Content="Caminhao"/>
                        <ComboBoxItem Content="Moto"/>
                        <ComboBoxItem Content="Utilitario"/>
                        <ComboBoxItem Content="Onibus"/>
                        <ComboBoxItem Content="Maquina"/>
                        <ComboBoxItem Content="Outro"/>
                    </ComboBox>
                </Grid>

                <TextBlock x:Name="ContadorResultadosText"
                           Grid.Row="1"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="0 veiculos encontrados"/>

                <DataGrid x:Name="VeiculosDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          RowHeight="86"
                          MouseDoubleClick="VeiculosDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Veiculo"
                                                Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46"
                                                Height="46"
                                                VerticalAlignment="Center"
                                                CornerRadius="12"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding FotoPreview}"
                                                       Stretch="UniformToFill"/>
                                                <TextBlock Text="Sem foto"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding FotoPlaceholderVisibility}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MarcaModelo}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding AnoCor}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding PlacaFormatada}"
                                                       Margin="0,4,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Eletrica"
                                                Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SistemaResumo}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding BateriasResumo}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MotorResumo}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Cliente / Agenda"
                                                Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NomeCliente}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding VinculosResumo}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding QuilometragemFormatada}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Alertas"
                                                Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Padding="8,4"
                                                HorizontalAlignment="Left"
                                                CornerRadius="10"
                                                Background="{Binding AlertaBackground}">
                                            <TextBlock Text="{Binding AlertaPrincipal}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding AlertaForeground}"/>
                                        </Border>
                                        <TextBlock Text="{Binding AlertaResumo}"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Acoes"
                                                Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Width="34"
                                                Height="34"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource TableActionButton}"
                                                Click="VisualizarVeiculo_Click"
                                                Tag="{Binding}">
                                            Ver
                                        </Button>

                                        <Button Width="34"
                                                Height="34"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource TableActionButton}"
                                                Click="EditarVeiculo_Click"
                                                Tag="{Binding}">
                                            Edit
                                        </Button>

                                        <Button Width="34"
                                                Height="34"
                                                Style="{StaticResource TableActionButton}"
                                                Click="ExcluirVeiculo_Click"
                                                Tag="{Binding}">
                                            Del
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
