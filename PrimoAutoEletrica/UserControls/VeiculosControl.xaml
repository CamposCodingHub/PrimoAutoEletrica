<UserControl x:Class="PrimoAutoEletrica.UserControls.VeiculosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="VeiculosModulePageHeader"
                Style="{StaticResource ModulePageHeader}">
            <StackPanel>
                <TextBlock Text="Veículo"
                           Style="{StaticResource ModulePageHeaderTitle}"/>
                <TextBlock Text="Prontuário técnico — identidade, quilometragem, histórico de OS e vínculo com o proprietário."
                           Style="{StaticResource ModulePageHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PageActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Ações do prontuário"
                               Style="{StaticResource PageActionTitle}"/>
                    <TextBlock Text="Cadastro técnico, alertas, retornos e histórico operacional por unidade."
                               Style="{StaticResource PageActionSubtitle}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right">
                    <Button x:Name="NovoVeiculoButton"
                            MinWidth="132"
                            Margin="0,0,10,10"
                            Style="{StaticResource PagePrimaryActionButton}"
                            ToolTip="Cadastrar novo veículo (Ctrl+N)"
                            Click="NovoVeiculoButton_Click">
                        Novo veiculo
                    </Button>

                    <Button x:Name="ExportarVeiculosButton"
                            MinWidth="116"
                            Margin="0,0,10,10"
                            Style="{StaticResource ExportActionButton}"
                            ToolTip="Exportar veículos filtrados"
                            Click="ExportarVeiculosButton_Click">
                        Exportar
                    </Button>

                    <Button x:Name="LimparFiltrosVeiculosButton"
                            MinWidth="120"
                            Margin="0,0,0,10"
                            Style="{StaticResource FilterActionButton}"
                            ToolTip="Limpar busca e filtros"
                            Click="LimparFiltros_Click">
                        Limpar filtros
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="4"
                     Margin="0,0,0,16">
            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total em carteira"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="TotalVeiculosText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Text="{Binding TotalVeiculosText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Retorno em 7 dias"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="VeiculosLevesText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Text="{Binding VeiculosLevesText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Garantias ativas"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="VeiculosPesadosText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="{Binding VeiculosPesadosText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpsPulseCard}">
                <StackPanel>
                    <TextBlock Text="Alertas técnicos"
                               Style="{StaticResource DashboardMetricLabel}"/>
                    <TextBlock x:Name="SemProprietarioText"
                               Margin="0,6,0,0"
                               Style="{StaticResource DashboardMetricValue}"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding SemProprietarioText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Border x:Name="VeiculosLoadingPanel"
                    Style="{StaticResource LoadingStatePanel}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Carregando veículos…"
                               Style="{StaticResource LoadingStateTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Consultando prontuários e vínculos operacionais."
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="VeiculosErrorPanel"
                    Style="{StaticResource ErrorStatePanel}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="Falha ao carregar veículos"
                               Style="{StaticResource ErrorStateTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="VeiculosErrorDescriptionText"
                               Style="{StaticResource ErrorStateDescription}"
                               Text="Não foi possível consultar os veículos."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,16"/>
                    <Button Content="Tentar novamente"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center"
                            Click="RetryVeiculosButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="VeiculosEmptyPanel"
                    Style="{StaticResource PrimoxEmptyStatePanel}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="Nenhum veículo cadastrado"
                               Style="{StaticResource PrimoxEmptyStateTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="A consulta funcionou, mas não há veículos na base. Cadastre o primeiro prontuário técnico."
                               Style="{StaticResource PrimoxEmptyStateDescription}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,16"/>
                    <Button Content="Novo veiculo"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Click="NovoVeiculoButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="VeiculosContentPanel"
                    Visibility="Visible"
                    Padding="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="BuscaTextBox"
                             Height="{DynamicResource DensityControlHeight}"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource SearchBox}"
                             Tag="{Binding Source={StaticResource LocalizationHelper}, Path=SearchPlaceholder}"
                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <ComboBox x:Name="FiltroCombustivelCombo"
                              Grid.Column="1"
                              Margin="12,0,0,0"
                              Height="{DynamicResource DensityControlHeight}"
                              Style="{StaticResource PremiumComboBox}"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding SelectedSistema, Mode=TwoWay}">
                        <ComboBoxItem Content="Todos os sistemas" IsSelected="True"/>
                        <ComboBoxItem Content="12V"/>
                        <ComboBoxItem Content="24V"/>
                        <ComboBoxItem Content="12/24V"/>
                    </ComboBox>

                    <ComboBox x:Name="FiltroTipoCombo"
                              Grid.Column="2"
                              Margin="12,0,0,0"
                              Height="{DynamicResource DensityControlHeight}"
                              Style="{StaticResource PremiumComboBox}"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding SelectedTipo, Mode=TwoWay}">
                        <ComboBoxItem Content="Todos os tipos" IsSelected="True"/>
                        <ComboBoxItem Content="Carro"/>
                        <ComboBoxItem Content="Caminhao"/>
                        <ComboBoxItem Content="Moto"/>
                        <ComboBoxItem Content="Utilitario"/>
                        <ComboBoxItem Content="Onibus"/>
                        <ComboBoxItem Content="Maquina"/>
                        <ComboBoxItem Content="Outro"/>
                    </ComboBox>
                </Grid>

                <TextBlock x:Name="ContadorResultadosText"
                           Grid.Row="1"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding ResultCountText}"/>

                <DataGrid x:Name="VeiculosDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          RowHeight="86"
                          Style="{StaticResource PremiumDataGrid}"
                          ItemsSource="{Binding FilteredVeiculos}"
                          MouseDoubleClick="VeiculosDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Veiculo"
                                                Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46"
                                                Height="46"
                                                VerticalAlignment="Center"
                                                CornerRadius="12"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding FotoPreview}"
                                                       Stretch="UniformToFill"/>
                                                <TextBlock Text="Sem foto"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding FotoPlaceholderVisibility}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MarcaModelo}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding AnoCor}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding PlacaFormatada}"
                                                       Margin="0,4,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Eletrica"
                                                Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SistemaResumo}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding BateriasResumo}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MotorResumo}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Cliente / Agenda"
                                                Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NomeCliente}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding VinculosResumo}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding QuilometragemFormatada}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Alertas"
                                                Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Padding="8,4"
                                                HorizontalAlignment="Left"
                                                CornerRadius="10"
                                                Background="{Binding AlertaBackground}">
                                            <TextBlock Text="{Binding AlertaPrincipal}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding AlertaForeground}"/>
                                        </Border>
                                        <TextBlock Text="{Binding AlertaResumo}"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Acoes"
                                                Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Width="34"
                                                Height="34"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource TableActionButton}"
                                                ToolTip="Visualizar veículo"
                                                AutomationProperties.Name="Visualizar veículo"
                                                Click="VisualizarVeiculo_Click"
                                                Tag="{Binding}">
                                            Ver
                                        </Button>

                                        <Button Width="34"
                                                Height="34"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource TableActionButton}"
                                                ToolTip="Editar veículo"
                                                AutomationProperties.Name="Editar veículo"
                                                Click="EditarVeiculo_Click"
                                                Tag="{Binding}">
                                            Edit
                                        </Button>

                                        <Button Width="34"
                                                Height="34"
                                                Style="{StaticResource TableActionButton}"
                                                ToolTip="Excluir veículo"
                                                AutomationProperties.Name="Excluir veículo"
                                                Click="ExcluirVeiculo_Click"
                                                Tag="{Binding}">
                                            Del
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
