<UserControl x:Class="PrimoAutoEletrica.UserControls.OrcamentoHistoricoNegociacaoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="180" Width="Auto">
    <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="16" Margin="8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Histórico de Negociação" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding HistoricoNegociacao}" Height="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{Binding DataHora}" FontWeight="SemiBold" Width="120"/>
                                <TextBlock Text="{Binding Usuario}" FontWeight="Bold" Width="120" Margin="8,0"/>
                                <TextBlock Text="{Binding Acao}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
