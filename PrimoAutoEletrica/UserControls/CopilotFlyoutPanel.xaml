<UserControl x:Class="PrimoAutoEletrica.UserControls.CopilotFlyoutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="420"
             Background="{DynamicResource SurfaceBrush}">

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0"
            Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecalho do Copilot -->
            <Border Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource SurfaceAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="{DynamicResource BrandSoftBrush}"
                            BorderBrush="{DynamicResource BrandBrush}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <TextBlock Text="✨"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PRIMOX Copilot"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Border x:Name="EngineBadge"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    Background="{DynamicResource SuccessCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="EngineBadgeText"
                                           Text="Offline Técnico"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="IA Automotiva &amp; Assistente ERP"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="LimparChatButton"
                                Style="{StaticResource FilterActionButton}"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Click="LimparChatButton_Click"
                                ToolTip="Limpar histórico da conversa"
                                Margin="0,0,4,0">
                            🗑️
                        </Button>
                        <Button x:Name="FecharButton"
                                Style="{StaticResource FilterActionButton}"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Click="FecharButton_Click"
                                ToolTip="Fechar painel do Copilot (Esc ou Ctrl+I)">
                            ✕
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chips de Prompts Rápidos -->
            <Border Grid.Row="1"
                    Padding="12,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⚡ DTC P0562"
                                Tag="Diagnosticar código P0562"
                                Click="PromptChip_Click"
                                Style="{StaticResource FilterActionButton}"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                FontSize="11"/>
                        <Button Content="🔋 Consumo Parasita"
                                Tag="Como medir corrente parasita na bateria?"
                                Click="PromptChip_Click"
                                Style="{StaticResource FilterActionButton}"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                FontSize="11"/>
                        <Button Content="🔌 Teste de Relé"
                                Tag="Como testar relé e qual a pinagem padrão?"
                                Click="PromptChip_Click"
                                Style="{StaticResource FilterActionButton}"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                FontSize="11"/>
                        <Button Content="📦 Peças em Falta"
                                Tag="Quais peças estão em falta?"
                                Click="PromptChip_Click"
                                Style="{StaticResource FilterActionButton}"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                FontSize="11"/>
                        <Button Content="🧰 Ferramentas em Uso"
                                Tag="Quem está com ferramentas em uso?"
                                Click="PromptChip_Click"
                                Style="{StaticResource FilterActionButton}"
                                Padding="8,4"
                                FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Historico de Mensagens -->
            <ScrollViewer Grid.Row="2"
                          x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14,10">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <!-- Indicador de Carregamento / Resposta -->
            <Border Grid.Row="3"
                    x:Name="ThinkingPanel"
                    Padding="16,8"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ Consultando base técnica e gerando resposta..."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Barra de Envio de Mensagem -->
            <Border Grid.Row="4"
                    Padding="12,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputTextBox"
                             MinHeight="40"
                             MaxHeight="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource SearchBox}"
                             Tag="Pergunte sobre falhas elétricas, DTCs, peças ou ferramentas..."
                             KeyDown="InputTextBox_KeyDown"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>

                    <Button x:Name="EnviarButton"
                            Grid.Column="1"
                            Style="{StaticResource PagePrimaryActionButton}"
                            Click="EnviarButton_Click"
                            Height="40"
                            Padding="14,0"
                            Content="Enviar (Enter)"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
