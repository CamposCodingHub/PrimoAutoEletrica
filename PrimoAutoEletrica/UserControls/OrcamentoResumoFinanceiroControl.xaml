<UserControl x:Class="PrimoAutoEletrica.UserControls.OrcamentoResumoFinanceiroControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinHeight="132"
    Width="Auto">
    <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18"
                Margin="8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="10" ShadowDepth="3"/>
            </Border.Effect>

            <WrapPanel Orientation="Horizontal"
                       ItemHeight="78"
                       Margin="0,-4,0,-4">
                <Border Margin="0,4,12,4"
                        Padding="14,12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Subtotal"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat=C}"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,12,4"
                        Padding="14,12"
                        Background="{DynamicResource DangerCardBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Desconto"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding Desconto, StringFormat=C}"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,12,4"
                        Padding="14,12"
                        Background="{DynamicResource SuccessCardBackgroundBrush}"
                        BorderBrush="{DynamicResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Acrescimo"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{Binding Acrescimo, StringFormat=C}"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,12,4"
                        Padding="14,12"
                        Background="{DynamicResource PrimaryBackgroundBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Total"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding Total, StringFormat=C}"
                                   Margin="0,6,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,12,4"
                        Padding="14,12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Margem"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding MargemLucro, StringFormat=P}"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,12,4"
                        Padding="14,12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Lucro estimado"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding LucroEstimado, StringFormat=C}"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,12,4"
                        Padding="14,12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Comissao"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding ComissaoVendedor, StringFormat=C}"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,0,4"
                        Padding="14,12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Impostos"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding ImpostosEstimados, StringFormat=C}"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
