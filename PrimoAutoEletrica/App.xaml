<Application x:Class="PrimoAutoEletrica.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PrimoAutoEletrica.Converters"
             xmlns:helpers="clr-namespace:PrimoAutoEletrica.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Carregar um dicionário de cores padrão para evitar falha no parse de XAML
                     GlobalStyles pode referenciar chaves de cor (ex: BackgroundBrush) durante
                     o carregamento de Application.Resources. O ThemeService substituirá este
                     dicionário no OnStartup conforme o tema salvo. -->
                <!-- PRIMOX DS: Colors + Shadows + GlobalStyles (Typography/Buttons/…).
                     StandardTheme.xaml é LEGADO (não mergeado; arquivo mantido no disco). -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="Themes/Shadows.xaml"/>
                <ResourceDictionary Source="Themes/GlobalStyles.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
            <converters:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
            <converters:BooleanToSimNaoConverter x:Key="BooleanToSimNaoConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:TendenciaToColorConverter x:Key="TendenciaToColorConverter"/>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:InverseNullToBoolConverter x:Key="InverseNullToBoolConverter"/>
            <helpers:LocalizationHelper x:Key="LocalizationHelper"/>
            <!--
              P15E-001: override SystemParameters.FocusVisualStyleKey (Style autocontido).
              Controles do tema WPF usam DynamicResource neste key.
            -->
            <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Margin="2"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource BrandBrush}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="helpers:TextSanitizerBehavior.Enabled" Value="True"/>
            </Style>
            <Style TargetType="{x:Type Window}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="helpers:TextSanitizerBehavior.Enabled" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
