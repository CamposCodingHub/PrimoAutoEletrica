<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Cores Primárias - Laranja Premium (Auto Elétrica) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#F97316"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#EA580C"/>
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#FFEDD5"/>
    
    <!-- Cores Secundárias - Azul Escuro Elegante -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="#0F172A"/>
    
    <!-- Cores Neutras - Cinza Claro Premium -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9"/>
    <!-- Compatibilidade: chave histórica BackgroundBrush usada em algumas janelas -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5E1"/>
    
    <!-- Cores de Texto -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentButtonTextBrush" Color="#FFFFFF"/>
    
    <!-- Cores de Input -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#F97316"/>
    
    <!-- Cores de Sucesso - Verde Moderno -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#15803D"/>
    
    <!-- Cores de Perigo - Vermelho Profissional -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#991B1B"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#991B1B"/>
    
    <!-- Cores de Aviso - Amarelo Elegante -->
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningDarkBrush" Color="#B45309"/>
    
    <!-- Cores de Informação -->
    <SolidColorBrush x:Key="InfoBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="InfoDarkBrush" Color="#1D4ED8"/>
    
    <!-- Cores de Status -->
    <SolidColorBrush x:Key="StatusAgendadoBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="StatusConfirmadoBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="StatusEmAndamentoBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusConcluidoBrush" Color="#1F8C63"/>
    <SolidColorBrush x:Key="StatusCanceladoBrush" Color="#DC2626"/>
    
    <!-- Cores de Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShellHeaderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A"/>
    
    <!-- Cores de Tabela -->
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TableRowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TableAlternateRowBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TableHoverBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TableSelectedBrush" Color="#FFEDD5"/>

    <!-- Cores de Disabled -->
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#CBD5E1"/>
    
    <!-- Cores de Card Hover -->
    <SolidColorBrush x:Key="CardHoverBrush" Color="#E2E8F0"/>
    
    <!-- Cores de Sombra -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Cores de Cards de Status - TEMA CLARO -->
    <SolidColorBrush x:Key="InfoCardBackgroundBrush" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="SuccessCardBackgroundBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WarningCardBackgroundBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="DangerCardBackgroundBrush" Color="#FEE2E2"/>

    <!-- Cores de Sidebar - TEMA CLARO -->
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SidebarItemHoverBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarItemActiveBackgroundBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SidebarItemActiveForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarItemActiveBorderBrush" Color="#F97316"/>
    <SolidColorBrush x:Key="SidebarSectionTextBrush" Color="#94A3B8"/>

</ResourceDictionary>
