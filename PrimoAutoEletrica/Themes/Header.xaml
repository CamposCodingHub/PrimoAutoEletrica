<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- HEADER / TOOLBAR GLOBAL COM SUPORTE A TEMA CLARO/ESCURO   -->
    <!-- ========================================================= -->
    <!--
        Este arquivo foi ajustado para usar DynamicResource.
        Assim, quando o ThemeService alternar entre Colors.Light.xaml
        e Colors.Dark.xaml, o header principal, os chips, as barras
        de ação das páginas e os botões compactos acompanham o tema.

        Regra:
        - Header usa SurfaceBrush / ShellHeaderBrush.
        - Cards e barras internas usam CardBackgroundBrush.
        - Textos usam PrimaryTextBrush, SecondaryTextBrush ou MutedTextBrush.
        - Botões usam SurfaceAltBrush e BorderBrush.
        - Botões primários usam PrimaryBrush e InverseTextBrush.
    -->

    <!-- HEADER PRINCIPAL DA APLICAÇÃO -->
    <Style x:Key="ShellHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShellHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="22,18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000"
                                  Opacity="0.10"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Direction="0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PremiumHeader"
           TargetType="Border"
           BasedOn="{StaticResource ShellHeader}"/>

    <!-- TÍTULO DO HEADER PRINCIPAL -->
    <Style x:Key="ShellHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="HeaderTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource ShellHeaderTitle}"/>

    <!-- SUBTÍTULO DO HEADER PRINCIPAL -->
    <Style x:Key="ShellHeaderSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="HeaderSubtitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource ShellHeaderSubtitle}"/>

    <!-- CHIP DE INFORMAÇÃO DO HEADER -->
    <Style x:Key="ShellHeaderInfoChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- LABEL DO CHIP -->
    <Style x:Key="ShellHeaderChipLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- VALOR DO CHIP -->
    <Style x:Key="ShellHeaderChipValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- BARRA DE AÇÕES DAS PÁGINAS -->
    <Style x:Key="PageActionBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="20,20,20,16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000"
                                  Opacity="0.10"
                                  BlurRadius="12"
                                  ShadowDepth="0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageActionBarStyle"
           TargetType="Border"
           BasedOn="{StaticResource PageActionBar}"/>

    <!-- TOOLBAR COMPACTA -->
    <Style x:Key="CompactToolbarStyle"
           TargetType="Border"
           BasedOn="{StaticResource PageActionBar}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- TÍTULO DA BARRA DE AÇÃO -->
    <Style x:Key="PageActionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- SUBTÍTULO DA BARRA DE AÇÃO -->
    <Style x:Key="PageActionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- BOTÃO SECUNDÁRIO DA BARRA DE AÇÃO -->
    <Style x:Key="PageActionButton" TargetType="Button">
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- BOTÃO PRIMÁRIO DA BARRA DE AÇÃO -->
    <Style x:Key="PagePrimaryActionButton" TargetType="Button">
        <Setter Property="MinWidth" Value="132"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageSecondaryActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageActionButton}"/>

    <Style x:Key="PageSuccessActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PagePrimaryActionButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <Style x:Key="PageWarningActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PagePrimaryActionButton}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
    </Style>

    <Style x:Key="PageDangerActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PagePrimaryActionButton}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style x:Key="PageInfoActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PagePrimaryActionButton}">
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
    </Style>

    <Style x:Key="PageIconButton"
           TargetType="Button"
           BasedOn="{StaticResource PageActionButton}">
        <Setter Property="MinWidth" Value="38"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="PageCompactButton"
           TargetType="Button"
           BasedOn="{StaticResource PageActionButton}">
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="CompactSecondaryActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageCompactButton}"/>

    <Style x:Key="CompactPrimaryActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PagePrimaryActionButton}">
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="CompactSuccessActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageSuccessActionButton}">
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="CompactWarningActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageWarningActionButton}">
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="CompactDangerActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageDangerActionButton}">
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="CompactInfoActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageInfoActionButton}">
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="TableActionButton"
           TargetType="Button"
           BasedOn="{StaticResource CompactSecondaryActionButton}">
        <Setter Property="MinWidth" Value="82"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="ExportActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageSuccessActionButton}">
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <Style x:Key="PrintActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageInfoActionButton}">
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <Style x:Key="FilterActionButton"
           TargetType="Button"
           BasedOn="{StaticResource PageSecondaryActionButton}">
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <!-- CHIP DE INFORMAÇÃO PARA TOOLBAR -->
    <Style x:Key="ToolbarInfoChip"
           TargetType="Border"
           BasedOn="{StaticResource ShellHeaderInfoChip}">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

</ResourceDictionary>
