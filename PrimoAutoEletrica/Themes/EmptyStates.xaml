<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Empty State Style (PRIMOX — sem emoji; tokens DS).
         Não referenciar PrimoxEmptyStatePanel aqui: EmptyStates carrega após Feedback,
         mas estilos legados EmptyStateWithAction ainda usam templates próprios. -->
    <Style x:Key="EmptyStateStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLG}"
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="280">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Title, FallbackValue='Nenhum item encontrado'}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding Description, FallbackValue='Não há itens para exibir no momento.'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Empty State with Action Button -->
    <Style x:Key="EmptyStateWithActionStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📭" 
                                       FontSize="64" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding Title, FallbackValue='Nenhum item encontrado'}" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource PrimaryTextBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Description, FallbackValue='Não há itens para exibir no momento.'}" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" 
                                       HorizontalAlignment="Center" 
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="400"
                                       Margin="0,0,0,24"/>
                            <Button Content="{Binding ActionText, FallbackValue='Adicionar Novo'}" 
                                    Command="{Binding ActionCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="24,12"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Empty State for Search -->
    <Style x:Key="EmptyStateSearchStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" 
                                       FontSize="64" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding Title, FallbackValue='Nenhum resultado encontrado'}" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource PrimaryTextBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Description, FallbackValue='Tente buscar com outros termos ou filtros.'}" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" 
                                       HorizontalAlignment="Center" 
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="400"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Empty State for Error -->
    <Style x:Key="EmptyStateErrorStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource DangerCardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" 
                                       FontSize="64" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding Title, FallbackValue='Erro ao carregar dados'}" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource DangerBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Description, FallbackValue='Ocorreu um erro ao tentar carregar os dados. Tente novamente.'}" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource DangerDarkBrush}" 
                                       HorizontalAlignment="Center" 
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="400"
                                       Margin="0,0,0,24"/>
                            <Button Content="Tentar Novamente" 
                                    Command="{Binding RetryCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="24,12"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Empty State for Loading -->
    <Style x:Key="EmptyStateLoadingStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⏳" 
                                       FontSize="64" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding Title, FallbackValue='Carregando...'}" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource PrimaryTextBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Description, FallbackValue='Por favor, aguarde enquanto carregamos os dados.'}" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" 
                                       HorizontalAlignment="Center" 
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="400"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
