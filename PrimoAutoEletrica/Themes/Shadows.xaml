<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shadow Effects -->
    <DropShadowEffect x:Key="ShadowXS" Color="#000000" Opacity="0.05" BlurRadius="4" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="ShadowSM" Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="ShadowMD" Color="#000000" Opacity="0.08" BlurRadius="12" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="ShadowLG" Color="#000000" Opacity="0.10" BlurRadius="16" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="ShadowXL" Color="#000000" Opacity="0.12" BlurRadius="24" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="Shadow2XL" Color="#000000" Opacity="0.15" BlurRadius="32" ShadowDepth="0" Direction="0"/>

    <!-- Standardized Shadow Effects (FASE 2.2) -->
    <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" Opacity="0.12" BlurRadius="12" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="SoftShadowEffect" Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="MediumShadowEffect" Color="#000000" Opacity="0.10" BlurRadius="16" ShadowDepth="0" Direction="0"/>
    <!-- Alias para CommandPalette e superfícies elevadas (mesmo efeito que MediumShadowEffect) -->
    <DropShadowEffect x:Key="ElevationShadowMedium" Color="#000000" Opacity="0.10" BlurRadius="16" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="StrongShadowEffect" Color="#000000" Opacity="0.15" BlurRadius="24" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="PanelShadowEffect" Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="0" Direction="0"/>

    <!-- Colored Shadows -->
    <DropShadowEffect x:Key="PrimaryShadow" Color="#3730A3" Opacity="0.15" BlurRadius="16" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="SuccessShadow" Color="#1F8C63" Opacity="0.15" BlurRadius="16" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="WarningShadow" Color="#F59E0B" Opacity="0.15" BlurRadius="16" ShadowDepth="0" Direction="0"/>
    <DropShadowEffect x:Key="DangerShadow" Color="#DC2626" Opacity="0.15" BlurRadius="16" ShadowDepth="0" Direction="0"/>

</ResourceDictionary>
