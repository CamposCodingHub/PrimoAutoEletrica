<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      LEGADO PRIMOX (Fase 1): dicionário indigo estático.
      NÃO mergeado em App.xaml. Fonte ativa: Colors.Light.xaml / Colors.Dark.xaml.
    -->

    <!-- Cores Primárias - Azul Premium -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3730A3"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#312E81"/>
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#EEF2FF"/>
    
    <!-- Cores Secundárias - Azul Escuro Elegante -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="#0F172A"/>
    
    <!-- Cores Neutras - Cinza Claro Premium -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5E1"/>
    
    <!-- Cores de Sucesso - Verde Moderno -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1F8C63"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="#15803D"/>
    
    <!-- Cores de Perigo - Vermelho Profissional -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#991B1B"/>
    
    <!-- Cores de Aviso - Amarelo Elegante -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningDarkBrush" Color="#B45309"/>
    
    <!-- Cores de Informação -->
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="InfoDarkBrush" Color="#1D4ED8"/>
    
    <!-- Cores de Status -->
    <SolidColorBrush x:Key="StatusAgendadoBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="StatusConfirmadoBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="StatusEmAndamentoBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusConcluidoBrush" Color="#1F8C63"/>
    <SolidColorBrush x:Key="StatusCanceladoBrush" Color="#DC2626"/>
    
    <!-- Cores de Sombra -->
    <Color x:Key="ShadowColor">#000000</Color>
    
    <!-- Valores de Cor Hex -->
    <sys:String x:Key="PrimaryColor">#3730A3</sys:String>
    <sys:String x:Key="PrimaryLightColor">#6366F1</sys:String>
    <sys:String x:Key="PrimaryDarkColor">#312E81</sys:String>
    <sys:String x:Key="PrimaryBackgroundColor">#EEF2FF</sys:String>
    
    <sys:String x:Key="SecondaryColor">#1E293B</sys:String>
    <sys:String x:Key="SecondaryLightColor">#334155</sys:String>
    <sys:String x:Key="SecondaryDarkColor">#0F172A</sys:String>
    
    <sys:String x:Key="BackgroundColor">#F1F5F9</sys:String>
    <sys:String x:Key="SurfaceColor">#FFFFFF</sys:String>
    <sys:String x:Key="BorderColor">#E2E8F0</sys:String>
    <sys:String x:Key="TextPrimaryColor">#0F172A</sys:String>
    <sys:String x:Key="TextSecondaryColor">#64748B</sys:String>
    <sys:String x:Key="TextTertiaryColor">#94A3B8</sys:String>
    <sys:String x:Key="DividerColor">#CBD5E1</sys:String>
    
    <sys:String x:Key="SuccessColor">#1F8C63</sys:String>
    <sys:String x:Key="SuccessLightColor">#DCFCE7</sys:String>
    <sys:String x:Key="SuccessDarkColor">#15803D</sys:String>
    
    <sys:String x:Key="DangerColor">#DC2626</sys:String>
    <sys:String x:Key="DangerLightColor">#FEE2E2</sys:String>
    <sys:String x:Key="DangerDarkColor">#991B1B</sys:String>
    
    <sys:String x:Key="WarningColor">#F59E0B</sys:String>
    <sys:String x:Key="WarningLightColor">#FEF3C7</sys:String>
    <sys:String x:Key="WarningDarkColor">#B45309</sys:String>
    
    <sys:String x:Key="InfoColor">#3B82F6</sys:String>
    <sys:String x:Key="InfoLightColor">#DBEAFE</sys:String>
    <sys:String x:Key="InfoDarkColor">#1D4ED8</sys:String>

</ResourceDictionary>
