<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PRIMOX Centro de Operações — tokens Fase 1 -->

    <Style x:Key="DashboardPageHeader" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Alias seguro (Dashboard carrega antes de Header; não BasedOn ModulePageHeader) -->
    <Style x:Key="PageHeader"
           TargetType="Border"
           BasedOn="{StaticResource DashboardPageHeader}"/>

    <Style x:Key="DashboardPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLG}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect" Value="{DynamicResource Elevation1}"/>
    </Style>

    <Style x:Key="DashboardHeroCard"
           TargetType="Border"
           BasedOn="{StaticResource DashboardPanel}">
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="OpsPulseCard"
           TargetType="Border"
           BasedOn="{StaticResource DashboardPanel}">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect" Value="{DynamicResource Elevation0}"/>
    </Style>

    <Style x:Key="DashboardMetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="DashboardMetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>

    <Style x:Key="DashboardChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InfoCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TechnicalInfoBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusFull}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="FlowStageChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMD}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style x:Key="AttentionRowButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrimoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusMD}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
