<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- DASHBOARD COM SUPORTE A TEMA CLARO/ESCURO                 -->
    <!-- ========================================================= -->

    <Style x:Key="DashboardHeroCard"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderElevated}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="DashboardMetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="DashboardMetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>

    <Style x:Key="DashboardChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InfoCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

</ResourceDictionary>