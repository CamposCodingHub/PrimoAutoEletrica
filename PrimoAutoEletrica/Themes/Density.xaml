<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Display density tokens. Comfortable is the default operating mode. -->
    <sys:String x:Key="DisplayDensityName">Comfortable</sys:String>

    <Thickness x:Key="PageOuterMargin">20</Thickness>
    <Thickness x:Key="PageSectionMargin">0,0,0,20</Thickness>
    <Thickness x:Key="PageCardPadding">22</Thickness>
    <Thickness x:Key="PageToolbarPadding">16</Thickness>
    <Thickness x:Key="PageInputPadding">12,0</Thickness>

    <sys:Double x:Key="DensityControlHeight">40</sys:Double>
    <sys:Double x:Key="DensityCompactControlHeight">34</sys:Double>
    <sys:Double x:Key="DensityTableRowHeight">38</sys:Double>
    <sys:Double x:Key="DensityTableCompactRowHeight">30</sys:Double>
    <sys:Double x:Key="DensityCardRadius">18</sys:Double>
    <sys:Double x:Key="DensityCompactCardRadius">12</sys:Double>

    <Style x:Key="ComfortableWorkspacePanel" TargetType="Border">
        <Setter Property="Padding" Value="{DynamicResource PageCardPadding}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="CompactWorkspacePanel" TargetType="Border">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ComfortableDataGrid" TargetType="DataGrid" BasedOn="{StaticResource PremiumDataGrid}">
        <Setter Property="RowHeight" Value="{DynamicResource DensityTableRowHeight}"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
    </Style>

    <Style x:Key="CompactDataGrid" TargetType="DataGrid" BasedOn="{StaticResource PremiumDataGrid}">
        <Setter Property="RowHeight" Value="{DynamicResource DensityTableCompactRowHeight}"/>
        <Setter Property="ColumnHeaderHeight" Value="32"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</ResourceDictionary>
