    <!-- Aliases Icon.* para qualquer consumidor legado que ainda espere DrawingImage.
         Preferir Path + Geo.* na Sidebar (recoloração por Foreground). -->
    <DrawingImage x:Key="Icon.Dashboard">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="{StaticResource Geo.Dashboard}">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SidebarItemForegroundBrush}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>
