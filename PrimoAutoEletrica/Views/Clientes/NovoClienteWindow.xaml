<Window x:Class="PrimoAutoEletrica.Views.Clientes.NovoClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Novo Cliente"
        Height="860"
        Width="1380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>

        <Style x:Key="ClienteCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ClienteDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="ClienteDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#3730A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClienteDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ClienteDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource ClienteDataGridHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{DynamicResource ClienteDataGridRowStyle}"/>
            <Setter Property="CellStyle" Value="{DynamicResource ClienteDataGridCellStyle}"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Novo Cliente"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Cadastre o cliente, organize a frota vinculada e registre os anexos iniciais."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="FecharButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.25*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Dados Pessoais"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Nome completo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NomeTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="CPF ou CNPJ"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CpfTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Telefone"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="TelefoneTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="WhatsApp"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="WhatsAppTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="2">
                                        <TextBlock Text="Email"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="EmailTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Endereco"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="CEP"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CepTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Rua"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="RuaTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Numero"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NumeroTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Bairro"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="BairroTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,12,0">
                                        <TextBlock Text="Cidade"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CidadeTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="UF"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="EstadoTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16"
                                           LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Veiculos"
                                                   Style="{StaticResource ModalSectionTitle}"
                                                   FontSize="18"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="Cadastre os veiculos do cliente para agilizar OS, orcamentos e atendimento."
                                                   Style="{StaticResource ModalSubheaderText}"/>
                                    </StackPanel>

                                    <Button x:Name="AdicionarVeiculoClienteButton"
                                            DockPanel.Dock="Right"
                                            Width="170"
                                            Style="{StaticResource ModalAccentButton}"
                                            Click="AdicionarVeiculoButton_Click">
                                        Adicionar veiculo
                                    </Button>
                                </DockPanel>

                                <DataGrid x:Name="VeiculosDataGrid"
                                          Height="260"
                                          Style="{StaticResource ClienteDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Marca"
                                                            Width="*"
                                                            Binding="{Binding Marca}"/>
                                        <DataGridTextColumn Header="Modelo"
                                                            Width="*"
                                                            Binding="{Binding Modelo}"/>
                                        <DataGridTextColumn Header="Ano"
                                                            Width="100"
                                                            Binding="{Binding Ano}"/>
                                        <DataGridTextColumn Header="Placa"
                                                            Width="140"
                                                            Binding="{Binding Placa}"/>
                                        <DataGridTextColumn Header="KM"
                                                            Width="120"
                                                            Binding="{Binding Quilometragem}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="20,0,0,0">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Cadastro Visual"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Border Width="136"
                                        Height="136"
                                        CornerRadius="68"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="FotoPreviewImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <TextBlock x:Name="FotoPlaceholderText"
                                                   Text="SEM FOTO"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Button x:Name="SelecionarFotoClienteButton"
                                        Margin="0,20,0,0"
                                        Width="190"
                                        Style="{StaticResource ModalSecondaryButton}"
                                        Click="SelecionarFotoButton_Click">
                                    Selecionar foto
                                </Button>

                                <Button x:Name="RemoverFotoButton"
                                        Margin="0,10,0,0"
                                        Width="190"
                                        Style="{StaticResource ModalSecondaryButton}"
                                        Click="RemoverFotoButton_Click">
                                    Remover foto
                                </Button>

                                <TextBlock Text="A foto fica salva junto do cadastro para uso na listagem e na ficha do cliente."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Documentos"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Button x:Name="UploadDocumentoClienteButton"
                                        Height="44"
                                        Style="{StaticResource ModalSecondaryButton}"
                                        Margin="0,0,0,12"
                                        Click="UploadDocumentoButton_Click">
                                    Upload documento
                                </Button>

                                <Button x:Name="AssinaturaClienteButton"
                                        Height="44"
                                        Style="{StaticResource ModalAccentButton}"
                                        Click="AssinaturaButton_Click">
                                    Assinatura digital
                                </Button>

                                <TextBlock x:Name="DocumentoStatusTextBlock"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource ModalSubheaderText}"
                                           Text="Nenhum documento anexado."
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="AssinaturaStatusTextBlock"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource ModalSubheaderText}"
                                           Text="Nenhuma assinatura registrada."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Relacionamento"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <CheckBox x:Name="ClienteVipCheckBox"
                                          Content="Cliente VIP"
                                          Style="{StaticResource ClienteCheckBoxStyle}"/>

                                <CheckBox x:Name="ConsentimentoLgpdCheckBox"
                                          Content="Consentimento LGPD registrado"
                                          Style="{StaticResource ClienteCheckBoxStyle}"
                                          Checked="ConsentimentoLgpdCheckBox_Changed"
                                          Unchecked="ConsentimentoLgpdCheckBox_Changed"/>

                                <CheckBox x:Name="AutorizaWhatsAppCheckBox"
                                          Content="Autoriza contato por WhatsApp"
                                          Style="{StaticResource ClienteCheckBoxStyle}"/>

                                <TextBlock x:Name="LgpdStatusTextBlock"
                                           Margin="0,0,0,14"
                                           Style="{StaticResource ModalSubheaderText}"
                                           Text="LGPD pendente: registre o aceite antes de campanhas ou contatos ativos."
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Pontos de fidelidade"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="PontosTextBox"
                                         Margin="0,0,0,14"
                                         Text="0"/>

                                <TextBlock Text="Observacoes"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="ObservacoesTextBox"
                                         Margin="0,0,0,14"
                                         MinHeight="120"
                                         Style="{StaticResource MultiLineTextBox}"/>

                                <TextBlock Text="Clientes com cadastro completo e frota vinculada aceleram atendimento, historico e a abertura de OS."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="130"
                            Style="{StaticResource ModalSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="CancelarButton_Click">
                        Cancelar
                    </Button>
                    <Button x:Name="SalvarClienteButton"
                            Width="190"
                            Style="{StaticResource ModalAccentButton}"
                            Click="SalvarButton_Click">
                        Salvar cliente
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
