<Window x:Class="PrimoAutoEletrica.Views.Clientes.VisualizarClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualizar Cliente"
        MinWidth="1500"
        MinHeight="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>

        <Style x:Key="ClienteMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="ClienteLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ClienteValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="84"
                                Height="84"
                                CornerRadius="42"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="FotoPreviewImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="FotoPlaceholderText"
                                           Text="SEM FOTO"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="18,0,0,0">
                            <TextBlock x:Name="NomeClienteHeaderText"
                                       Text="Cliente"
                                       Style="{StaticResource ModalHeaderText}"/>
                            <TextBlock x:Name="ResumoHeaderText"
                                       Text="Sem resumo disponivel."
                                       Style="{StaticResource ModalSubheaderText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Width="160"
                                Style="{StaticResource ModalAccentButton}"
                                Margin="0,0,10,0"
                                Click="EditarButton_Click">
                            Editar cliente
                        </Button>

                        <Button Width="150"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="0,0,10,0"
                                Click="WhatsAppButton_Click">
                            WhatsApp
                        </Button>

                        <Button Width="48"
                                Style="{StaticResource ModalCloseButton}"
                                Click="FecharButton_Click">
                            X
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,20,0">
                    <StackPanel>
                        <UniformGrid Columns="4"
                                     Margin="0,0,0,20">
                            <Border Style="{StaticResource ModalSectionCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Total gasto"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="TotalGastoTextBlock"
                                               Text="R$ 0,00"
                                               Style="{StaticResource ClienteMetricValue}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModalSectionCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Servicos"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="TotalServicosTextBlock"
                                               Text="0"
                                               Style="{StaticResource ClienteMetricValue}"
                                               Foreground="{DynamicResource InfoBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModalSectionCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Fidelidade"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="PontosTextBlock"
                                               Text="0"
                                               Style="{StaticResource ClienteMetricValue}"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModalSectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Ultima visita"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="UltimaVisitaTextBlock"
                                               Text="-"
                                               Style="{StaticResource ClienteMetricValue}"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Informacoes do Cliente"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nome"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="NomeTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="Telefone"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="TelefoneTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="WhatsApp"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="WhatsAppTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="Endereco"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="EnderecoTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Documento"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="DocumentoTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="Tipo de pessoa"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="TipoPessoaTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="RG/IE"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="RgIeTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="Email"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="EmailTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="Categoria"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="CategoriaTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="LGPD e contato"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="LgpdTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>

                                        <TextBlock Text="Observacoes"
                                                   Style="{StaticResource ClienteLabel}"/>
                                        <TextBlock x:Name="ObservacoesTextBlock"
                                                   Style="{StaticResource ClienteValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Veiculos"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <DataGrid x:Name="VeiculosDataGrid"
                                          Height="280"
                                          IsReadOnly="True"
                                          Style="{StaticResource PremiumDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Marca"
                                                            Width="*"
                                                            Binding="{Binding Marca}"/>
                                        <DataGridTextColumn Header="Modelo"
                                                            Width="*"
                                                            Binding="{Binding Modelo}"/>
                                        <DataGridTextColumn Header="Ano"
                                                            Width="90"
                                                            Binding="{Binding Ano}"/>
                                        <DataGridTextColumn Header="Placa"
                                                            Width="120"
                                                            Binding="{Binding Placa}"/>
                                        <DataGridTextColumn Header="Motor"
                                                            Width="120"
                                                            Binding="{Binding Motor}"/>
                                        <DataGridTextColumn Header="Comb."
                                                            Width="110"
                                                            Binding="{Binding Combustivel}"/>
                                        <DataGridTextColumn Header="KM"
                                                            Width="100"
                                                            Binding="{Binding Quilometragem}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Timeline de Relacionamento"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,20"/>

                                <ItemsControl x:Name="TimelineItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="18"
                                                    Margin="0,0,0,14">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding Titulo}"
                                                                   FontSize="16"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding Data, StringFormat=dd/MM/yyyy}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Subtitulo}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding Descricao}"
                                                               Margin="0,10,0,0"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource ModalSidebarCard}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Status do Cliente"
                                       Style="{StaticResource ModalSidebarTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>

                            <Border x:Name="StatusBorder"
                                    CornerRadius="12"
                                    Padding="14,10">
                                <TextBlock x:Name="StatusTextBlock"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Text="Ativo"/>
                            </Border>

                            <TextBlock x:Name="StatusResumoTextBlock"
                                       Margin="0,18,0,0"
                                       Style="{StaticResource ModalSubheaderText}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModalSidebarCard}">
                        <StackPanel>
                            <TextBlock Text="Documentos"
                                       Style="{StaticResource ModalSidebarTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>

                            <Button Height="42"
                                    Style="{StaticResource ModalSecondaryButton}"
                                    Margin="0,0,0,12"
                                    Click="AbrirDocumentoButton_Click">
                                Abrir documento
                            </Button>

                            <Button Height="42"
                                    Style="{StaticResource ModalSecondaryButton}"
                                    Margin="0,0,0,12"
                                    Click="AbrirAssinaturaButton_Click">
                                Abrir assinatura
                            </Button>

                            <TextBlock x:Name="DocumentoStatusTextBlock"
                                       Style="{StaticResource ModalSubheaderText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AssinaturaStatusTextBlock"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource ModalSubheaderText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModalSidebarCard}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="Insights"
                                       Style="{StaticResource ModalSidebarTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,20"/>

                            <Border Background="{DynamicResource InfoCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource InfoBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="15"
                                    Margin="0,0,0,10">
                                <TextBlock x:Name="InsightPrimarioTextBlock"
                                           Foreground="{DynamicResource InfoBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource SuccessCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="15"
                                    Margin="0,0,0,10">
                                <TextBlock x:Name="InsightSecundarioTextBlock"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="15">
                                <TextBlock x:Name="InsightTerciarioTextBlock"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

