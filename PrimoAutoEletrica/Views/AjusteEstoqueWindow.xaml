<Window x:Class="PrimoAutoEletrica.Views.AjusteEstoqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ajuste de Estoque"
        MinHeight="860"
        MinWidth="1320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>

        <Style x:Key="AjusteRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AjusteDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="AjusteDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AjusteDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AjusteDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource AjusteDataGridHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{DynamicResource AjusteDataGridRowStyle}"/>
            <Setter Property="CellStyle" Value="{DynamicResource AjusteDataGridCellStyle}"/>
        </Style>

        <Style x:Key="AjusteSuccessButton" TargetType="Button" BasedOn="{StaticResource ModalAccentButton}">
            <Setter Property="Background" Value="{DynamicResource SuccessDarkBrush}"/>
        </Style>

        <Style x:Key="AjusteWarningButton" TargetType="Button" BasedOn="{StaticResource ModalAccentButton}">
            <Setter Property="Background" Value="#D97706"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ajuste de estoque"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Ajuste quantidades e precos com filtros, lote e validacao operacional."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button x:Name="SalvarButton"
                                Width="150"
                                Margin="0,0,10,0"
                                Style="{StaticResource AjusteSuccessButton}"
                                Click="SalvarButton_Click">
                            Salvar ajustes
                        </Button>
                        <Button x:Name="CancelarButton"
                                Width="120"
                                Style="{StaticResource ModalSecondaryButton}"
                                Click="CancelarButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <StackPanel>
                    <Border Style="{StaticResource ModalSectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,24,0">
                                <RadioButton x:Name="AjusteUnitarioRadio"
                                             Content="Ajuste de estoque"
                                             IsChecked="True"
                                             Style="{StaticResource AjusteRadioStyle}"
                                             Checked="AjusteUnitarioRadio_Checked"/>
                                <RadioButton x:Name="AjusteLoteRadio"
                                             Content="Ajuste em lote"
                                             Style="{StaticResource AjusteRadioStyle}"
                                             Checked="AjusteLoteRadio_Checked"/>
                                <RadioButton x:Name="AjustePrecoRadio"
                                             Content="Ajuste de preco"
                                             Style="{StaticResource AjusteRadioStyle}"
                                             Checked="AjustePrecoRadio_Checked"/>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="BuscaTextBox"
                                         Grid.Column="0"
                                         Margin="0,0,10,0"
                                         TextChanged="BuscaTextBox_TextChanged"/>
                                <ComboBox x:Name="FiltroComboBox"
                                          Grid.Column="1"
                                          SelectionChanged="FiltroComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[All]}" IsSelected="True"/>
                                    <ComboBoxItem Content="Estoque Critico"/>
                                    <ComboBoxItem Content="Sem Estoque"/>
                                    <ComboBoxItem Content="Com Estoque"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="AjusteUnitarioPanel"
                            Style="{StaticResource ModalSectionCard}"
                            Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="Ajuste unitario"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="20"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Produto"
                                           Style="{StaticResource ModalFieldLabel}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ComboBox x:Name="ProdutoComboBox"
                                          Grid.Column="1"
                                          DisplayMemberPath="Nome"
                                          SelectionChanged="ProdutoComboBox_SelectionChanged"/>

                                <TextBlock Grid.Column="2"
                                           x:Name="EstoqueAtualText"
                                           Text="Estoque Atual: 0"
                                           Margin="16,0,0,0"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Tipo de ajuste"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="EntradaRadio"
                                                     Content="Entrada (+)"
                                                     IsChecked="True"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="EntradaRadio_Checked"/>
                                        <RadioButton x:Name="SaidaRadio"
                                                     Content="Saida (-)"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="SaidaRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0">
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Quantity]}"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="QuantidadeTextBox"
                                             Text="0"
                                             TextChanged="QuantidadeTextBox_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Motivo"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <ComboBox x:Name="MotivoComboBox">
                                        <ComboBoxItem Content="Contagem Fisica" IsSelected="True"/>
                                        <ComboBoxItem Content="Avaria"/>
                                        <ComboBoxItem Content="Perda"/>
                                        <ComboBoxItem Content="Transferencia"/>
                                        <ComboBoxItem Content="Devolucao"/>
                                        <ComboBoxItem Content="Outro"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AjusteLotePanel"
                            Style="{StaticResource ModalSectionCard}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Tipo de ajuste"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LoteEntradaRadio"
                                                     Content="Entrada (+)"
                                                     IsChecked="True"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="LoteEntradaRadio_Checked"/>
                                        <RadioButton x:Name="LoteSaidaRadio"
                                                     Content="Saida (-)"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="LoteSaidaRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0">
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Quantity]}"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="LoteQuantidadeTextBox"
                                             Text="0"
                                             TextChanged="LoteQuantidadeTextBox_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Motivo"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <ComboBox x:Name="LoteMotivoComboBox">
                                        <ComboBoxItem Content="Contagem Fisica" IsSelected="True"/>
                                        <ComboBoxItem Content="Avaria"/>
                                        <ComboBoxItem Content="Perda"/>
                                        <ComboBoxItem Content="Transferencia"/>
                                        <ComboBoxItem Content="Devolucao"/>
                                        <ComboBoxItem Content="Outro"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Selecione os produtos para ajuste em lote"
                                           Style="{StaticResource ModalSubheaderText}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="SelecionadosCountText"
                                           Text="0 selecionados"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource InfoBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <DataGrid x:Name="ProdutosDataGrid"
                                      Grid.Row="2"
                                      MinHeight="300"
                                      Style="{StaticResource AjusteDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Selecionar" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding Selecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Estoque Atual" Binding="{Binding QuantidadeEstoque, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Category]}" Binding="{Binding Categoria, Mode=OneWay}" Width="150"/>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Brand]}" Binding="{Binding Marca, Mode=OneWay}" Width="130"/>
                                    <DataGridTemplateColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusColor}"
                                                        CornerRadius="999"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border x:Name="AjustePrecoPanel"
                            Style="{StaticResource ModalSectionCard}"
                            Visibility="Collapsed"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Tipo de ajuste"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="PrecoPorcentagemRadio"
                                                     Content="Porcentagem"
                                                     IsChecked="True"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="PrecoPorcentagemRadio_Checked"/>
                                        <RadioButton x:Name="PrecoValorRadio"
                                                     Content="Valor (R$)"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="PrecoValorRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0">
                                    <TextBlock Text="Valor do ajuste"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="PrecoValorTextBox"
                                             Text="0"
                                             TextChanged="PrecoValorTextBox_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="12,0">
                                    <TextBlock Text="Operacao"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="PrecoAumentarRadio"
                                                     Content="Aumentar"
                                                     IsChecked="True"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="PrecoAumentarRadio_Checked"/>
                                        <RadioButton x:Name="PrecoDiminuirRadio"
                                                     Content="Diminuir"
                                                     Style="{StaticResource AjusteRadioStyle}"
                                                     Checked="PrecoDiminuirRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Motivo"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <ComboBox x:Name="PrecoMotivoComboBox">
                                        <ComboBoxItem Content="Reajuste de Mercado" IsSelected="True"/>
                                        <ComboBoxItem Content="Promocao"/>
                                        <ComboBoxItem Content="Inflacao"/>
                                        <ComboBoxItem Content="Correcao de Erro"/>
                                        <ComboBoxItem Content="Outro"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Selecione os produtos para ajuste de preco"
                                           Style="{StaticResource ModalSubheaderText}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="PrecoSelecionadosCountText"
                                           Text="0 selecionados"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource InfoBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <DataGrid x:Name="PrecoDataGrid"
                                      Grid.Row="2"
                                      MinHeight="300"
                                      Style="{StaticResource AjusteDataGridStyle}"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Selecionar" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding Selecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Preco Atual" Binding="{Binding PrecoVenda, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="Novo Preco" Binding="{Binding NovoPreco, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="Diferenca" Binding="{Binding Diferenca, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Category]}" Binding="{Binding Categoria, Mode=OneWay}" Width="140"/>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Brand]}" Binding="{Binding Marca, Mode=OneWay}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Produtos a ajustar" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="ProdutosAjustarText" Text="0" Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total do ajuste" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TotalAjusteText" Text="0" Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Estoque final" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="EstoqueFinalText" Text="0" Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Width="140"
                            Style="{StaticResource AjusteWarningButton}"
                            Click="SalvarButton_Click">
                        Aplicar agora
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

