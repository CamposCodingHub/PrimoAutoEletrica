<Window x:Class="PrimoAutoEletrica.Views.SelecionarOrdemServicoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PRIMOX Copilot - Vincular Peças e Serviços à Ordem de Serviço"
        MinHeight="680"
        MinWidth="1100"
        Height="720"
        Width="1160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- 0. CABEÇALHO MODAL                                                        -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ PRIMOX Copilot ➔ Ordem de Serviço"
                                       Style="{StaticResource ModalHeaderText}"/>
                            <Border Margin="12,0,0,0"
                                    Padding="8,3"
                                    Background="{DynamicResource BrandSoftBrush}"
                                    BorderBrush="{DynamicResource BrandBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="1-CLICK WORK ORDER BRIDGE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrandBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Insira as peças e serviços identificados no diagnóstico elétrico diretamente no orçamento ou OS em andamento na oficina."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            FontSize="16"
                            FontWeight="Bold"
                            Width="36"
                            Height="36"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="Fechar_Click"
                            ToolTip="Fechar janela"/>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- 1. CORPO PRINCIPAL (DUAL-PANE: ITENS DA IA + ORDEM DE SERVIÇO)            -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <!-- Coluna Esquerda: Itens Propostos pela IA (46%) -->
                    <ColumnDefinition Width="4.6*"/>
                    <!-- Espaçador -->
                    <ColumnDefinition Width="16"/>
                    <!-- Coluna Direita: Seleção da Ordem de Serviço (5.4%) -->
                    <ColumnDefinition Width="5.4*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================================================================== -->
                <!-- COLUNA ESQUERDA: LISTA DE PEÇAS E MÃO DE OBRA SUGERIDAS               -->
                <!-- ===================================================================== -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do Card de Itens -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🛠️ Peças e Serviços Identificados"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Selecione quais itens deseja adicionar ao orçamento/serviço:"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Lista de Itens Propostos -->
                        <ListView Grid.Row="1"
                                  x:Name="ItensListView"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- CheckBox de Inclusão -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Selecionado}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Checked="ItemCheckBox_Changed"
                                                      Unchecked="ItemCheckBox_Changed"/>

                                            <!-- Detalhes do Item -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <!-- Badge Tipo: Peca ou Servico -->
                                                    <Border Padding="6,2"
                                                            CornerRadius="4"
                                                            Margin="0,0,8,0"
                                                            Background="{DynamicResource BrandSoftBrush}">
                                                        <TextBlock Text="{Binding Tipo}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrandBrush}"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding CodigoFabricante}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Descricao}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>

                                                <!-- Status do Estoque / Tempo Estimado -->
                                                <TextBlock Text="{Binding StatusEstoqueFormatado}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>

                                            <!-- Valores / Quantidade -->
                                            <StackPanel Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                <TextBlock Text="{Binding PrecoSugerido, StringFormat=C}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Quantidade, StringFormat='Qtd: {0:N0}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Resumo Financeiro da Seleção -->
                        <Border Grid.Row="2"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="QtdItensSelecionadosTextBlock"
                                               Text="0 itens selecionados"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Button x:Name="GerarRequisicaoCompraButton"
                                            Content="📦 Requisitar Peças em Falta"
                                            Style="{StaticResource ModalSecondaryButton}"
                                            Height="28"
                                            Padding="8,0"
                                            FontSize="11"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Click="GerarRequisicaoCompraButton_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Total dos Itens:"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TotalItensTextBlock"
                                               Text="R$ 0,00"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===================================================================== -->
                <!-- COLUNA DIREITA: SELEÇÃO DA ORDEM DE SERVIÇO EM ABERTO                 -->
                <!-- ===================================================================== -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0: Título e Busca -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1: DataGrid de OSs -->
                            <RowDefinition Height="*"/>
                            <!-- 2: OS Selecionada Destacada -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título e Busca Rápida -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="📋 Ordens de Serviço em Aberto"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Escolha o veículo/cliente para vincular os itens diagnosticados:"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="BuscaOSTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource SearchBox}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="BuscaOSTextBox_TextChanged"
                                         ToolTip="Pesquise por placa, cliente, modelo ou número da OS"/>

                                <Button Grid.Column="1"
                                        Content="🔄 Atualizar"
                                        Style="{StaticResource ModalSecondaryButton}"
                                        Width="90"
                                        Margin="8,0,0,0"
                                        Click="RecarregarOS_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- DataGrid das Ordens de Serviço Abertas -->
                        <DataGrid Grid.Row="1"
                                  x:Name="OrdensServicoDataGrid"
                                  Style="{StaticResource PremiumDataGrid}"
                                  SelectionMode="Single"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="OrdensServicoDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="OS #"
                                                    Binding="{Binding Numero}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Placa"
                                                    Binding="{Binding PlacaSnapshot}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Veículo"
                                                    Binding="{Binding VeiculoDescricaoSnapshot}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Cliente"
                                                    Binding="{Binding ClienteNomeSnapshot}"
                                                    Width="1.2*"/>
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Abertura"
                                                    Binding="{Binding DataAbertura, StringFormat=dd/MM/yyyy}"
                                                    Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Painel da OS Atualmente Selecionada -->
                        <Border Grid.Row="2"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BrandBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Destino Selecionado:"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="OsSelecionadaTexto"
                                               Text="⚠️ Nenhuma Ordem de Serviço selecionada na tabela acima."
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        x:Name="OsStatusBadge"
                                        Padding="10,4"
                                        Background="{DynamicResource BrandSoftBrush}"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="OsStatusText"
                                               Text="EM ABERTO"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrandBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 2. RODAPÉ DO MODAL (AÇÕES)                                                -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2" Style="{StaticResource ModalFooterSurface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Os itens inseridos atualizarão o total e o histórico da OS com rastreabilidade auditada pelo PRIMOX."
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Style="{StaticResource ModalSecondaryButton}"
                                Width="110"
                                Margin="0,0,10,0"
                                Click="Fechar_Click"/>

                        <Button x:Name="ConfirmarInsercaoButton"
                                Content="🛒 Confirmar e Inserir na OS"
                                Style="{StaticResource ModalAccentButton}"
                                Padding="16,0"
                                Height="40"
                                FontWeight="Bold"
                                IsEnabled="False"
                                Click="ConfirmarInsercaoButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
