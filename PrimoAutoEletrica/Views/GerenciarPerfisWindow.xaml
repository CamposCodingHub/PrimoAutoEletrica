<Window x:Class="PrimoAutoEletrica.Views.GerenciarPerfisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Perfis - Primo Auto Eletrica"
        MinWidth="1140"
        MinHeight="780"
       
       
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>

        <Style x:Key="SectionDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="SectionDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource SectionDataGridHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{DynamicResource SectionDataGridRowStyle}"/>
            <Setter Property="CellStyle" Value="{DynamicResource SectionDataGridCellStyle}"/>
            <Setter Property="RowHeight" Value="44"/>
        </Style>

        <Style x:Key="GridActionButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionToggleStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Gerenciar Perfis de Acesso"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Padronize os perfis, niveis e permissoes disponiveis para cada funcao da oficina."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="FecharButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ModalSectionCard}"
                        Margin="0,0,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                                   LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Perfis cadastrados"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Selecione um perfil para revisar detalhes, permissoes e nivel de acesso."
                                           Style="{StaticResource ModalSubheaderText}"/>
                            </StackPanel>

                            <Button x:Name="NovoPerfilButton"
                                    DockPanel.Dock="Right"
                                    Width="150"
                                    Style="{StaticResource ModalAccentButton}"
                                    Click="NovoPerfilButton_Click">
                                Novo perfil
                            </Button>
                        </DockPanel>

                        <Border Grid.Row="1"
                                Margin="0,20,0,20"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <TextBlock Text="Use perfis para separar permissoes de administrador, caixa, vendedor, estoque e financeiro sem depender apenas do menu."
                                       Style="{StaticResource ModalSubheaderText}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <DataGrid x:Name="PerfisDataGrid"
                                  Grid.Row="2"
                                  Style="{StaticResource SectionDataGridStyle}"
                                  SelectionChanged="PerfisDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Name]}"
                                                    Binding="{Binding Nome}"
                                                    Width="1.15*"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Descricao"
                                                    Binding="{Binding Descricao}"
                                                    Width="1.55*"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nivel"
                                                    Binding="{Binding NivelHierarquico}"
                                                    Width="0.75*"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                    Binding="{Binding Status}"
                                                    Width="0.65*"
                                                    IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Actions]}"
                                                        Width="108">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource GridActionButton}"
                                                        ToolTip="Editar perfil"
                                                        Click="EditarPerfilButton_Click">
                                                    E
                                                </Button>
                                                <Button Style="{StaticResource GridActionButton}"
                                                        Margin="0"
                                                        Background="{DynamicResource DangerLightBrush}"
                                                        BorderBrush="{DynamicResource DangerBrush}"
                                                        ToolTip="Excluir perfil"
                                                        Click="ExcluirPerfilButton_Click">
                                                    X
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource ModalSidebarCard}"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Detalhes do perfil"
                                       Style="{StaticResource ModalSidebarTitle}"
                                       Margin="0,0,0,16"/>

                            <Grid Grid.Row="1">
                                <StackPanel x:Name="DetalhesPanel"
                                            Visibility="Collapsed">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Name]}"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NomePerfilTextBox"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Descricao"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="DescricaoPerfilTextBox"
                                                 Height="88"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <TextBlock Text="Permissoes"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Margin="0,0,0,18">
                                        <ScrollViewer Height="240"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="PermissoesItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Nome}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Style="{StaticResource PermissionToggleStyle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button x:Name="CancelarPerfilButton"
                                                Width="126"
                                                Style="{StaticResource ModalSecondaryButton}"
                                                Margin="0,0,10,0"
                                                Click="CancelarPerfilButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"/>
                                        <Button x:Name="SalvarPerfilButton"
                                                Width="150"
                                                Style="{StaticResource ModalAccentButton}"
                                                Click="SalvarPerfilButton_Click">
                                            Salvar perfil
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="NenhumPerfilSelecionadoTextBlock"
                                           Text="Selecione um perfil para revisar os detalhes e permissoes."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           MaxWidth="260"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource ModalSidebarCard}"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Boas praticas"
                                       Style="{StaticResource ModalSidebarTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,14"/>
                            <TextBlock Text="Perfis essenciais devem permanecer bloqueados para evitar perda de acesso administrativo."
                                       Style="{StaticResource ModalSubheaderText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Revise permissoes criticas como financeiro, exclusoes e alteracoes de estoque antes de liberar novos perfis."
                                       Style="{StaticResource ModalSubheaderText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="FecharButton"
                            Width="130"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="FecharButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Close]}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>



