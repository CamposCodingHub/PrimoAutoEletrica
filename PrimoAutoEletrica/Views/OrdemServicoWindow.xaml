<Window x:Class="PrimoAutoEletrica.Views.OrdemServicoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Ordem de Servico"
        MinWidth="1500"
        MinHeight="960"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <x:Array x:Key="TipoItens" Type="{x:Type sys:String}">
            <sys:String>Peca</sys:String>
            <sys:String>Servico</sys:String>
        </x:Array>

        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
        <Style TargetType="DatePicker" BasedOn="{StaticResource PremiumDatePicker}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="TituloTextBlock"
                                   Text="Nova Ordem de Servico"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Fluxo tecnico com checklist de entrada e saida, fotos, assinatura, tempos e vinculo comercial."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Numero da OS"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="NumeroTextBlock"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Button Width="48"
                                Style="{StaticResource ModalCloseButton}"
                                Click="CancelarButton_Click">
                            X
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Contexto da ordem"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Cliente" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="ClienteComboBox"
                                                  DisplayMemberPath="Nome"
                                                  SelectionChanged="ClienteComboBox_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,12,16">
                                        <TextBlock Text="Veiculo cadastrado" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="VeiculoComboBox"
                                                  DisplayMemberPath="Placa"
                                                  SelectionChanged="VeiculoComboBox_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,0,16">
                                        <TextBlock Text="Tecnico responsavel" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="TecnicoComboBox"
                                                  DisplayMemberPath="Nome"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Descricao do veiculo" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="VeiculoDescricaoTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,12,16">
                                        <TextBlock Text="Placa" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PlacaTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="12,0,0,16">
                                        <TextBlock Text="Telefone cliente" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="TelefoneClienteTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Prioridade" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="PrioridadeComboBox">
                                            <ComboBoxItem Content="Alta"/>
                                            <ComboBoxItem Content="Normal"/>
                                            <ComboBoxItem Content="Baixa"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,12,0">
                                        <TextBlock Text="Origem" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="OrigemComboBox">
                                            <ComboBoxItem Content="Balcao"/>
                                            <ComboBoxItem Content="WhatsApp"/>
                                            <ComboBoxItem Content="Telefone"/>
                                            <ComboBoxItem Content="Agendamento"/>
                                            <ComboBoxItem Content="Orcamento"/>
                                            <ComboBoxItem Content="Indicacao"/>
                                            <ComboBoxItem Content="Retorno"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="12,0,0,0">
                                        <TextBlock Text="Status" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="StatusComboBox">
                                            <ComboBoxItem Content="Rascunho"/>
                                            <ComboBoxItem Content="Aberta"/>
                                            <ComboBoxItem Content="Aguardando aprovacao"/>
                                            <ComboBoxItem Content="Aprovada"/>
                                            <ComboBoxItem Content="Em diagnostico"/>
                                            <ComboBoxItem Content="Em execucao"/>
                                            <ComboBoxItem Content="Aguardando peca"/>
                                            <ComboBoxItem Content="Finalizada"/>
                                            <ComboBoxItem Content="Aguardando pagamento"/>
                                            <ComboBoxItem Content="Pronta para entrega"/>
                                            <ComboBoxItem Content="Entregue"/>
                                            <ComboBoxItem Content="Cancelada"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Diagnosticos e comunicacao"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Problema relatado" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ProblemaTextBox"
                                                 MinHeight="96"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,16">
                                        <TextBlock Text="Diagnostico inicial" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="DiagnosticoInicialTextBox"
                                                 MinHeight="96"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,16">
                                        <TextBlock Text="Diagnostico final" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="DiagnosticoTextBox"
                                                 MinHeight="96"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,16">
                                        <TextBlock Text="Observacoes internas" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ObservacoesInternasTextBox"
                                                 MinHeight="96"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="Observacoes para o cliente" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ObservacoesClienteTextBox"
                                                 MinHeight="88"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Fotos antes e depois"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Margin="0,0,10,0"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Antes do servico"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="AdicionarFotosAntesOsButton"
                                                        Margin="0,0,10,10"
                                                        Style="{StaticResource ModalAccentButton}"
                                                        Click="AdicionarFotoAntesButton_Click">
                                                    Adicionar fotos
                                                </Button>
                                                <Button x:Name="LimparFotosAntesOsButton"
                                                        Style="{StaticResource ModalSecondaryButton}"
                                                        Margin="0,0,0,10"
                                                        Click="LimparFotosAntesButton_Click">
                                                    Limpar
                                                </Button>
                                            </WrapPanel>
                                            <WrapPanel x:Name="FotosAntesPanel"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Depois do servico"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="AdicionarFotosDepoisOsButton"
                                                        Margin="0,0,10,10"
                                                        Style="{StaticResource ModalAccentButton}"
                                                        Click="AdicionarFotoDepoisButton_Click">
                                                    Adicionar fotos
                                                </Button>
                                                <Button x:Name="LimparFotosDepoisOsButton"
                                                        Style="{StaticResource ModalSecondaryButton}"
                                                        Margin="0,0,0,10"
                                                        Click="LimparFotosDepoisButton_Click">
                                                    Limpar
                                                </Button>
                                            </WrapPanel>
                                            <WrapPanel x:Name="FotosDepoisPanel"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Itens da OS"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.45*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Adicionar peca do estoque" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="ProdutoComboBox"
                                                  DisplayMemberPath="Nome"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Qtd" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="QuantidadeProdutoTextBox"
                                                 Text="1"/>
                                    </StackPanel>

                                    <Button x:Name="AdicionarProdutoOsButton"
                                            Grid.Column="2"
                                            Margin="0,28,12,0"
                                            Style="{StaticResource ModalAccentButton}"
                                            Content="Adicionar peca"
                                            Click="AdicionarProdutoButton_Click"/>

                                    <Button x:Name="AdicionarServicoOsButton"
                                            Grid.Column="3"
                                            Margin="0,28,12,0"
                                            Style="{StaticResource ModalSecondaryButton}"
                                            Content="Adicionar servico"
                                            Click="AdicionarServicoButton_Click"/>

                                    <Button x:Name="RemoverItemOsButton"
                                            Grid.Column="4"
                                            Margin="0,28,0,0"
                                            Style="{StaticResource ModalSecondaryButton}"
                                            Content="Remover item"
                                            Click="RemoverItemButton_Click"/>
                                </Grid>

                                <DataGrid x:Name="ItensDataGrid"
                                          Height="320"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CellEditEnding="ItensDataGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridComboBoxColumn Header="Tipo"
                                                                Width="110"
                                                                ItemsSource="{StaticResource TipoItens}"
                                                                SelectedItemBinding="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Descricao"
                                                            Width="2*"
                                                            Binding="{Binding Descricao, UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="Qtd"
                                                            Width="85"
                                                            Binding="{Binding Quantidade, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="Valor Unit."
                                                            Width="120"
                                                            Binding="{Binding ValorUnitario, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="Custo Unit."
                                                            Width="120"
                                                            Binding="{Binding CustoUnitario, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="Observacoes"
                                                            Width="1.4*"
                                                            Binding="{Binding Observacoes, UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="Total"
                                                            Width="120"
                                                            IsReadOnly="True"
                                                            Binding="{Binding TotalFormatado}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Aprovacao, prazo e tempo"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <CheckBox x:Name="ClienteAprovouCheckBox"
                                          Content="Cliente ja aprovou a OS"
                                          Margin="0,0,0,14"
                                          Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <TextBlock Text="Metodo de aprovacao" Style="{StaticResource ModalFieldLabel}"/>
                                <ComboBox x:Name="MetodoAprovacaoComboBox"
                                          Margin="0,0,0,14">
                                    <ComboBoxItem Content="Nao definido"/>
                                    <ComboBoxItem Content="Balcao"/>
                                    <ComboBoxItem Content="WhatsApp"/>
                                    <ComboBoxItem Content="Telefone"/>
                                    <ComboBoxItem Content="Email"/>
                                </ComboBox>

                                <TextBlock Text="Previsao de entrega" Style="{StaticResource ModalFieldLabel}"/>
                                <DatePicker x:Name="DataPrevisaoDatePicker"
                                            Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Tempo previsto (min)" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="TempoPrevistoTextBox"
                                                 Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Tempo real (min)" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="TempoRealTextBox"
                                                 Text="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Orcamento aprovado"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <TextBlock x:Name="OrcamentoResumoTextBlock"
                                           Text="Nenhum orcamento vinculado."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Margin="0,0,10,10"
                                            Style="{StaticResource ModalAccentButton}"
                                            Click="SelecionarOrcamentoButton_Click">
                                        Vincular orcamento
                                    </Button>
                                    <Button Style="{StaticResource ModalSecondaryButton}"
                                            Margin="0,0,0,10"
                                            Click="LimparOrcamentoButton_Click">
                                        Limpar
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Financeiro previsto"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Pecas" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="PecasTotalTextBlock"
                                               Grid.Column="1"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="R$ 0,00"/>

                                    <TextBlock Grid.Row="1" Text="Servicos" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="ServicosTotalTextBlock"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,12,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="R$ 0,00"/>

                                    <TextBlock Grid.Row="2" Text="Desconto" Margin="0,12,0,8" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="DescontoTextBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             Width="120"
                                             Height="40"
                                             Margin="0,12,0,8"
                                             Text="0"
                                             TextChanged="DescontoTextBox_TextChanged"/>

                                    <Border Grid.Row="3"
                                            Grid.ColumnSpan="2"
                                            Margin="0,8,0,0"
                                            Padding="16"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Total previsto"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock x:Name="TotalGeralTextBlock"
                                                           Margin="0,6,0,0"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Text="R$ 0,00"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="Custo estimado"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="CustoTotalTextBlock"
                                                           Margin="0,6,0,0"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           HorizontalAlignment="Right"
                                                           Text="R$ 0,00"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Checklist, garantia e assinatura"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <TextBlock Text="Checklist de entrada" Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="ChecklistEntradaTextBox"
                                         MinHeight="72"
                                         Margin="0,0,0,14"
                                         Style="{StaticResource MultiLineTextBox}"/>

                                <TextBlock Text="Termo de autorizacao" Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="TermoAutorizacaoTextBox"
                                         MinHeight="92"
                                         Margin="0,0,0,14"
                                         Style="{StaticResource MultiLineTextBox}"/>

                                <TextBlock Text="Checklist de entrega" Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="ChecklistEntregaTextBox"
                                         MinHeight="72"
                                         Margin="0,0,0,14"
                                         Style="{StaticResource MultiLineTextBox}"/>

                                <TextBlock Text="Checklist de saida" Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="ChecklistSaidaTextBox"
                                         MinHeight="72"
                                         Margin="0,0,0,14"
                                         Style="{StaticResource MultiLineTextBox}"/>

                                <TextBlock Text="Observacoes de garantia" Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="GarantiaObservacoesTextBox"
                                         MinHeight="84"
                                         Margin="0,0,0,14"
                                         Style="{StaticResource MultiLineTextBox}"/>

                                <TextBlock Text="Garantia valida ate" Style="{StaticResource ModalFieldLabel}"/>
                                <DatePicker x:Name="GarantiaValidaAteDatePicker"
                                            Margin="0,0,0,14"/>

                                <Border Height="160"
                                        CornerRadius="16"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="AssinaturaPreviewImage"
                                               Stretch="Uniform"
                                               Visibility="Collapsed"/>
                                        <TextBlock x:Name="AssinaturaPlaceholderText"
                                                   Text="Sem assinatura"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="AssinaturaStatusTextBlock"
                                           Margin="0,12,0,0"
                                           Text="Anexe a assinatura ou aprovacao visual do cliente quando disponivel."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="SelecionarAssinaturaOsButton"
                                            Margin="0,0,10,10"
                                            Style="{StaticResource ModalAccentButton}"
                                            Click="SelecionarAssinaturaButton_Click">
                                        Selecionar assinatura
                                    </Button>
                                    <Button x:Name="CapturarAssinaturaOsButton"
                                            Margin="0,0,10,10"
                                            Style="{StaticResource ModalAccentButton}"
                                            Click="CapturarAssinaturaButton_Click">
                                        Capturar assinatura
                                    </Button>
                                    <Button x:Name="RemoverAssinaturaOsButton"
                                            Style="{StaticResource ModalSecondaryButton}"
                                            Margin="0,0,0,10"
                                            Click="RemoverAssinaturaButton_Click">
                                        Remover
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Regras do fluxo"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>
                                <TextBlock Text="Salvar cria ou atualiza a OS sem forcar emissao."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Emitir leva a OS para aprovacao ou atendimento conforme o status atual."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="Baixa de estoque e integracao financeira continuam acontecendo ao chegar em Entregue."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Content="Cancelar"
                            Click="CancelarButton_Click"/>
                    <Button x:Name="SalvarButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Content="Salvar rascunho"
                            Click="SalvarButton_Click"/>
                    <Button x:Name="EmitirButton"
                            Style="{StaticResource ModalAccentButton}"
                            Content="Emitir OS"
                            Click="EmitirButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
