<Window x:Class="PrimoAutoEletrica.Views.ImportarCatalogoPecasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar Catalogo de Pecas"
        Width="1240"
        Height="880"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
        <Style TargetType="DataGrid" BasedOn="{StaticResource PremiumDataGrid}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Importar Catalogo de Pecas"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Gere a previa antes de gravar. PDF, CSV, Excel e XML entram aqui sem poluir o estoque."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="CancelarButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="24,20,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Arquivo"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1"
                           Text="Tipo"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2"
                           Text="Marca"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="ArquivoTextBox"
                         Grid.Row="1"
                         Margin="0,8,12,0"
                         MinHeight="40"
                         VerticalContentAlignment="Center"/>

                <ComboBox x:Name="TipoArquivoComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,8,12,0"
                          MinHeight="40"/>

                <TextBox x:Name="MarcaTextBox"
                         Grid.Row="1"
                         Grid.Column="2"
                         Margin="0,8,12,0"
                         MinHeight="40"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="SelecionarArquivoButton"
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,8,0,0"
                        Height="40"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="SelecionarArquivoButton_Click">
                    Selecionar arquivo
                </Button>

                <TextBlock Grid.Row="2"
                           Text="Fonte do catalogo"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="SemiBold"
                           Margin="0,16,0,0"/>
                <TextBox x:Name="FonteCatalogoTextBox"
                         Grid.Row="3"
                         Grid.ColumnSpan="4"
                         Margin="0,8,0,0"
                         MinHeight="40"
                         VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="AlertaQualidadeBorder"
                        Margin="0,0,0,16"
                        Padding="14,12"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource WarningBrush}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Alerta de qualidade da previa"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock x:Name="AlertaQualidadeText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="6"
                             Margin="0,0,0,16">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Total lido"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="TotalLidosText"
                                       Text="0"
                                       Margin="0,10,0,0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Total valido"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="TotalValidosText"
                                       Text="0"
                                       Margin="0,10,0,0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Duplicados provaveis"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="TotalDuplicadosText"
                                       Text="0"
                                       Margin="0,10,0,0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource InfoBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Com erro"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="TotalErrosText"
                                       Text="0"
                                       Margin="0,10,0,0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Incompletos"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="TotalIncompletosText"
                                       Text="0"
                                       Margin="0,10,0,0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Sem nome real"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="TotalSemNomeRealText"
                                       Text="0"
                                       Margin="0,10,0,0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TabControl Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}">
                    <TabItem Header="Previa">
                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="12">
                            <DataGrid x:Name="PreviewDataGrid"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Codigo"
                                                        Binding="{Binding CodigoFabricante}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Marca"
                                                        Binding="{Binding Marca}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Nome"
                                                        Binding="{Binding NomeExibicao}"
                                                        Width="200"/>
                                    <DataGridTextColumn Header="Descricao"
                                                        Binding="{Binding Descricao}"
                                                        Width="220"/>
                                    <DataGridTextColumn Header="Categoria"
                                                        Binding="{Binding Categoria}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Pagina"
                                                        Binding="{Binding PaginaCatalogo}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding StatusRevisao}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Validacao"
                                                        Binding="{Binding MensagemValidacao}"
                                                        Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                    <TabItem Header="Erros e alertas">
                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="12">
                            <DataGrid x:Name="ErrosDataGrid"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Linha"
                                                        Binding="{Binding LinhaOrigem}"
                                                        Width="110"/>
                                    <DataGridTextColumn Header="Codigo"
                                                        Binding="{Binding CodigoDetectado}"
                                                        Width="150"/>
                                    <DataGridTextColumn Header="Erro"
                                                        Binding="{Binding MensagemErro}"
                                                        Width="280"/>
                                    <DataGridTextColumn Header="Conteudo original"
                                                        Binding="{Binding ConteudoOriginal}"
                                                        Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Row="3"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="170"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="CancelarButton_Click">
                        Cancelar
                    </Button>
                    <Button x:Name="GerarPreviaButton"
                            Width="180"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="GerarPreviaButton_Click">
                        Gerar previa
                    </Button>
                    <Button x:Name="ConfirmarImportacaoButton"
                            Width="220"
                            Style="{StaticResource ModalAccentButton}"
                            IsEnabled="False"
                            Click="ConfirmarImportacaoButton_Click">
                        Confirmar importacao
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
