<Window x:Class="PrimoAutoEletrica.Views.PosVendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestão de Pós-Venda, Garantias e Retornos"
        MinWidth="1050"
        MinHeight="660"
        Width="1150"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="16"
            Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="16,16,0,0"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Central de Pós-Venda, Garantias e Follow-up"
                                   Style="{StaticResource ModalHeaderText}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="ContextoSubheaderText"
                                   Style="{StaticResource ModalSubheaderText}"
                                   Text="Rastreabilidade de revisões preventivas, retorno de garantia e satisfação do cliente."
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OS: " FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="OsNumeroTextBlock" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,14,0"/>
                                <TextBlock Text="Cliente: " FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="ClienteNomeTextBlock" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,14,0"/>
                                <TextBlock Text="Placa: " FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="VeiculoPlacaTextBlock" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Width="40"
                                Height="40"
                                Style="{StaticResource ModalCloseButton}"
                                Content="✕"
                                Click="FecharButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY CONTENT (GRID 2 COLUNAS: ESQUERDA LISTA HISTORICO, DIREITA FORMULARIO) -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUNA ESQUERDA: HISTORICO DE OCORRENCIAS -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ocorrências e Registros de Pós-Venda"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="+ Nova Ocorrência"
                                    Style="{StaticResource ModalSecondaryButton}"
                                    Height="30"
                                    Padding="10,0"
                                    Click="NovaOcorrenciaButton_Click"/>
                        </Grid>

                        <DataGrid x:Name="PosVendaDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="PosVendaDataGrid_SelectionChanged"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data Prevista" Binding="{Binding DataPrevistaContato, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                <DataGridTextColumn Header="Responsável" Binding="{Binding Responsavel}" Width="110"/>
                                <DataGridCheckBoxColumn Header="Reincidência" Binding="{Binding Reincidencia}" Width="85"/>
                                <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- COLUNA DIREITA: DETALHE / EDICAO -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="10,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Detalhe da Ocorrência"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- TIPO E STATUS -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Tipo de Pós-Venda:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="TipoComboBox" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Status do Atendimento:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="StatusComboBox" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- DATAS -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Data Prevista para Contato:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="DataPrevistaDatePicker" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Data Realizada do Contato:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="DataRealizadaDatePicker" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- RESPONSAVEL E REINCIDENCIA -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Responsável pelo Contato:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ResponsavelTextBox" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <CheckBox x:Name="ReincidenciaCheckBox"
                                              Content="É Reincidência Técnica"
                                              FontWeight="SemiBold"
                                              Foreground="#D32F2F"
                                              Margin="0,0,0,8"/>
                                </StackPanel>
                            </Grid>

                            <!-- DESCRICAO / RECLAMACAO -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Descrição da Demanda / Relato do Cliente:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="DescricaoTextBox"
                                         Height="65"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- RESULTADO / SOLUCAO -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Resultado / Solução Aplicada:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ResultadoTextBox"
                                         Height="65"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- ACOES ESPECIFICAS -->
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="AnalisarDiagnosticoButton"
                                        Content="Analisar Diagnóstico Técnico"
                                        Style="{StaticResource ModalSecondaryButton}"
                                        Height="32"
                                        Margin="0,0,8,8"
                                        Padding="12,0"
                                        Click="AnalisarDiagnosticoButton_Click"/>
                                <Button x:Name="MarcarResolvidoButton"
                                        Content="Concluir / Encerrar Atendimento"
                                        Style="{StaticResource ModalAccentButton}"
                                        Height="32"
                                        Margin="0,0,8,8"
                                        Padding="14,0"
                                        Click="MarcarResolvidoButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Fechar"
                            Style="{StaticResource ModalSecondaryButton}"
                            Margin="0,0,10,0"
                            Height="36"
                            Padding="16,0"
                            Click="FecharButton_Click"/>
                    <Button x:Name="SalvarOcorrenciaButton"
                            Content="Salvar Pós-Venda"
                            Style="{StaticResource ModalAccentButton}"
                            Height="36"
                            Padding="20,0"
                            Click="SalvarOcorrenciaButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
