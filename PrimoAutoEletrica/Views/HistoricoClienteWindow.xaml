<Window x:Class="PrimoAutoEletrica.Views.HistoricoClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historico do Cliente - Primo Auto Eletrica"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="1120"
        MinHeight="780"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="HistoricoValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HistoricoValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="HistoricoDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="HistoricoDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoricoDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HistoricoDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource HistoricoDataGridHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{DynamicResource HistoricoDataGridRowStyle}"/>
            <Setter Property="CellStyle" Value="{DynamicResource HistoricoDataGridCellStyle}"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientHistoryTitle]}"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock x:Name="NomeClienteTextBlock"
                                   Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientName]}"
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Width="132"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="FecharButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Close]}"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientData]}"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Name]}"
                                                   Style="{StaticResource HistoricoValueLabel}"/>
                                        <TextBlock x:Name="NomeTextBlock"
                                                   Style="{StaticResource HistoricoValueText}"/>

                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Phone]}"
                                                   Style="{StaticResource HistoricoValueLabel}"/>
                                        <TextBlock x:Name="TelefoneTextBlock"
                                                   Style="{StaticResource HistoricoValueText}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CPF/CNPJ"
                                                   Style="{StaticResource HistoricoValueLabel}"/>
                                        <TextBlock x:Name="CPFTextBlock"
                                                   Style="{StaticResource HistoricoValueText}"/>

                                        <TextBlock Text="Data de cadastro"
                                                   Style="{StaticResource HistoricoValueLabel}"/>
                                        <TextBlock x:Name="DataCadastroTextBlock"
                                                   Style="{StaticResource HistoricoValueText}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[VehiclesLabel]}"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <ItemsControl x:Name="VeiculosItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Model]}"
                                                                   Style="{StaticResource HistoricoValueLabel}"/>
                                                        <TextBlock Text="{Binding Modelo}"
                                                                   Style="{StaticResource HistoricoValueText}"
                                                                   Margin="0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Plate]}"
                                                                   Style="{StaticResource HistoricoValueLabel}"/>
                                                        <TextBlock Text="{Binding Placa}"
                                                                   Style="{StaticResource HistoricoValueText}"
                                                                   Margin="0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Year]}"
                                                                   Style="{StaticResource HistoricoValueLabel}"/>
                                                        <TextBlock Text="{Binding Ano}"
                                                                   Style="{StaticResource HistoricoValueText}"
                                                                   Margin="0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Servicos Realizados"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <DataGrid x:Name="ServicosDataGrid"
                                          Height="280"
                                          Style="{StaticResource HistoricoDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Service]}"
                                                            Binding="{Binding Nome}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Date]}"
                                                            Binding="{Binding Data, StringFormat=dd/MM/yyyy}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Valor"
                                                            Binding="{Binding Valor, StringFormat=C2}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                            Binding="{Binding Status}"
                                                            Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[QuotesLabel]}"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <DataGrid x:Name="OrcamentosDataGrid"
                                          Height="180"
                                          Style="{StaticResource HistoricoDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Numero"
                                                            Binding="{Binding Numero}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Date]}"
                                                            Binding="{Binding Data, StringFormat=dd/MM/yyyy}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                            Binding="{Binding Status}"
                                                            Width="150"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Total]}"
                                                            Binding="{Binding Total, StringFormat=C2}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="Itens"
                                                            Binding="{Binding Itens}"
                                                            Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Ordens de Servico"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <DataGrid x:Name="OrdensServicoDataGrid"
                                          Height="180"
                                          Style="{StaticResource HistoricoDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Numero"
                                                            Binding="{Binding Numero}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Inbound]}"
                                                            Binding="{Binding Data, StringFormat=dd/MM/yyyy}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                            Binding="{Binding Status}"
                                                            Width="150"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Vehicle]}"
                                                            Binding="{Binding Veiculo}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Total]}"
                                                            Binding="{Binding Total, StringFormat=C2}"
                                                            Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Vendas"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <DataGrid x:Name="VendasDataGrid"
                                          Height="180"
                                          Style="{StaticResource HistoricoDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Date]}"
                                                            Binding="{Binding Data, StringFormat=dd/MM/yyyy}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Forma"
                                                            Binding="{Binding FormaPagamento}"
                                                            Width="140"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                            Binding="{Binding Status}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="Itens"
                                                            Binding="{Binding Itens}"
                                                            Width="80"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Total]}"
                                                            Binding="{Binding Total, StringFormat=C2}"
                                                            Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Pagamentos"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <ItemsControl x:Name="PagamentosItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Metodo}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="{Binding Vencimento, StringFormat=Venc: dd/MM/yyyy}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Valor, StringFormat=C2}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SuccessDarkBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Margin="0,4,0,0"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Debitos"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <ItemsControl x:Name="DebitosItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource DangerLightBrush}"
                                                    BorderBrush="{DynamicResource DangerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14"
                                                    Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Descricao}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerDarkBrush}"/>
                                                    <TextBlock Text="{Binding Valor, StringFormat=C2}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource DangerDarkBrush}"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Vencimento, StringFormat=Venc: dd/MM/yyyy}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource DangerDarkBrush}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Fotos e documentos"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <ItemsControl x:Name="DocumentosItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14"
                                                    Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Tipo}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Resumo}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Notes]}"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>
                                <TextBox x:Name="ObservacoesTextBox"
                                         Height="120"
                                         IsReadOnly="True"
                                         Style="{StaticResource MultiLineTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Timeline"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <ItemsControl x:Name="TimelineItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="40"
                                                        Height="40"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="20"
                                                        Margin="0,0,14,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Icone}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Titulo}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Descricao}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

