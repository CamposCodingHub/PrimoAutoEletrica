<Window x:Class="PrimoAutoEletrica.Views.ExternalAiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRIMOX External AI — Configuração Segura"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="IA Externa (fail-closed)"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Padrão: desabilitado. Segredo apenas via variável de ambiente / user store — nunca em plaintext no repositório ou neste formulário."/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Status:" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Margin="8,0,0,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <TextBlock x:Name="StatusTextBlock" Text="disabled"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                    </DockPanel>

                    <CheckBox x:Name="EnabledCheckBox"
                              Content="Habilitar provedor externo (explícito)"
                              Margin="0,0,0,10"
                              Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <CheckBox x:Name="KillSwitchCheckBox"
                              Content="Kill-switch (força fail-closed)"
                              Margin="0,0,0,14"
                              Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Nome do provedor" Margin="0,0,0,4"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="ProviderNameTextBox" Margin="0,0,0,10"
                             Style="{StaticResource PremiumTextBox}"/>

                    <TextBlock Text="Model id (opcional)" Margin="0,0,0,4"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="ModelIdTextBox" Margin="0,0,0,10"
                             Style="{StaticResource PremiumTextBox}"/>

                    <TextBlock Text="Nome da variável de ambiente da chave (NÃO a chave)"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="ApiKeyEnvVarTextBox" Margin="0,0,0,10"
                             Style="{StaticResource PremiumTextBox}"
                             IsReadOnly="True"/>

                    <TextBlock x:Name="SecretHintTextBlock" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="0,4,0,0"
                               Text="Chave: defina PRIMOX_EXTERNAL_AI_API_KEY no ambiente do usuário. Este campo nunca aceita o valor da chave."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click"/>
            <Button Content="Salvar" Width="110"
                    Style="{StaticResource PagePrimaryActionButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>