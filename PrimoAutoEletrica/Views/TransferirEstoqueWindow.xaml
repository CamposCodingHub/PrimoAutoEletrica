<Window x:Class="PrimoAutoEletrica.Views.TransferirEstoqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transferir estoque — localizacao"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
  <Border Style="{StaticResource ModalSurface}" Margin="16" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock x:Name="TituloText" Text="Transferir localizacao" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock x:Name="SubtituloText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Move o produto entre prateleira/local sem alterar a quantidade. Ideal para reorganizar a peca na oficina."/>
      </StackPanel>
      <StackPanel Grid.Row="1">
        <TextBlock Text="Localizacao" Style="{StaticResource ModalFieldLabel}"/>
        <TextBox x:Name="LocalizacaoTextBox" Margin="0,0,0,12"/>
        <TextBlock Text="Prateleira" Style="{StaticResource ModalFieldLabel}"/>
        <TextBox x:Name="PrateleiraTextBox" Margin="0,0,0,12"/>
        <TextBlock Text="Gaveta" Style="{StaticResource ModalFieldLabel}"/>
        <TextBox x:Name="GavetaTextBox" Margin="0,0,0,12"/>
        <TextBlock Text="Motivo / observacao" Style="{StaticResource ModalFieldLabel}"/>
        <TextBox x:Name="MotivoTextBox" Height="72" TextWrapping="Wrap" AcceptsReturn="True"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Width="120" Margin="0,0,10,0" Style="{StaticResource ModalSecondaryButton}" Click="CancelarButton_Click" Content="Cancelar"/>
        <Button Width="160" Style="{StaticResource ModalAccentButton}" Click="ConfirmarButton_Click" Content="Transferir"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
