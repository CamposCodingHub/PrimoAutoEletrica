<Window x:Class="PrimoAutoEletrica.Views.AssinaturaDigitalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assinatura digital"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="TituloTextBlock"
                               Text="Assinatura digital do cliente"
                               Style="{StaticResource ModalHeaderText}"/>
                    <TextBlock Text="Use mouse, touch ou caneta para assinar. A imagem sera salva com rastreabilidade local."
                               Style="{StaticResource ModalSubheaderText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="22">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="2"
                        CornerRadius="16"
                        ClipToBounds="True">
                    <InkCanvas x:Name="SignatureInkCanvas"
                               Background="{DynamicResource CardBackgroundBrush}"
                               EditingMode="Ink"
                               UseCustomCursor="True"/>
                </Border>

                <TextBlock x:Name="AjudaTextBlock"
                           Text="Assine dentro da area branca"
                           Foreground="#6B7280"
                           FontSize="18"
                           FontWeight="SemiBold"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18"
                    CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusTextBlock"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Nenhuma assinatura salva ainda."/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="Limpar"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="0,0,10,0"
                                Click="LimparButton_Click"/>
                        <Button Content="Cancelar"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="0,0,10,0"
                                Click="CancelarButton_Click"/>
                        <Button Content="Salvar assinatura"
                                Style="{StaticResource ModalAccentButton}"
                                Click="SalvarButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
