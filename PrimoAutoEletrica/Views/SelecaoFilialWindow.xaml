<Window x:Class="PrimoAutoEletrica.Views.SelecaoFilialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Selecionar Filial" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Selecione a filial para trabalhar:" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListView Grid.Row="1" Name="FiliaisListView" Margin="0,0,0,20" 
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding Codigo}" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding Cidade}" FontSize="12"/>
                        <TextBlock Text="{Binding Telefone}" FontSize="12" Foreground="DarkBlue"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}" Width="100" Height="30" Margin="0,0,10,0" Click="CancelarButton_Click"/>
            <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Confirm]}" Width="100" Height="30" Click="ConfirmarButton_Click"/>
        </StackPanel>
    </Grid>
</Window>