<Window x:Class="PrimoAutoEletrica.Views.AdminPasswordConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmação de Administrador"
        Height="380"
        Width="460"
        MinHeight="340"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Loaded="AdminPasswordConfirmationWindow_Loaded">

    <Border Style="{StaticResource ModalSurface}"
            Margin="16"
            Padding="0"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="16,16,0,0"
                    Padding="20,16">
                <TextBlock x:Name="TitleTextBlock"
                           Text="Confirmação de Administrador"
                           Style="{StaticResource ModalHeaderText}"
                           Foreground="{DynamicResource DangerBrush}"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel>
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Esta ação requer confirmação de senha de administrador."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="Senha do Administrador"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtSenhaConfirmacao"
                                 Style="{StaticResource PremiumPasswordBox}"
                                 AutomationProperties.Name="Senha de administrador"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}"
                    CornerRadius="0,0,16,16"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"
                            Style="{StaticResource ModalSecondaryButton}"
                            MinWidth="100"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnConfirmar"
                            Content="Confirmar"
                            Style="{StaticResource ModalDangerButton}"
                            MinWidth="120"
                            Margin="0"
                            IsDefault="True"
                            Click="BtnConfirmar_Click"
                            AutomationProperties.Name="Confirmar exclusão com senha de administrador"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
