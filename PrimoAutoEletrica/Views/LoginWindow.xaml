<Window x:Class="PrimoAutoEletrica.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRIMOX — Acesso"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="LoginCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusXL}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect" Value="{DynamicResource Elevation2}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource PremiumPasswordBox}"/>

        <Style x:Key="LoginLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource PrimoxFocusVisual}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Style="{StaticResource LoginCardStyle}">
            <Grid MaxWidth="420"
                  MinWidth="320"
                  MinHeight="480">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource NavyBrush}"
                        CornerRadius="16,16,0,0"
                        Padding="28,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Width="48"
                                    Height="48"
                                    Background="{DynamicResource BrandBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusMD}"
                                    Margin="0,0,0,14">
                                <TextBlock Text="PX"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentButtonTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="PRIMOX"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentButtonTextBrush}"/>
                            <TextBlock Text="Acesso à plataforma de operações"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource SidebarItemForegroundBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="36"
                                Height="36"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource AccentButtonTextBrush}"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                FocusVisualStyle="{StaticResource PrimoxFocusVisual}">
                            <Image Source="{StaticResource Icon.Close}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="28,28,28,20">
                    <TextBlock Text="Entrar"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Email"
                                   Style="{StaticResource ModalFieldLabel}"/>
                        <TextBox x:Name="EmailTextBox"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Senha"
                                   Style="{StaticResource ModalFieldLabel}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="SenhaPasswordBox"
                                         Grid.Column="0"
                                         Margin="0,0,10,0"
                                         PasswordChanged="SenhaPasswordBox_PasswordChanged"/>

                            <TextBox x:Name="SenhaTextBox"
                                     Grid.Column="0"
                                     Margin="0,0,10,0"
                                     Visibility="Collapsed"/>

                            <Button x:Name="MostrarSenhaButton"
                                    Grid.Column="1"
                                    Width="88"
                                    Style="{StaticResource ModalSecondaryButton}"
                                    ToolTip="Mostrar senha"
                                    Click="MostrarSenhaButton_Click">
                                <TextBlock Text="Mostrar"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="LembrarCheckBox"
                                  Grid.Column="0"
                                  Content="Lembrar usuario"
                                  FontSize="13"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"/>

                        <Button x:Name="EsqueciSenhaButton"
                                Grid.Column="1"
                                Style="{StaticResource LoginLinkButton}"
                                Click="EsqueciSenhaButton_Click">
                            Esqueci a senha
                        </Button>
                    </Grid>

                    <Button x:Name="LoginButton"
                            Style="{StaticResource ModalAccentButton}"
                            Height="44"
                            FontSize="15"
                            Click="LoginButton_Click">
                        Entrar
                    </Button>

                    <Border Margin="0,18,0,0"
                            Padding="12"
                            Background="{DynamicResource DangerCardBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusMD}"
                            Visibility="{Binding ElementName=ErrorMessageTextBlock, Path=Visibility}">
                        <TextBlock x:Name="ErrorMessageTextBlock"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="0,0,16,16"
                        Padding="20">
                    <TextBlock Text="Acesso restrito a usuarios autorizados"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
