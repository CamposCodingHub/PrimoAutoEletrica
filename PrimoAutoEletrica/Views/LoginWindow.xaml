<Window x:Class="PrimoAutoEletrica.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Primo Auto Eletrica"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="LoginCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A"
                                      Opacity="0.18"
                                      BlurRadius="28"
                                      ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource PremiumPasswordBox}"/>

        <Style x:Key="LoginLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Border Style="{StaticResource LoginCardStyle}">
            <Grid MaxWidth="440"
                  MinWidth="320"
                  MinHeight="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SecondaryDarkBrush}"
                        CornerRadius="22,22,0,0"
                        Padding="28,28,28,26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Width="64"
                                    Height="64"
                                    Background="{DynamicResource PrimaryBackgroundBrush}"
                                    CornerRadius="18"
                                    Margin="0,0,0,18">
                                <Image Source="{StaticResource Icon.PDV}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Primo Auto Eletrica"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentButtonTextBrush}"/>
                            <TextBlock Text="Acesso seguro ao ERP da oficina"
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource SidebarItemForegroundBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="44"
                                Height="44"
                                Background="{DynamicResource SecondaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource AccentButtonTextBrush}"
                                FontSize="16"
                                Cursor="Hand"
                                Click="CloseButton_Click">
                            <Image Source="{StaticResource Icon.Close}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="34,30,34,24">
                    <TextBlock Text="Acesso ao sistema"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Email"
                                   Style="{StaticResource ModalFieldLabel}"/>
                        <TextBox x:Name="EmailTextBox"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="Senha"
                                   Style="{StaticResource ModalFieldLabel}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="SenhaPasswordBox"
                                         Grid.Column="0"
                                         Margin="0,0,10,0"
                                         PasswordChanged="SenhaPasswordBox_PasswordChanged"/>

                            <TextBox x:Name="SenhaTextBox"
                                     Grid.Column="0"
                                     Margin="0,0,10,0"
                                     Visibility="Collapsed"/>

                            <Button x:Name="MostrarSenhaButton"
                                    Grid.Column="1"
                                    Width="96"
                                    Style="{StaticResource ModalSecondaryButton}"
                                    ToolTip="Mostrar senha"
                                    Click="MostrarSenhaButton_Click">
                                <TextBlock Text="Mostrar"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="LembrarCheckBox"
                                  Grid.Column="0"
                                  Content="Lembrar usuario"
                                  FontSize="13"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"/>

                        <Button x:Name="EsqueciSenhaButton"
                                Grid.Column="1"
                                Style="{StaticResource LoginLinkButton}"
                                Click="EsqueciSenhaButton_Click">
                            Esqueci a senha
                        </Button>
                    </Grid>

                    <Button x:Name="LoginButton"
                            Style="{StaticResource ModalAccentButton}"
                            Height="52"
                            FontSize="16"
                            Click="LoginButton_Click">
                        Entrar no sistema
                    </Button>

                    <Border Margin="0,22,0,0"
                            Padding="14"
                            Background="{DynamicResource DangerCardBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding ElementName=ErrorMessageTextBlock, Path=Visibility}">
                        <TextBlock x:Name="ErrorMessageTextBlock"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="0,0,22,22"
                        Padding="24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Acesso restrito a usuarios autorizados"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Primo Auto Eletrica"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
