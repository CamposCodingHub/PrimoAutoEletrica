<Window x:Class="PrimoAutoEletrica.Views.NovoOrcamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Novo Orcamento"
        MinWidth="1320"
        MinHeight="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
        <Style TargetType="DatePicker" BasedOn="{StaticResource PremiumDatePicker}"/>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>
        <Style TargetType="{x:Type primitives:DatePickerTextBox}" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style x:Key="OrcamentoDataGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource PremiumDataGrid}">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Novo Orcamento"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Monte a proposta comercial com cliente, itens, validade e previsao financeira."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Numero do orcamento"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding OrcamentoAtual.Numero}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Button Width="48"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Cancelar_Click">
                            X
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Cliente e status"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[ClientsTitle]}"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="ClienteComboBox"
                                                  Foreground="{DynamicResource InputForegroundBrush}"
                                                  Background="{DynamicResource InputBackgroundBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Veiculo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="VeiculoComboBox"
                                                  Foreground="{DynamicResource InputForegroundBrush}"
                                                  Background="{DynamicResource InputBackgroundBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,16,0,0">
                                        <TextBlock Text="Status comercial"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="StatusComboBox"
                                                  Foreground="{DynamicResource InputForegroundBrush}"
                                                  Background="{DynamicResource InputBackgroundBrush}">
                                            <ComboBoxItem Content="Rascunho"/>
                                            <ComboBoxItem Content="Enviado"/>
                                            <ComboBoxItem Content="Em Aberto"/>
                                            <ComboBoxItem Content="Aguardando Cliente"/>
                                            <ComboBoxItem Content="Em Negociacao"/>
                                            <ComboBoxItem Content="Aprovado"/>
                                            <ComboBoxItem Content="Recusado"/>
                                            <ComboBoxItem Content="Vencido"/>
                                            <ComboBoxItem Content="Convertido"/>
                                            <ComboBoxItem Content="Cancelado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Condicoes do orcamento"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Data de criacao"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <DatePicker x:Name="DataCriacaoDatePicker"
                                                    Foreground="{DynamicResource InputForegroundBrush}"
                                                    Background="{DynamicResource InputBackgroundBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0">
                                        <TextBlock Text="Data de validade"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <DatePicker x:Name="DataValidadeDatePicker"
                                                    Foreground="{DynamicResource InputForegroundBrush}"
                                                    Background="{DynamicResource InputBackgroundBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Prazo de entrega"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PrazoEntregaTextBox"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Condicoes de pagamento"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="CondicoesPagamentoTextBox"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Diagnostico tecnico"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="DiagnosticoTextBox"
                                             MinHeight="90"
                                             Style="{StaticResource MultiLineTextBox}"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Observacoes comerciais"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="ObservacoesTextBox"
                                             MinHeight="110"
                                             Style="{StaticResource MultiLineTextBox}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Itens do orcamento"
                                                   Style="{StaticResource ModalSectionTitle}"
                                                   FontSize="20"
                                                   Margin="0"/>
                                        <TextBlock Text="Adicione produtos, ajuste quantidade e acompanhe o subtotal em tempo real."
                                                   Style="{StaticResource ModalSubheaderText}"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <WrapPanel Grid.Row="1"
                                               Margin="0,14,0,0"
                                               HorizontalAlignment="Left">
                                        <Button Width="164"
                                                Margin="0,0,12,0"
                                                Style="{StaticResource ModalAccentButton}"
                                                Click="AdicionarProduto_Click">
                                            Adicionar produto
                                        </Button>

                                        <Button Width="176"
                                                Style="{StaticResource ModalSecondaryButton}"
                                                Click="AdicionarMaoDeObra_Click">
                                            Adicionar mao de obra
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <DataGrid x:Name="ItensDataGrid"
                                          MinHeight="280"
                                          Style="{StaticResource OrcamentoDataGridStyle}"
                                          CellEditEnding="ItensDataGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tipo"
                                                            Binding="{Binding TipoDescricao}"
                                                            Width="120"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Codigo"
                                                            Binding="{Binding ProdutoCodigo, UpdateSourceTrigger=LostFocus}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Item]}"
                                                            Binding="{Binding ProdutoNome, UpdateSourceTrigger=LostFocus}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Qty]}"
                                                            Binding="{Binding Quantidade, UpdateSourceTrigger=LostFocus}"
                                                            Width="80"/>
                                        <DataGridTextColumn Header="Preco Unit."
                                                            Binding="{Binding PrecoUnitario, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="Custo Unit."
                                                            Binding="{Binding PrecoCusto, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Discount]}"
                                                            Binding="{Binding Desconto, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Subtotal]}"
                                                            Binding="{Binding Subtotal, StringFormat=C}"
                                                            Width="120"/>
                                        <DataGridTemplateColumn Header="Acao"
                                                                Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Remover"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource ModalSecondaryButton}"
                                                            Height="34"
                                                            Padding="12,0"
                                                            Click="RemoverItem_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Resumo financeiro"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Subtotal]}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="SubtotalTextBlock"
                                               Grid.Column="1"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <TextBlock Grid.Row="1"
                                               Text="Tipo de desconto"
                                               Margin="0,14,0,8"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <ComboBox x:Name="DescontoTipoComboBox"
                                              Grid.Row="1"
                                              Grid.Column="1"
                                              Width="120"
                                              Margin="0,12,0,8"
                                              SelectionChanged="DescontoTipo_SelectionChanged">
                                        <ComboBoxItem Content="R$" Tag="Valor"/>
                                        <ComboBoxItem Content="%" Tag="Percentual"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2"
                                               Text="Desconto geral"
                                               Margin="0,6,0,8"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="DescontoTextBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             Width="120"
                                             Margin="0,4,0,8"
                                             TextChanged="Desconto_TextChanged"/>

                                    <TextBlock Grid.Row="3"
                                               Text="Acrescimo"
                                               Margin="0,6,0,8"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="AcrescimoTextBox"
                                             Grid.Row="3"
                                             Grid.Column="1"
                                             Width="120"
                                             Margin="0,4,0,8"
                                             TextChanged="Acrescimo_TextChanged"/>

                                    <TextBlock Grid.Row="4"
                                               Text="Margem estimada"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="MargemLucroTextBlock"
                                               Grid.Row="4"
                                               Grid.Column="1"
                                               Margin="0,8,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>

                                    <Border Grid.Row="5"
                                            Grid.ColumnSpan="2"
                                            Margin="0,18,0,0"
                                            Padding="16"
                                            Background="{DynamicResource PrimaryBackgroundBrush}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Text="Total previsto"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                            <TextBlock x:Name="TotalTextBlock"
                                                       Margin="0,6,0,0"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Indicadores comerciais"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Lucro estimado"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="LucroEstimadoTextBlock"
                                               Grid.Column="1"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>

                                    <TextBlock Grid.Row="1"
                                               Text="Comissao do vendedor"
                                               Margin="0,14,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="ComissaoTextBlock"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,14,0,0"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Regras do fluxo"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>
                                <TextBlock Text="Salvar rascunho preserva o orcamento em aberto para ajuste posterior."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Salvar definitivo respeita o status comercial selecionado na tela."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="Os totais sao recalculados automaticamente a cada alteracao de item ou desconto."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="120"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="Cancelar_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"/>
                    <Button Width="160"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="SalvarRascunho_Click">
                        Salvar rascunho
                    </Button>
                    <Button Width="170"
                            Style="{StaticResource ModalAccentButton}"
                            Click="Salvar_Click">
                        Salvar orcamento
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
