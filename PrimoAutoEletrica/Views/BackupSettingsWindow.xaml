<Window x:Class="PrimoAutoEletrica.Views.BackupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configurações de Backup" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Configurações de Backup" 
                   FontSize="20" 
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryBrush}"
                   Margin="0,0,0,20"/>

        <!-- Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Auto Backup -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Backup Automático" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="AutoBackupEnabledCheckBox" 
                                  Content="Habilitar backup automático" 
                                  Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Frequência:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="FrequencyComboBox" Grid.Column="1" Height="30">
                                <ComboBoxItem Content="Diário" Tag="daily"/>
                                <ComboBoxItem Content="Semanal" Tag="weekly"/>
                                <ComboBoxItem Content="Mensal" Tag="monthly"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Horário:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="BackupTimeTextBox" Grid.Column="1" Text="02:00" Height="30"/>
                        </Grid>

                        <CheckBox x:Name="BeforeUpdateCheckBox" 
                                  Content="Backup antes de atualizações" 
                                  Margin="0,0,0,5"/>
                        
                        <CheckBox x:Name="BeforeMigrationCheckBox" 
                                  Content="Backup antes de migrações" 
                                  Margin="0,0,0,5"/>
                        
                        <CheckBox x:Name="IncludeMediaCheckBox" 
                                  Content="Incluir arquivos de mídia" 
                                  IsChecked="True"/>
                    </StackPanel>
                </Border>

                <!-- External Backup -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Backup Externo" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="ExternalBackupEnabledCheckBox" 
                                  Content="Habilitar backup externo" 
                                  Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Destino:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="ExternalPathTextBox" Grid.Column="1" Height="30"/>
                            <Button x:Name="BrowseButton" Grid.Column="2" Content="..." Width="40" Height="30" Margin="5,0,0,0"/>
                        </Grid>

                        <CheckBox x:Name="SyncCloudCheckBox" 
                                  Content="Sincronizar com nuvem" 
                                  Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Provedor:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CloudProviderComboBox" Grid.Column="1" Height="30">
                                <ComboBoxItem Content="Nenhum" Tag="none"/>
                                <ComboBoxItem Content="OneDrive" Tag="onedrive"/>
                                <ComboBoxItem Content="Google Drive" Tag="googledrive"/>
                                <ComboBoxItem Content="Dropbox" Tag="dropbox"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="EncryptBackupCheckBox" 
                                  Content="Criptografar backup" 
                                  Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>

                <!-- Compression -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Compactação" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="CompressionEnabledCheckBox" 
                                  Content="Habilitar compactação" 
                                  IsChecked="True"
                                  Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nível:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CompressionLevelComboBox" Grid.Column="1" Height="30">
                                <ComboBoxItem Content="Rápido" Tag="fast"/>
                                <ComboBoxItem Content="Normal" Tag="normal" IsSelected="True"/>
                                <ComboBoxItem Content="Máximo" Tag="maximum"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Retention -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Política de Retenção" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Backups diários:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="DailyRetentionTextBox" Grid.Column="1" Text="30" Height="30"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Backups semanais:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="WeeklyRetentionTextBox" Grid.Column="1" Text="12" Height="30"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Backups mensais:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="MonthlyRetentionTextBox" Grid.Column="1" Text="6" Height="30"/>
                        </Grid>

                        <CheckBox x:Name="AutoCleanCheckBox" 
                                  Content="Limpeza automática" 
                                  IsChecked="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="TestBackupButton" 
                    Content="Testar Backup" 
                    Width="120" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Click="TestBackupButton_Click"/>
            
            <Button x:Name="SaveButton" 
                    Content="Salvar" 
                    Width="100" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            
            <Button x:Name="CancelButton" 
                    Content="Cancelar" 
                    Width="100" 
                    Height="35" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
