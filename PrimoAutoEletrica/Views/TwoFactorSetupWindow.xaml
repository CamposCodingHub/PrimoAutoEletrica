<Window x:Class="PrimoAutoEletrica.Views.TwoFactorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autenticação de Dois Fatores (2FA)"
        Width="480" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔐 Configurar Autenticação de Dois Fatores"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Proteja sua conta com um segundo fator de autenticação."
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Passo 1: Instrução -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Passo 1: Instale um aplicativo autenticador"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    Instale o Google Authenticator, Microsoft Authenticator ou Authy no seu celular.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Passo 2: Chave secreta -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Passo 2: Adicione esta chave ao aplicativo"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Copie a chave abaixo e adicione manualmente no seu app autenticador:"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,8"/>
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtSecretKey"
                                   Text="CARREGANDO..."
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="📋 Copiar"
                                Click="BtnCopyKey_Click"
                                Padding="8,4"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Background="{DynamicResource SecondaryBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Passo 3: URL otpauth (para QR Code futuro) -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Passo 3: Ou use o link direto"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="txtOtpUrl"
                           Text="" FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Passo 4: Verificação -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Passo 4: Confirme o código de 6 dígitos"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Digite o código exibido no seu app autenticador:"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="txtVerificationCode"
                         MaxLength="6"
                         FontSize="28"
                         FontFamily="Consolas"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         Height="50"
                         Foreground="{DynamicResource InputForegroundBrush}"
                         Background="{DynamicResource InputBackgroundBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Aviso -->
        <Border Grid.Row="5" Background="{DynamicResource WarningCardBackgroundBrush}"
                CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <TextBlock Text="⚠️ Guarde sua chave secreta em local seguro. Sem ela, você não poderá recuperar o acesso à sua conta caso perca o celular."
                       FontSize="11"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"
                    Width="120" Height="38"
                    Click="BtnCancel_Click"
                    Margin="0,0,10,0"
                    Background="{DynamicResource SecondaryBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button x:Name="btnVerify" Content="✅ Verificar e Ativar"
                    Width="180" Height="38"
                    Click="BtnVerify_Click"
                    Background="{DynamicResource SuccessBrush}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="7" x:Name="txtStatus"
                   Text=""
                   FontSize="12"
                   Foreground="{DynamicResource DangerBrush}"
                   VerticalAlignment="Bottom"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>
