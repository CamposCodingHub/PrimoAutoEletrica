<Window x:Class="PrimoAutoEletrica.Views.Produto360Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produto 360 — PRIMOX"
        MinWidth="720"
        MinHeight="520"
        Width="820"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Produto 360"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock x:Name="SubheaderTextBlock"
                                   Text="Estoque, margem e uso comprovado em OS por ProdutoId."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            MinWidth="110"
                            Style="{StaticResource ModalSecondaryButton}"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Close]}"
                            Click="FecharButton_Click"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <StackPanel>
                    <Border Style="{StaticResource ModalSectionCard}">
                        <StackPanel>
                            <TextBlock x:Name="TituloTextBlock"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="CodigoTextBlock"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,12"/>
                            <TextBlock x:Name="HubTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Style="{StaticResource ModalSidebarCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Estoque" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="EstoqueTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ModalSidebarCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Margem" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="MargemTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Uso em OS" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="UsoOsTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource ModalSectionCard}">
                        <StackPanel>
                            <TextBlock Text="Comercial"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="16"
                                       Margin="0,0,0,12"/>
                            <TextBlock x:Name="ComercialTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModalSectionCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="OS onde o produto foi utilizado"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="16"
                                       Margin="0,0,0,12"/>
                            <TextBlock x:Name="OsIdsTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}"
                    CornerRadius="0,0,18,18"
                    Padding="24,16">
                <TextBlock x:Name="NotaTextBlock"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Vínculo OS somente por ProdutoId. Sem matching textual."/>
            </Border>
        </Grid>
    </Border>
</Window>
