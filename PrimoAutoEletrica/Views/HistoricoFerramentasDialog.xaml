<Window x:Class="PrimoAutoEletrica.Views.HistoricoFerramentasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de Movimentações — Ferramentaria"
        Width="1050"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="14"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecalho -->
            <Border Grid.Row="0"
                    Padding="20,16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Auditoria &amp; Histórico de Movimentações"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Rastreabilidade completa de saídas, devoluções, técnicos responsáveis e estado de conservação."
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="FecharButton_Click"
                            Style="{StaticResource FilterActionButton}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Tabela de Historico -->
            <Border Grid.Row="1"
                    Margin="16">
                <DataGrid x:Name="HistoricoDataGrid"
                          Style="{StaticResource PremiumDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Patrimônio" Binding="{Binding CodigoPatrimonio}" FontWeight="Bold" Width="100"/>
                        <DataGridTextColumn Header="Ferramenta" Binding="{Binding FerramentaNome}" FontWeight="SemiBold" Width="1.8*"/>
                        <DataGridTextColumn Header="Técnico" Binding="{Binding FuncionarioNome}" Width="1.3*"/>
                        <DataGridTextColumn Header="OS Vinculada" Binding="{Binding NumeroOS}" Width="105"/>
                        <DataGridTextColumn Header="Data Retirada" Binding="{Binding DataRetirada, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="Data Devolução" Binding="{Binding DataDevolucao, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="Est. Retirada" Binding="{Binding EstadoConservacaoRetirada}" Width="100"/>
                        <DataGridTextColumn Header="Est. Devolução" Binding="{Binding EstadoConservacaoDevolucao}" Width="120"/>
                        <DataGridTextColumn Header="Observação Devolução" Binding="{Binding ObservacaoDevolucao}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Rodape -->
            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Fechar"
                            Width="120"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="FecharButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
