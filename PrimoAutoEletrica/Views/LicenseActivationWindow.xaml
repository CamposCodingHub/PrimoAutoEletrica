<Window x:Class="PrimoAutoEletrica.Views.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ativação de Licença" 
        MinHeight="400" 
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Ativação de Licença" 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="Digite sua chave de licença para ativar o sistema" 
                       FontSize="12" 
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Chave de Licença" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="LicenseKeyTextBox" 
                     Height="35" 
                     Margin="0,0,0,15"
                     CharacterCasing="Upper"/>

            <TextBlock Text="Nome da Empresa" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CompanyNameTextBox" 
                     Height="35" 
                     Margin="0,0,0,15"/>

            <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Cnpj]}" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CnpjTextBox" 
                     Height="35" 
                     Margin="0,0,0,15"/>

            <TextBlock x:Name="HardwareIdText" 
                       Text="Hardware ID: XXXX" 
                       FontSize="11" 
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="ActivateButton" 
                    Content="Ativar" 
                    Width="100" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Click="ActivateButton_Click"/>
            
            <Button x:Name="CancelButton" 
                    Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}" 
                    Width="100" 
                    Height="35" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
