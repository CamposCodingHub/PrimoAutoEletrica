<Window x:Class="PrimoAutoEletrica.Views.ConfirmacaoCriticaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmacao critica"
        MinWidth="980"
        MinHeight="700"
        ShowActivated="True"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmationTextBox}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="HeaderTextBlock"
                                   Text="Revise antes de continuar"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Esta tela existe para evitar perda acidental de dados em operacoes sensiveis."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="CancelarButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Resumo da acao"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"/>
                                <TextBlock x:Name="SummaryTextBlock"
                                           Margin="0,12,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Dados revisados"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"/>
                                <TextBlock x:Name="DetailsTextBlock"
                                           Margin="0,12,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Confirmacao manual"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"/>
                                <TextBlock Text="Digite no campo abaixo a palavra obrigatoria para liberar a exclusao. O campo aceita teclado normalmente."
                                           Style="{StaticResource ModalSubheaderText}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="KeywordHintTextBlock"
                                           Margin="0,16,0,8"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>

                                <TextBox x:Name="ConfirmationTextBox"
                                         Height="Auto"
                                         MinHeight="48"
                                         FontSize="20"
                                         FontWeight="SemiBold"
                                         Padding="14,10"
                                         IsReadOnly="False"
                                         IsEnabled="True"
                                         Focusable="True"
                                         IsTabStop="True"
                                         IsHitTestVisible="True"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Left"
                                         CaretBrush="{DynamicResource InputForegroundBrush}"
                                         Foreground="{DynamicResource InputForegroundBrush}"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         BorderBrush="{DynamicResource InputFocusBorderBrush}"
                                         BorderThickness="2"
                                         AutomationProperties.Name="Campo de confirmacao"
                                         PreviewMouseLeftButtonDown="ConfirmationTextBox_PreviewMouseLeftButtonDown"
                                         TextChanged="ConfirmationTextBox_TextChanged"/>
                                <TextBlock x:Name="ValidationTextBlock"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Impacto esperado"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>
                                <TextBlock x:Name="ImpactTextBlock"
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Checklist rapido"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>
                                <TextBlock Text="1. Confirme se este e o registro correto."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="2. Revise o impacto descrito ao lado antes de prosseguir."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="3. Digite a palavra obrigatoria apenas se quiser concluir a acao agora."
                                           Style="{StaticResource ModalSubheaderText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="140"
                            Margin="0,0,10,0"
                            Style="{StaticResource ConfirmCancelButton}"
                            IsCancel="True"
                            Click="CancelarButton_Click">
                        Voltar
                    </Button>
                    <Button x:Name="ConfirmarButton"
                            Width="220"
                            Style="{StaticResource ConfirmDangerButton}"
                            Click="ConfirmarButton_Click"
                            IsDefault="True"
                            IsEnabled="False" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Confirm]}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>



