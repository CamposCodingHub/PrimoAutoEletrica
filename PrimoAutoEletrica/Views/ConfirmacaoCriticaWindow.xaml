<Window x:Class="PrimoAutoEletrica.Views.ConfirmacaoCriticaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmacao critica"
        Width="560"
        MinWidth="480"
        SizeToContent="Height"
        ShowActivated="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="420">
                        <TextBlock x:Name="HeaderTextBlock"
                                   Text="Revise antes de continuar"
                                   Style="{StaticResource ModalHeaderText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="SummaryTextBlock"
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="CancelarButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,8">
                <TextBlock x:Name="DetailsTextBlock"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="ImpactTextBlock"
                           Style="{StaticResource ModalSubheaderText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Para confirmar, digite a palavra abaixo neste campo:"
                           Style="{StaticResource ModalFieldLabel}"
                           TextWrapping="Wrap"/>

                <Border Background="{DynamicResource DangerCardBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,8"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Palavra:"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="KeywordTextBlock"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid MinHeight="52">
                    <TextBox x:Name="ConfirmationTextBox"
                             Style="{x:Null}"
                             Height="52"
                             MinHeight="52"
                             FontSize="22"
                             FontWeight="SemiBold"
                             Padding="14,10"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             AcceptsReturn="False"
                             AcceptsTab="False"
                             IsReadOnly="False"
                             IsEnabled="True"
                             Focusable="True"
                             IsTabStop="True"
                             IsUndoEnabled="True"
                             FocusVisualStyle="{x:Null}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource InputForegroundBrush}"
                             CaretBrush="{DynamicResource InputForegroundBrush}"
                             SelectionBrush="{DynamicResource PrimaryBrush}"
                             BorderBrush="{DynamicResource InputFocusBorderBrush}"
                             BorderThickness="2"
                             AutomationProperties.Name="Campo para digitar a palavra de confirmacao"
                             TextChanged="ConfirmationTextBox_TextChanged"/>
                    <TextBlock x:Name="PlaceholderTextBlock"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontSize="16"
                               Foreground="{DynamicResource InputPlaceholderBrush}"
                               Text="Clique aqui e digite a palavra"/>
                </Grid>

                <TextBlock x:Name="ValidationTextBlock"
                           Foreground="{DynamicResource DangerBrush}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="140"
                            Margin="0,0,10,0"
                            Style="{StaticResource ConfirmCancelButton}"
                            IsCancel="True"
                            Click="CancelarButton_Click">
                        Voltar
                    </Button>
                    <Button x:Name="ConfirmarButton"
                            Width="200"
                            Style="{StaticResource ConfirmDangerButton}"
                            Click="ConfirmarButton_Click"
                            IsDefault="False"
                            IsEnabled="False"
                            Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Confirm]}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
