<Window x:Class="PrimoAutoEletrica.Views.ConfirmacaoCriticaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmacao critica"
        Width="560"
        Height="560"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="16"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="16,16,0,0"
                    Padding="20,16">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="420">
                        <TextBlock x:Name="HeaderTextBlock"
                                   Text="Revise antes de continuar"
                                   Style="{StaticResource ModalHeaderText}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Digite a palavra obrigatoria para confirmar esta acao sensivel."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="CancelarButton_Click"
                            VerticalAlignment="Top">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">
                <StackPanel Margin="24,18">
                    <TextBlock Text="Resumo"
                               Style="{StaticResource ModalFieldLabel}"/>
                    <TextBlock x:Name="SummaryTextBlock"
                               Margin="0,4,0,14"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Detalhes"
                               Style="{StaticResource ModalFieldLabel}"/>
                    <TextBlock x:Name="DetailsTextBlock"
                               Margin="0,4,0,14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MaxHeight="96"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="Impacto"
                               Style="{StaticResource ModalFieldLabel}"/>
                    <TextBlock x:Name="ImpactTextBlock"
                               Margin="0,4,0,16"
                               Style="{StaticResource ModalSubheaderText}"
                               TextWrapping="Wrap"
                               MaxHeight="72"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Palavra obrigatoria"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="KeywordTextBlock"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,6,0,0"
                                       AutomationProperties.Name="Palavra obrigatoria da confirmacao"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Digite a palavra acima"
                               Style="{StaticResource ModalFieldLabel}"/>
                    <TextBox x:Name="ConfirmationTextBox"
                             Margin="0,6,0,0"
                             MinHeight="36"
                             FontSize="16"
                             FontWeight="SemiBold"
                             TextChanged="ConfirmationTextBox_TextChanged"
                             AutomationProperties.Name="Campo de digitacao da palavra de confirmacao"/>
                    <TextBlock x:Name="ValidationTextBlock"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}"
                    CornerRadius="0,0,16,16"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="120"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="CancelarButton_Click"
                            IsCancel="True">
                        Voltar
                    </Button>
                    <Button x:Name="ConfirmarButton"
                            Width="180"
                            Style="{StaticResource PageDangerActionButton}"
                            Click="ConfirmarButton_Click"
                            IsEnabled="False"
                            IsDefault="True"
                            Content="Confirmar"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
