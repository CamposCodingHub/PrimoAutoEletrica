<Window x:Class="PrimoAutoEletrica.Views.SelecionarVendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Selecionar venda"
        Height="560"
        Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="VendaDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="VendaDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#3730A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VendaDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="HeaderTextBlock"
                               Text="Selecionar venda"
                               Style="{StaticResource ModalHeaderText}"/>
                    <TextBlock x:Name="SubheaderTextBlock"
                               Text="Escolha uma venda recente para continuar a operacao no PDV."
                               Style="{StaticResource ModalSubheaderText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="24">
                <DataGrid x:Name="VendasDataGrid"
                          Background="{DynamicResource CardBackgroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          RowBackground="{DynamicResource CardBackgroundBrush}"
                          AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="13"
                          ColumnHeaderStyle="{StaticResource VendaDataGridHeaderStyle}"
                          RowStyle="{StaticResource VendaDataGridRowStyle}"
                          CellStyle="{StaticResource VendaDataGridCellStyle}"
                          MouseDoubleClick="VendasDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Cliente"
                                            Binding="{Binding Cliente.Nome}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Forma"
                                            Binding="{Binding FormaPagamento}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Itens"
                                            Binding="{Binding Itens.Count}"
                                            Width="70"/>
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding Total, StringFormat=C}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="120"
                            Style="{StaticResource ModalSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="Cancelar_Click">
                        Cancelar
                    </Button>
                    <Button x:Name="SelecionarButton"
                            Width="180"
                            Style="{StaticResource ModalAccentButton}"
                            Click="Selecionar_Click">
                        Selecionar venda
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
