<Window x:Class="PrimoAutoEletrica.Views.SelecionarProdutoPDVWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar produto"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        MaxWidth="1280"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Selecionar produto"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Busque no estoque por nome, código, SKU, código de barras, marca ou categoria."
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Close]}"
                        Width="100"
                        Height="38"
                        Style="{StaticResource PageSecondaryActionButton}"
                        Click="FecharButton_Click"/>
            </Grid>
        </Border>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Margin="20,18,20,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="BuscaTextBox"
                         Grid.Column="0"
                         Height="40"
                         Margin="0,0,12,0"
                         Style="{StaticResource SearchBox}"
                         Tag="{Binding Source={StaticResource LocalizationHelper}, Path=SearchPlaceholder}"
                         ToolTip="Digite nome, código, SKU, código de barras, marca ou categoria"
                         TextChanged="BuscaTextBox_TextChanged"
                         KeyDown="BuscaTextBox_KeyDown"/>

                <ComboBox x:Name="CategoriaComboBox"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          Height="42"
                          SelectionChanged="CategoriaComboBox_SelectionChanged"/>

                <ComboBox x:Name="StatusComboBox"
                          Grid.Column="2"
                          Margin="12,0,0,0"
                          Height="42"
                          SelectionChanged="StatusComboBox_SelectionChanged"/>

                <Button Grid.Column="3"
                        Content="Limpar"
                        Width="90"
                        Height="42"
                        Margin="12,0,0,0"
                        Style="{StaticResource PageSecondaryActionButton}"
                        Click="LimparFiltrosButton_Click"/>
            </Grid>
        </Border>

        <!-- TABELA -->
        <Border Grid.Row="2"
                Margin="20,0,20,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ResumoTextBlock"
                               Text="Produtos encontrados: 0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Grid.Column="1"
                               Text="Dica: d� duplo clique para adicionar ao carrinho"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>

                <DataGrid x:Name="ProdutosDataGrid"
                          Grid.Row="1"
                          Style="{StaticResource PremiumDataGrid}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AutoGenerateColumns="False"
                          MouseDoubleClick="ProdutosDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="C�digo"
                                            Width="110"
                                            Binding="{Binding Codigo}"/>

                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Part]}"
                                            Width="260"
                                            Binding="{Binding Nome}"/>

                        <DataGridTextColumn Header="Categoria"
                                            Width="140"
                                            Binding="{Binding Categoria}"/>

                        <DataGridTextColumn Header="Marca"
                                            Width="130"
                                            Binding="{Binding Marca}"/>

                        <DataGridTextColumn Header="SKU"
                                            Width="130"
                                            Binding="{Binding SKU}"/>

                        <DataGridTextColumn Header="C�digo barras"
                                            Width="150"
                                            Binding="{Binding CodigoBarras}"/>

                        <DataGridTextColumn Header="Dispon�vel"
                                            Width="100"
                                            Binding="{Binding QuantidadeDisponivel, Mode=OneWay}"/>

                        <DataGridTextColumn Header="Pre�o"
                                            Width="110"
                                            Binding="{Binding PrecoVenda, StringFormat=C2}"/>

                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Supplier]}"
                                            Width="180"
                                            Binding="{Binding Fornecedor}"/>

                        <DataGridTemplateColumn Header="A��o"
                                                Width="130"
                                                MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Adicionar"
                                            Height="32"
                                            Width="100"
                                            Style="{StaticResource TableActionButton}"
                                            Background="{DynamicResource SuccessBrush}"
                                            BorderBrush="{DynamicResource SuccessBrush}"
                                            Foreground="{DynamicResource AccentButtonTextBrush}"
                                            Click="AdicionarLinhaButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- RODAP� -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Enter adiciona o produto selecionado. Esc fecha a janela."
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <Button Grid.Column="1"
                        Content="Adicionar e continuar"
                        Width="170"
                        Height="42"
                        Margin="0,0,10,0"
                        Style="{StaticResource PageSuccessActionButton}"
                        Click="AdicionarContinuarButton_Click"/>

                <Button Grid.Column="2"
                        Content="Adicionar e fechar"
                        Width="160"
                        Height="42"
                        Margin="0,0,10,0"
                        Style="{StaticResource PagePrimaryActionButton}"
                        Click="AdicionarFecharButton_Click"/>

                <Button Grid.Column="3"
                        Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"
                        Width="110"
                        Height="42"
                        Style="{StaticResource PageSecondaryActionButton}"
                        Click="FecharButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>


