<Window x:Class="PrimoAutoEletrica.Views.NovoFornecedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Novo Fornecedor"
        MinHeight="860"
        MinWidth="1220"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Novo Fornecedor"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Cadastro operacional com parceiro principal, contato comercial, prazo e historico de abastecimento."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ModalCloseButton}"
                            Click="FecharButton_Click">
                        <Image Source="{StaticResource Icon.Close}" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Dados cadastrais"
                                           Style="{StaticResource ModalSectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Razao social *"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="RazaoSocialTextBox" MaxLength="120"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Nome fantasia *"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NomeFantasiaTextBox" MaxLength="120"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="CPF/CNPJ"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CNPJTextBox" MaxLength="18"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Inscricao estadual"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="InscricaoEstadualTextBox" MaxLength="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Categoria"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="CategoriaComboBox">
                                            <ComboBoxItem Content="Peças"/>
                                            <ComboBoxItem Content="Serviços"/>
                                            <ComboBoxItem Content="Materiais"/>
                                            <ComboBoxItem Content="Equipamentos"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Site"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="SiteTextBox" MaxLength="120"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Contato comercial"
                                           Style="{StaticResource ModalSectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Telefone"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="TelefoneTextBox" MaxLength="20"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Celular"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CelularTextBox" MaxLength="20"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,0,0,16">
                                        <TextBlock Text="Email"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="EmailTextBox" MaxLength="120"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="2">
                                        <TextBlock Text="WhatsApp do vendedor"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="WhatsAppVendedorTextBox" MaxLength="20"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Contato principal"
                                           Style="{StaticResource ModalSectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                     </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Nome do contato"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalNomeTextBox" MaxLength="80"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Cargo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalCargoTextBox" MaxLength="60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Telefone direto"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalTelefoneTextBox" MaxLength="20"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Email do contato"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalEmailTextBox" MaxLength="120"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Endereco"
                                           Style="{StaticResource ModalSectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="CEP"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CEPTextBox" MaxLength="10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Rua"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="RuaTextBox" MaxLength="120"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Numero"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NumeroTextBox" MaxLength="20"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Bairro"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="BairroTextBox" MaxLength="80"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,12,0">
                                        <TextBlock Text="Cidade"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CidadeTextBox" MaxLength="80"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="UF"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="EstadoTextBox" MaxLength="2"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Condicoes comerciais"
                                           Style="{StaticResource ModalSectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Forma de pagamento"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="FormaPagamentoComboBox">
                                            <ComboBoxItem Content="À vista"/>
                                            <ComboBoxItem Content="Boleto"/>
                                            <ComboBoxItem Content="Cartão de crédito"/>
                                            <ComboBoxItem Content="PIX"/>
                                            <ComboBoxItem Content="Transferência"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Prazo de pagamento"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PrazoPagamentoTextBox"
                                                 Text="30 dias"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Pedido minimo (R$)"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PedidoMinimoTextBox"
                                                 Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Prazo medio de entrega (dias)"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PrazoMedioEntregaTextBox"
                                                 Text="0"/>
                                    </StackPanel>

                                     <StackPanel Grid.Row="1"
                                                 Grid.Column="1"
                                                 Margin="12,0,12,0">
                                        <TextBlock Text="Prazo medio de pagamento (dias)"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PrazoMedioPagamentoTextBox"
                                                 Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Categoria preferencial"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CategoriaPreferencialTextBox" MaxLength="60"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="20,0,0,0">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Avaliacao"
                                           Style="{StaticResource ModalSidebarTitle}"/>

                                <TextBlock Text="Nota (1-5)"
                                           Style="{StaticResource ModalFieldLabel}"
                                           Margin="0,16,0,0"/>
                                <ComboBox x:Name="NotaComboBox">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5" IsSelected="True"/>
                                </ComboBox>

                                <TextBlock Text="Observacoes"
                                           Style="{StaticResource ModalFieldLabel}"
                                           Margin="0,18,0,0"/>
                                <TextBox x:Name="ObservacoesTextBox"
                                         Height="160"
                                         Style="{StaticResource MultiLineTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Status"
                                           Style="{StaticResource ModalSidebarTitle}"/>
                                <CheckBox x:Name="AtivoCheckBox"
                                          Content="Fornecedor ativo"
                                          FontSize="15"
                                          Margin="0,16,0,0"
                                          IsChecked="True"/>
                                <TextBlock Text="Fornecedores inativos ficam sinalizados no ranking e nos alertas operacionais."
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource ModalSubheaderText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="140"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="CancelarButton_Click">
                        Cancelar
                    </Button>

                    <Button Width="220"
                            Style="{StaticResource ModalAccentButton}"
                            Click="SalvarButton_Click">
                        Salvar fornecedor
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

