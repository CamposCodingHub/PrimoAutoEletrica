<Window x:Class="PrimoAutoEletrica.Views.OrcamentosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrimoAutoEletrica.Views"
        mc:Ignorable="d"
        Title="Orcamentos - Central Inteligente"
        MinHeight="940"
        MinWidth="1600"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ModalSurface}"
                Padding="24"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <TextBlock Text="Orcamentos"
                               Style="{StaticResource ModalHeaderText}"
                               FontSize="30"/>
                    <TextBlock Text="|"
                               FontSize="22"
                               Foreground="{DynamicResource DividerBrush}"
                               Margin="10,0"/>
                    <TextBlock Text="Usuario:"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding UsuarioLogado}"
                               Margin="6,0,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="|"
                               FontSize="18"
                               Foreground="{DynamicResource DividerBrush}"
                               Margin="12,0"/>
                    <TextBlock Text="{Binding DataAtual}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding HoraAtual}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[NewQuote]}"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalAccentButton}"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Duplicate]}"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[ExportPdf]}"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Print]}"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"/>
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[WhatsApp]}"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"/>
                    <Button Content="Email"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"/>
                    <Button Content="Converter em venda"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"/>
                    <Button Content="Salvar rascunho"
                            Style="{StaticResource ModalSecondaryButton}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:OrcamentosDashboardControl Grid.Row="0"/>

            <Border Grid.Row="1"
                    Style="{StaticResource ModalSectionCard}"
                    Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Central comercial"
                                   Style="{StaticResource ModalSectionTitle}"
                                   FontSize="20"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="Esta tela concentra os atalhos de orcamentos, dashboard e proximas etapas de conversao para venda ou OS."
                                   Style="{StaticResource ModalSubheaderText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="A base funcional continua validada pelos testes automatizados enquanto a interface vai sendo consolidada no padrao global."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Status atual"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="Dashboard operacional ativo"
                                           Margin="0,6,0,0"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryDarkBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Proximo passo"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Continuar integracao da central com pesquisa, carrinho, historico e relatorios comerciais."
                                           Margin="0,6,0,0"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

