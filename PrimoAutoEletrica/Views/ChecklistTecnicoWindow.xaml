<Window x:Class="PrimoAutoEletrica.Views.ChecklistTecnicoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Checklist Técnico Multiponto — Autoelétrica"
        MinWidth="1100"
        MinHeight="680"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="16"
            Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="16,16,0,0"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Checklist Técnico Multiponto — Autoelétrica 2.0"
                                   Style="{StaticResource ModalHeaderText}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="ContextoSubheaderText"
                                   Style="{StaticResource ModalSubheaderText}"
                                   Text="Inspeção física, medições elétricas 12V/24V, verificação antes/depois e laudo auditável."
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OS: "
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="OsNumeroTextBlock"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="Sistema: "
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="TensaoContextoTextBlock"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="Status: "
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="StatusGeralTextBlock"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Width="40"
                                Height="40"
                                Style="{StaticResource ModalCloseButton}"
                                Content="✕"
                                Click="FecharButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY CONTENT -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- METRICS & PROGRESS BAR -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Progresso da Inspeção:"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ProgressBar x:Name="ChecklistProgressBar"
                                         Width="220"
                                         Height="14"
                                         VerticalAlignment="Center"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,0,10,0"/>
                            <TextBlock x:Name="PercentualText"
                                       Text="0%"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,24,0"/>

                            <Border Background="#2E7D32" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock x:Name="BadgeOkText" Text="OK: 0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#ED6C02" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock x:Name="BadgeAtencaoText" Text="Atenção: 0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#D32F2F" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock x:Name="BadgeCriticoText" Text="Crítico: 0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#607D8B" CornerRadius="6" Padding="8,4">
                                <TextBlock x:Name="BadgePendentesText" Text="Pendentes: 0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Técnico:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="TecnicoTextBox"
                                     Width="180"
                                     Height="32"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TOOLBAR & FILTROS -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Filtrar Seção:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="SecaoFilterComboBox"
                                  Width="200"
                                  Height="32"
                                  SelectionChanged="SecaoFilterComboBox_SelectionChanged"/>
                        <Button Content="Todos OK"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="12,0,0,0"
                                Height="32"
                                Padding="10,4"
                                Click="MarcarTodosOkButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AbrirDiagnosticoGuiadoButton"
                                Content="Abrir Roteiro D01-D06"
                                Style="{StaticResource ModalSecondaryButton}"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="AbrirDiagnosticoGuiadoButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ITEMS LIST / SCROLLVIEWER -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChecklistItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- LINHA 1: IDENTIFICACAO E STATUS -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Secao}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Descricao}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>

                                                <!-- BOTOES DE STATUS RAPIDO -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton Content="OK"
                                                                 GroupName="{Binding ItemId}"
                                                                 IsChecked="{Binding Conforme, Mode=TwoWay}"
                                                                 Checked="StatusRadioButton_Checked"
                                                                 Margin="0,0,8,0"
                                                                 Foreground="#2E7D32"
                                                                 FontWeight="Bold"/>
                                                    <RadioButton Content="Atenção"
                                                                 GroupName="{Binding ItemId}"
                                                                 Checked="StatusAtencao_Checked"
                                                                 Margin="0,0,8,0"
                                                                 Foreground="#ED6C02"
                                                                 FontWeight="Bold"/>
                                                    <RadioButton Content="Crítico"
                                                                 GroupName="{Binding ItemId}"
                                                                 Checked="StatusCritico_Checked"
                                                                 Margin="0,0,8,0"
                                                                 Foreground="#D32F2F"
                                                                 FontWeight="Bold"/>
                                                    <RadioButton Content="N/D"
                                                                 GroupName="{Binding ItemId}"
                                                                 Checked="StatusNaoDisponivel_Checked"
                                                                 Margin="0,0,8,0"
                                                                 Foreground="#0288D1"/>
                                                    <RadioButton Content="N/A"
                                                                 GroupName="{Binding ItemId}"
                                                                 IsChecked="{Binding NaoAplicavel, Mode=TwoWay}"
                                                                 Checked="StatusRadioButton_Checked"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- LINHA 2: MEDICOES ANTES / DEPOIS / DELTA / OBSERVACOES -->
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Medição Inicial:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox Text="{Binding ValorMedido, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextChanged="ValorMedido_TextChanged"
                                                                 Width="75"
                                                                 Height="28"/>
                                                        <TextBlock Text="{Binding Unidade}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="Pós-Reparo:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox Text="{Binding ValorPosReparo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextChanged="ValorPosReparo_TextChanged"
                                                                 Width="75"
                                                                 Height="28"/>
                                                        <TextBlock Text="{Binding Unidade}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Delta:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding DeltaPosReparo, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                    <TextBlock Text="Observação / Sintoma Encontrado:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBox Text="{Binding Observacao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="28"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                                    <Button Content="Anexar Evidência"
                                                            Tag="{Binding}"
                                                            Click="AnexarEvidenciaButton_Click"
                                                            Style="{StaticResource ModalSecondaryButton}"
                                                            Height="28"
                                                            Padding="8,2"
                                                            FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Observações Gerais da Conclusão:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="ObservacoesGeraisTextBox"
                                 Width="350"
                                 Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Fechar"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="0,0,10,0"
                                Height="36"
                                Padding="16,0"
                                Click="FecharButton_Click"/>
                        <Button x:Name="SalvarProgressoButton"
                                Content="Salvar Progresso"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="0,0,10,0"
                                Height="36"
                                Padding="16,0"
                                Click="SalvarProgressoButton_Click"/>
                        <Button x:Name="ConcluirChecklistButton"
                                Content="Concluir Checklist"
                                Style="{StaticResource ModalAccentButton}"
                                Height="36"
                                Padding="18,0"
                                Click="ConcluirChecklistButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
