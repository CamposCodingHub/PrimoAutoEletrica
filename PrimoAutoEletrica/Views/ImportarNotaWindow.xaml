<Window x:Class="PrimoAutoEletrica.Views.ImportarNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar NF-e"
        MinHeight="920"
        MinWidth="1520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Conferencia e importacao de NF-e"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Revise item por item, escolha a acao e conclua a entrada de estoque com historico fiscal."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1"
                               HorizontalAlignment="Right">
                        <Button x:Name="SelecionarXmlButton"
                                Margin="0,0,10,0"
                                Style="{StaticResource ModalSecondaryButton}"
                                Click="SelecionarXmlButton_Click">
                            Selecionar XML
                        </Button>
                        <Button x:Name="AplicarSugestoesButton"
                                Margin="0,0,10,0"
                                Style="{StaticResource ModalSecondaryButton}"
                                Click="AplicarSugestoesButton_Click">
                            Aplicar sugestoes
                        </Button>
                        <Button x:Name="SelecionarTodosButton"
                                Margin="0,0,10,0"
                                Style="{StaticResource ModalSecondaryButton}"
                                Click="SelecionarTodosButton_Click">
                            Selecionar todos
                        </Button>
                        <Button x:Name="IgnorarSelecionadosButton"
                                Margin="0,0,10,0"
                                Style="{StaticResource ModalSecondaryButton}"
                                Click="IgnorarSelecionadosButton_Click">
                            Ignorar selecionados
                        </Button>
                        <Button x:Name="ImportarButton"
                                Style="{StaticResource ModalAccentButton}"
                                IsEnabled="False"
                                Click="ImportarButton_Click">
                            Confirmar importacao
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,20,0">
                    <StackPanel>
                        <UniformGrid Columns="4"
                                     Margin="0,0,0,20">
                            <Border Style="{StaticResource ModalSectionCard}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Itens da nota"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="TotalProdutosText"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModalSectionCard}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Selecionados"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="SelecionadosText"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Text="0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModalSectionCard}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Pendencias"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="PendenciasText"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Text="0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModalSectionCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[TotalValue]}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="ValorTotalText"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="R$ 0,00"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource ModalSectionCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Supplier]}"
                                               Style="{StaticResource ModalSectionTitle}"
                                               FontSize="18"/>
                                    <TextBlock x:Name="FornecedorText"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="-" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ChaveAcessoText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Chave: -"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource ModalSectionCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Emissao"
                                               Style="{StaticResource ModalSectionTitle}"
                                               FontSize="18"/>
                                    <TextBlock x:Name="DataEmissaoText"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="-"/>
                                    <TextBlock x:Name="NumeroNotaText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Numero/Série: -"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource ModalSectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Resultado previsto"
                                               Style="{StaticResource ModalSectionTitle}"
                                               FontSize="18"/>
                                    <TextBlock x:Name="ResultadoPrevistoText"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Aguardando XML"/>
                                    <TextBlock x:Name="ResultadoDetalheText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="DragDropArea"
                                Margin="0,0,0,20"
                                Padding="24"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="16"
                                AllowDrop="True"
                                Drop="DragDropArea_Drop"
                                DragEnter="DragDropArea_DragEnter"
                                DragLeave="DragDropArea_DragLeave">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Arraste o XML da NF-e para esta area"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="O sistema prepara a conferencia e mantem o historico das importacoes mais recentes."
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Margin="0,0,0,16">
                                    <TextBlock Text="Conferencia dos itens"
                                               Style="{StaticResource ModalSectionTitle}"
                                               FontSize="20"/>
                                    <TextBlock Text="Defina se cada item cria um produto novo, atualiza um existente ou deve ser ignorado."
                                               Style="{StaticResource ModalSubheaderText}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                                <DataGrid x:Name="ProdutosDataGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          MinHeight="380"
                                          CanUserAddRows="False"
                                          SelectionMode="Extended"
                                          Style="{StaticResource PremiumDataGrid}"
                                          CellEditEnding="ProdutosDataGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Import]}"
                                                                Width="80"
                                                                Binding="{Binding SelecionadoParaImportacao, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Codigo"
                                                            Width="110"
                                                            Binding="{Binding Codigo}"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Product]}"
                                                            Width="220"
                                                            Binding="{Binding Nome}"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Qty]}"
                                                            Width="70"
                                                            Binding="{Binding Quantidade}"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Cost]}"
                                                            Width="90"
                                                            Binding="{Binding ValorUnitario, StringFormat=C2}"/>
                                        <DataGridTemplateColumn Header="Acao" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding AcaoPlanejada, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Content">
                                                        <ComboBoxItem Content="Criar novo"/>
                                                        <ComboBoxItem Content="Atualizar existente"/>
                                                        <ComboBoxItem Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Ignore]}"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Category]}"
                                                            Width="150"
                                                            Binding="{Binding CategoriaSugerida, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Vinculo"
                                                            Width="200"
                                                            Binding="{Binding ProdutoVinculadoReferencia, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Margem %"
                                                            Width="90"
                                                            Binding="{Binding MargemAplicada, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Preco venda"
                                                            Width="110"
                                                            Binding="{Binding PrecoVendaSugerido, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource LocalizationHelper}, Path=[Status]}"
                                                            Width="120"
                                                            Binding="{Binding StatusDescricao}"/>
                                        <DataGridTextColumn Header="Observacao"
                                                            Width="220"
                                                            Binding="{Binding MotivoIgnorado, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource ModalSidebarCard}"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Historico recente"
                                       Style="{StaticResource ModalSidebarTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>

                            <ListBox x:Name="HistoricoListBox"
                                     Height="280"
                                     SelectionChanged="HistoricoListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Numero}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Fornecedor.Nome}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DataImportacao, StringFormat=dd/MM/yyyy HH:mm}"
                                                           Margin="0,6,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModalSidebarCard}">
                        <StackPanel>
                            <TextBlock Text="Logs da conferencia"
                                       Style="{StaticResource ModalSidebarTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>
                            <TextBlock x:Name="HistoricoDetalhesText"
                                       Style="{StaticResource ModalSubheaderText}"
                                       TextWrapping="Wrap"
                                       Text="Selecione um historico para detalhes."/>
                            <Border Margin="0,16,0,0"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              MinHeight="180">
                                    <TextBlock x:Name="LogsText"
                                               Text="Aguardando selecao de arquivo XML..."
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="140"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="SelecionarXmlButton_Click">
                        Trocar XML
                    </Button>
                    <Button Width="120"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="CancelarButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Close]}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

