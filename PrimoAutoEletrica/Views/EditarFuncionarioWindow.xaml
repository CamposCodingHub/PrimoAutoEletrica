<Window x:Class="PrimoAutoEletrica.Views.EditarFuncionarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Funcionario - Primo Auto Eletrica"
        MinWidth="900"
        MinHeight="930"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
        <Style TargetType="DatePicker" BasedOn="{StaticResource PremiumDatePicker}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource PremiumPasswordBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <StackPanel>
                    <TextBlock Text="Editar Funcionario"
                               Style="{StaticResource ModalHeaderText}"/>
                    <TextBlock Text="Atualize os dados do colaborador, a foto e o status de acesso com seguranca."
                               Style="{StaticResource ModalSubheaderText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <StackPanel>
                    <Border Style="{StaticResource ModalSectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,20,0">
                                <TextBlock Text="Dados pessoais"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Nome completo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NomeTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Email"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="EmailTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Telefone"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="TelefoneTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="CPF"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CPFTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource ModalSidebarCard}"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Foto do colaborador"
                                                   Style="{StaticResource ModalSidebarTitle}"/>

                                        <Border Height="220"
                                                CornerRadius="16"
                                                Margin="0,16,0,12"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Image x:Name="FotoPreviewImage"
                                                       Stretch="UniformToFill"
                                                       Visibility="Collapsed"/>
                                                <TextBlock x:Name="FotoPlaceholderText"
                                                           Text="Sem foto"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Width="160"
                                                    Style="{StaticResource ModalAccentButton}"
                                                    Click="SelecionarFotoButton_Click">
                                                Trocar foto
                                            </Button>
                                            <Button x:Name="RemoverFotoButton"
                                                    Width="120"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource ModalSecondaryButton}"
                                                    Click="RemoverFotoButton_Click">
                                                Remover
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModalSidebarCard}">
                                    <StackPanel>
                                        <TextBlock Text="Acesso"
                                                   Style="{StaticResource ModalSidebarTitle}"/>

                                        <TextBlock Text="Ultimo acesso"
                                                   Style="{StaticResource ModalFieldLabel}"
                                                   Margin="0,16,0,0"/>
                                        <TextBlock x:Name="UltimoAcessoTextBlock"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                                        <TextBlock Text="Criado em"
                                                   Style="{StaticResource ModalFieldLabel}"
                                                   Margin="0,14,0,0"/>
                                        <TextBlock x:Name="DataCadastroTextBlock"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModalSectionCard}">
                        <StackPanel>
                            <TextBlock Text="Dados profissionais"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,12,16">
                                    <TextBlock Text="Funcao"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="FuncaoTextBox"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="12,0,0,16">
                                    <TextBlock Text="Salario"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="SalarioTextBox"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="Data de admissao"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <DatePicker x:Name="DataAdmissaoDatePicker"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Status"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <ComboBox x:Name="StatusComboBox">
                                        <ComboBoxItem Content="Ativo"/>
                                        <ComboBoxItem Content="Em treinamento"/>
                                        <ComboBoxItem Content="Em ferias"/>
                                        <ComboBoxItem Content="Licenca medica"/>
                                        <ComboBoxItem Content="Inativo"/>
                                        <ComboBoxItem Content="Bloqueado"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Margin="0,16,0,0">
                                    <TextBlock Text="Observacoes"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="ObservacoesTextBox"
                                             MinHeight="90"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModalSectionCard}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="Dados de acesso"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,12,16">
                                    <TextBlock Text="Perfil de acesso"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <ComboBox x:Name="PerfilComboBox"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="12,0,0,16">
                                    <TextBlock Text="Nova senha"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <PasswordBox x:Name="SenhaPasswordBox"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Confirmar senha"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <PasswordBox x:Name="ConfirmarSenhaPasswordBox"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="ErrorMessageTextBlock"
                                       Text=""
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource ModalSecondaryButton}"
                            Width="140"
                            Margin="0,0,10,0"
                            Click="CancelarButton_Click">
                        Cancelar
                    </Button>
                    <Button x:Name="SalvarButton"
                            Style="{StaticResource ModalAccentButton}"
                            Width="220"
                            Click="SalvarButton_Click">
                        Salvar alteracoes
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

