<Window x:Class="PrimoAutoEletrica.Views.Configuracoes.ResetSistemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zerar Dados do Sistema"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowActivated="True"
        FocusManager.FocusedElement="{Binding ElementName=txtSenhaConfirmacao}"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <StackPanel>
                    <TextBlock Text="Zerar dados do sistema"
                               Style="{StaticResource ModalHeaderText}"/>
                    <TextBlock Text="Acao destrutiva. Confirme com a senha do administrador logado."
                               Style="{StaticResource ModalSubheaderText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24">
                <TextBlock Text="Selecione o que deseja apagar. Esta acao nao pode ser desfeita."
                           Style="{StaticResource ModalFieldLabel}"
                           TextWrapping="Wrap"/>

                <CheckBox x:Name="chkClientes"
                          Content="Apagar todos os clientes (zerar cadastro)"
                          Margin="0,4,0,8"
                          Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="chkVeiculos"
                          Content="Apagar todos os veiculos"
                          Margin="0,0,0,8"
                          Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="chkEstoque"
                          Content="Apagar estoque e produtos"
                          Margin="0,0,0,16"
                          Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Border Background="{DynamicResource DangerCardBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,20">
                    <TextBlock Text="Apagar clientes, veiculos ou produtos tambem remove ordens de servico e orcamentos vinculados."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="Senha de administrador para confirmar"
                           Style="{StaticResource ModalFieldLabel}"/>
                <PasswordBox x:Name="txtSenhaConfirmacao"
                             Style="{StaticResource PremiumPasswordBox}"
                             IsEnabled="True"
                             Focusable="True"
                             IsTabStop="True"
                             IsHitTestVisible="True"
                             AutomationProperties.Name="Senha de administrador para confirmar"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"
                            Width="120"
                            Margin="0,0,10,0"
                            Style="{StaticResource ConfirmCancelButton}"
                            IsCancel="True"
                            Click="BtnCancelar_Click"/>
                    <Button Content="Zerar dados"
                            Width="160"
                            Style="{StaticResource ConfirmDangerButton}"
                            Click="BtnConfirmar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
