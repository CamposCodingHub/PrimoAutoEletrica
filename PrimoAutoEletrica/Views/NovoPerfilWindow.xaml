<Window x:Class="PrimoAutoEletrica.Views.NovoPerfilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo Perfil - Primo Auto Eletrica"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <StackPanel>
                    <TextBlock Text="Novo Perfil de Acesso"
                               Style="{StaticResource ModalHeaderText}"
                               FontSize="22"/>
                    <TextBlock Text="Crie um perfil com nivel hierarquico e permissoes iniciais."
                               Style="{StaticResource ModalSubheaderText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <StackPanel>
                    <Border Style="{StaticResource ModalSectionCard}">
                        <StackPanel>
                            <TextBlock Text="Dados do Perfil"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,12,16">
                                    <TextBlock Text="Nome do perfil"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="NomePerfilTextBox"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="12,0,0,16">
                                    <TextBlock Text="Nivel hierarquico"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <ComboBox x:Name="NivelComboBox">
                                        <ComboBoxItem Content="Executivo"/>
                                        <ComboBoxItem Content="Gerencial"/>
                                        <ComboBoxItem Content="Operacional"/>
                                        <ComboBoxItem Content="Basico"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="2">
                                    <TextBlock Text="Descricao"
                                               Style="{StaticResource ModalFieldLabel}"/>
                                    <TextBox x:Name="DescricaoTextBox"
                                             Height="88"
                                             Style="{StaticResource MultiLineTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModalSectionCard}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="Permissoes Iniciais"
                                       Style="{StaticResource ModalSectionTitle}"
                                       FontSize="18"
                                       Margin="0,0,0,16"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <ScrollViewer MaxHeight="180"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PermissoesIniciaisStackPanel"/>
                                </ScrollViewer>
                            </Border>

                            <TextBlock x:Name="ErrorMessageTextBlock"
                                       Text=""
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelarButton"
                            Width="140"
                            Style="{StaticResource ModalSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="CancelarButton_Click">
                        Cancelar
                    </Button>
                    <Button x:Name="SalvarButton"
                            Width="170"
                            Style="{StaticResource ModalAccentButton}"
                            Click="SalvarButton_Click">
                        Criar perfil
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>


