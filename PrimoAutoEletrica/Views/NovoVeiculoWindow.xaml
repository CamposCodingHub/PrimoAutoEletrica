<Window x:Class="PrimoAutoEletrica.Views.NovoVeiculoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Novo Veiculo"
        Width="1120"
        Height="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
        <Style TargetType="DatePicker" BasedOn="{StaticResource PremiumDatePicker}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="TituloText"
                                   Text="Novo Veiculo"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Cadastro tecnico com historico eletrico, alertas de retorno e anexos visuais do veiculo."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="FecharButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Identificacao"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Marca"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="MarcaComboBox"
                                                  IsEditable="True"
                                                  SelectionChanged="MarcaComboBox_SelectionChanged"
                                                  TextBoxBase.TextChanged="MarcaComboBox_TextChanged">
                                            <ComboBoxItem Content="Fiat"/>
                                            <ComboBoxItem Content="Volkswagen"/>
                                            <ComboBoxItem Content="Chevrolet"/>
                                            <ComboBoxItem Content="Ford"/>
                                            <ComboBoxItem Content="Toyota"/>
                                            <ComboBoxItem Content="Honda"/>
                                            <ComboBoxItem Content="Renault"/>
                                            <ComboBoxItem Content="Nissan"/>
                                            <ComboBoxItem Content="Hyundai"/>
                                            <ComboBoxItem Content="Jeep"/>
                                            <ComboBoxItem Content="Mitsubishi"/>
                                            <ComboBoxItem Content="Scania"/>
                                            <ComboBoxItem Content="Volvo"/>
                                            <ComboBoxItem Content="Mercedes-Benz"/>
                                            <ComboBoxItem Content="Ford Cargo"/>
                                            <ComboBoxItem Content="VW Truck"/>
                                            <ComboBoxItem Content="Iveco"/>
                                            <ComboBoxItem Content="MAN"/>
                                            <ComboBoxItem Content="DAF"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Modelo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="ModeloComboBox"
                                                  IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Tipo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="TipoVeiculoComboBox">
                                            <ComboBoxItem Content="Carro"/>
                                            <ComboBoxItem Content="Caminhao"/>
                                            <ComboBoxItem Content="Moto"/>
                                            <ComboBoxItem Content="Utilitario"/>
                                            <ComboBoxItem Content="Onibus"/>
                                            <ComboBoxItem Content="Maquina"/>
                                            <ComboBoxItem Content="Outro"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Ano"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="AnoTextBox"
                                                 MaxLength="4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Cor"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CorTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Sistema eletrico"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="SistemaEletricoComboBox">
                                            <ComboBoxItem Content="12V"/>
                                            <ComboBoxItem Content="24V"/>
                                            <ComboBoxItem Content="12/24V"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Placa"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PlacaTextBox"
                                                 CharacterCasing="Upper"
                                                 TextChanged="PlacaTextBox_TextChanged"/>
                                        <TextBlock x:Name="PlacaErroText"
                                                   Text="Placa ja cadastrada"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="12"
                                                   Margin="0,8,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="12,0,12,0">
                                        <TextBlock Text="Chassi"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ChassiTextBox"
                                                 CharacterCasing="Upper"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Renavam"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="RenavamTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Conjunto eletrico e kilometragem"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Motor"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="MotorTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Combustivel"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="CombustivelComboBox">
                                            <ComboBoxItem Content="Diesel"/>
                                            <ComboBoxItem Content="Gasolina"/>
                                            <ComboBoxItem Content="Flex"/>
                                            <ComboBoxItem Content="GNV"/>
                                            <ComboBoxItem Content="Eletrico"/>
                                            <ComboBoxItem Content="Hibrido"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Ultima quilometragem"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="QuilometragemTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Bateria principal"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="BateriaPrincipalTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,12,0">
                                        <TextBlock Text="Bateria auxiliar"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="BateriaAuxiliarTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Alternador"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="AlternadorTextBox"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Motor de partida"
                                           Style="{StaticResource ModalFieldLabel}"
                                           Margin="0,16,0,0"/>
                                <TextBox x:Name="MotorPartidaTextBox"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Historico tecnico e recorrencias"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Historico tecnico"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="HistoricoTecnicoTextBox"
                                                 MinHeight="110"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Observacoes eletricas recorrentes"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ObservacoesRecorrentesTextBox"
                                                 MinHeight="110"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Problema recorrente"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ProblemaRecorrenteTextBox"
                                                 MinHeight="88"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Observacao importante para o tecnico"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ObservacaoTecnicoTextBox"
                                                 MinHeight="88"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Proprietario, alertas e observacoes"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="20"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Margin="0,0,0,16">
                                        <TextBlock Text="Cliente"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="ClienteComboBox"
                                                  DisplayMemberPath="DisplayText"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Retorno recomendado"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <DatePicker x:Name="RetornoDatePicker"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Garantia ate"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <DatePicker x:Name="GarantiaDatePicker"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Proxima revisao"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <DatePicker x:Name="RevisaoDatePicker"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3">
                                        <TextBlock Text="Observacoes gerais"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ObservacoesTextBox"
                                                 MinHeight="110"
                                                 Style="{StaticResource MultiLineTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Foto do veiculo"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,14"/>

                                <Border Width="220"
                                        Height="220"
                                        HorizontalAlignment="Center"
                                        CornerRadius="20"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="FotoPreviewImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <TextBlock x:Name="FotoPlaceholderText"
                                                   Text="Sem foto"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="FotoStatusTextBlock"
                                           Margin="0,12,0,0"
                                           Text="Adicione uma imagem frontal ou lateral para facilitar a triagem."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button Style="{StaticResource ModalAccentButton}"
                                            Margin="0,0,10,10"
                                            Click="SelecionarFotoButton_Click">
                                        Selecionar foto
                                    </Button>
                                    <Button Style="{StaticResource ModalSecondaryButton}"
                                            Margin="0,0,0,10"
                                            Click="RemoverFotoButton_Click">
                                        Remover
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Documento do veiculo"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,14"/>

                                <Border Height="180"
                                        CornerRadius="18"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="DocumentoPreviewImage"
                                               Stretch="Uniform"
                                               Visibility="Collapsed"/>
                                        <TextBlock x:Name="DocumentoPlaceholderText"
                                                   Text="Sem anexo"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="DocumentoStatusTextBlock"
                                           Margin="0,12,0,0"
                                           Text="Anexe CRLV ou documento visual para atendimento."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button Style="{StaticResource ModalAccentButton}"
                                            Margin="0,0,10,10"
                                            Click="SelecionarDocumentoButton_Click">
                                        Selecionar documento
                                    </Button>
                                    <Button Style="{StaticResource ModalSecondaryButton}"
                                            Margin="0,0,0,10"
                                            Click="RemoverDocumentoButton_Click">
                                        Remover
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Resumo rapido"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,14"/>

                                <TextBlock Text="Uso ideal"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBlock Text="Equipe de recepcao e tecnico passam a registrar o estado eletrico do veiculo na mesma ficha."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Text="Campos criticos"
                                           Style="{StaticResource ModalFieldLabel}"
                                           Margin="0,16,0,0"/>
                                <TextBlock Text="Placa, tipo, sistema eletrico, conjunto de baterias, alternador e historico recorrente."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Text="Alertas"
                                           Style="{StaticResource ModalFieldLabel}"
                                           Margin="0,16,0,0"/>
                                <TextBlock Text="Retorno, garantia e revisao ajudam a equipe a antecipar contato e garantia ativa."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="130"
                            Style="{StaticResource ModalSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="CancelarButton_Click">
                        Cancelar
                    </Button>
                    <Button Width="180"
                            Style="{StaticResource ModalAccentButton}"
                            Click="SalvarButton_Click">
                        Salvar veiculo
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
