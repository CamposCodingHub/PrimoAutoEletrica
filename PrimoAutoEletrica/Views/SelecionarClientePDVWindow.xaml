<Window x:Class="PrimoAutoEletrica.Views.SelecionarClientePDVWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar cliente"
        MinWidth="980"
        MinHeight="650"
       
       
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Selecionar cliente"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Busque por nome, CPF/CNPJ, telefone, WhatsApp ou e-mail."
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Close]}"
                        Width="100"
                        Height="38"
                        Style="{StaticResource PageSecondaryActionButton}"
                        Click="FecharButton_Click"/>
            </Grid>
        </Border>

        <!-- BUSCA -->
        <Border Grid.Row="1"
                Margin="20,18,20,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="BuscaTextBox"
                         Grid.Column="0"
                         Height="42"
                         Style="{StaticResource SearchBox}"
                         ToolTip="Digite nome, CPF/CNPJ, telefone, WhatsApp ou e-mail"
                         TextChanged="BuscaTextBox_TextChanged"
                         KeyDown="BuscaTextBox_KeyDown"/>

                <Button Grid.Column="1"
                        Content="Limpar"
                        Width="90"
                        Height="42"
                        Margin="12,0,0,0"
                        Style="{StaticResource PageSecondaryActionButton}"
                        Click="LimparBuscaButton_Click"/>

                <Button Grid.Column="2"
                        Content="Consumidor final"
                        Width="150"
                        Height="42"
                        Margin="12,0,0,0"
                        Style="{StaticResource PageInfoActionButton}"
                        Click="ConsumidorFinalButton_Click"/>
            </Grid>
        </Border>

        <!-- TABELA -->
        <Border Grid.Row="2"
                Margin="20,0,20,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ResumoTextBlock"
                               Text="Clientes encontrados: 0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Grid.Column="1"
                               Text="Dica: d� duplo clique para selecionar"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>

                <DataGrid x:Name="ClientesDataGrid"
                          Grid.Row="1"
                          Style="{StaticResource PremiumDataGrid}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AutoGenerateColumns="False"
                          MouseDoubleClick="ClientesDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome"
                                            Width="260"
                                            Binding="{Binding Nome}"/>

                        <DataGridTextColumn Header="Documento"
                                            Width="150"
                                            Binding="{Binding Documento}"/>

                        <DataGridTextColumn Header="CPF"
                                            Width="130"
                                            Binding="{Binding CPF}"/>

                        <DataGridTextColumn Header="Telefone"
                                            Width="130"
                                            Binding="{Binding Telefone}"/>

                        <DataGridTextColumn Header="WhatsApp"
                                            Width="130"
                                            Binding="{Binding WhatsApp}"/>

                        <DataGridTextColumn Header="E-mail"
                                            Width="220"
                                            Binding="{Binding Email}"/>

                        <DataGridTemplateColumn Header="A��o"
                                                Width="130"
                                                MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Confirm]}"
                                            Height="32"
                                            Width="100"
                                            Style="{StaticResource TableActionButton}"
                                            Background="{DynamicResource SuccessBrush}"
                                            BorderBrush="{DynamicResource SuccessBrush}"
                                            Foreground="{DynamicResource AccentButtonTextBrush}"
                                            Click="SelecionarLinhaButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- RODAP� -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Enter seleciona o cliente marcado. Esc fecha a janela."
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <Button Grid.Column="1"
                        Content="Selecionar cliente"
                        Width="160"
                        Height="42"
                        Margin="0,0,10,0"
                        Style="{StaticResource PagePrimaryActionButton}"
                        Click="SelecionarClienteButton_Click"/>

                <Button Grid.Column="2"
                        Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"
                        Width="110"
                        Height="42"
                        Style="{StaticResource PageSecondaryActionButton}"
                        Click="FecharButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>


