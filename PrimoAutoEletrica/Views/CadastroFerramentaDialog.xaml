<Window x:Class="PrimoAutoEletrica.Views.CadastroFerramentaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Ferramenta / Instrumento"
        Width="640"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="14"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecalho -->
            <Border Grid.Row="0"
                    Padding="20,16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TituloModalText"
                                   Text="Cadastrar Novo Equipamento"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Cadastre scanners, instrumentos de medição ou ferramentas especializadas com controle patrimonial."
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CancelarButton_Click"
                            Style="{StaticResource FilterActionButton}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Formulario com ScrollViewer -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,16">
                <StackPanel>
                    <!-- Linha 1: Codigo Patrimonio e Categoria -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="CÓDIGO PATRIMÔNIO *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="CodigoPatrimonioTextBox"
                                     Margin="0,6,0,0"
                                     Height="38"
                                     Style="{StaticResource SearchBox}"
                                     Tag="Ex: FER-0100"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CATEGORIA DE INSTRUMENTO *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox x:Name="CategoriaComboBox"
                                      Margin="0,6,0,0"
                                      Height="38"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 2: Nome do Equipamento -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="NOME / DESCRIÇÃO DO EQUIPAMENTO *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="NomeTextBox"
                                 Margin="0,6,0,0"
                                 Height="38"
                                 Style="{StaticResource SearchBox}"
                                 Tag="Ex: Osciloscópio Automotivo 4 Canais Hantek"/>
                    </StackPanel>

                    <!-- Linha 3: Marca / Modelo e Numero de Serie -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="MARCA &amp; MODELO" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="MarcaModeloTextBox"
                                     Margin="0,6,0,0"
                                     Height="38"
                                     Style="{StaticResource SearchBox}"
                                     Tag="Ex: Hantek 2D82Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NÚMERO DE SÉRIE" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="NumeroSerieTextBox"
                                     Margin="0,6,0,0"
                                     Height="38"
                                     Style="{StaticResource SearchBox}"
                                     Tag="Ex: SN-984729184"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 4: Armario / Localizacao e Valor Aquisicao -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="LOCALIZAÇÃO NO ARMAZÉM / ARMÁRIO *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="LocalizacaoArmarioTextBox"
                                     Margin="0,6,0,0"
                                     Height="38"
                                     Style="{StaticResource SearchBox}"
                                     Tag="Ex: Armário 02 / Gaveta B (Bancada 1)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="VALOR AQUISIÇÃO (R$)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="ValorAquisicaoTextBox"
                                     Margin="0,6,0,0"
                                     Height="38"
                                     Style="{StaticResource SearchBox}"
                                     Tag="0,00"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bloco Calibracao Periodica -->
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="RequerCalibracaoCheckBox"
                                      Content="Equipamento requer Calibração Periódica / Aferição Técnica"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      Checked="RequerCalibracaoCheckBox_CheckedChanged"
                                      Unchecked="RequerCalibracaoCheckBox_CheckedChanged"/>

                            <Grid x:Name="PainelCalibracao"
                                  Margin="0,10,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="INTERVALO DE CALIBRAÇÃO (DIAS)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="IntervaloCalibracaoTextBox"
                                             Text="365"
                                             Margin="0,4,0,0"
                                             Height="34"
                                             Style="{StaticResource SearchBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DATA DA ÚLTIMA CALIBRAÇÃO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <DatePicker x:Name="UltimaCalibracaoDatePicker"
                                                Margin="0,4,0,0"
                                                Height="34"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Observacoes -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="OBSERVAÇÕES OPERACIONAIS" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="ObservacoesTextBox"
                                 Margin="0,6,0,0"
                                 Height="64"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Style="{StaticResource SearchBox}"
                                 Tag="Detalhes adicionais, kit de pontas de prova inclusos, etc."/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Rodape com Acoes -->
            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <Grid>
                    <Button x:Name="ExcluirButton"
                            Content="Excluir Equipamento"
                            Click="ExcluirButton_Click"
                            Style="{StaticResource DangerActionButton}"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Width="110"
                                Margin="0,0,10,0"
                                Style="{StaticResource ModalSecondaryButton}"
                                Click="CancelarButton_Click"/>
                        <Button x:Name="SalvarButton"
                                Content="Salvar Equipamento"
                                Width="170"
                                Style="{StaticResource ModalAccentButton}"
                                Click="SalvarButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
