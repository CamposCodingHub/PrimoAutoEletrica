<Window x:Class="PrimoAutoEletrica.Views.RevisarCatalogoPecaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar Item do Catalogo"
        MinWidth="1080"
        MinHeight="860"
       
       
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Revisar Item do Catalogo"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Ajuste os dados tecnicos antes de transformar o item em produto real."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="CancelarButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="24,20,24,20"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource ModalSectionCard}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,16">
                                <TextBlock Text="Codigo fabricante"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="CodigoFabricanteTextBox"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="12,0,0,16">
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Brand]}"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="MarcaTextBox"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,0,16">
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Name]}"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="NomeTextBox"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,0,16">
                                <TextBlock Text="Descricao"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="DescricaoTextBox"
                                         Height="110"
                                         Style="{StaticResource MultiLineTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Status de revisao"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <ComboBox x:Name="StatusComboBox"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="Pagina do catalogo"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="PaginaCatalogoTextBox"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModalSectionCard}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,16">
                                <TextBlock Text="{Binding Source={StaticResource LocalizationHelper}, Path=[Category]}"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="CategoriaTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="12,0,12,16">
                                <TextBlock Text="Subcategoria"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="SubcategoriaTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="12,0,0,16">
                                <TextBlock Text="Aplicacao"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="AplicacaoTextBox"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Voltagem"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="VoltagemTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="12,0,12,0">
                                <TextBlock Text="Amperagem"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="AmperagemTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="12,0,0,0">
                                <TextBlock Text="Terminais"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="TerminaisTextBox"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModalSectionCard}"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Observacoes tecnicas"
                                       Style="{StaticResource ModalFieldLabel}"/>
                            <TextBox x:Name="ObservacoesTextBox"
                                     Height="140"
                                     Style="{StaticResource MultiLineTextBox}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="Origem do item"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InfoBrush}"/>
                            <TextBlock x:Name="OrigemItemText"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="140"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="CancelarButton_Click" Content="{Binding Source={StaticResource LocalizationHelper}, Path=[Cancel]}"/>
                    <Button x:Name="CriarProdutoButton"
                            Width="220"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalAccentButton}"
                            Click="CriarProdutoButton_Click">
                        Criar produto no estoque
                    </Button>
                    <Button x:Name="SalvarButton"
                            Width="180"
                            Style="{StaticResource ModalAccentButton}"
                            Click="SalvarButton_Click">
                        Salvar revisao
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>


