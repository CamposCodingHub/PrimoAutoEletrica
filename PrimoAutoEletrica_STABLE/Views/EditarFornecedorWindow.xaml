<Window x:Class="PrimoAutoEletrica.Views.EditarFornecedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar Fornecedor"
        Height="900"
        Width="1220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBox}"/>
    </Window.Resources>

    <Border Style="{StaticResource ModalSurface}"
            Padding="0"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeaderSurface}"
                    CornerRadius="18,18,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Editar Fornecedor"
                                   Style="{StaticResource ModalHeaderText}"/>
                        <TextBlock Text="Atualize o parceiro principal, a regra comercial e os vinculos operacionais."
                                   Style="{StaticResource ModalSubheaderText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ModalCloseButton}"
                            Click="FecharButton_Click">
                        X
                    </Button>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Dados cadastrais"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Razao social"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="RazaoSocialTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Nome fantasia"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NomeFantasiaTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="CPF/CNPJ"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CNPJTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Inscricao estadual"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="InscricaoEstadualTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Categoria"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="CategoriaComboBox">
                                            <ComboBoxItem Content="Pecas"/>
                                            <ComboBoxItem Content="Servicos"/>
                                            <ComboBoxItem Content="Materiais"/>
                                            <ComboBoxItem Content="Equipamentos"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Site"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="SiteTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Contato comercial"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Telefone"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="TelefoneTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Celular"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CelularTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,0,0,16">
                                        <TextBlock Text="Email"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="EmailTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="2">
                                        <TextBlock Text="WhatsApp do vendedor"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="WhatsAppVendedorTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Contato principal"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Nome do contato"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalNomeTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Cargo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalCargoTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Telefone direto"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalTelefoneTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Email do contato"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="ContatoPrincipalEmailTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Endereco"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="CEP"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CEPTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Rua"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="RuaTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Numero"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="NumeroTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Bairro"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="BairroTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,0,12,0">
                                        <TextBlock Text="Cidade"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CidadeTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="UF"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="EstadoTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSectionCard}"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="Condicoes comerciais"
                                           Style="{StaticResource ModalSectionTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,12,16">
                                        <TextBlock Text="Forma de pagamento"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox x:Name="FormaPagamentoComboBox">
                                            <ComboBoxItem Content="A vista"/>
                                            <ComboBoxItem Content="Boleto"/>
                                            <ComboBoxItem Content="Cartao de credito"/>
                                            <ComboBoxItem Content="PIX"/>
                                            <ComboBoxItem Content="Transferencia"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="12,0,12,16">
                                        <TextBlock Text="Prazo de pagamento"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PrazoPagamentoTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="12,0,0,16">
                                        <TextBlock Text="Pedido minimo"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PedidoMinimoTextBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Prazo medio de entrega (dias)"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PrazoMedioEntregaTextBox"/>
                                    </StackPanel>

                                     <StackPanel Grid.Row="1"
                                                 Grid.Column="1"
                                                 Margin="12,0,12,0">
                                        <TextBlock Text="Prazo medio de pagamento (dias)"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="PrazoMedioPagamentoTextBox"
                                                 Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="Categoria preferencial"
                                                   Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox x:Name="CategoriaPreferencialTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="20,0,0,0">
                        <Border Style="{StaticResource ModalSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Avaliacao"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <TextBlock Text="Nota do fornecedor"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <ComboBox x:Name="NotaComboBox"
                                          Margin="0,0,0,18">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                </ComboBox>

                                <TextBlock Text="Observacoes"
                                           Style="{StaticResource ModalFieldLabel}"/>
                                <TextBox x:Name="ObservacoesTextBox"
                                         Height="160"
                                         Style="{StaticResource MultiLineTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModalSidebarCard}"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Status"
                                           Style="{StaticResource ModalSidebarTitle}"
                                           FontSize="18"
                                           Margin="0,0,0,16"/>

                                <CheckBox x:Name="AtivoCheckBox"
                                          Content="Fornecedor ativo"
                                          FontSize="14"/>

                                <TextBlock Text="Desmarque apenas quando o fornecedor nao puder mais ser usado em compras e reposicao."
                                           Style="{StaticResource ModalSubheaderText}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterSurface}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="130"
                            Style="{StaticResource ModalSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="CancelarButton_Click">
                        Cancelar
                    </Button>
                    <Button Width="210"
                            Style="{StaticResource ModalAccentButton}"
                            Click="SalvarButton_Click">
                        Salvar alteracoes
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
