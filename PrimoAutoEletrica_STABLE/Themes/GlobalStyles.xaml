<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Merge all theme dictionaries -->
    <ResourceDictionary.MergedDictionaries>
        <!-- Colors.xaml removido, pois o ThemeService já insere Colors.Light.xaml ou Colors.Dark.xaml dinamicamente -->
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Buttons.xaml"/>
        <ResourceDictionary Source="Cards.xaml"/>
        <ResourceDictionary Source="Dashboard.xaml"/>
        <ResourceDictionary Source="Inputs.xaml"/>
        <ResourceDictionary Source="DataGrid.xaml"/>
        <ResourceDictionary Source="Density.xaml"/>
        <ResourceDictionary Source="Tables.xaml"/>
        <ResourceDictionary Source="ListView.xaml"/>
        <ResourceDictionary Source="Calendar.xaml"/>
        <ResourceDictionary Source="Shadows.xaml"/>
        <ResourceDictionary Source="Animations.xaml"/>
        <ResourceDictionary Source="Header.xaml"/>
        <ResourceDictionary Source="Modal.xaml"/>
        <ResourceDictionary Source="Sidebar.xaml"/>
        <ResourceDictionary Source="EmptyStates.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Global Spacing Standards -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingSM">8</sys:Double>
    <sys:Double x:Key="SpacingMD">12</sys:Double>
    <sys:Double x:Key="SpacingLG">16</sys:Double>
    <sys:Double x:Key="SpacingXL">20</sys:Double>
    <sys:Double x:Key="Spacing2XL">24</sys:Double>
    <sys:Double x:Key="Spacing3XL">32</sys:Double>

    <!-- Global Border Radius -->
    <CornerRadius x:Key="CornerRadiusSM">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMD">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLG">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>

</ResourceDictionary>
