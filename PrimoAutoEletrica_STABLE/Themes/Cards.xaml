<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- CARDS GLOBAIS COM SUPORTE A TEMA CLARO/ESCURO             -->
    <!-- ========================================================= -->
    <!--
        IMPORTANTE:
        Este arquivo foi ajustado para usar DynamicResource.
        Assim, quando o ThemeService trocar Colors.Light.xaml por Colors.Dark.xaml,
        os cards passam a acompanhar automaticamente o tema global.

        Regras:
        - Fundo de card usa CardBackgroundBrush.
        - Borda usa BorderBrush.
        - Área secundária usa SurfaceAltBrush.
        - Cards de status usam fundo suave próprio do tema.
    -->

    <!-- Card Border Style -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
    </Style>

    <!-- Card Border Elevated (More Shadow) -->
    <Style x:Key="CardBorderElevated"
           TargetType="Border"
           BasedOn="{StaticResource CardBorder}">
        <Setter Property="Effect" Value="{StaticResource StrongShadowEffect}"/>
    </Style>

    <!-- Card Border Flat (No Shadow) -->
    <Style x:Key="CardBorderFlat"
           TargetType="Border"
           BasedOn="{StaticResource CardBorder}">
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Card Border Interactive (Hover Effect) -->
    <Style x:Key="CardBorderInteractive"
           TargetType="Border"
           BasedOn="{StaticResource CardBorder}">
        <Setter Property="Cursor" Value="Hand"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#F97316"
                                          Opacity="0.20"
                                          BlurRadius="16"
                                          ShadowDepth="0"
                                          Direction="0"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dashboard Card Style -->
    <Style x:Key="DashboardCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource MediumShadowEffect}"/>
    </Style>

    <!-- Metric Card -->
    <Style x:Key="MetricCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource DashboardCard}">
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="MinHeight" Value="146"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,16,16"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- Responsive Metric Card -->
    <Style x:Key="ResponsiveMetricCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource MetricCardStyle}">
        <Setter Property="MaxWidth" Value="320"/>
    </Style>

    <!-- Operational Panel -->
    <Style x:Key="OperationalPanelStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorder}">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,16,16"/>
        <Setter Property="MinHeight" Value="120"/>
    </Style>

    <!-- Product/List Item -->
    <Style x:Key="ProductListItemStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="MinHeight" Value="92"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Info Card -->
    <Style x:Key="InfoCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InfoCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Success Card -->
    <Style x:Key="SuccessCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SuccessCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Warning Card -->
    <Style x:Key="WarningCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Danger Card -->
    <Style x:Key="DangerCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DangerCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Panel Style -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Widget Style -->
    <Style x:Key="Widget" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{StaticResource PanelShadowEffect}"/>
    </Style>

</ResourceDictionary>
