<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Font Family -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeXS">10</sys:Double>
    <sys:Double x:Key="FontSizeSM">11</sys:Double>
    <sys:Double x:Key="FontSizeBase">13</sys:Double>
    <sys:Double x:Key="FontSizeMD">14</sys:Double>
    <sys:Double x:Key="FontSizeLG">16</sys:Double>
    <sys:Double x:Key="FontSizeXL">18</sys:Double>
    <sys:Double x:Key="FontSize2XL">20</sys:Double>
    <sys:Double x:Key="FontSize3XL">24</sys:Double>
    <sys:Double x:Key="FontSize4XL">30</sys:Double>
    <sys:Double x:Key="FontSize5XL">36</sys:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="FontWeightLight">Light</FontWeight>
    <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <FontWeight x:Key="FontWeightExtraBold">ExtraBold</FontWeight>

    <!-- Line Heights -->
    <sys:Double x:Key="LineHeightTight">1.2</sys:Double>
    <sys:Double x:Key="LineHeightNormal">1.5</sys:Double>
    <sys:Double x:Key="LineHeightRelaxed">1.75</sys:Double>

    <!-- Typography Styles -->
    <Style x:Key="H1Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize4XL}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
    </Style>

    <Style x:Key="H2Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize3XL}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
    </Style>

    <Style x:Key="H3Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize2XL}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
    </Style>

    <Style x:Key="H4Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXL}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
    </Style>

    <Style x:Key="H5Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLG}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
    </Style>

    <Style x:Key="BodyLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMD}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
    </Style>

    <Style x:Key="BodySmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXS}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
    </Style>

    <Style x:Key="LinkStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="SubtitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>

</ResourceDictionary>
