<UserControl x:Class="PrimoAutoEletrica.UserControls.OrcamentoClientePanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinHeight="220">
    <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="24" Margin="8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Cliente" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding Nome}" ToolTip="{Binding Nome}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" Foreground="#0F172A" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="56"/>
                    <TextBlock Text="{Binding Telefone, StringFormat=Telefone: {0}}" FontSize="14" Foreground="#334155" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Documento, StringFormat=Documento: {0}}" FontSize="14" Foreground="#334155" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding StatusVip, StringFormat=Perfil: {0}}" FontSize="14" Foreground="#C2410C" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Resumo de relacionamento" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding HistoricoComprasResumo}" ToolTip="{Binding HistoricoComprasResumo}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="64" Margin="0,10,0,0" Foreground="#334155"/>
                    <TextBlock Text="{Binding UltimaCompraResumo, StringFormat=Ultima visita: {0}}" Margin="0,8,0,0" Foreground="#334155"/>
                    <TextBlock Text="{Binding ValorTotalGastoResumo, StringFormat=Total gasto: {0:C}}" Margin="0,4,0,0" Foreground="#334155"/>
                    <TextBlock Text="{Binding InadimplenciaResumo, StringFormat=Financeiro: {0}}" Margin="0,4,0,0" Foreground="#334155"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Button Content="Cadastro rapido" MinWidth="160" Margin="0,0,0,8" Click="CadastroRapido_Click"/>
                    <Button Content="Buscar cliente" MinWidth="160" Margin="0,0,0,8" Click="BuscarCliente_Click"/>
                    <Button Content="Historico completo" MinWidth="160" Click="HistoricoCompleto_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
