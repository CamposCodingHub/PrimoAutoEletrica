<UserControl x:Class="PrimoAutoEletrica.UserControls.ClientesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Margin="20,20,20,16"
                Padding="18"
                Style="{StaticResource ModalSectionCard}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Clientes e relacionamento"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="CRM operacional com foto, historico, frota e acoes rapidas de atendimento."
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">

                    <Button x:Name="LimparFiltrosClientesButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageSecondaryActionButton}"
                            Click="LimparFiltrosClientesButton_Click">
                        Limpar filtros
                    </Button>

                    <Button x:Name="ExportarClientesButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource ExportActionButton}"
                            Click="ExportarClientesButton_Click">
                        Exportar
                    </Button>

                    <Button x:Name="WhatsAppClienteButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageInfoActionButton}"
                            IsEnabled="False"
                            Click="WhatsAppClienteButton_Click">
                        WhatsApp
                    </Button>

                    <Button x:Name="NovaOsClienteButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageWarningActionButton}"
                            IsEnabled="False"
                            Click="NovaOsClienteButton_Click">
                        Nova OS
                    </Button>

                    <Button x:Name="NovoOrcamentoClienteButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource PageSecondaryActionButton}"
                            IsEnabled="False"
                            Click="NovoOrcamentoClienteButton_Click">
                        Novo orcamento
                    </Button>

                    <Button x:Name="NovoClienteButton"
                            Style="{StaticResource PageSuccessActionButton}"
                            Click="NovoClienteButton_Click">
                        Novo cliente
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- CARDS RESUMO -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="20,0,20,16">

            <Border Style="{StaticResource ModalSectionCard}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Total clientes"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="TotalClientesText"
                               Margin="0,8,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModalSectionCard}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Ativos"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="ClientesAtivosText"
                               Margin="0,8,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModalSectionCard}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="VIP"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="ClientesFidelizadosText"
                               Margin="0,8,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModalSectionCard}">
                <StackPanel>
                    <TextBlock Text="Sem retorno recente"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="ClientesInativosText"
                               Margin="0,8,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Row="2"
              Margin="20,0,20,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA DE CLIENTES -->
            <Border Grid.Column="0"
                    Margin="0,0,16,0"
                    Style="{StaticResource ModalSectionCard}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FILTROS -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BuscaClienteTextBox"
                                 Height="42"
                                 Margin="0,0,12,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="BuscaClienteTextBox_TextChanged"/>

                        <ComboBox x:Name="FiltroStatusComboBox"
                                  Grid.Column="1"
                                  Height="42"
                                  SelectionChanged="FiltroStatusComboBox_SelectionChanged"
                                  Style="{StaticResource PremiumComboBox}">

                            <ComboBoxItem Content="Todos"
                                          IsSelected="True"/>

                            <ComboBoxItem Content="Ativos"/>

                            <ComboBoxItem Content="VIP"/>

                            <ComboBoxItem Content="Sem retorno"/>
                        </ComboBox>
                    </Grid>

                    <!-- TABELA -->
                    <DataGrid x:Name="ClientesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionChanged="ClientesDataGrid_SelectionChanged"
                              Style="{StaticResource PremiumDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Cliente"
                                                    Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <Border Width="44"
                                                    Height="44"
                                                    CornerRadius="22"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">

                                                <Grid>
                                                    <Image Source="{Binding ImagemUrl}"
                                                           Stretch="UniformToFill"/>

                                                    <TextBlock Text="{Binding Iniciais}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryTextBrush}">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagemUrl}"
                                                                                 Value="">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Nome}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock Text="{Binding DocumentoResumo}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tipo"
                                                Width="120"
                                                Binding="{Binding TipoPessoaResumo}"/>

                            <DataGridTextColumn Header="Contato"
                                                Width="170"
                                                Binding="{Binding ContatoPrincipal}"/>

                            <DataGridTextColumn Header="Veiculo principal"
                                                Width="180"
                                                Binding="{Binding VeiculoPrincipal}"/>

                            <DataGridTextColumn Header="Ultima visita"
                                                Width="120"
                                                Binding="{Binding UltimaVisita}"/>

                            <DataGridTextColumn Header="Ticket"
                                                Width="110"
                                                Binding="{Binding TicketMedio}"/>

                            <DataGridTextColumn Header="Status"
                                                Width="120"
                                                Binding="{Binding StatusResumo}"/>

                            <DataGridTextColumn Header="LGPD"
                                                Width="145"
                                                Binding="{Binding LgpdResumo}"/>

                            <DataGridTemplateColumn Header="Acoes"
                                                    Width="290">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <WrapPanel>
                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource TableActionButton}"
                                                    Click="VisualizarClienteButton_Click">
                                                Ver
                                            </Button>

                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource CompactSuccessActionButton}"
                                                    Click="EditarClienteButton_Click">
                                                Editar
                                            </Button>

                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource CompactWarningActionButton}"
                                                    Click="HistoricoClienteButton_Click">
                                                Historico
                                            </Button>

                                            <Button Margin="0,0,8,8"
                                                    Style="{StaticResource CompactDangerActionButton}"
                                                    Click="ExcluirClienteButton_Click">
                                                Excluir
                                            </Button>
                                        </WrapPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PAINEL DIREITO -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- CADASTROS RECENTES -->
                <Border Grid.Row="0"
                        Style="{StaticResource ModalSectionCard}"
                        Margin="0,0,0,16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Cadastros recentes"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">

                            <ItemsControl x:Name="ClientesRecentesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,10">

                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock Text="{Binding Resumo}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- INSIGHTS OPERACIONAIS -->
                <Border Grid.Row="1"
                        Style="{StaticResource InfoCard}"
                        Margin="0,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Insights operacionais"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">

                            <StackPanel>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                    <TextBlock x:Name="InsightTicketTextBlock"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                    <TextBlock x:Name="InsightCrescimentoTextBlock"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Background="{DynamicResource WarningCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,0">

                                    <TextBlock x:Name="InsightRetencaoTextBlock"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
