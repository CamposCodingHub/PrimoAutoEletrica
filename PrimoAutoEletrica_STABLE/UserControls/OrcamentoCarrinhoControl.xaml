<UserControl x:Class="PrimoAutoEletrica.UserControls.OrcamentoCarrinhoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinHeight="260">
    <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Margin="8" Padding="12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding ItensCarrinho}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      MinHeight="240"
                      FontSize="14"
                      Background="Transparent"
                      BorderThickness="0"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Produto" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProdutoNome}"
                                           ToolTip="{Binding ProdutoNome}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="42"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Codigo" Binding="{Binding ProdutoCodigo}" Width="1.2*"/>
                    <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="0.7*"/>
                    <DataGridTextColumn Header="Preco Unit." Binding="{Binding PrecoUnitario, StringFormat={}{0:C}}" Width="1*"/>
                    <DataGridTextColumn Header="Desconto" Binding="{Binding Desconto, StringFormat={}{0:C}}" Width="0.9*"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="1*"/>
                    <DataGridTextColumn Header="Lucro Est." Binding="{Binding LucroEstimado, StringFormat={}{0:C}}" Width="1*"/>
                    <DataGridTextColumn Header="Estoque" Binding="{Binding EstoqueDisponivel}" Width="0.8*"/>
                    <DataGridTemplateColumn Header="Acoes" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="Editar" Tag="{Binding}" Margin="0,0,6,0" Padding="10,4" Click="EditarItem_Click"/>
                                    <Button Content="Remover" Tag="{Binding}" Margin="0,0,6,0" Padding="10,4" Click="RemoverItem_Click"/>
                                    <Button Content="Duplicar" Tag="{Binding}" Padding="10,4" Click="DuplicarItem_Click"/>
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
