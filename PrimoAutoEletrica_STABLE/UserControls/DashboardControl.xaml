<UserControl x:Class="PrimoAutoEletrica.UserControls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="24">
            <Border Style="{StaticResource DashboardHeroCard}"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Dashboard operacional"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Indicadores reais do banco para acompanhar a oficina em tempo de decisao."
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="AtualizadoEmTextBlock"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="AtualizarDashboardButton"
                            Style="{StaticResource ModalSecondaryButton}"
                            Content="Atualizar"
                            Padding="18,8"
                            VerticalAlignment="Top"
                            Click="AtualizarDashboardButton_Click"/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}"
                                Margin="0,0,12,12"
                                MinHeight="128">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}"
                                               Style="{StaticResource DashboardMetricLabel}"/>
                                    <TextBlock Text="{Binding Valor}"
                                               Style="{StaticResource DashboardMetricValue}"
                                               Margin="0,10,0,4"/>
                                    <TextBlock Text="{Binding Detalhe}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="{DynamicResource InfoCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource InfoBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Icone}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource InfoBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource DashboardHeroCard}"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Faturamento dos ultimos 7 dias"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding RevenueBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Dia}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>

                                        <ProgressBar Grid.Column="1"
                                                     Height="12"
                                                     Maximum="100"
                                                     Value="{Binding Percentual}"
                                                     Foreground="{DynamicResource PrimaryBrush}"
                                                     Background="{DynamicResource BorderBrush}"
                                                     VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ValorFormatado}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource DashboardHeroCard}">
                    <StackPanel>
                        <TextBlock Text="Operacao agora"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding Highlights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Detalhe}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource DashboardHeroCard}"
                    Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Atalhos rapidos"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,14"/>

                    <WrapPanel>
                        <Button x:Name="AtalhoAgendamentosDashboardButton"
                                Content="Novo agendamento"
                                Tag="Agendamentos"
                                Style="{StaticResource ModalAccentButton}"
                                Margin="0,0,10,10"
                                Click="AtalhoModuloButton_Click"/>
                        <Button x:Name="AtalhoPdvDashboardButton"
                                Content="Nova venda"
                                Tag="PDV"
                                Style="{StaticResource ModalAccentButton}"
                                Margin="0,0,10,10"
                                Click="AtalhoModuloButton_Click"/>
                        <Button x:Name="AtalhoOrcamentosDashboardButton"
                                Content="Novo orcamento"
                                Tag="Orcamentos"
                                Style="{StaticResource ModalAccentButton}"
                                Margin="0,0,10,10"
                                Click="AtalhoModuloButton_Click"/>
                        <Button x:Name="AtalhoOrdensServicoDashboardButton"
                                Content="Nova OS"
                                Tag="OrdensServico"
                                Style="{StaticResource ModalAccentButton}"
                                Margin="0,0,10,10"
                                Click="AtalhoModuloButton_Click"/>
                        <Button x:Name="AtalhoEstoqueDashboardButton"
                                Content="Estoque critico"
                                Tag="Estoque"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="0,0,10,10"
                                Click="AtalhoModuloButton_Click"/>
                        <Button x:Name="AtalhoFinanceiroDashboardButton"
                                Content="Financeiro"
                                Tag="Financeiro"
                                Style="{StaticResource ModalSecondaryButton}"
                                Margin="0,0,10,10"
                                Click="AtalhoModuloButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
