<UserControl x:Class="PrimoAutoEletrica.UserControls.FinanceiroControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE AÇÕES -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="20,20,20,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ações financeiras"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Resumo, filtros, exportação e impressão do panorama financeiro."
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <WrapPanel Margin="0,10,0,0">
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="10,6"
                                Margin="0,0,8,8">
                            <TextBlock Text="{Binding CaixaNumero, StringFormat=Caixa: {0}}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border Background="{DynamicResource SuccessCardBackgroundBrush}"
                                BorderBrush="{DynamicResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="10,6"
                                Margin="0,0,8,8">
                            <TextBlock Text="{Binding StatusFinanceiro, StringFormat=Status: {0}}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">

                    <Button Content="Atualizar"
                            Click="AtualizarDadosButton_Click"
                            Style="{StaticResource PagePrimaryActionButton}"/>

                    <Button x:Name="ExportarRelatorioButton"
                            Content="Exportar"
                            Click="ExportarRelatorioButton_Click"
                            Style="{StaticResource ExportActionButton}"/>

                    <Button Content="PDF"
                            Click="GerarPDFButton_Click"
                            Style="{StaticResource PageDangerActionButton}"
                            MinWidth="86"/>

                    <Button Content="Imprimir"
                            Click="ImprimirButton_Click"
                            Style="{StaticResource PrintActionButton}"/>

                    <Button Content="Filtros"
                            Click="FiltrosAvancadosButton_Click"
                            Style="{StaticResource FilterActionButton}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBackgroundBrush}">

            <StackPanel Margin="20,0,20,24"
                        Background="{DynamicResource AppBackgroundBrush}">

                <TextBlock Text="Indicadores"
                           Margin="0,0,0,14"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- CARDS FINANCEIROS LINHA 1 -->
                <ItemsControl ItemsSource="{Binding CardsFinanceirosLinha1}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icone}"
                                                   FontSize="22"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Titulo}"
                                                   ToolTip="{Binding Titulo}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Valor, StringFormat={}{0:C}}"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Comparacao}"
                                               ToolTip="{Binding Comparacao}"
                                               Foreground="{Binding CorComparacao}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CARDS FINANCEIROS LINHA 2 -->
                <ItemsControl ItemsSource="{Binding CardsFinanceirosLinha2}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icone}"
                                                   FontSize="22"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Titulo}"
                                                   ToolTip="{Binding Titulo}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Valor, StringFormat={}{0:C}}"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Comparacao}"
                                               ToolTip="{Binding Comparacao}"
                                               Foreground="{Binding CorComparacao}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CARDS FINANCEIROS LINHA 3 -->
                <ItemsControl ItemsSource="{Binding CardsFinanceirosLinha3}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icone}"
                                                   FontSize="22"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Titulo}"
                                                   ToolTip="{Binding Titulo}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Valor, StringFormat={}{0:C}}"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Comparacao}"
                                               ToolTip="{Binding Comparacao}"
                                               Foreground="{Binding CorComparacao}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- GRÁFICOS -->
                <Grid Margin="0,8,0,24"
                      Background="{DynamicResource AppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FLUXO DE CAIXA -->
                    <Border Grid.Column="0"
                            Margin="0,0,16,0"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.10"
                                              BlurRadius="12"
                                              ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Fluxo de caixa diário"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="Entradas e saídas do mês atual"
                                       Margin="0,4,0,18"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <TextBlock Text="{Binding FluxoCaixaResumo}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,18,0">
                                    <Border Width="12"
                                            Height="12"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource SuccessBrush}"
                                            CornerRadius="3"/>
                                    <TextBlock Text="Entradas"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12"
                                            Height="12"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource DangerBrush}"
                                            CornerRadius="3"/>
                                    <TextBlock Text="Saídas"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Background="{DynamicResource CardBackgroundBrush}">
                                <ItemsControl ItemsSource="{Binding FluxoCaixaGrafico}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="52"
                                                    Margin="0,0,10,0"
                                                    Padding="8,12"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    CornerRadius="10"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid Height="210">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0"
                                                          VerticalAlignment="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Height="{Binding EntradasAltura}"
                                                                Margin="0,0,3,0"
                                                                VerticalAlignment="Bottom"
                                                                Background="{DynamicResource SuccessBrush}"
                                                                CornerRadius="4,4,0,0"/>

                                                        <Border Grid.Column="1"
                                                                Height="{Binding SaidasAltura}"
                                                                Margin="3,0,0,0"
                                                                VerticalAlignment="Bottom"
                                                                Background="{DynamicResource DangerBrush}"
                                                                CornerRadius="4,4,0,0"/>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1"
                                                               Margin="0,10,0,0"
                                                               HorizontalAlignment="Center"
                                                               Text="{Binding Dia}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,4,0,0"
                                                               HorizontalAlignment="Center"
                                                               Text="{Binding Lucro, StringFormat={}{0:C0}}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding LucroCor}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- FORMAS DE PAGAMENTO -->
                    <Border Grid.Column="1"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.10"
                                              BlurRadius="12"
                                              ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Formas de pagamento"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="Distribuição de recebimentos do mês"
                                       Margin="0,4,0,18"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <TextBlock Text="{Binding FormasPagamentoResumo}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FormasPagamentoGrafico}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Nome}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Valor, StringFormat={}{0:C}}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="Bold"/>
                                            </DockPanel>

                                            <Grid Height="12"
                                                  Margin="0,8,0,4">
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        CornerRadius="6"/>
                                                <Border Width="{Binding LarguraBarra}"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding Cor}"
                                                        CornerRadius="6"/>
                                            </Grid>

                                            <TextBlock Text="{Binding ParticipacaoTexto}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ALERTAS FINANCEIROS -->
                <Border Padding="22"
                        Margin="0,0,0,24"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          Opacity="0.10"
                                          BlurRadius="12"
                                          ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Alertas de divergencia"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <TextBlock Text="Pendencias que podem distorcer caixa, DRE ou conciliacao."
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,6">
                                <TextBlock Text="{Binding StatusFinanceiro, StringFormat=Status financeiro: {0}}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding AlertasDivergencia}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="310"
                                            MinHeight="142"
                                            Margin="0,0,12,12"
                                            Padding="16"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{Binding Cor}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Tipo}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>

                                                <Border DockPanel.Dock="Right"
                                                        Background="{Binding Cor}"
                                                        CornerRadius="999"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Severidade}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource InverseTextBrush}"/>
                                                </Border>
                                            </DockPanel>

                                            <TextBlock Text="{Binding Mensagem}"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Valor, StringFormat=Valor em atencao: {0:C}}"
                                                       Margin="0,8,0,0"
                                                       Foreground="{Binding Cor}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding Detalhes}"
                                                       Margin="0,8,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CONTAS -->
                <Grid Margin="0,0,0,24"
                      Background="{DynamicResource AppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CONTAS A PAGAR -->
                    <Border Grid.Column="0"
                            Margin="0,0,16,0"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.10"
                                              BlurRadius="12"
                                              ShadowDepth="3"/>
                        </Border.Effect>

                        <Grid Background="{DynamicResource CardBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Contas a pagar"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <WrapPanel Grid.Row="1"
                                       Margin="0,14,0,14">
                                <Button x:Name="FiltroContasPagarTodasButton"
                                        Content="Todas"
                                        Click="FiltroContasPagarTodas_Click"
                                        Style="{StaticResource CompactSecondaryActionButton}"/>

                                <Button x:Name="FiltroContasPagarVencidasButton"
                                        Content="Vencidas"
                                        Click="FiltroContasPagarVencidas_Click"
                                        Style="{StaticResource CompactDangerActionButton}"/>

                                <Button x:Name="FiltroContasPagarHojeButton"
                                        Content="Hoje"
                                        Click="FiltroContasPagarHoje_Click"
                                        Style="{StaticResource CompactWarningActionButton}"/>

                                <Button x:Name="FiltroContasPagarSemanaButton"
                                        Content="Semana"
                                        Click="FiltroContasPagarSemana_Click"
                                        Style="{StaticResource CompactInfoActionButton}"/>

                                <Button x:Name="BaixarContaPagarSelecionadaButton"
                                        Content="Baixar selecionada"
                                        Click="BaixarContaPagarSelecionada_Click"
                                        Style="{StaticResource CompactPrimaryActionButton}"/>
                            </WrapPanel>

                            <DataGrid x:Name="ContasPagarDataGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource PremiumDataGrid}"
                                      ItemsSource="{Binding ContasPagarFiltradas}"
                                      SelectedItem="{Binding ContaPagarSelecionada}"
                                      BorderThickness="0"
                                      RowHeaderWidth="0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fornecedor"
                                                        Binding="{Binding Fornecedor}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Descrição"
                                                        Binding="{Binding Descricao}"
                                                        Width="1.4*"/>
                                    <DataGridTextColumn Header="Vencimento"
                                                        Binding="{Binding DataVencimento, StringFormat={}{0:dd/MM/yyyy}}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Valor"
                                                        Binding="{Binding Valor, StringFormat={}{0:C}}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}"
                                                        Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- CONTAS A RECEBER -->
                    <Border Grid.Column="1"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.10"
                                              BlurRadius="12"
                                              ShadowDepth="3"/>
                        </Border.Effect>

                        <Grid Background="{DynamicResource CardBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Contas a receber"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <WrapPanel Grid.Row="1"
                                       Margin="0,14,0,14">
                                <Button x:Name="FiltroContasReceberTodasButton"
                                        Content="Todas"
                                        Click="FiltroContasReceberTodas_Click"
                                        Style="{StaticResource CompactSecondaryActionButton}"/>

                                <Button x:Name="FiltroContasReceberVencidasButton"
                                        Content="Vencidas"
                                        Click="FiltroContasReceberVencidas_Click"
                                        Style="{StaticResource CompactDangerActionButton}"/>

                                <Button x:Name="FiltroContasReceberHojeButton"
                                        Content="Hoje"
                                        Click="FiltroContasReceberHoje_Click"
                                        Style="{StaticResource CompactWarningActionButton}"/>

                                <Button x:Name="FiltroContasReceberSemanaButton"
                                        Content="Semana"
                                        Click="FiltroContasReceberSemana_Click"
                                        Style="{StaticResource CompactInfoActionButton}"/>

                                <Button x:Name="BaixarContaReceberSelecionadaButton"
                                        Content="Receber selecionada"
                                        Click="BaixarContaReceberSelecionada_Click"
                                        Style="{StaticResource CompactSuccessActionButton}"/>
                            </WrapPanel>

                            <DataGrid x:Name="ContasReceberDataGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource PremiumDataGrid}"
                                      ItemsSource="{Binding ContasReceberFiltradas}"
                                      SelectedItem="{Binding ContaReceberSelecionada}"
                                      BorderThickness="0"
                                      RowHeaderWidth="0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cliente"
                                                        Binding="{Binding Cliente}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Descrição"
                                                        Binding="{Binding Descricao}"
                                                        Width="1.4*"/>
                                    <DataGridTextColumn Header="Vencimento"
                                                        Binding="{Binding DataVencimento, StringFormat={}{0:dd/MM/yyyy}}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Valor"
                                                        Binding="{Binding Valor, StringFormat={}{0:C}}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}"
                                                        Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- DRE -->
                <Border Padding="22"
                        Margin="0,0,0,24"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          Opacity="0.10"
                                          BlurRadius="12"
                                          ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="DRE operacional do período"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding DemonstrativoResultado.DataInicio, StringFormat=Período inicial: {0:dd/MM/yyyy}}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding DemonstrativoResultado.DataFim, StringFormat=Período final: {0:dd/MM/yyyy}}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,18"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Receitas confirmadas"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding DemonstrativoResultado.ReceitasConfirmadas, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Despesas confirmadas"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding DemonstrativoResultado.DespesasConfirmadas, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Resultado operacional"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding DemonstrativoResultado.ResultadoOperacional, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Contas a receber pendentes"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding DemonstrativoResultado.ContasReceberPendentes, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Contas a pagar pendentes"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding DemonstrativoResultado.ContasPagarPendentes, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Resultado projetado"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding DemonstrativoResultado.ResultadoProjetado, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding DemonstrativoResultado.InadimplenciaEmAberto, StringFormat=Inadimplência: {0:C}}"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,20,0,20"
                                   Background="{DynamicResource BorderBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Total de entradas"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding TotalEntradas, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total de saídas"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding TotalSaidas, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Saldo projetado"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SaldoPrevisto, StringFormat={}{0:C}}"
                                           Margin="0,6,0,0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PLANO FINANCEIRO EXECUTIVO -->
                <Border x:Name="PlanoFinanceiroExecutivoPanel"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          Opacity="0.10"
                                          BlurRadius="12"
                                          ShadowDepth="3"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Plano financeiro operacional"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ResumoPlanoFinanceiro}"
                                   Margin="0,6,0,18"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>

                        <ItemsControl x:Name="IndicadoresPlanoFinanceiroItems"
                                      ItemsSource="{Binding IndicadoresPlanoFinanceiro}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MetricCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Titulo}"
                                                       ToolTip="{Binding Titulo}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Valor, StringFormat={}{0:C}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Comparacao}"
                                                       ToolTip="{Binding Comparacao}"
                                                       Foreground="{Binding CorComparacao}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,18,0,0">
                            <Border Width="520"
                                    MinHeight="260"
                                    Margin="0,0,16,16"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="Lucro por OS"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <DataGrid x:Name="LucroOsFinanceiroGrid"
                                              Margin="0,12,0,0"
                                              MaxHeight="220"
                                              Style="{StaticResource PremiumDataGrid}"
                                              ItemsSource="{Binding LucroPorOrdemServico}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="OS"
                                                                Binding="{Binding Referencia}"
                                                                Width="1.2*"/>
                                            <DataGridTextColumn Header="Cliente"
                                                                Binding="{Binding Detalhe}"
                                                                Width="1.4*"/>
                                            <DataGridTextColumn Header="Receita"
                                                                Binding="{Binding Receita, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                            <DataGridTextColumn Header="Lucro"
                                                                Binding="{Binding LucroBruto, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Width="520"
                                    MinHeight="260"
                                    Margin="0,0,16,16"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="Lucro por produto"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <DataGrid x:Name="LucroProdutoFinanceiroGrid"
                                              Margin="0,12,0,0"
                                              MaxHeight="220"
                                              Style="{StaticResource PremiumDataGrid}"
                                              ItemsSource="{Binding LucroPorProduto}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Produto"
                                                                Binding="{Binding Referencia}"
                                                                Width="1.5*"/>
                                            <DataGridTextColumn Header="Qtd"
                                                                Binding="{Binding Quantidade, StringFormat={}{0:N0}}"
                                                                Width="80"/>
                                            <DataGridTextColumn Header="Receita"
                                                                Binding="{Binding Receita, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                            <DataGridTextColumn Header="Margem"
                                                                Binding="{Binding MargemPercentual, StringFormat={}{0:N1}%}"
                                                                Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Width="520"
                                    MinHeight="260"
                                    Margin="0,0,16,16"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="Lucro por servico"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <DataGrid x:Name="LucroServicoFinanceiroGrid"
                                              Margin="0,12,0,0"
                                              MaxHeight="220"
                                              Style="{StaticResource PremiumDataGrid}"
                                              ItemsSource="{Binding LucroPorServico}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Servico"
                                                                Binding="{Binding Referencia}"
                                                                Width="1.5*"/>
                                            <DataGridTextColumn Header="Origem"
                                                                Binding="{Binding Origem}"
                                                                Width="100"/>
                                            <DataGridTextColumn Header="Receita"
                                                                Binding="{Binding Receita, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                            <DataGridTextColumn Header="Lucro"
                                                                Binding="{Binding LucroBruto, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Width="520"
                                    MinHeight="260"
                                    Margin="0,0,16,16"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="Despesas fixas e variaveis"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <DataGrid x:Name="DespesasFinanceirasGrid"
                                              Margin="0,12,0,0"
                                              MaxHeight="220"
                                              Style="{StaticResource PremiumDataGrid}"
                                              ItemsSource="{Binding DespesasPorTipo}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tipo"
                                                                Binding="{Binding Tipo}"
                                                                Width="1.4*"/>
                                            <DataGridTextColumn Header="Qtd"
                                                                Binding="{Binding Quantidade}"
                                                                Width="70"/>
                                            <DataGridTextColumn Header="Valor"
                                                                Binding="{Binding Valor, StringFormat={}{0:C}}"
                                                                Width="120"/>
                                            <DataGridTextColumn Header="%"
                                                                Binding="{Binding Percentual, StringFormat={}{0:N1}%}"
                                                                Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Width="520"
                                    MinHeight="260"
                                    Margin="0,0,16,16"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="Recebimentos por forma"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <DataGrid x:Name="RecebimentosFinanceirosGrid"
                                              Margin="0,12,0,0"
                                              MaxHeight="220"
                                              Style="{StaticResource PremiumDataGrid}"
                                              ItemsSource="{Binding RecebimentosPorFormaPagamento}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Forma"
                                                                Binding="{Binding FormaPagamento}"
                                                                Width="1.4*"/>
                                            <DataGridTextColumn Header="Qtd"
                                                                Binding="{Binding Quantidade}"
                                                                Width="70"/>
                                            <DataGridTextColumn Header="Valor"
                                                                Binding="{Binding Valor, StringFormat={}{0:C}}"
                                                                Width="120"/>
                                            <DataGridTextColumn Header="%"
                                                                Binding="{Binding Percentual, StringFormat={}{0:N1}%}"
                                                                Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Width="520"
                                    MinHeight="260"
                                    Margin="0,0,16,16"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="Caixa por operador"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <DataGrid x:Name="CaixaOperadorFinanceiroGrid"
                                              Margin="0,12,0,0"
                                              MaxHeight="220"
                                              Style="{StaticResource PremiumDataGrid}"
                                              ItemsSource="{Binding CaixaPorOperador}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Operador"
                                                                Binding="{Binding Operador}"
                                                                Width="1.4*"/>
                                            <DataGridTextColumn Header="Vendas"
                                                                Binding="{Binding TotalVendas, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                            <DataGridTextColumn Header="Entradas"
                                                                Binding="{Binding Entradas, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                            <DataGridTextColumn Header="Saldo"
                                                                Binding="{Binding Saldo, StringFormat={}{0:C}}"
                                                                Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Width="520"
                                    MinHeight="260"
                                    Margin="0,0,16,16"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock Text="Faturamento por periodo"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <DataGrid x:Name="FaturamentoPeriodoFinanceiroGrid"
                                              Margin="0,12,0,0"
                                              MaxHeight="220"
                                              Style="{StaticResource PremiumDataGrid}"
                                              ItemsSource="{Binding FaturamentoPorPeriodo}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Periodo"
                                                                Binding="{Binding Periodo}"
                                                                Width="120"/>
                                            <DataGridTextColumn Header="Receitas"
                                                                Binding="{Binding Receitas, StringFormat={}{0:C}}"
                                                                Width="120"/>
                                            <DataGridTextColumn Header="Despesas"
                                                                Binding="{Binding Despesas, StringFormat={}{0:C}}"
                                                                Width="120"/>
                                            <DataGridTextColumn Header="Resultado"
                                                                Binding="{Binding Resultado, StringFormat={}{0:C}}"
                                                                Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
