<Window x:Class="PrimoAutoEletrica.Views.DatabaseConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração de Banco" Height="220" Width="460">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Connection string:" />
        <TextBox x:Name="ConnectionStringBox" Grid.Row="1" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="TestButton" Content="Testar conexão" Width="120" Margin="0,0,8,0" Click="TestButton_Click" />
            <Button x:Name="SaveButton" Content="Salvar" Width="80" Click="SaveButton_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" />
    </Grid>
</Window>
